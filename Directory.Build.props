<Project>
  <!-- Single source of truth for the application version. Both heads and the
       About dialog derive from this value: the MAUI head via
       ApplicationDisplayVersion=$(Version), the WebHost via the implicit
       assembly version, and Settings > About via the assembly informational
       version read at runtime. Bump ONLY here on release. -->
  <PropertyGroup>
    <Version>2.16.0</Version>
  </PropertyGroup>

  <!-- ── The .NET runtime the downloads carry ──────────────────────────────
       A self-contained publish bundles the runtime its SDK band knows about,
       not the newest one. global.json holds the SDK at 10.0.3xx (for rzc), and
       that band stopped at 10.0.303, so 2.16.0's WebHost zips carried runtime
       10.0.11 and missed the Brotli fix in 10.0.14 (GHSA-p3jp-9v83-76w9); the
       Mac app, built with SDK 10.0.100 for Xcode 26.0, carried 10.0.0.

       release.yml passes PinShippedRuntime=true on every publish that bundles
       a runtime (the WebHost zips and the Mac app), which asks NuGet for this
       version's runtime packs instead. It is not set for ordinary builds: a
       framework-dependent build would then demand this runtime on the machine
       running it, and the test runners and the Windows app (which uses the
       user's installed .NET) do not have to have it.

       scripts/verify_release_payloads.py reads this value and refuses a release
       whose zips carry any other runtime. Raise it to the newest 10.0.x patch
       before each release (nuget.org, Microsoft.NETCore.App.Runtime.linux-x64);
       the release job warns when a newer one exists. -->
  <PropertyGroup>
    <ShippedRuntimeVersion>10.0.15</ShippedRuntimeVersion>
    <RuntimeFrameworkVersion Condition="'$(PinShippedRuntime)' == 'true'">$(ShippedRuntimeVersion)</RuntimeFrameworkVersion>
  </PropertyGroup>

  <!-- ── Commit stamp ──────────────────────────────────────────────────────
       Most builds of this project are NOT releases; they are commits. Between
       tags the version number alone cannot answer the only question that
       matters when a user reports something: "which build is that?" Two people
       both running 2.3.0 can be four hundred commits apart.

       So the informational version becomes `2.3.0+<short sha>`, which is what
       Settings > About shows and what a bug report can be pinned to. SemVer
       build metadata is the correct field for this — it is ignored for version
       ordering, so it cannot affect any upgrade comparison.

       Deliberately tolerant of having no git: a build from a source tarball or
       an exported directory simply gets the bare version rather than failing.
       ContinueOnError plus the exit-code guard mean a machine without git
       installed builds exactly as it did before. -->
  <Target Name="StampCommitId"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(SuppressCommitStamp)' != 'true'">
    <Exec Command="git rev-parse --short=8 HEAD"
          ConsoleToMSBuild="true"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <PropertyGroup Condition="'$(_GitExitCode)' == '0' AND '$(_GitShortSha)' != ''">
      <InformationalVersion>$(Version)+$(_GitShortSha.Trim())</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
