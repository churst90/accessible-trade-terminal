---
title: Accessible Trading Terminal — architecture overview
---
%% Verified against the tree on 2026-08-28.
%% Counts here are load-bearing: 16 trading + 17 analytics plugins, 128 audio voices.
%% docs/README.md claims the same numbers and CI (scripts/check_doc_drift.py) enforces them there.
graph TD
    subgraph HEADS["Three heads, one component library"]
        MAUI["MAUI Blazor Hybrid<br/>Windows / macOS / iOS / Android<br/>native SKCanvasView overlay"]
        WEB["ASP.NET Core Blazor Server<br/>AccessibleTrader.WebHost<br/>chart as streamed PNG"]
        LAB["AccessibleTrader.StrategyLab<br/>headless research CLI"]
        RCL["AccessibleTrader.BlazorClient.Components<br/>Razor Class Library — every modal, toolbar, chart shell"]
        MAUI --> RCL
        WEB --> RCL
    end

    subgraph POLICY["Host gating"]
        DP["DemoPolicy — HostMode Full | Demo | Hosted<br/>Full only: live trading, API-key modal, custom scripts,<br/>AI analyst, strategies, background monitoring<br/>Not-demo: paper dashboard, alerts, order book, settings"]
    end

    subgraph INPUT["Input pipeline"]
        KB["Platform key capture<br/>keyboard.js (web/WebView) · MainActivity.DispatchKeyEvent (Android)<br/>KeyboardPageHandler (Mac Catalyst)"]
        BIS["BlazorInputService"]
        SM["ShortcutManager<br/>InitializeDefaultProfile — every default binding"]
        REMAP["WebHostShortcutRemap<br/>Ctrl+Shift+letter to Alt+Shift+letter,<br/>reserved single-Ctrl chords rebound"]
        CD["CommandDispatcher"]
        KB --> BIS --> SM --> CD
        REMAP -.mutates in-memory profile at WebHost startup.-> SM
    end

    subgraph CORE["AccessibleTrader.Core — platform-agnostic"]
        EB["EventBus — cross-layer, fire-and-forget"]
        STORE["WorkspaceStore — Redux-style, Rx StateStream"]

        subgraph ORCH["Orchestration"]
            MO["MarketOrchestrator<br/>market to provider to symbol cascade"]
            DO["DataOrchestrator<br/>Polly retry + circuit breaker<br/>DataState machine"]
            DOS["DataOrchestrationService"]
            IO["IndicatorOrchestrator"]
        end

        subgraph A11Y["Accessibility cluster"]
            NE["NavigationEngine"]
            VM["ViewportManager"]
            AFC["AccessibilityFeedbackCoordinator<br/>the single brain for user-facing feedback"]
            SFR["SpeechFeedbackRouter"]
            AFR["AudioFeedbackRouter"]
            ANS["AutoNarrationService"]
            CLD["ChartLayoutDescriber"]
        end

        subgraph AUDIO["Audio engine — custom DSP, no NAudio synthesis"]
            SMM["SonificationManager<br/>sole owner of navigation audio"]
            NS["NavigationSonifier"]
            SEQ["AudioSequencer — playback scopes"]
            DSP["AudioEngine — 128 voices<br/>0-15 navigation · 16-31 UI earcons<br/>32-95 playback · 96-127 cloud/ribbon fills<br/>brickwall limiter before the DAC"]
        end

        subgraph TRADE["Trading"]
            GOS["GeneralOrderService<br/>typed OrderPlacement result"]
            PAPER["PaperTradingProvider + PaperAccountHub<br/>isolated and cross margin"]
            QT["QuickTrade — arm, size, place from the chart"]
            ALERT["AlertOrchestrator + AlertEvaluator"]
            STRAT["StrategyEngine"]
        end

        subgraph DATA["Data"]
            HDF["HistoricalDataFetcher"]
            LSM["LiveStreamManager — watchdog, gap fill"]
            STORE2["OhlcvStore + FileCacheService"]
            RES["ResamplerService"]
            IS["IndicatorService — 36 IIndicatorProvider implementations"]
        end

        PLS["PluginLoaderService"]
        PTP["PluginTrustPolicy — SHA-256 allow-list"]
        SCR["Out-of-process scripting<br/>OutOfProcessScriptHost to ScriptWorker"]
    end

    subgraph PLUGINS["Plugins — AccessibleTrader.Sdk contract"]
        TP["16 trading providers<br/>Plugins/Providers"]
        AP["17 analytics providers<br/>Plugins/Analytics"]
        IP["Drop-in indicator DLLs<br/>Plugins/Indicators"]
    end

    subgraph SANDBOX["Script isolation — separate OS process, per platform"]
        SW["AccessibleTrader.ScriptWorker"]
        BW["Linux bwrap"]
        AC["Windows AppContainer"]
        SBX["macOS sandbox-exec"]
        AND["Android isolatedProcess"]
        REF["RefusingScriptWorkerLauncher<br/>no sandbox available means no execution"]
    end

    subgraph OUT["Output surfaces"]
        REND["ChartRenderer — SkiaSharp<br/>native canvas (MAUI) or PNG over SignalR (WebHost)"]
        SPEECH["ISpeechManager<br/>NVDA/JAWS/Narrator/VoiceOver/TalkBack · Orca D-Bus · spd-say · browser SpeechSynthesis"]
        TACT["ITactileDriver to Dot Pad<br/>300 graphic cells + 20 braille cells"]
        AUDOUT["IAudioDriver<br/>WASAPI · AudioTrack · AVAudioEngine · Web Audio"]
    end

    subgraph PERSIST["Persistence"]
        CFG["Workspaces, tabs, settings, sound design (JSON)"]
        CACHE["OHLCV cache (SQLite + files)"]
        SEC["ISecureStorageService<br/>keychain / KeyStore / DPAPI / DataProtection key ring"]
    end

