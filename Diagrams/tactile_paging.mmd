        HB[History Buffer - Ohlcv Data]
        VC[Virtual Canvas - 960x400]
        VP[Viewport Manager]
    end

    subgraph Hardware Driver (MAUI Interop)
        TD[ITactileDriver]
        MTD[MonarchTactileDriver]
