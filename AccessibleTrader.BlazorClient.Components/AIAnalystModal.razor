@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Sdk.Strategies
@inherits ModalBase
@inject IAIAnalystService AIAnalyst
@inject ISpeechManager SpeechManager
@inject IJournalService Journal
@inject IStrategyLibrary StrategyLibrary

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="ai-analyst-title"
             @onclick:stopPropagation="true">

            <h2 id="ai-analyst-title" tabindex="-1">AI Technical Analyst</h2>

            @if (_isAnalysing)
            {
                <p role="status" aria-live="polite" aria-busy="true" style="margin-top: 12px;">
                    Analysing chart&hellip; please wait.
                </p>
            }
            else if (!string.IsNullOrEmpty(_errorMessage))
            {
                @* Amber on a bordered plate rather than pure red text. #c00 on a dark surface is both
                   harsh and low-contrast, and "no API key configured" is a thing to go and do, not
                   a failure — styling it as an error made a setup step read as a fault. *@
                <p role="alert"
                   style="margin-top: 12px; color: #ffb300;
                          border-left: 3px solid #ffb300; padding: 8px 12px;
                          background: color-mix(in srgb, #ffb300 10%, transparent);">@_errorMessage</p>
            }
            else if (!string.IsNullOrEmpty(_analysisText))
            {
                <div role="region" aria-label="Analysis result" style="margin-top: 12px; white-space: pre-wrap; line-height: 1.6;">
                    @_analysisText
                </div>
            }

            <div class="modal-footer">
                @if (!_isAnalysing && string.IsNullOrEmpty(_analysisText) && string.IsNullOrEmpty(_errorMessage))
                {
                    <button class="primary" @onclick="RunAnalysis">Analyse</button>
                }
                @if (!_isAnalysing && !string.IsNullOrEmpty(_analysisText))
                {
                    <button @onclick="RunAnalysis">Re-analyse</button>
                }
                @if (!_isAnalysing)
                {
                    <button @onclick="ReviewSetupsAsync"
                            aria-label="Review setups today by reading the journal and asking the AI">
                        Review setups today
                    </button>
                }
                <button @onclick="Close" aria-label="Close AI Analyst dialog">Close</button>
            </div>

        </div>
    </div>
}

@code {
    private bool   _isAnalysing;
    private string _analysisText  = "";
    private string _errorMessage  = "";

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        _eventSub = EventBus.Subscribe<OpenAIAnalystEvent>(_ => InvokeAsync(ShowAsync));
    }

    private async Task ShowAsync()
    {
        _analysisText = "";
        _errorMessage = "";
        _isAnalysing  = false;
        await ShowModalAsync("ai-analyst-title");
        // Auto-trigger analysis on open
        await RunAnalysis();
    }

    private async Task RunAnalysis()
    {
        _analysisText = "";
        _errorMessage = "";
        _isAnalysing  = true;
        StateHasChanged();

        try
        {
            var result = await AIAnalyst.AnalyseAsync();
            if (result == null)
            {
                _errorMessage = "No AI API key is configured. Add a Claude, OpenAI, or Ollama key in Settings → API Keys.";
                SpeechManager.Speak("No AI API key configured. Open Settings and add a Claude or OpenAI key.", interrupt: true);
            }
            else
            {
                _analysisText = result;
                SpeechManager.Speak(result, interrupt: true);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Analysis failed: {ex.Message}";
            SpeechManager.Speak("AI analysis failed. " + ex.Message, interrupt: true);
        }
        finally
        {
            _isAnalysing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// "Review my setups today" — builds a structured prompt from today's journal entries
    /// (strategy signals, setup confirmations / reconfirmations / dropouts) and the relevant
    /// strategy specs from the library, then asks the LLM to identify what worked, what failed,
    /// and any patterns. Result is displayed in the modal AND added to the journal as an Info
    /// entry so the user can review it later via Ctrl+Alt+Shift+J.
    /// </summary>
    private async Task ReviewSetupsAsync()
    {
        _analysisText = "";
        _errorMessage = "";
        _isAnalysing = true;
        StateHasChanged();

        try
        {
            // 1. Filter the journal to today's strategy-related entries.
            var today = DateTime.Now.Date;
            var entries = Journal.Snapshot()
                .Where(e => e.Timestamp.Date == today
                            && (e.Kind == JournalEntryKind.StrategySignal
                             || e.Kind == JournalEntryKind.Alert))
                .ToList();

            if (entries.Count == 0)
            {
                _errorMessage = "No strategy setups have fired today yet — nothing to review.";
                SpeechManager.Speak("No setups today.", interrupt: true);
                return;
            }

            // 2. Collect the unique source strategy names referenced by today's entries, then
            // pull the matching specs from the library so the LLM can see what conditions and
            // risk plans drove each fired setup.
            var sourceNames = entries.Select(e => e.Source).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            var specs = StrategyLibrary.All
                .Where(s => sourceNames.Contains(s.Name, StringComparer.OrdinalIgnoreCase))
                .ToList();

            // 3. Build the prompt body. Keep it structured so the LLM can scan it.
            var sb = new System.Text.StringBuilder();
            sb.AppendLine($"Review {entries.Count} strategy events from today ({today:yyyy-MM-dd}):");
            sb.AppendLine();
            sb.AppendLine("=== Strategy Specs Active Today ===");
            foreach (var spec in specs)
            {
                sb.AppendLine($"- {spec.Name} ({spec.Side}): {spec.Description}");
                sb.AppendLine($"  Min R:R = {spec.Risk.MinRewardRiskRatio:F1}, Stop = {spec.Risk.Stop.Kind}, " +
                              $"Sizing = {spec.Risk.Sizing.Mode} ({spec.Risk.Sizing.RiskPercent:P1})");
            }
            sb.AppendLine();
            sb.AppendLine("=== Today's Journal ===");
            foreach (var e in entries)
            {
                sb.AppendLine($"[{e.Timestamp:HH:mm}] {e.Kind} {e.Source}: {e.Text}");
            }
            sb.AppendLine();
            sb.AppendLine("Please review and respond.");

            // 4. Send to the analyst.
            var result = await AIAnalyst.AskAsync(sb.ToString());
            if (result == null)
            {
                _errorMessage = "No AI API key is configured. Add a Claude, OpenAI, or Ollama key in Settings → API Keys.";
                SpeechManager.Speak("No AI key configured.", interrupt: true);
                return;
            }

            _analysisText = result;
            SpeechManager.Speak(result, interrupt: true);

            // Mirror the review into the journal so the user can re-read it later.
            Journal.Add(new JournalEntry(
                Timestamp: DateTime.Now,
                Kind: JournalEntryKind.Info,
                Source: "AI Analyst",
                Symbol: null,
                Text: "Setup review: " + result));
        }
        catch (Exception ex)
        {
            _errorMessage = $"Review failed: {ex.Message}";
            SpeechManager.Speak("Review failed.", interrupt: true);
        }
        finally
        {
            _isAnalysing = false;
            StateHasChanged();
        }
    }

    private void Close() => CloseModal();

    protected override string ModalName => "AI Analyst";
}
