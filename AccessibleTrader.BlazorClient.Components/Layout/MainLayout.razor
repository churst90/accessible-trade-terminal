@inherits LayoutComponentBase
@implements IDisposable
@using System.Threading
@using System.Reactive.Linq
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.BlazorClient.Services
@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Services.Scripting
@inject IWorkspaceStore Store
@inject ISpeechManager SpeechManager
@inject GlobalInputService InputService
@inject IJSRuntime JSRuntime
@inject AccessibleTrader.Core.Services.Input.ModalStack ModalStack
@inject IAudioFeedbackRouter AudioRouter
@inject IScriptWorkerLauncher ScriptWorkerLauncher
@*
    SetupSonifier is a singleton that subscribes to SetupConfirmed/Reconfirmed/Dropped
    events on construction. Injecting it into MainLayout forces DI to construct it at
    app start so the subscriptions are wired before any composite strategy can fire.
    StrategyAutoLoader is also resolved here for the same reason — its LoadAllAsync() runs
    once on first render to re-instantiate every IsAutoActivate strategy from the library.
*@
@inject SetupSonifier _setupSonifier
@inject StrategyAutoLoader _autoLoader
@* TactileCanvasCoordinator subscribes to RedrawEvent + StateStream on construction
   so the Dot Pad mirrors the chart automatically. Eager-resolved here so the
   subscriptions are wired before the first redraw can fire. *@
@inject ITactileCanvasCoordinator _tactileCoordinator
@* AlertDeliveryService eagerly resolved here so its AlertFiredEvent subscription
   is live before any alert can fire — the service does nothing on its own
   beyond subscribing, and DI would otherwise lazy-construct it only on first
   caller, leaving early alerts undelivered to SMTP / Telegram channels. *@
@inject AccessibleTrader.Core.Services.Alerts.AlertDeliveryService _alertDelivery
@* SetupAlertBridge subscribes to Setup* events on construction; eager-resolved here
   so setups can be routed to webhooks the moment the app starts (default-off gate). *@
@inject AccessibleTrader.Core.Services.Alerts.SetupAlertBridge _setupAlertBridge
@inject ILogger<MainLayout> _layoutLogger
@inject AccessibleTrader.Core.Services.ThemeService _themeService
@inject DemoPolicy Demo
@* Same seam as ApiKeysModal: the release gate arrives as a value so it is not a static
   that only a source grep can check. See WithdrawalReleasePolicy. *@
@inject IServiceProvider Services
@inject ISettingsManager _settings
@* Injected purely to construct it. It subscribes to QuickTradeRequestedEvent in its constructor and
   is the thing that turns a committed quick trade into an actual order — a service nobody resolves
   is a service that never runs, and the whole feature silently placed nothing. *@
@inject AccessibleTrader.Core.Services.Trading.QuickTradeExecutor _quickTradeExecutor
@* Same reason again, for the pair that keeps a background position alive. The paper
   broker subscribes to MonitoredBarEvent on construction (that is what fills a resting
   order in an unfocused tab), and the monitoring service subscribes to tab and order
   events and is what starts a monitor for a symbol the account has money on. Both were
   reachable only through the Settings dialog, so until the user opened Settings a
   position in another tab was neither priced nor filled. *@
@inject IPaperTradingProvider _paperBroker
@inject AccessibleTrader.Core.Services.Workspace.IBackgroundMonitoringService _backgroundMonitoring
@* Per-circuit pipeline init: on the multi-user web host every browser connection is its
   own DI scope, so the data/indicator/input/accessibility pipeline is initialized HERE,
   once per visitor (it used to run once at app start). MainLayout is the parent of the
   Toolbar, so awaiting this in OnInitializedAsync guarantees the pipeline is ready before
   the Toolbar's market cascade loads the first chart. Harmless/idempotent on the desktop
   head (IAppStartupService is a no-op-if-already-initialized singleton there). *@
@inject IAppStartupService _startup

@* Browser tab title — reflects the loaded chart (asset, timeframe, exchange) so a screen
   reader announcing the tab, and a sighted user scanning tabs, both see what's loaded.
   Updates reactively (MainLayout re-renders on every store state change). Renders via the
   HeadOutlet on the web host; harmless on MAUI (the native window title is set separately). *@
<PageTitle>@GetBrowserTitle()</PageTitle>

<div class="app-container">

    @* Icon sprite injected once — <use href="#icon-*"> in every button references these symbols. *@
    <IconSprite />

    @* Screen-reader-only banner landmark. The native Windows titlebar already
       renders the same text as the window title (set by MainPage.xaml.cs), so
       painting it a second time inside the WebView wasted a 40-pixel strip.
       Keeping the <h1> as a `visually-hidden` landmark preserves the primary
       heading for screen readers without the visual duplication. *@
    <header role="banner" class="visually-hidden">
        <h1 id="main-heading">@GetTitle()</h1>
    </header>

    <Toolbar />

    <TabBar />

    <main role="main" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; background: transparent; position: relative;">
        <ChartArea />
    </main>

    <IndicatorBar />

    @* Touch navigation toolbar — visible only on coarse-pointer (touch) devices
       via CSS. Large-button parity for the core chart commands; see TouchNavBar. *@
    <TouchNavBar />

    @* ── Modals ── All modals subscribe to their own OpenXxxEvent on the EventBus.
       They are rendered here (outside <main>) so they overlay the entire viewport. *@
    @* Always available (even in the public demo): chart tooling + read-only views. *@
    <AddIndicatorModal />
    <ObjectTreeModal />
    <PropertiesModal />
    <HelpModal />
    <DrawingContextMenu />
    <ChartContextMenu />
    <VisualEarconOverlay />
    <JournalModal />
    @if (Demo.AllowDrawingTools)     { <DrawingToolsModal /> }

    @* Gated in the public demo (download incentives / shared-server safety). *@
    @if (Demo.AllowSettingsModal)    { <SettingsModal /> }
    @if (Demo.AllowSoundDesigner)    { <SoundDesignerModal /> }
    @if (Demo.AllowTrading)          { <TradingDashboardModal /> }
    @if (Demo.AllowOrderBook)        { <OrderBookModal /> }
    @if (Demo.AllowApiKeysModal)     { <ApiKeysModal /> }
    @* Deposit addresses. Gated on real trading rather than the demo: it reads from
       an authenticated wallet API with the user's own keys, which the locked demo
       has none of. The button that opens it is separately gated on the provider
       actually implementing IWalletProvider. *@
    @if (Demo.AllowTrading)          { <WalletModal /> }
    @* Withdrawals. Same gate as deposits, and the opening event is only ever
       raised when CanWithdrawAsync is true — provider capability AND a
       withdrawal-enabled key profile, both checked in the service.

       Plus the release gate: the withdrawal gate is closed for 2.4.0, so the
       dialog is not even instantiated. Not strictly required — CanWithdrawAsync
       already refuses, so nothing raises the event — but a modal that cannot open
       should not be in the render tree waiting for one. *@
    @if (Demo.AllowTrading && WithdrawalsReleased)
                                     { <WithdrawModal /> }
    @if (Demo.AllowStrategies)       { <StrategyModal /> }
    @if (Demo.AllowAlerts)           { <AlertsModal /> }
    @if (Demo.AllowCustomScripts)    { <CustomScriptsModal /> }
    @if (Demo.AllowAiAnalyst)        { <AIAnalystModal /> }
    @if (Demo.AllowWorkspaceSaveLoad) { <SaveWorkspaceModal /> <LoadWorkspaceModal /> }
    @* My Data import — hidden in the shared public demo (no per-visitor persistence). *@
    @if (!Demo.IsDemo)               { <MyDataModal /> }
    @* Market watch (Alt+M) — watchlists + screener. Hidden in the shared public demo for
       the same reason My Data is: no per-visitor persistence, and screens fan REST requests
       out across the server's shared keys. *@
    @if (!Demo.IsDemo)               { <WatchlistModal /> }
    @* Respect report (Alt+R) — read-only measurement over already-loaded bars, so it is safe
       in the demo: no keys, no outbound requests. *@
    <LevelReportModal />
    <AssetDossierModal />
    <ThemeEditorModal />
    <LabelTextModal />

    @* ARIA LIVE DOUBLE BUFFER — the app's ONE announcing channel.
       Two assertive regions swap on each spoken phrase so that identical strings are
       re-announced. Only one region has content at any time; the other is empty.
       Screen readers re-read a region when its content changes, so alternating
       between the two guarantees every message triggers an announcement.

       Nothing else in the document may be a live region carrying these same sentences.
       StatusBar mirrors them VISUALLY and used to do it with role="status" aria-live,
       which made two announcers for one sentence and cost the user the sentence whenever
       the AT's duplicate-suppression fired between them. LiveRegionInventoryTests pins
       this down to these two elements.

       Both are emptied three seconds after the last phrase (ScheduleSpeechBufferClear), so
       browse mode finds one line at the bottom of the page — the visible status strip —
       rather than a buffer still holding the last thing said. *@
    <div class="visually-hidden" aria-hidden="false">
        <div id="aria-speech-1" role="status" aria-live="assertive" aria-atomic="true">
            @_speechRegions.TextFor(1)
        </div>
        <div id="aria-speech-2" role="status" aria-live="assertive" aria-atomic="true">
            @_speechRegions.TextFor(2)
        </div>
    </div>

    @* The status bar carries the last spoken feedback and the PAPER badge. It existed, fully built
       and styled, and was never placed on a page — so the one persistent visual reminder that orders
       are simulated was invisible for as long as the feature has shipped. Above the footer, because
       "am I on paper or live?" is a question you want answered without hunting. *@
    <StatusBar />

    <footer role="contentinfo" class="app-footer">
        <span>Accessible Trade Terminal &copy; 2026.</span>
    </footer>


</div>

@inject AccessibleTrader.Core.Services.IEventBus _eventBus

@code {
    /// <summary>The withdrawal release gate. Falls back to the shipped (closed) value when
    /// nothing is registered — see WithdrawalReleasePolicy.</summary>
    private bool WithdrawalsReleased =>
        AccessibleTrader.Core.Services.Trading.WithdrawalReleasePolicy.From(Services).Released;

    /// <summary>The two ARIA live regions and the alternation rule — see the type.</summary>
    private readonly SpeechLiveRegionBuffer _speechRegions = new();

    /// <summary>
    /// Empties whichever speech buffer is holding text, a short while after it announced.
    ///
    /// <para><b>Why.</b> The two buffers keep their last sentence in the DOM forever, so the
    /// bottom of the page read as three lines in browse mode — one blank buffer, one buffer
    /// still holding the last sentence, and the visible status bar holding the same sentence
    /// again. Cody read exactly that and it is how the duplicate live region was found.
    /// Clearing them leaves one line: the status strip a sighted user is looking at.</para>
    ///
    /// <para><b>Why clearing cannot swallow the announcement.</b> A live region is announced on
    /// text being ADDED, and every screen reader captures the text into its own speech queue at
    /// the moment the event is delivered — Orca's live-region presenter goes further and
    /// presents ONLY <c>object:text-changed:insert</c>, so a pure deletion is never spoken at
    /// all. The delay is generous on purpose: three seconds is an order of magnitude past any
    /// AT's event-to-queue latency and far outside Orca's 0.25 s duplicate window, so it can
    /// only ever remove text that has already been read.</para>
    ///
    /// <para>It does NOT flip <c>_activeBuffer</c>. The flip is what makes a repeated identical
    /// phrase land on a different node and therefore re-announce; a clear that also flipped
    /// would put the next utterance back on the node the previous one used.</para>
    /// </summary>
    private static readonly TimeSpan SpeechBufferLinger = TimeSpan.FromSeconds(3);
    private CancellationTokenSource? _speechClearCts;

    private IDisposable? _stateSub;
    private IDisposable? _modalSub;
    private IDisposable? _dataSub;

    protected override async Task OnInitializedAsync()
    {
        // Wire the ARIA live region callback. The speech manager queues any early
        // boot messages and delivers them here as soon as the callback is set.
        SpeechManager.OnSpeak = text =>
            InvokeAsync(() =>
            {
                if (_speechRegions.Push(text)) ScheduleSpeechBufferClear();
                StateHasChanged();
            });

        // Per-circuit pipeline init (see the @inject note above). Awaited before the
        // child Toolbar renders, so this visitor's providers/orchestrator/indicators are
        // ready before its first chart load. Wrapped so a failure is logged, not fatal.
        try
        {
            await _startup.InitializeAsync();
        }
        catch (Exception ex)
        {
            _layoutLogger.LogError(ex, "Per-circuit pipeline init failed.");
        }

        // Re-render on every store state change so the header title stays current.
        _stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(StateHasChanged));

        // The browser-tab title carries the live price, and live ticks arrive on
        // DataStream (StateStream doesn't fire per tick). Sample at 1s so a busy
        // feed re-renders the layout at most once a second, not once per tick.
        _dataSub = Store.DataStream
            .Sample(TimeSpan.FromSeconds(1))
            .Subscribe(_ => InvokeAsync(StateHasChanged));

        // Announce modal open/close through the same ARIA live pipeline speech uses.
        // Focus-move alone is not enough — NVDA/JAWS users in browse mode don't hear
        // a focus change, so the live-region text is what tells them which modal
        // just opened or closed.
        // The browser's Tab trap reads the SAME ordered stack the dispatcher aims Escape by.
        // ModalStack subscribes to ModalStateChangedEvent itself and raises Changed afterwards,
        // so what is pushed here is the stack as it stands after the event, not a guess made
        // from the event alone — the old call sent a bare bool and keyboard.js kept a counter,
        // which could count but could not order. Fire-and-forget; the trap no-ops if the JS
        // runtime isn't ready yet, and the next change re-sends the whole stack.
        ModalStack.Changed += OnModalStackChanged;

        _modalSub = _eventBus.AsObservable<ModalStateChangedEvent>()
            .Subscribe(evt =>
            {
                // Note: chart-focus tracking is NOT driven from modal open/close any
                // more. ChartArea publishes ChartFocusEvent / DeactivateEvent on its
                // own @onfocus / @onblur, and those drive both the .NET-side
                // _isChartActive gate (CommandDispatcher) and the JS-side
                // _chartFocused gate (keyboard.js single-letter trap). Tying the JS
                // flag to !modalOpen made chart commands fire from the toolbar /
                // body any time no modal was open — Phase 5 keyboard scope fix.

                // Earcon before speech so a blind user hears an immediate audio cue
                // when any modal opens or closes — speech arrives ~100-300 ms later
                // and not at all if the screen reader is in a pattern that dedupes
                // the double-buffered live region. Info tone on open, boundary on close.
                try
                {
                    AudioRouter.PlayEarcon(evt.IsOpen ? FeedbackType.Info : FeedbackType.Boundary);
                }
                catch (Exception ex)
                {
                    _layoutLogger.LogWarning(ex, "Modal earcon failed.");
                }

                if (string.IsNullOrEmpty(evt.ModalName)) return;
                // Respect the F2 speech mute (workspace flag), then route through
                // SpeechManager.Speak instead of writing the live region directly. The
                // direct write reached ONLY the live region — which the sink policy disables
                // for browser-voice-only users, so they heard nothing on modal open/close.
                // Speak() applies ShouldEnableLiveRegion: browser voice → browser TTS,
                // server backends → their sink, browser-hop → the live region (exactly one).
                if (!Store.State.IsSpeechEnabled) return;
                var phrase = evt.IsOpen ? $"{evt.ModalName} dialog opened" : $"{evt.ModalName} dialog closed";
                SpeechManager.Speak(phrase);
            });

        await base.OnInitializedAsync();
    }

    private void OnModalStackChanged(AccessibleTrader.Core.Services.Input.ModalStackChange change)
    {
        // Names only, bottom first. Whatever the JS side knew before is replaced wholesale, so a
        // dropped call cannot leave it one modal out of step for the rest of the session.
        try { _ = JSRuntime.InvokeVoidAsync("accessibleTrader.setModalStack", change.Stack); }
        catch { /* non-critical */ }
    }

    // ── Theme → CSS bridge ────────────────────────────────────────────────
    // The chart is Skia; every toolbar, dialog and label around it is HTML. Without this a
    // theme change repaints the canvas and leaves the frame around it on the old palette.
    private void OnThemeChangedForCss(object? sender, AccessibleTrader.Sdk.Theming.ChartTheme theme)
        => _ = InvokeAsync(ApplyThemeCssAsync);

    private async Task ApplyThemeCssAsync()
    {
        try
        {
            var vars = AccessibleTrader.Core.Services.Theming.ThemeCssBridge
                .BuildVariables(_themeService.Current);
            await JSRuntime.InvokeVoidAsync("accessibleTrader.applyThemeVariables", vars);
        }
        catch (Exception ex)
        {
            // app.css carries a full :root fallback, so a failure here leaves the application
            // in the default palette rather than unstyled. Not worth interrupting startup for.
            _layoutLogger.LogWarning(ex, "Could not apply theme CSS variables");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Push the theme's chrome palette into CSS custom properties before anything else,
            // so the toolbars are already the right colour on the first paint rather than
            // flashing the stylesheet's fallback palette and then correcting.
            await ApplyThemeCssAsync();
            _themeService.ThemeChanged += OnThemeChangedForCss;

            // Register the global keyboard handler. Wrapping in try/catch prevents
            // a JS interop failure from crashing the layout component. Time-bounded
            // so a hung JS runtime doesn't trap the first render indefinitely.
            try
            {
                using var initCts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                await InputService.InitializeAsync(JSRuntime).WaitAsync(initCts.Token);
            }
            catch (OperationCanceledException)
            {
                _layoutLogger.LogError("Keyboard bridge init timed out after 10 s.");
            }
            catch (Exception ex)
            {
                // Log silently; keyboard input may be partially unavailable but the
                // app should still render rather than throw.
                _layoutLogger.LogError(ex, "Keyboard bridge init failed.");
            }

            // Apply the persisted UI text scale (Settings → Appearance → Text size).
            // 100% is a no-op; failures are non-fatal (default browser size stands).
            try
            {
                int uiScale = _settings.GetSetting("appearance.uiScale")?.ToObject<int>() ?? 100;
                if (uiScale != 100)
                    await JSRuntime.InvokeVoidAsync("accessibleTrader.setUiScale", uiScale);
            }
            catch (Exception ex)
            {
                _layoutLogger.LogDebug(ex, "UI scale apply failed (non-fatal).");
            }

            // Re-instantiate every saved strategy whose IsAutoActivate flag is true. Idempotent —
            // calling LoadAllAsync() a second time is a no-op. Wrapped in try/catch so a single bad
            // spec can never block the app from finishing initial render.
            try
            {
                await _autoLoader.LoadAllAsync();
            }
            catch (Exception ex)
            {
                _layoutLogger.LogError(ex, "StrategyAutoLoader failed.");
            }

            // Startup sandbox advisory. If the registered script-worker launcher is the
            // plain DefaultProcessLauncher — i.e. none of the platform-specific OS sandboxes
            // are in effect — the user is running custom indicators with only process-boundary
            // isolation. On Windows or macOS this means the AppContainer / sandbox-exec
            // primitives were unavailable (AV, GPO, corporate policy, or dev toolchain gap).
            // Surface it explicitly at launch so the trader knows and can decide whether
            // custom indicators are safe to run on this machine.
            try
            {
                var launcherType = ScriptWorkerLauncher.GetType();
                if (launcherType == typeof(DefaultProcessLauncher))
                {
                    const string msg = "Security notice: OS-level sandbox not available. Custom indicators run with process-boundary isolation only. Built-in indicators are unaffected.";
                    _layoutLogger.LogWarning(msg);
                    _eventBus.Publish(new AnnouncementEvent(msg, true));
                    try { AudioRouter.PlayEarcon(FeedbackType.Alert); }
                    catch { /* earcon is enhancement; message itself is what matters */ }
                }
            }
            catch (Exception ex)
            {
                _layoutLogger.LogWarning(ex, "Sandbox advisory check failed.");
            }
        }
    }

    private string GetTitle()
    {
        var identity = Store.State.Identity;
        if (string.IsNullOrEmpty(identity.Symbol))
            return "Accessible Trade Terminal";
        return $"Accessible Trade Terminal: {identity.Symbol} {identity.Timeframe} on {identity.Provider}";
    }

    // Browser-tab title: a load-state triangle (filled "▲" = data ready, hollow "△" = still
    // loading), the LIVE PRICE, the chart identity, then the app name — e.g.
    // "▲ 67,432.15 BTC/USDT 4h on Bitstamp - Accessible Trade Terminal". Precision is
    // magnitude-aware (KAS at 0.0363 must not show "0.04"); price refresh rides the
    // 1s-sampled DataStream subscription above.
    private string GetBrowserTitle()
    {
        var state = Store.State;
        var identity = state.Identity;
        if (string.IsNullOrEmpty(identity.Symbol))
            return "Accessible Trade Terminal";

        bool ready = state.InitStatus == AccessibleTrader.Sdk.Models.InitializationStatus.Ready
                     && state.DataStatus == AccessibleTrader.Sdk.Models.DataStatus.Ready;
        string glyph = ready ? "▲" : "△";
        string price = "";
        if (ready && state.Data != null && state.Data.Count > 0)
        {
            double close = state.Data[^1].Close;
            if (!double.IsNaN(close))
                price = SpeechPriceFormatter.FormatPrice(close) + " ";
        }
        string tf = string.IsNullOrEmpty(identity.Timeframe) ? "" : $"{identity.Timeframe} ";
        return $"{glyph} {price}{identity.Symbol} {tf}on {identity.Provider} - Accessible Trade Terminal";
    }

    public void Dispose()
    {
        _stateSub?.Dispose();
        _modalSub?.Dispose();
        ModalStack.Changed -= OnModalStackChanged;
        _dataSub?.Dispose();
        _themeService.ThemeChanged -= OnThemeChangedForCss;
        SpeechManager.OnSpeak = null;
        _speechClearCts?.Cancel();
        _speechClearCts?.Dispose();
        _speechClearCts = null;
    }

    /// <summary>
    /// Restarts the linger timer. Each new utterance cancels the pending clear, so a burst of
    /// speech empties once, three seconds after the LAST sentence — not three seconds after the
    /// first, which would blank a region mid-burst for no reason.
    /// </summary>
    private void ScheduleSpeechBufferClear()
    {
        var previous = _speechClearCts;
        _speechClearCts = new CancellationTokenSource();
        previous?.Cancel();
        previous?.Dispose();

        _ = ClearSpeechBuffersAfterLingerAsync(_speechClearCts.Token);
    }

    /// <summary>
    /// The delay half of <see cref="ScheduleSpeechBufferClear"/>. Deliberately NOT wrapped in
    /// Task.Run: there is no computation to offload — it is a timer and one render — and a
    /// Task.Run body that touches StateHasChanged is the shape DispatcherAffinityScanTests
    /// exists to reject, because off the Blazor dispatcher it throws and an unhandled exception
    /// from an async handler kills the whole circuit.
    /// </summary>
    private async Task ClearSpeechBuffersAfterLingerAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(SpeechBufferLinger, token);
            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested) return;
                _speechRegions.Clear();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* superseded by a newer utterance, or disposed */ }
        catch (ObjectDisposedException) { /* the circuit went away mid-delay */ }
    }
}
