@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject IApiKeyService ApiKeyService
@inject IDataService DataService
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@implements IDisposable

@* API Keys manager: add, edit, remove, and activate credential profiles per provider.
   Each provider supports multiple named profiles (e.g. "Alpaca Paper", "Alpaca Live")
   stored with metadata in apikeys_meta.json and credentials in MAUI SecureStorage. *@

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="apikeys-title"
             style="max-width:620px;"
             @onclick:stopPropagation="true">

            <h2 id="apikeys-title" tabindex="-1">API Keys</h2>

            <p style="color:var(--text-muted); font-size:0.85rem; margin-top:0;">
                Manage credentials for data and trading providers. Use separate profiles
                for Paper and Live environments. Active profiles are used for the current session.
            </p>

            @* ── Existing profiles list ─────────────────────────────────────── *@
            @if (_keys.Any())
            {
                <div role="list" aria-label="Configured API key profiles" style="margin-bottom:16px;">
                    @foreach (var k in _keys)
                    {
                        <div class="object-tree-item"
                             role="listitem"
                             aria-label="@GetKeyLabel(k)">

                            <span style="flex:1; font-weight:@(k.IsActive ? "700" : "400");">
                                @k.Nickname
                            </span>

                            <span style="font-size:0.78rem; color:var(--text-muted); min-width:60px;">
                                @k.Provider
                            </span>

                            <span style="font-size:0.78rem;
                                         color:@(k.Environment == "Live" ? "#c00" : "#060");
                                         min-width:44px; font-weight:600;">
                                @k.Environment
                            </span>

                            <span style="font-size:0.78rem; color:var(--text-muted); min-width:50px;">
                                @k.MarketType
                            </span>

                            @if (k.IsActive)
                            {
                                <span aria-label="Active profile" style="color:#060; font-size:0.78rem; min-width:50px;">✔ Active</span>
                            }
                            else
                            {
                                <button aria-label="Set @k.Nickname as active"
                                        title="Set as active"
                                        @onclick="() => SetActive(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    Activate
                                </button>
                            }

                            @* Schwab OAuth: kicks off the interactive browser-based authorization
                               flow so the provider can acquire its initial refresh token. The
                               button shows only for Schwab profiles — every other provider
                               authenticates directly with the saved key + secret and needs no
                               second step. *@
                            @if (string.Equals(k.Provider, "Schwab", StringComparison.OrdinalIgnoreCase))
                            {
                                <button aria-label="Sign in to Schwab to grant API access for @k.Nickname"
                                        title="Opens the Schwab sign-in page in your browser to authorize this profile."
                                        @onclick="() => BeginSchwabAuthorizationAsync(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    Sign in
                                </button>
                            }

                            <button aria-label="Remove @k.Nickname"
                                    style="color:#c00;"
                                    title="Remove profile"
                                    @onclick="() => Remove(k.Nickname)"
                                    @onclick:stopPropagation="true">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:var(--text-muted); font-size:0.88rem; margin-bottom:16px;">
                    No API keys configured. Add a profile below.
                </p>
            }

            @* ── Add new profile form ────────────────────────────────────────── *@
            <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Add New Profile</legend>

                <div class="modal-row">
                    <label for="key-provider">Provider</label>
                    <select id="key-provider" @bind="_newProvider">
                        @foreach (var p in _knownProviders)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-nickname">Profile Name</label>
                    <input id="key-nickname" type="text" placeholder="e.g. Alpaca Paper"
                           @bind="_newNickname" aria-label="Profile nickname" />
                </div>

                <div class="modal-row">
                    <label for="key-env">Environment</label>
                    <select id="key-env" @bind="_newEnvironment">
                        <option value="Paper">Paper</option>
                        <option value="Live">Live</option>
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-market">Market Type</label>
                    <select id="key-market" @bind="_newMarketType">
                        <option value="Spot">Spot</option>
                        <option value="Futures">Futures</option>
                        <option value="Crypto">Crypto</option>
                        <option value="Stocks">Stocks</option>
                    </select>
                </div>

                @* Credentials always use <input type="password"> — no in-DOM reveal toggle.
                   Rationale: a toggle that flips to type="text" dumps the raw key into the
                   accessibility tree, screen-share captures, and DOM snapshots. Native OS
                   password-reveal is still available at the browser/WebView level and is
                   user-initiated, so accessibility of typing isn't lost. *@

                <div class="modal-row">
                    <label for="key-apikey">API Key</label>
                    <input id="key-apikey" type="password" autocomplete="off" spellcheck="false"
                           @bind="_newApiKey" aria-label="API key" style="flex:1;" />
                </div>

                <div class="modal-row">
                    <label for="key-secret">API Secret</label>
                    <input id="key-secret" type="password" autocomplete="off" spellcheck="false" placeholder="Optional — only exchanges need it"
                           @bind="_newApiSecret" aria-label="API secret (optional — key-only providers like Twelve Data, FMP, and Polygon leave this blank)" style="flex:1;" />
                </div>

                <div class="modal-row">
                    <label for="key-pass">Passphrase</label>
                    <input id="key-pass" type="password" autocomplete="off" spellcheck="false" placeholder="Optional"
                           @bind="_newPassphrase" aria-label="Passphrase (optional)" style="flex:1;" />
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <p role="alert" style="color:#c00; margin-top:6px; font-size:0.88rem;">@_formError</p>
                }

                <div style="margin-top:12px; display:flex; justify-content:flex-end;">
                    <button id="apikeys-save" class="primary"
                            @onclick="SaveNew"
                            aria-label="Save new API key profile">
                        Save Profile
                    </button>
                </div>
            </fieldset>

            <div class="modal-footer">
                <button id="apikeys-close" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private List<ApiKeyConfig> _keys = new();

    // New profile form fields
    private string _newProvider    = "Alpaca";
    private string _newNickname    = "";
    private string _newEnvironment = "Paper";
    private string _newMarketType  = "Spot";
    private string _newApiKey      = "";
    private string _newApiSecret   = "";
    private string _newPassphrase  = "";
    private string? _formError;

    private static readonly List<string> _knownProviders = new()
    {
        "Alpaca", "BGeometrics", "Binance", "Bitstamp", "Coinbase", "CoinMetrics",
        "DefiLlama", "Etherscan", "Finnhub", "FMP", "FRED", "Glassnode",
        "Kraken", "Mempool", "Oanda", "Polygon", "Schwab", "Tradier", "TwelveData", "Custom"
    };

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenApiKeysEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "API keys") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _keys = await ApiKeyService.GetAllKeysAsync();
        _formError = null;
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "API keys"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "apikeys-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "API keys"));
        StateHasChanged();
    }

    private async Task SaveNew()
    {
        if (string.IsNullOrWhiteSpace(_newNickname))
        {
            _formError = "Profile name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newApiKey))
        {
            _formError = "API key is required.";
            return;
        }
        if (_keys.Any(k => k.Nickname.Equals(_newNickname, StringComparison.OrdinalIgnoreCase)))
        {
            _formError = $"A profile named \"{_newNickname}\" already exists.";
            return;
        }

        try
        {
            // Auto-activate when this is the provider's only profile (or its first
            // active one). Saving a key that then sat INACTIVE was a silent trap:
            // ConfigureStoredKeyProviders skips inactive keys, so the provider stayed
            // on the "API key required" sentinel and the user had no idea why.
            bool autoActivate = !_keys.Any(k =>
                k.Provider.Equals(_newProvider, StringComparison.OrdinalIgnoreCase) && k.IsActive);

            var config = new ApiKeyConfig(
                Provider:    _newProvider,
                Nickname:    _newNickname,
                ApiKey:      _newApiKey,
                ApiSecret:   _newApiSecret,
                Passphrase:  _newPassphrase,
                MarketType:  _newMarketType,
                Environment: _newEnvironment,
                IsActive:    false);

            await ApiKeyService.SaveKeyAsync(config);
            if (autoActivate)
                await ApiKeyService.SetActiveKeyAsync(config.Nickname);
            // Configure the provider now so it is usable immediately — otherwise the
            // symbol dropdown gates on IsConfigured before the first (lazy) data fetch
            // that would configure it, and the provider appears stuck on the
            // "API key required" sentinel until the app is restarted.
            await DataService.ConfigureStoredKeyProvidersAsync();
            _keys = await ApiKeyService.GetAllKeysAsync();

            // Reset form
            _newNickname = "";
            _newApiKey = "";
            _newApiSecret = "";
            _newPassphrase = "";
            _formError = null;
            StateHasChanged();

            // Configuring the provider is only half of it. The market cascade had
            // already filled its symbol list with the "API key required" sentinel,
            // and nothing recomputed it — so the dropdown went on demanding a key
            // that had just been added, and only a restart cleared it.
            EventBus.Publish(new ApiKeysChangedEvent(config.Provider));

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                autoActivate
                    ? $"Profile {config.Nickname} saved and activated"
                    : $"Profile {config.Nickname} saved. Press Activate on it to use it."));
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save profile: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SetActive(string nickname)
    {
        try
        {
            await ApiKeyService.SetActiveKeyAsync(nickname);
            // Re-configure providers so the newly-active key takes effect immediately
            // instead of on the next app restart.
            await DataService.ConfigureStoredKeyProvidersAsync();
            _keys = await ApiKeyService.GetAllKeysAsync();
            StateHasChanged();

            EventBus.Publish(new ApiKeysChangedEvent(
                _keys.FirstOrDefault(k => k.Nickname == nickname)?.Provider ?? ""));

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"{nickname} set as active"));
        }
        catch (Exception ex)
        {
            _formError = $"Failed to activate profile: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task Remove(string nickname)
    {
        try
        {
            await ApiKeyService.RemoveKeyAsync(nickname);
            _keys = await ApiKeyService.GetAllKeysAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _formError = $"Failed to remove profile: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Kicks off the Schwab OAuth authorization-code flow for the selected profile.
    /// Activates the profile first so the provider loads its client id / secret, then
    /// reaches the Schwab provider through <see cref="IDataService.GetProviderAsync"/>
    /// and calls its <c>BeginAuthorizationAsync</c> entry point. The method opens the
    /// Schwab sign-in page in the OS default browser; the provider's embedded HTTP
    /// listener captures the callback and stores the refresh token. Feedback lands
    /// through the accessibility event bus so screen-reader users hear when the flow
    /// starts, succeeds, or fails.
    /// </summary>
    private async Task BeginSchwabAuthorizationAsync(string nickname)
    {
        try
        {
            // Ensure the profile whose sign-in was requested is the active one. Without
            // this the provider might still be holding another profile's client id.
            await ApiKeyService.SetActiveKeyAsync(nickname);
            _keys = await ApiKeyService.GetAllKeysAsync();

            var provider = await DataService.GetProviderAsync("Schwab");
            if (provider == null)
            {
                _formError = "Schwab provider not loaded. Is the plugin installed?";
                StateHasChanged();
                return;
            }

            // Reach the concrete method via reflection so the UI layer doesn't take a
            // hard plugin dependency. BeginAuthorizationAsync is declared on the
            // SchwabProvider concrete class (not on IMarketDataProvider) so a cast or
            // reflection is required either way.
            var method = provider.GetType().GetMethod(
                "BeginAuthorizationAsync",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (method == null)
            {
                _formError = "Schwab provider missing BeginAuthorizationAsync; plugin version mismatch.";
                StateHasChanged();
                return;
            }

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                "Opening Schwab sign-in in browser."));

            // The BeginAuthorizationAsync(Action<string>? openBrowser = null, CancellationToken = default)
            // contract: first arg is an optional browser-launch hook; passing null falls
            // back to the provider's default Process.Start shell opener.
            var task = (Task?)method.Invoke(provider, new object?[] { null, default(System.Threading.CancellationToken) });
            if (task == null)
            {
                _formError = "Schwab authorization invocation returned null.";
                StateHasChanged();
                return;
            }
            await task.ConfigureAwait(true);

            _formError = null;
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"Schwab sign-in complete for {nickname}."));
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _formError = $"Schwab sign-in failed: {ex.Message}";
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, _formError));
            StateHasChanged();
        }
    }

    private string GetKeyLabel(ApiKeyConfig k)
    {
        string active = k.IsActive ? ", active" : "";
        return $"{k.Nickname}, {k.Provider}, {k.Environment}, {k.MarketType}{active}";
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
