@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject IApiKeyService ApiKeyService
@inject IDataService DataService
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@* Resolved through the container rather than read off the static so this surface can be
   rendered with the gate BOTH open and closed — see WithdrawalReleasePolicy. *@
@inject IServiceProvider Services
@implements IDisposable

@* API Keys manager: add, edit, remove, and activate credential profiles per provider.
   Each provider supports multiple named profiles (e.g. "Alpaca Paper", "Alpaca Live")
   stored with metadata in apikeys_meta.json and credentials in MAUI SecureStorage. *@

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="apikeys-title"
             style="max-width:620px;"
             @onclick:stopPropagation="true">

            <h2 id="apikeys-title" tabindex="-1">API Keys</h2>

            <p style="color:var(--text-muted); font-size:0.85rem; margin-top:0;">
                Manage credentials for data and trading providers. Use separate profiles
                for Paper and Live environments. Active profiles are used for the current session.
            </p>

            @* ── Existing profiles list ─────────────────────────────────────── *@
            @if (_keys.Any())
            {
                <div role="list" aria-label="Configured API key profiles" style="margin-bottom:16px;">
                    @* Indexed rather than @foreach: the remove control needs an id, and the id
                       has to say WHICH row it is so focus can be put back on this row after a
                       cancel, or on the row that takes this one's place after a removal. A
                       fixed id would collide across rows — the same obstacle the take-profit
                       ladder recorded, and it dissolves the same way. *@
                    @for (int i = 0; i < _keys.Count; i++)
                    {
                        var k = _keys[i];
                        var rowIndex = i;
                        <div class="object-tree-item"
                             role="listitem"
                             aria-label="@GetKeyLabel(k)">

                            <span style="flex:1; font-weight:@(k.IsActive ? "700" : "400");">
                                @k.Nickname
                            </span>

                            <span style="font-size:0.78rem; color:var(--text-muted); min-width:60px;">
                                @k.Provider
                            </span>

                            <span style="font-size:0.78rem;
                                         color:@(k.Environment == "Live" ? "#c00" : "#060");
                                         min-width:44px; font-weight:600;">
                                @k.Environment
                            </span>

                            <span style="font-size:0.78rem; color:var(--text-muted); min-width:50px;">
                                @k.MarketType
                            </span>

                            @if (k.AllowsWithdrawal)
                            {
                                @* No Activate button: a withdrawal profile is found by its
                                   flag, never by activation — and activating it would
                                   deactivate the real trading profile for this provider. *@
                                <span aria-label="Withdrawal profile, used only by the Withdraw screen"
                                      title="Used only to move funds off the venue, never for trading"
                                      style="color:#a50; font-size:0.78rem; font-weight:600; min-width:50px;">
                                    Withdrawal
                                </span>
                            }
                            else if (k.IsActive)
                            {
                                <span aria-label="Active profile" style="color:#060; font-size:0.78rem; min-width:50px;">✔ Active</span>
                            }
                            else
                            {
                                <button aria-label="Set @k.Nickname as active"
                                        title="Set as active"
                                        @onclick="() => SetActive(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    Activate
                                </button>
                            }

                            @* Schwab OAuth: kicks off the interactive browser-based authorization
                               flow so the provider can acquire its initial refresh token. The
                               button shows only for Schwab profiles — every other provider
                               authenticates directly with the saved key + secret and needs no
                               second step. *@
                            @if (string.Equals(k.Provider, "Schwab", StringComparison.OrdinalIgnoreCase))
                            {
                                <button aria-label="Sign in to Schwab to grant API access for @k.Nickname"
                                        title="Opens the Schwab sign-in page in your browser to authorize this profile."
                                        @onclick="() => BeginSchwabAuthorizationAsync(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    Sign in
                                </button>
                            }

                            @* Two-step removal, in place. A credential profile is not
                               recoverable — the secret lives in SecureStorage and removing it
                               is the last copy — so the ✕ arms a confirmation rather than doing
                               it. In place rather than a nested dialog on purpose: the row
                               already carries the profile's name, and a second modal on top of
                               this one is a stack that Escape, the Tab trap and the MAUI canvas
                               hide would all have to learn. *@
                            @if (_pendingRemoval == k.Nickname)
                            {
                                <button id="apikey-remove-confirm"
                                        aria-label="Confirm remove @k.Nickname permanently, this cannot be undone"
                                        style="color:#c00; font-weight:700;"
                                        title="Permanently remove this profile"
                                        @onclick="() => ConfirmRemove(rowIndex)"
                                        @onclick:stopPropagation="true">
                                    Confirm remove
                                </button>
                                <button id="apikey-remove-cancel"
                                        aria-label="Cancel, keep @k.Nickname"
                                        title="Keep this profile"
                                        @onclick="CancelRemove"
                                        @onclick:stopPropagation="true">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button id="apikey-remove-@rowIndex"
                                        aria-label="Remove @k.Nickname"
                                        style="color:#c00;"
                                        title="Remove profile"
                                        @onclick="() => Remove(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    ✕
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:var(--text-muted); font-size:0.88rem; margin-bottom:16px;">
                    No API keys configured. Add a profile below.
                </p>
            }

            @* ── Add new profile form ────────────────────────────────────────── *@
            <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Add New Profile</legend>

                <div class="modal-row">
                    <label for="key-provider">Provider</label>
                    <select id="key-provider" @bind="_newProvider">
                        @foreach (var p in _knownProviders)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-nickname">Profile Name</label>
                    <input id="key-nickname" type="text" placeholder="e.g. Alpaca Paper"
                           @bind="_newNickname" aria-label="Profile Name, a nickname for these credentials" />
                </div>

                <div class="modal-row">
                    <label for="key-env">Environment</label>
                    <select id="key-env" @bind="_newEnvironment">
                        <option value="Paper">Paper</option>
                        <option value="Live">Live</option>
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-market">Market Type</label>
                    <select id="key-market" @bind="_newMarketType">
                        <option value="Spot">Spot</option>
                        <option value="Futures">Futures</option>
                        <option value="Crypto">Crypto</option>
                        <option value="Stocks">Stocks</option>
                    </select>
                </div>

                @* Credentials always use <input type="password"> — no in-DOM reveal toggle.
                   Rationale: a toggle that flips to type="text" dumps the raw key into the
                   accessibility tree, screen-share captures, and DOM snapshots. Native OS
                   password-reveal is still available at the browser/WebView level and is
                   user-initiated, so accessibility of typing isn't lost. *@

                <div class="modal-row">
                    <label for="key-apikey">API Key</label>
                    <input id="key-apikey" type="password" autocomplete="off" spellcheck="false"
                           @bind="_newApiKey" aria-label="API key" style="flex:1;" />
                </div>

                <div class="modal-row">
                    <label for="key-secret">API Secret</label>
                    <input id="key-secret" type="password" autocomplete="off" spellcheck="false" placeholder="Optional — only exchanges need it"
                           @bind="_newApiSecret" aria-label="API secret (optional — key-only providers like Twelve Data, FMP, and Polygon leave this blank)" style="flex:1;" />
                </div>

                <div class="modal-row">
                    <label for="key-pass">Passphrase</label>
                    <input id="key-pass" type="password" autocomplete="off" spellcheck="false" placeholder="Optional"
                           @bind="_newPassphrase" aria-label="Passphrase (optional)" style="flex:1;" />
                </div>

                @* Deliberately its own bordered block rather than one more row: marking
                   a profile withdrawal-enabled is a different act from adding a trading
                   key, and the form should make the user stop on it rather than tick it
                   in passing. The explanation is part of the control — without the WHY,
                   the obvious "fix" is to grant withdrawal to the trading key.

                   Hidden while the withdrawal release gate is closed (2.4.0): offering a
                   checkbox that creates a profile nothing can use would be worse than
                   offering nothing, because the user would go to the venue, mint a
                   withdrawal key, and find no screen that takes it. _newAllowsWithdrawal
                   stays false when this block does not render, so the saved profile is
                   an ordinary one. *@
                @if (WithdrawalsReleased)
                {
                    <div id="key-withdrawal-block" style="border:1px solid var(--border-color); padding:10px 12px; margin-top:12px;">
                        <div class="modal-row" style="margin:0;">
                            <input id="key-withdrawal" type="checkbox"
                                   @bind="_newAllowsWithdrawal"
                                   aria-describedby="key-withdrawal-why" />
                            <label for="key-withdrawal" style="font-weight:600;">
                                Withdrawal profile — used only to move funds off the venue, never for trading
                            </label>
                        </div>
                        <p id="key-withdrawal-why" style="color:var(--text-muted); font-size:0.82rem; margin:6px 0 0;">
                            Leave unchecked for an ordinary trading or data key.
                            Checked: this profile is used exclusively by the Withdraw screen and is
                            excluded from every trading lookup. Create a separate key on the venue's
                            site with withdrawal permission and WITHOUT trading permission — keeping
                            the two powers on different keys means a leaked trading key cannot empty
                            the account. One withdrawal profile per provider.
                        </p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <p role="alert" style="color:#c00; margin-top:6px; font-size:0.88rem;">@_formError</p>
                }

                <div style="margin-top:12px; display:flex; justify-content:flex-end;">
                    <button id="apikeys-save" class="primary"
                            @onclick="SaveNew"
                            aria-label="Save Profile as a new API key profile">
                        Save Profile
                    </button>
                </div>
            </fieldset>

            <div class="modal-footer">
                <button id="apikeys-close" @onclick="Close" aria-label="Close API keys dialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>The release gate for the withdrawal-profile checkbox. Falls back to the shipped
    /// (closed) value when nothing is registered — see WithdrawalReleasePolicy.</summary>
    private bool WithdrawalsReleased =>
        AccessibleTrader.Core.Services.Trading.WithdrawalReleasePolicy.From(Services).Released;

    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private List<ApiKeyConfig> _keys = new();

    /// <summary>
    /// Nickname of the profile whose removal has been armed and is waiting for a Confirm or
    /// Cancel, or null when nothing is armed. Cleared on open and on close so a confirmation
    /// left hanging cannot be answered by the next visit to this dialog.
    /// </summary>
    private string? _pendingRemoval;

    // New profile form fields
    private string _newProvider    = "Alpaca";
    private string _newNickname    = "";
    private string _newEnvironment = "Paper";
    private string _newMarketType  = "Spot";
    private string _newApiKey      = "";
    private string _newApiSecret   = "";
    private string _newPassphrase  = "";
    private bool   _newAllowsWithdrawal;
    private string? _formError;

    /// <summary>
    /// The provider names offered when the plugin host has told us nothing — a fresh
    /// install whose plugins have not loaded, or a unit-test container with a substituted
    /// data service. The live list is built from the LOADED providers (see
    /// <see cref="BuildProviderChoicesAsync"/>), because a hand-maintained list is exactly
    /// what broke here.
    ///
    /// <para>
    /// Every name below is a provider's own <c>Name</c>, character for character. The
    /// dropdown's value becomes the <c>Provider</c> field of a stored credential, and every
    /// later lookup resolves a provider object by that string — so a name that differs by a
    /// space stores a working key against a provider nothing answers to. That is precisely
    /// what <c>"TwelveData"</c> did for a provider called <c>"Twelve Data"</c>: the key
    /// saved, the modal said saved, and the symbol dropdown went on reading "API key
    /// required" with no way out short of editing storage.
    /// <c>ApiKeysProviderNameTests</c> now checks this list against the real providers.
    /// </para>
    ///
    /// <para>
    /// KrakenFutures and MEXC were once MISSING here even though both plugins trade — so
    /// their keys literally could not be saved through this dropdown. A provider that takes
    /// a key belongs in this list the day it ships; better still, it just needs to load.
    /// </para>
    /// </summary>
    public static readonly IReadOnlyList<string> FallbackProviders = new List<string>
    {
        "Alpaca", "BGeometrics", "Binance", "Bitstamp", "Coinbase", "CoinMetrics",
        "DefiLlama", "Etherscan", "Finnhub", "FMP", "FMP Analytics", "FRED", "Gemini",
        "Glassnode", "Kraken", "KrakenFutures", "Mempool", "MEXC", "OANDA", "Polygon",
        "Schwab", "Tradier", "Twelve Data", CustomProvider
    };

    /// <summary>
    /// The escape hatch for a credential that belongs to no loaded provider. It matches
    /// nothing on purpose, so the "this key reached no provider" warning skips it.
    /// </summary>
    public const string CustomProvider = "Custom";

    private List<string> _knownProviders = FallbackProviders.ToList();

    /// <summary>
    /// Whether a saved profile's provider name resolves to a provider this process actually
    /// loaded. False means the credential is stored and inert. Errors answer TRUE: a broken
    /// lookup must not turn a good save into a scary warning — the honest failure mode of
    /// this check is silence, not a false alarm.
    /// </summary>
    private async Task<bool> ReachesALoadedProviderAsync(string providerName)
    {
        if (string.IsNullOrWhiteSpace(providerName)) return true;
        if (providerName.Equals(CustomProvider, StringComparison.OrdinalIgnoreCase)) return true;
        try { return await DataService.GetProviderAsync(providerName) != null; }
        catch { return true; }
    }

    /// <summary>
    /// The dropdown, built from the providers actually loaded in this process, with the
    /// fallback names added for anything not present. Sourcing it from the plugin host is
    /// the real fix: a name that comes from the provider itself cannot be spelled wrong,
    /// and a provider that ships tomorrow appears here without anyone remembering to type
    /// it in.
    /// </summary>
    private async Task<List<string>> BuildProviderChoicesAsync()
    {
        List<string> loaded;
        try { loaded = await DataService.LoadProvidersAsync() ?? new List<string>(); }
        catch { loaded = new List<string>(); }

        var choices = loaded.Where(n => !string.IsNullOrWhiteSpace(n)).ToList();

        // Add fallback names the host did not report. ProviderNames.Match, not string
        // equality: if the loaded provider is "Twelve Data", the fallback "Twelve Data"
        // must not produce a second, differently-spelled entry beside it.
        foreach (var name in FallbackProviders)
            if (!choices.Any(c => ProviderNames.Match(c, name))) choices.Add(name);

        choices = choices
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // "Custom" is not a provider — it goes last, where an escape hatch belongs, rather
        // than alphabetically among the real ones.
        choices.RemoveAll(n => n.Equals(CustomProvider, StringComparison.OrdinalIgnoreCase));
        choices.Add(CustomProvider);
        return choices;
    }

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenApiKeysEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (!_isVisible || e.ModalName != "API keys") return;

            // Escape with a removal armed backs out of the QUESTION, not the dialog. Closing the
            // whole dialog would leave the user outside it with no word on what happened to the
            // profile they were asked about — and the answer to "are you sure" is the thing they
            // were reaching for. One more Escape closes the dialog as usual.
            if (_pendingRemoval != null) InvokeAsync(CancelRemove);
            else InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _keys = await ApiKeyService.GetAllKeysAsync();
        _knownProviders = await BuildProviderChoicesAsync();
        // The default has to be an option that exists, or the <select> shows the first
        // entry while _newProvider still holds something else — and the profile is then
        // saved for a provider the user never chose.
        if (!_knownProviders.Any(p => p.Equals(_newProvider, StringComparison.OrdinalIgnoreCase)))
            _newProvider = _knownProviders.FirstOrDefault() ?? CustomProvider;
        _formError = null;
        _pendingRemoval = null;
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "API keys"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "apikeys-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        _pendingRemoval = null;
        EventBus.Publish(new ModalStateChangedEvent(false, "API keys"));
        StateHasChanged();
    }

    private async Task SaveNew()
    {
        if (string.IsNullOrWhiteSpace(_newNickname))
        {
            _formError = "Profile name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newApiKey))
        {
            _formError = "API key is required.";
            return;
        }
        if (_keys.Any(k => k.Nickname.Equals(_newNickname, StringComparison.OrdinalIgnoreCase)))
        {
            _formError = $"A profile named \"{_newNickname}\" already exists.";
            return;
        }

        // One withdrawal profile per provider: the withdrawal path takes the FIRST
        // flagged profile it finds, so a second one would be silently ignored — the
        // user would believe the new key is in use while the old one still moves the
        // money. Refusing with the fix beats an arbitrary winner.
        if (_newAllowsWithdrawal &&
            _keys.Any(k => k.AllowsWithdrawal && ProviderNames.Match(k.Provider, _newProvider)))
        {
            _formError = $"{_newProvider} already has a withdrawal profile "
                       + $"(\"{_keys.First(k => k.AllowsWithdrawal && ProviderNames.Match(k.Provider, _newProvider)).Nickname}\"). "
                       + "Remove it first — only one withdrawal profile per provider is used.";
            return;
        }

        try
        {
            // Auto-activate when this is the provider's only profile (or its first
            // active one). Saving a key that then sat INACTIVE was a silent trap:
            // ConfigureStoredKeyProviders skips inactive keys, so the provider stayed
            // on the "API key required" sentinel and the user had no idea why.
            // Withdrawal profiles sit outside activation entirely: they are never
            // activated, and their presence must not stop the NEXT trading key from
            // auto-activating.
            bool autoActivate = !_newAllowsWithdrawal && !_keys.Any(k =>
                !k.AllowsWithdrawal && ProviderNames.Match(k.Provider, _newProvider) && k.IsActive);

            var config = new ApiKeyConfig(
                Provider:    _newProvider,
                Nickname:    _newNickname,
                ApiKey:      _newApiKey,
                ApiSecret:   _newApiSecret,
                Passphrase:  _newPassphrase,
                MarketType:  _newMarketType,
                Environment: _newEnvironment,
                IsActive:    false,
                AllowsWithdrawal: _newAllowsWithdrawal);

            await ApiKeyService.SaveKeyAsync(config);
            if (autoActivate)
                await ApiKeyService.SetActiveKeyAsync(config.Nickname);
            // Configure the provider now so it is usable immediately — otherwise the
            // symbol dropdown gates on IsConfigured before the first (lazy) data fetch
            // that would configure it, and the provider appears stuck on the
            // "API key required" sentinel until the app is restarted.
            await DataService.ConfigureStoredKeyProvidersAsync();
            _keys = await ApiKeyService.GetAllKeysAsync();

            // Reset form
            _newNickname = "";
            _newApiKey = "";
            _newApiSecret = "";
            _newPassphrase = "";
            _newAllowsWithdrawal = false;
            _formError = null;
            StateHasChanged();

            // Configuring the provider is only half of it. The market cascade had
            // already filled its symbol list with the "API key required" sentinel,
            // and nothing recomputed it — so the dropdown went on demanding a key
            // that had just been added, and only a restart cleared it.
            EventBus.Publish(new ApiKeysChangedEvent(config.Provider));

            // "Saved" is not the same claim as "in use", and the gap between them is the
            // whole reported bug: a profile naming a provider that is not loaded is stored
            // perfectly and does nothing at all. Say so HERE, where the user still has the
            // form open, instead of leaving them to infer it from a symbol dropdown that
            // goes on asking for a key. Custom is exempt — it names no provider by design.
            bool reachedAProvider = await ReachesALoadedProviderAsync(config.Provider);
            if (!reachedAProvider)
            {
                _formError = $"Saved, but no loaded provider is named \"{config.Provider}\", so this key "
                           + "is not in use. Check the provider plugin is installed.";
                StateHasChanged();
            }

            EventBus.Publish(new FeedbackRequestEvent(
                reachedAProvider ? FeedbackType.StateChange : FeedbackType.Error,
                !reachedAProvider
                    ? $"Profile {config.Nickname} saved, but no loaded provider is named "
                      + $"{config.Provider}, so the key is not in use."
                    : config.AllowsWithdrawal
                        ? $"Withdrawal profile {config.Nickname} saved for {config.Provider}. "
                          + "It will be used only by the Withdraw screen, never for trading."
                        : autoActivate
                            ? $"Profile {config.Nickname} saved and activated"
                            : $"Profile {config.Nickname} saved. Press Activate on it to use it."));
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save profile: {ex.Message}";
            StateHasChanged();
        }
    }

    private async Task SetActive(string nickname)
    {
        try
        {
            await ApiKeyService.SetActiveKeyAsync(nickname);
            // Re-configure providers so the newly-active key takes effect immediately
            // instead of on the next app restart.
            await DataService.ConfigureStoredKeyProvidersAsync();
            _keys = await ApiKeyService.GetAllKeysAsync();
            StateHasChanged();

            EventBus.Publish(new ApiKeysChangedEvent(
                _keys.FirstOrDefault(k => k.Nickname == nickname)?.Provider ?? ""));

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"{nickname} set as active"));
        }
        catch (Exception ex)
        {
            _formError = $"Failed to activate profile: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Arms the removal of <paramref name="nickname"/> — it does not remove anything.
    ///
    /// <para>
    /// Until 2026-08-29 this method WAS the removal: one click, no question asked, nothing
    /// spoken, and the button that took the click was inside the row that then disappeared,
    /// so focus fell to <c>&lt;body&gt;</c>. A screen-reader user pressed a control, was
    /// returned to the top of the document, and had no way to tell whether the profile was
    /// gone or the button had done nothing at all.
    /// </para>
    /// </summary>
    private async Task Remove(string nickname)
    {
        _pendingRemoval = nickname;
        StateHasChanged();
        await Task.Yield();

        // Speak the question. The visible markup changed under a sighted user's eyes; the
        // announcement is what makes that true for everyone else, and it must say what is
        // at stake before it says which keys answer it.
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Remove {nickname}? This cannot be undone. Confirm remove, or cancel."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "apikey-remove-confirm"); }
        catch { /* focus is best-effort; the buttons are still one Tab away */ }
    }

    /// <summary>
    /// Answers the confirmation with "no": nothing is removed, focus goes back to the row's own
    /// remove button so the user is where they started. Reached from the Cancel button and from
    /// Escape — the row index is recovered from the armed nickname rather than passed in, so
    /// both routes behave identically.
    /// </summary>
    private async Task CancelRemove()
    {
        string? nickname = _pendingRemoval;
        int rowIndex = Math.Max(0, _keys.FindIndex(k => k.Nickname == nickname));
        _pendingRemoval = null;
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Cancelled. {nickname} was kept."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", $"apikey-remove-{rowIndex}"); }
        catch { }
    }

    private async Task ConfirmRemove(int rowIndex)
    {
        string nickname = _pendingRemoval ?? "";
        _pendingRemoval = null;
        try
        {
            string provider = _keys.FirstOrDefault(k => k.Nickname == nickname)?.Provider ?? "";
            await ApiKeyService.RemoveKeyAsync(nickname);
            _keys = await ApiKeyService.GetAllKeysAsync();
            StateHasChanged();

            // Removal changes the same answers saving does — including whether the
            // toolbar may still offer Withdraw for this provider. A removed
            // withdrawal profile must retract the button, not leave it to open
            // onto a refusal.
            EventBus.Publish(new ApiKeysChangedEvent(provider));

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                _keys.Count == 0
                    ? $"{nickname} removed. No profiles remain."
                    : $"{nickname} removed."));

            await Task.Yield();
            // The row that was focused no longer exists. Land on the row that took its place
            // (or the last one, when the removed profile was at the end); with none left the
            // list itself is gone, so the add form is the nearest thing still on screen.
            string target = _keys.Count > 0
                ? $"apikey-remove-{Math.Min(rowIndex, _keys.Count - 1)}"
                : "key-provider";
            try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", target); }
            catch { }
        }
        catch (Exception ex)
        {
            _formError = $"Failed to remove profile: {ex.Message}";
            StateHasChanged();
            // _formError is on screen for a sighted user and nowhere at all for anyone else:
            // this modal is not a live region. Say it.
            // The detail stays on screen and out of the speech channel: an exception message
            // from a credential store is exactly the string that has carried a secret in this
            // codebase before.
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error,
                $"Failed to remove {nickname}. The profile was not removed. See the error in the dialog."));
        }
    }

    /// <summary>
    /// Kicks off the Schwab OAuth authorization-code flow for the selected profile.
    /// Activates the profile first so the provider loads its client id / secret, then
    /// reaches the Schwab provider through <see cref="IDataService.GetProviderAsync"/>
    /// and calls its <c>BeginAuthorizationAsync</c> entry point. The method opens the
    /// Schwab sign-in page in the OS default browser; the provider's embedded HTTP
    /// listener captures the callback and stores the refresh token. Feedback lands
    /// through the accessibility event bus so screen-reader users hear when the flow
    /// starts, succeeds, or fails.
    /// </summary>
    private async Task BeginSchwabAuthorizationAsync(string nickname)
    {
        try
        {
            // Ensure the profile whose sign-in was requested is the active one. Without
            // this the provider might still be holding another profile's client id.
            await ApiKeyService.SetActiveKeyAsync(nickname);
            _keys = await ApiKeyService.GetAllKeysAsync();

            var provider = await DataService.GetProviderAsync("Schwab");
            if (provider == null)
            {
                _formError = "Schwab provider not loaded. Is the plugin installed?";
                StateHasChanged();
                return;
            }

            // Reach the concrete method via reflection so the UI layer doesn't take a
            // hard plugin dependency. BeginAuthorizationAsync is declared on the
            // SchwabProvider concrete class (not on IMarketDataProvider) so a cast or
            // reflection is required either way.
            var method = provider.GetType().GetMethod(
                "BeginAuthorizationAsync",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (method == null)
            {
                _formError = "Schwab provider missing BeginAuthorizationAsync; plugin version mismatch.";
                StateHasChanged();
                return;
            }

            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                "Opening Schwab sign-in in browser."));

            // The BeginAuthorizationAsync(Action<string>? openBrowser = null, CancellationToken = default)
            // contract: first arg is an optional browser-launch hook; passing null falls
            // back to the provider's default Process.Start shell opener.
            var task = (Task?)method.Invoke(provider, new object?[] { null, default(System.Threading.CancellationToken) });
            if (task == null)
            {
                _formError = "Schwab authorization invocation returned null.";
                StateHasChanged();
                return;
            }
            await task.ConfigureAwait(true);

            _formError = null;
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"Schwab sign-in complete for {nickname}."));
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _formError = $"Schwab sign-in failed: {ex.Message}";
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, _formError));
            StateHasChanged();
        }
    }

    private string GetKeyLabel(ApiKeyConfig k)
    {
        string active = k.IsActive ? ", active" : "";
        string withdrawal = k.AllowsWithdrawal ? ", withdrawal profile" : "";
        return $"{k.Nickname}, {k.Provider}, {k.Environment}, {k.MarketType}{active}{withdrawal}";
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
