@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject DemoPolicy Demo

<div class="indicator-bar" role="toolbar" aria-label="Indicator Controls">

    <label for="indicator-select">Focused Indicator:</label>
    <select id="indicator-select"
            aria-label="Select focused indicator"
            value="@Store.State.FocusedSeriesId"
            @onchange="OnSeriesChanged">
        @foreach (var s in Store.State.ActiveSeries)
        {
            <option value="@s.Id">@s.FriendlyName</option>
        }
    </select>

    @if (_focusedSeries != null)
    {
        @* Route through EventBus → ChartCommandManager so speech feedback fires. *@
        <ToolbarIconButton Icon="@(_focusedSeries.IsVisible ? "visible" : "hidden")"
                          Label="@(_focusedSeries.IsVisible ? "Visible" : "Hidden")"
                          Variant="neutral"
                          IsToggleOn="@(!_focusedSeries.IsVisible)"
                          Tooltip="Toggle visibility (H)"
                          AriaLabel="@(_focusedSeries.IsVisible ? "Hide " + _focusedSeries.FriendlyName : "Show " + _focusedSeries.FriendlyName)"
                          OnClick="() => EventBus.Publish(new ToggleHideEvent())" />

        <ToolbarIconButton Icon="@(_focusedSeries.IsMuted ? "audio-muted" : "audio-on")"
                          Label="@(_focusedSeries.IsMuted ? "Muted" : "Audio")"
                          Variant="@(_focusedSeries.IsMuted ? "warning" : "neutral")"
                          IsToggleOn="@(_focusedSeries.IsMuted)"
                          Tooltip="Toggle audio (M)"
                          AriaLabel="@(_focusedSeries.IsMuted ? "Unmute " + _focusedSeries.FriendlyName : "Mute " + _focusedSeries.FriendlyName)"
                          OnClick="() => EventBus.Publish(new ToggleMuteEvent())" />
    }

    <div style="flex: 1;" aria-hidden="true"></div>

    <ToolbarIconButton Icon="add-indicator" Label="Add" Variant="data" Primary="true"
                      Tooltip="Add indicator to chart"
                      AriaLabel="Add indicator to chart"
                      OnClick="() => EventBus.Publish(new OpenAddIndicatorEvent())" />

    @if (Demo.AllowCustomScripts)
    {
        <ToolbarIconButton Icon="scripts" Label="Scripts" Variant="thought"
                          Tooltip="Custom Scripts (Alt+,)"
                          AriaLabel="Custom Scripts (Alt+Comma)"
                          OnClick="() => EventBus.Publish(new OpenCustomScriptsEvent())" />
    }

</div>

@code {
    private ChartSeries? _focusedSeries =>
        Store.State.ActiveSeries.FirstOrDefault(s => s.Id == Store.State.FocusedSeriesId);

    private void OnSeriesChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id))
            Store.Dispatch(new SelectSeriesAction(id));
    }
}
