@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject DemoPolicy Demo
@implements IDisposable

@* A <nav> landmark, not role="toolbar". Every control here is a flat Tab stop with no
   roving tabindex and no arrow-key handler, so role="toolbar" was advertising an
   interaction model that does not exist. As a labelled landmark this bar becomes
   reachable by the D key instead, which is how a screen-reader user finds chrome. *@
<nav class="indicator-bar" data-background-region aria-label="Indicator controls">

    <label for="indicator-select">Focused Indicator:</label>
    <select id="indicator-select"
            aria-label="Select focused indicator"
            value="@Store.State.FocusedSeriesId"
            @onchange="OnSeriesChanged">
        @foreach (var s in Store.State.ActiveSeries)
        {
            <option value="@s.Id">@s.FriendlyName</option>
        }
    </select>

    @if (_focusedSeries != null)
    {
        @* Route through EventBus → ChartCommandManager so speech feedback fires. *@
        @* The LABEL names the action, exactly as ObjectTreeModal's row buttons do, and there
           is deliberately no aria-pressed beside it.

           These two were the last of the WCAG 2.5.3 Label-in-Name failures: the caption showed
           the STATE ("Visible", "Muted") and the accessible name gave the ACTION ("Hide SMA 20"),
           so the words a user could see appeared nowhere in the words voice control matches, and
           the announcement carried a third signal on top — aria-pressed — which on a muted series
           read "Unmute SMA 20, toggle button, pressed". The two buttons were even wired with
           opposite polarity: pressed meant hidden on the left and muted on the right.

           One signal now, in the label, extended by the series name. `Highlighted` keeps the
           visual on-state for sighted and low-vision users without re-introducing aria-pressed. *@
        <ToolbarIconButton Icon="@(_focusedSeries.IsVisible ? "visible" : "hidden")"
                          Label="@(_focusedSeries.IsVisible ? "Hide" : "Show")"
                          Variant="neutral"
                          Highlighted="@(!_focusedSeries.IsVisible)"
                          Tooltip="Toggle visibility (H)"
                          AriaLabel="@(_focusedSeries.IsVisible ? "Hide " + _focusedSeries.FriendlyName : "Show " + _focusedSeries.FriendlyName)"
                          OnClick="() => EventBus.Publish(new ToggleHideEvent())" />

        <ToolbarIconButton Icon="@(_focusedSeries.IsMuted ? "audio-muted" : "audio-on")"
                          Label="@(_focusedSeries.IsMuted ? "Unmute" : "Mute")"
                          Variant="@(_focusedSeries.IsMuted ? "warning" : "neutral")"
                          Highlighted="@(_focusedSeries.IsMuted)"
                          Tooltip="Toggle audio (M)"
                          AriaLabel="@(_focusedSeries.IsMuted ? "Unmute " + _focusedSeries.FriendlyName : "Mute " + _focusedSeries.FriendlyName)"
                          OnClick="() => EventBus.Publish(new ToggleMuteEvent())" />
    }

    <div style="flex: 1;" aria-hidden="true"></div>

    <ToolbarIconButton Icon="add-indicator" Label="Add" Variant="data" Primary="true"
                      Tooltip="Add indicator to chart"
                      AriaLabel="Add indicator to chart"
                      OnClick="() => EventBus.Publish(new OpenAddIndicatorEvent())" />

    @if (Demo.AllowCustomScripts)
    {
        <ToolbarIconButton Icon="scripts" Label="Scripts" Variant="thought"
                          Tooltip="Custom Scripts (Alt+,)"
                          AriaLabel="Custom Scripts (Alt+Comma)"
                          OnClick="() => EventBus.Publish(new OpenCustomScriptsEvent())" />
    }

</nav>

@code {
    private ChartSeries? _focusedSeries =>
        Store.State.ActiveSeries.FirstOrDefault(s => s.Id == Store.State.FocusedSeriesId);

    private IDisposable? _stateSub;

    /// <summary>
    /// Observe the store, the way <c>TabBar</c> and <c>Toolbar</c> already do.
    ///
    /// <para>
    /// Every control in this bar is a projection of <c>Store.State</c> — the series picker's
    /// options ARE <c>ActiveSeries</c>, and the Hide/Mute buttons name the focused one — but the
    /// component had no subscription of any kind, so it repainted only when something else
    /// happened to re-render it. Measured 2026-09-04 in the browser harness: on a cold circuit a
    /// chart loaded with FOUR series in the store (probed server-side: candles, volume, price,
    /// market structure, 200 bars) while this dropdown stayed at ZERO options; the tab bar beside
    /// it, which has this subscription, showed the new tab correctly. Four more Load presses
    /// changed nothing.
    /// </para>
    ///
    /// <para>
    /// For a screen-reader user that is the worst shape the bug could take: the terminal
    /// announces "Ready", the tab says the symbol, and the one list that names what is ON the
    /// chart says there is nothing there.
    /// </para>
    /// </summary>
    protected override void OnInitialized() =>
        _stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(StateHasChanged));

    public void Dispose() => _stateSub?.Dispose();

    private void OnSeriesChanged(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (!string.IsNullOrEmpty(id))
            Store.Dispatch(new SelectSeriesAction(id));
    }
}
