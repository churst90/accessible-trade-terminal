@using AccessibleTrader.Sdk.Alerts
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Core.Services
@inherits ModalBase
@inject IAlertOrchestrator AlertOrchestrator
@inject IWorkspaceStore Store
@inject ISettingsManager Settings

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="alerts-title"
             @onclick:stopPropagation="true">

            <h2 id="alerts-title" tabindex="-1">Alerts</h2>

            <div style="margin-top: 16px;">
                <h3>Active Alerts</h3>
                @if (!_activeAlerts.Any())
                {
                    <p role="status">No active alerts.</p>
                }
                else
                {
                    <ul role="list" style="list-style: none; padding: 0; margin: 0;">
                        @foreach (var alert in _activeAlerts)
                        {
                            <li role="listitem"
                                style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                                <span>@alert.Name — @(alert.Symbol ?? "Any") · @(alert.ConditionTree != null ? "Advanced rule" : $"{alert.Target} {alert.Condition}{(alert.Threshold.HasValue ? $" {alert.Threshold:G}" : "")}")@(string.IsNullOrEmpty(alert.WebhookTarget) ? "" : $" → {alert.WebhookTarget}")</span>
                                <button aria-label="@($"Delete alert: {alert.Name}")"
                                        @onclick="() => DeleteAlert(alert.Id)">
                                    Delete
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div style="margin-top: 24px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                <h3>Add Alert</h3>
                <div class="modal-row">
                    <label for="alert-name">Name:</label>
                    <input id="alert-name"
                           type="text"
                           @bind="_newAlertName"
                           placeholder="e.g. Price crosses 50000" />
                </div>
                <div class="modal-row">
                    <label for="alert-advanced">Advanced condition (custom rule tree):</label>
                    <input id="alert-advanced" type="checkbox"
                           checked="@_advancedCondition"
                           @onchange="OnAdvancedToggled" />
                </div>
                <div class="modal-row">
                    <label for="alert-breakthrough">Break through mutes (fires even when alerts are muted with Shift+F2 / Shift+F3):</label>
                    <input id="alert-breakthrough" type="checkbox"
                           checked="@_newAlertBreakThrough"
                           @onchange="e => _newAlertBreakThrough = e.Value is bool b && b" />
                </div>
                @if (_advancedCondition)
                {
                    <p style="font-size:0.85rem; color: var(--text-muted); margin: 4px 0 8px;">
                        Build a rule tree exactly like a strategy's conditions — groups
                        (AND / OR / NOT / Score) and leaves that test indicator components.
                        The alert fires on the bar where the whole tree first becomes true,
                        and re-arms when it goes false again. Leaves reference indicators by
                        code, so add the indicator to the chart first. Advanced alerts scoped
                        to a symbol keep working from background tabs.
                    </p>
                    <ConditionTreeEditor Spec="_advancedSpec" />
                }
                else
                {
                <div class="modal-row">
                    <label for="alert-target">Target:</label>
                    <select id="alert-target" @bind="_newAlertTarget">
                        <option value="@AlertTarget.Price">Price</option>
                        <option value="@AlertTarget.Candle">Candle</option>
                        <option value="@AlertTarget.Indicator">Indicator</option>
                    </select>
                </div>
                <div class="modal-row">
                    <label for="alert-condition">Condition:</label>
                    <select id="alert-condition" @bind="_newAlertCondition">
                        <option value="@AlertCondition.CrossesAbove">Crosses Above</option>
                        <option value="@AlertCondition.CrossesBelow">Crosses Below</option>
                        <option value="@AlertCondition.EntersZone">Enters Zone</option>
                        <option value="@AlertCondition.ExitsZone">Exits Zone</option>
                        <option value="@AlertCondition.ChangesDirection">Changes Direction</option>
                    </select>
                </div>
                @* The indicator and component pickers. Without these, Target=Indicator built
                   an alert with no IndicatorCode and no ComponentName, which AlertEvaluator's
                   Indicator arm requires — so the alert fell through every arm and could
                   never fire, while the modal announced that it worked. *@
                @if (_newAlertTarget == AlertTarget.Indicator || IsZoneCondition || IsTrendCondition)
                {
                    <div class="modal-row">
                        <label for="alert-indicator">Indicator:</label>
                        <select id="alert-indicator" @bind="_newAlertIndicatorCode">
                            <option value="">(choose an indicator)</option>
                            @foreach (var s in IndicatorSeries)
                            {
                                <option value="@s.IndicatorCode">@s.FriendlyName</option>
                            }
                        </select>
                    </div>
                }
                @if (_newAlertTarget == AlertTarget.Indicator)
                {
                    <div class="modal-row">
                        <label for="alert-component">Component:</label>
                        <select id="alert-component" @bind="_newAlertComponentName">
                            <option value="">(choose a component)</option>
                            @foreach (var c in ComponentsOfChosenIndicator)
                            {
                                <option value="@c.Name">@(string.IsNullOrEmpty(c.DisplayName) ? c.Name : c.DisplayName)</option>
                            }
                        </select>
                    </div>
                }
                @if (IsZoneCondition)
                {
                    <div class="modal-row">
                        <label for="alert-zone">Zone:</label>
                        <select id="alert-zone" @bind="_newAlertZone">
                            <option value="@AlertZone.Overbought">Overbought</option>
                            <option value="@AlertZone.Oversold">Oversold</option>
                            <option value="@AlertZone.UpperBand">Upper band</option>
                            <option value="@AlertZone.LowerBand">Lower band</option>
                        </select>
                    </div>
                }
                @if (!IsZoneCondition && _newAlertCondition != AlertCondition.ChangesDirection)
                {
                    <div class="modal-row">
                        <label for="alert-threshold">@(_newAlertTarget == AlertTarget.Indicator ? "Value:" : "Price Level:")</label>
                        <input id="alert-threshold"
                               type="number"
                               step="any"
                               @bind="_newAlertThreshold" />
                    </div>
                }
                }
                <div class="modal-row">
                    <label for="alert-delivery">Delivery:</label>
                    <select id="alert-delivery" @bind="_newAlertDelivery">
                        <option value="@AlertDelivery.Speech">Speech</option>
                        <option value="@AlertDelivery.Earcon">Earcon</option>
                        <option value="@AlertDelivery.Both">Both</option>
                    </select>
                </div>
                <div class="modal-row">
                    <label for="alert-symbol">Symbol:</label>
                    <select id="alert-symbol" @bind="_newAlertScopeToSymbol">
                        <option value="true">This symbol (@(_currentSymbol ?? "current chart"))</option>
                        <option value="false">Any symbol</option>
                    </select>
                </div>
                <div class="modal-row">
                    <label for="alert-webhook">Webhook:</label>
                    <select id="alert-webhook" @bind="_newAlertWebhookTarget">
                        <option value="">— none —</option>
                        @foreach (var name in _webhookNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
                    <button @onclick="AddAlert"
                            aria-label="Add alert"
                            class="primary"
                            disabled="@(string.IsNullOrWhiteSpace(_newAlertName) || (_advancedCondition && _advancedSpec.Root == null))">
                        Add Alert
                    </button>
                </div>
            </div>

            <div style="margin-top: 24px; display: flex; justify-content: flex-end;">
                <button @onclick="Close" aria-label="Close alerts dialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private List<AlertDefinition> _activeAlerts = new();
    private string _newAlertName = "";
    private AlertTarget _newAlertTarget = AlertTarget.Price;
    private AlertCondition _newAlertCondition = AlertCondition.CrossesAbove;
    private double _newAlertThreshold;

    // Indicator / component / zone selection. These three fields did not exist, which is
    // why every Target=Indicator and every zone alert was permanently silent.
    private string _newAlertIndicatorCode = "";
    private string _newAlertComponentName = "";
    private AlertZone _newAlertZone = AlertZone.Overbought;

    private bool IsZoneCondition =>
        _newAlertCondition is AlertCondition.EntersZone or AlertCondition.ExitsZone;

    private bool IsTrendCondition => _newAlertCondition == AlertCondition.TrendChange;

    /// <summary>Indicator series currently on the chart — the only ones an alert can read.</summary>
    private IEnumerable<ChartSeries> IndicatorSeries =>
        Store.State.ActiveSeries
            .Where(s => !s.IsDrawing
                     && !string.IsNullOrEmpty(s.IndicatorCode)
                     && s.Components.Count > 0)
            .GroupBy(s => s.IndicatorCode, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First());

    private IEnumerable<ComponentConfig> ComponentsOfChosenIndicator =>
        IndicatorSeries
            .FirstOrDefault(s => s.IndicatorCode.Equals(_newAlertIndicatorCode, StringComparison.OrdinalIgnoreCase))
            ?.Components ?? Enumerable.Empty<ComponentConfig>();
    private AlertDelivery _newAlertDelivery = AlertDelivery.Both;
    private bool _newAlertBreakThrough;

    // Part A — symbol scoping. Default a new alert to the on-screen chart's symbol.
    private bool _newAlertScopeToSymbol = true;
    private string? _currentSymbol;
    // Part B — per-asset webhook routing target ("" = none).
    private string _newAlertWebhookTarget = "";
    private List<string> _webhookNames = new();

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        // _eventSub is declared in ModalBase and disposed there automatically.
        _eventSub = EventBus.Subscribe<OpenAlertsEvent>(_ => InvokeAsync(ShowAsync));
        RefreshAlerts();
    }

    private async Task ShowAsync()
    {
        RefreshAlerts();
        RefreshChartContext();
        await ShowModalAsync("alerts-title");
    }

    private void RefreshChartContext()
    {
        var sym = Store.State.SymbolDisplayName;
        _currentSymbol = string.IsNullOrWhiteSpace(sym) ? null : sym;
        // Populate the webhook-target dropdown from the configured named webhooks
        // (migrating a legacy single URL to "Default").
        _webhookNames = AccessibleTrader.Core.Services.Alerts.WebhookAlertConfigLoader
            .ParseWebhooks(
                Settings.GetSetting("alerts.webhooks"),
                Settings.GetSetting("alerts.webhook.url")?.ToString(),
                Settings.GetSetting("alerts.webhook.authHeader")?.ToString())
            .Select(w => w.Name)
            .ToList();
        // Drop a stale selection if the named webhook no longer exists.
        if (!string.IsNullOrEmpty(_newAlertWebhookTarget) && !_webhookNames.Contains(_newAlertWebhookTarget))
            _newAlertWebhookTarget = "";
    }

    private void Close() => CloseModal();

    protected override string ModalName => "Alerts";

    private void RefreshAlerts()
    {
        _activeAlerts = AlertOrchestrator.GetAlerts().ToList();
    }

    private void AddAlert()
    {
        if (string.IsNullOrWhiteSpace(_newAlertName)) return;

        // Advanced mode: the tree REPLACES the simple rule. Target/Condition are
        // required record fields, so they carry placeholder values the evaluator
        // never consults when ConditionTree is set.
        var tree = _advancedCondition ? _advancedSpec.BuildConditionTree() : null;
        if (_advancedCondition && tree == null) return;

        // Stamp the full chart identity, not just the symbol. The background
        // monitors fetch by (provider, market, symbol, timeframe); with only a
        // Symbol on the record, DeriveWatches had nothing to fetch by, so an
        // alert created here was never watchable with the browser closed at all.
        var identity = Store.State.Identity;

        var def = new AlertDefinition
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newAlertName,
            Target = _newAlertTarget,
            Condition = _newAlertCondition,
            Threshold = _advancedCondition ? null : _newAlertThreshold,
            Delivery = _newAlertDelivery,
            // Scope to the current chart (null = any) and route to the chosen webhook.
            Symbol = _newAlertScopeToSymbol ? _currentSymbol : null,
            Provider = _newAlertScopeToSymbol ? identity.Provider : null,
            Timeframe = _newAlertScopeToSymbol ? identity.Timeframe : null,
            Market = _newAlertScopeToSymbol ? identity.Market : null,
            WebhookTarget = string.IsNullOrWhiteSpace(_newAlertWebhookTarget) ? null : _newAlertWebhookTarget,
            ConditionTree = tree,
            BreakThroughMutes = _newAlertBreakThrough,
            // These three were never set. AlertEvaluator's Indicator arm requires both
            // IndicatorCode and ComponentName, and EvaluateZone returns false immediately for
            // a null IndicatorCode — so every Target=Indicator and every zone alert built here
            // was permanently silent while the modal said it worked.
            IndicatorCode = string.IsNullOrWhiteSpace(_newAlertIndicatorCode) ? null : _newAlertIndicatorCode,
            ComponentName = string.IsNullOrWhiteSpace(_newAlertComponentName) ? null : _newAlertComponentName,
            Zone = IsZoneCondition ? _newAlertZone : null,
        };

        // REFUSE an alert that cannot fire, rather than adding it and calling it live.
        // "Your alert is watching the market" is the single claim this app must never make
        // falsely, because a user who believes it stops watching themselves.
        var unfireable = AccessibleTrader.Core.Services.Alerts.BackgroundWatchability.WhyUnfireable(def);
        if (unfireable != null)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error,
                $"Alert not added: {unfireable}.", true));
            return;
        }

        AlertOrchestrator.AddAlert(def);

        // If the background monitors cannot evaluate this alert, SAY so now —
        // the alternative is a user closing the browser believing an alert is
        // watching the market when it is not, which is the worst failure this
        // app has. The alert still works while its chart is open.
        var unwatchableReason = AccessibleTrader.Core.Services.Alerts.BackgroundWatchability.WhyUnwatchable(def);
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            unwatchableReason == null
                ? $"Alert {def.Name} added."
                : $"Alert {def.Name} added. It works while this chart is open, but background " +
                  $"and server-side monitoring cannot watch it: {unwatchableReason}."));
        _newAlertName = "";
        _newAlertThreshold = 0;
        if (_advancedCondition) _advancedSpec = new Core.Services.Strategies.EditableStrategySpec();
        RefreshAlerts();
        StateHasChanged();
    }

    // ── Part D: advanced condition tree ──────────────────────────────────────
    private bool _advancedCondition;
    private Core.Services.Strategies.EditableStrategySpec _advancedSpec = new();

    private void OnAdvancedToggled(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _advancedCondition = e.Value is bool b && b;
        StateHasChanged();
    }

    private void DeleteAlert(string id)
    {
        AlertOrchestrator.RemoveAlert(id);
        RefreshAlerts();
        StateHasChanged();
    }
}
