@using AccessibleTrader.Sdk.Alerts
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Alerts
@inherits ModalBase
@inject IAlertOrchestrator AlertOrchestrator
@inject IWorkspaceStore Store
@inject ISettingsManager Settings
@inject DemoPolicy Demo

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Alerts"
             aria-modal="true"
             aria-labelledby="alerts-title"
             @onclick:stopPropagation="true">

            <h2 id="alerts-title" tabindex="-1">Alerts</h2>

            @* ── Delivery settings — the Settings dialog's old Alerts tab, moved here ──
               Two views in one dialog rather than a second dialog on top of this one. A
               nested modal would put a second aria-modal="true" over a dialog the user is
               mid-task in, and Escape would then close the panel they are reading rather
               than the alert form they came for. A view swap keeps ONE dialog, one Escape,
               and one thing to close. Focus moves to the panel's heading on the way in and
               back to the button that opened it on the way out — the same contract every
               modal in this app keeps. *@
            @if (_view == View.Delivery)
            {
                <h3 id="alerts-delivery-title" tabindex="-1" style="margin-top:16px;">Delivery settings</h3>
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:12px;">
                    Where fired alerts are sent besides this terminal. Each channel activates only
                    when its required fields are filled; unconfigured channels are skipped. The
                    webhook names you define here are the choices in an alert's Webhook list.
                </p>

                <AlertDeliverySettings />

                <div style="margin-top: 24px; display: flex; gap: 8px; justify-content: flex-end;">
                    <button id="alerts-delivery-back" @onclick="ShowAlertsAsync">Back to alerts</button>
                    <button @onclick="Close" aria-label="Close alerts dialog">Close</button>
                </div>
            }
            else
            {
            <div style="margin-top: 16px;">
                <h3>Active Alerts</h3>
                @if (!_activeAlerts.Any())
                {
                    <p role="status">No active alerts.</p>
                }
                else
                {
                    <ul role="list" style="list-style: none; padding: 0; margin: 0;">
                        @* Indexed, not @foreach: the Delete button needs an id that says which
                           row it is, because the row it lives in is the one that disappears —
                           focus has to be put somewhere deliberate afterwards. *@
                        @for (int i = 0; i < _activeAlerts.Count; i++)
                        {
                            var alert = _activeAlerts[i];
                            var rowIndex = i;
                            <li role="listitem"
                                style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-color);">
                                @* The same sentence the add confirmation spoke, rather than the enum names
                                   ("Indicator EntersZone") the row used to show. *@
                                <span>@alert.Name — @(alert.ConditionTree != null ? $"{alert.Symbol ?? "Any"} · Advanced rule" : AlertDescriptions.Describe(alert, Store.State.ActiveSeries))@(string.IsNullOrEmpty(alert.WebhookTarget) ? "" : $" → {alert.WebhookTarget}")</span>
                                <button id="alert-delete-@rowIndex"
                                        aria-label="@($"Delete alert: {alert.Name}")"
                                        @onclick="() => DeleteAlert(alert.Id, rowIndex)">
                                    Delete
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div style="margin-top: 24px; border-top: 1px solid var(--border-color); padding-top: 16px;">
                <h3>Add Alert</h3>
                <div class="modal-row">
                    <label for="alert-name">Name:</label>
                    <input id="alert-name"
                           type="text"
                           @bind="_newAlertName"
                           placeholder="e.g. Price crosses 50000" />
                </div>
                <div class="modal-row">
                    <label for="alert-advanced">Advanced condition (custom rule tree):</label>
                    <input id="alert-advanced" type="checkbox"
                           checked="@_advancedCondition"
                           @onchange="OnAdvancedToggled" />
                </div>
                <div class="modal-row">
                    <label for="alert-breakthrough">Break through mutes (fires even when alerts are muted with Shift+F2 / Shift+F3):</label>
                    <input id="alert-breakthrough" type="checkbox"
                           checked="@_newAlertBreakThrough"
                           @onchange="e => _newAlertBreakThrough = e.Value is bool b && b" />
                </div>
                @if (_advancedCondition)
                {
                    <p style="font-size:0.85rem; color: var(--text-muted); margin: 4px 0 8px;">
                        Build a rule tree exactly like a strategy's conditions — groups
                        (AND / OR / NOT / Score) and leaves that test indicator components.
                        The alert fires on the bar where the whole tree first becomes true,
                        and re-arms when it goes false again. Leaves reference indicators by
                        code, so add the indicator to the chart first. Advanced alerts scoped
                        to a symbol keep working from background tabs.
                    </p>
                    <ConditionTreeEditor Spec="_advancedSpec" />
                }
                else
                {
                @* ── The simple form, in the order the questions depend on each other ──
                   WHAT is watched (target, then which indicator and component), then what to
                   wait for (condition — which depends on what is watched), then what to compare
                   with. Cody, 2026-10-09: "the cascade here doesn't make a whole lot of sense" —
                   the condition list came first and was the same for everything, so Price offered
                   "Enters zone" and an SMA offered "Overbought", neither of which could fire.
                   Every list below is computed from the choices above it, and a choice a later
                   list no longer contains is replaced by a valid one and SAID (see
                   ReconcileChoices). Focus never moves: the control being changed is never one
                   of the ones that appears or disappears. *@
                <div class="modal-row">
                    <label for="alert-target">Target:</label>
                    <select id="alert-target" @bind="_newAlertTarget" @bind:after="OnTargetChanged">
                        <option value="@AlertTarget.Price">Price</option>
                        <option value="@AlertTarget.Candle">Candle</option>
                        <option value="@AlertTarget.Indicator">Indicator</option>
                    </select>
                </div>
                @* The indicator and component pickers. Without these, Target=Indicator built
                   an alert with no IndicatorCode and no ComponentName, which AlertEvaluator's
                   Indicator arm requires — so the alert fell through every arm and could
                   never fire, while the modal announced that it worked. The indicator is
                   chosen by INSTANCE: an SMA 20 and an SMA 50 are two choices, not one "SMA". *@
                @if (_newAlertTarget == AlertTarget.Indicator)
                {
                    <div class="modal-row">
                        <label for="alert-indicator">Indicator:</label>
                        <select id="alert-indicator" @bind="_newAlertSeriesId" @bind:after="OnIndicatorChanged">
                            @* An empty list says WHY it is empty: "(choose an indicator)" alone, on a
                               chart with nothing on it, reads as a list the user has not opened yet. *@
                            <option value="">@(IndicatorSeries.Any() ? "(choose an indicator)" : "(no indicators on this chart; add one first)")</option>
                            @foreach (var s in IndicatorSeries)
                            {
                                <option value="@s.Id">@SeriesLabel(s)</option>
                            }
                        </select>
                    </div>
                    @* Component, condition, zone, compare-with and line each keep the user's
                       CHOICE apart from what is shown. Chrome and Firefox commit every option an
                       arrow key passes in a closed select, so arrowing the indicator list from RSI
                       through an SMA to Stochastic used to drop "Enters zone" on the SMA and leave
                       it gone on Stochastic. The choice now survives the pass and comes back. *@
                    <div class="modal-row">
                        <label for="alert-component">Component:</label>
                        <select id="alert-component" value="@_newAlertComponentName" @onchange="OnComponentPicked">
                            <option value="">(choose a component)</option>
                            @foreach (var c in ComponentsOfChosenIndicator)
                            {
                                <option value="@c.Name">@ComponentLabel(c)</option>
                            }
                        </select>
                    </div>
                }
                <div class="modal-row">
                    <label for="alert-condition">Condition:</label>
                    <select id="alert-condition" value="@_newAlertCondition" @onchange="OnConditionPicked">
                        @foreach (var c in ConditionsOffered)
                        {
                            <option value="@c">@ConditionLabel(c)</option>
                        }
                    </select>
                </div>
                @if (IsZoneCondition)
                {
                    @* Only the zones this indicator has — its own overbought / oversold lines, from
                       the same AlertZones helper the evaluator reads. The Upper band and Lower band
                       options that sat here matched nothing and never fired; a band is a line,
                       offered under "Compare with". *@
                    <div class="modal-row">
                        <label for="alert-zone">Zone:</label>
                        <select id="alert-zone" value="@_newAlertZone" @onchange="OnZonePicked">
                            @foreach (var z in ZonesOffered)
                            {
                                <option value="@z">@ZoneLabel(z)</option>
                            }
                        </select>
                    </div>
                }
                @if (UsesLevel)
                {
                    @if (LinesOffered.Count > 0)
                    {
                        <div class="modal-row">
                            <label for="alert-compare">Compare with:</label>
                            <select id="alert-compare" value="@_compareWith" @onchange="OnCompareWithPicked">
                                <option value="@CompareNumber">A number</option>
                                <option value="@CompareLine">A line on the chart</option>
                            </select>
                        </div>
                    }
                    @if (CompareToLine)
                    {
                        <div class="modal-row">
                            <label for="alert-line">Line:</label>
                            <select id="alert-line" value="@_newAlertLineKey" @onchange="OnLinePicked">
                                @foreach (var l in LinesOffered)
                                {
                                    <option value="@l.Key">@l.Label</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        @* A string, not a double: Blazor formats a bound double with the shortest
                           round-trip form, which is exponent notation below 0.0001 — a sub-cent
                           coin's 0.00001234 would read "1.234E-05". The hint says whether the
                           number is the live reading the form filled in or one the user typed. *@
                        <div class="modal-row">
                            <label for="alert-threshold">@(_newAlertTarget == AlertTarget.Indicator ? "Value:" : "Price level:")</label>
                            <input id="alert-threshold"
                                   type="number"
                                   step="any"
                                   aria-describedby="@(ThresholdHint != null ? "alert-threshold-hint" : null)"
                                   @bind="_newAlertThresholdText"
                                   @bind:after="OnThresholdTyped" />
                            @if (ThresholdHint != null)
                            {
                                <span id="alert-threshold-hint" style="font-size:0.85rem; color:var(--text-muted); margin-left:8px;">@ThresholdHint</span>
                            }
                        </div>
                    }
                }
                }
                <div class="modal-row">
                    <label for="alert-delivery">Delivery:</label>
                    <select id="alert-delivery" @bind="_newAlertDelivery">
                        <option value="@AlertDelivery.Speech">Speech</option>
                        <option value="@AlertDelivery.Earcon">Earcon</option>
                        <option value="@AlertDelivery.Both">Both</option>
                    </select>
                </div>
                <div class="modal-row">
                    <label for="alert-symbol">Symbol:</label>
                    <select id="alert-symbol" @bind="_newAlertScopeToSymbol">
                        <option value="true">This symbol (@(_currentSymbol ?? "current chart"))</option>
                        <option value="false">Any symbol</option>
                    </select>
                </div>
                <div class="modal-row">
                    <label for="alert-webhook">Webhook:</label>
                    <select id="alert-webhook" @bind="_newAlertWebhookTarget">
                        <option value="">— none —</option>
                        @foreach (var name in _webhookNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </div>
                <div style="margin-top: 12px; display: flex; gap: 8px; justify-content: flex-end;">
                    <GatedButton OnClick="AddAlert"
                            aria-label="Add alert"
                            class="primary"
                            Gate="AddAlertGate">
                        Add Alert
                    </GatedButton>
                </div>
            </div>

            <div style="margin-top: 24px; display: flex; gap: 8px; justify-content: flex-end;">
                @* Last in the dialog on purpose: the alert list and the add form are what
                   Alt+J is for, and a Tab order that reaches configuration before the thing
                   being configured is the wrong way round. *@
                <button id="alerts-delivery-open" @onclick="ShowDeliveryAsync">Delivery settings</button>
                <button @onclick="Close" aria-label="Close alerts dialog">Close</button>
            </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>Which of the dialog's two views is showing.</summary>
    private enum View { Alerts, Delivery }
    private View _view = View.Alerts;

    /// <summary>
    /// Into the delivery panel. Focus goes to its heading, which is what names the view to a
    /// screen reader — the dialog's own h2 still says "Alerts" and would not report the move.
    /// </summary>
    private async Task ShowDeliveryAsync()
    {
        _view = View.Delivery;
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "alerts-delivery-title"); }
        catch { /* focus is best-effort, exactly as in ShowModalAsync */ }
    }

    /// <summary>
    /// Back to the alert list, with focus returned to the button that left it.
    ///
    /// <para>
    /// The webhook list is re-read on the way back. Defining a webhook is the reason most
    /// people open the delivery panel from here at all, and without this the dropdown they
    /// came back to add it to would still be showing the list from before they defined it.
    /// </para>
    /// </summary>
    private async Task ShowAlertsAsync()
    {
        RefreshChartContext();
        _view = View.Alerts;
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "alerts-delivery-open"); }
        catch { /* focus is best-effort, exactly as in ShowModalAsync */ }
    }

    /// <summary>Null when the alert can be added; otherwise why it cannot.</summary>
    private string? AddAlertGate() =>
          string.IsNullOrWhiteSpace(_newAlertName) ? "Enter a name for this alert first."
        : _advancedCondition && _advancedSpec.Root == null
            ? "Build at least one condition, or switch back to a simple alert."
        // On the button, not only after it: the refusal used to come from WhyUnfireable at
        // click time, in record language ("it targets an indicator but names no indicator and
        // component"), with nothing on the field to go back to.
        : !_advancedCondition && _newAlertTarget == AlertTarget.Indicator && ChosenSeries == null
            ? (IndicatorSeries.Any() ? "Choose an indicator first." : "Add an indicator to the chart first; there is none to alert on.")
        : !_advancedCondition && _newAlertTarget == AlertTarget.Indicator && string.IsNullOrEmpty(_newAlertComponentName)
            ? "Choose a component first."
        : !_advancedCondition && UsesLevel && !CompareToLine && ParsedThreshold == null
            ? (_newAlertTarget == AlertTarget.Indicator ? "Enter a value first." : "Enter a price level first.")
        : null;

    private List<AlertDefinition> _activeAlerts = new();
    private string _newAlertName = "";
    private AlertTarget _newAlertTarget = AlertTarget.Price;

    // EFFECTIVE choices (what the form shows and the alert is built from) and the user's
    // WANTED ones (what they last picked). The effective one is the wanted one whenever the
    // list above it offers it, and the list's first entry otherwise — so a choice a passing
    // indicator could not have is put back when the next one can.
    private AlertCondition _newAlertCondition = AlertCondition.CrossesAbove;
    private AlertCondition _wantedCondition = AlertCondition.CrossesAbove;

    // The level as TEXT (see the input's comment), whether the user typed it, and the reading
    // the form last filled in — for the hint beside the field.
    private string _newAlertThresholdText = "";
    private bool _thresholdTyped;
    private double? _currentReading;

    // Indicator / component / zone selection. These three fields did not exist, which is
    // why every Target=Indicator and every zone alert was permanently silent. The indicator
    // is held by series ID since 2026-10-09 — by code, the picker could not tell an SMA 20
    // from an SMA 50 and offered only the first.
    private string _newAlertSeriesId = "";
    private string _chosenSeriesLabel = "";
    private string _newAlertComponentName = "";
    private string _wantedComponentName = "";
    private AlertZone _newAlertZone = AlertZone.Overbought;
    private AlertZone _wantedZone = AlertZone.Overbought;

    // "Compare with": a number, or one of the chart's lines ("seriesId|component").
    private const string CompareNumber = "number";
    private const string CompareLine = "line";
    private string _compareWith = CompareNumber;
    private string _wantedCompareWith = CompareNumber;
    private string _newAlertLineKey = "";
    private string _wantedLineKey = "";

    /// <summary>The typed level, or null when the field is empty or not a number.</summary>
    private double? ParsedThreshold =>
        double.TryParse(_newAlertThresholdText, System.Globalization.NumberStyles.Float,
                        System.Globalization.CultureInfo.InvariantCulture, out var v) && double.IsFinite(v)
            ? v : null;

    /// <summary>
    /// Said beside the Value field and read with it: whether the number is the live reading the
    /// form filled in or one the user typed, and what the reading is now. "Value: 55.3, spin
    /// button" alone cannot tell the two apart.
    /// </summary>
    private string? ThresholdHint => _currentReading is not { } now ? null
        : _thresholdTyped ? $"Current value {AlertDescriptions.FormatForSpeech(now)}."
        : $"Filled in with the current value, {AlertDescriptions.FormatForSpeech(now)}.";

    private bool IsZoneCondition =>
        _newAlertCondition is AlertCondition.EntersZone or AlertCondition.ExitsZone;

    // (IsTrendCondition used to sit here, showing the indicator picker for TrendChange — a
    // condition the list never offered, so it could never be true. "Changes direction" on an
    // indicator is that question now, asked of the component itself.)

    /// <summary>Whether the condition compares against a level — a number or a line.</summary>
    private bool UsesLevel =>
        _newAlertCondition is AlertCondition.CrossesAbove or AlertCondition.CrossesBelow or AlertCondition.Touches;

    private bool CompareToLine => _compareWith == CompareLine && LinesOffered.Count > 0;

    /// <summary>Codes that ARE the price, not an indicator on it: offering "Candles" as an
    /// indicator to alert on, or as a line for price to cross, is the price compared with itself.</summary>
    private static bool IsPriceItself(string code) =>
        code.ToUpperInvariant() is "CANDLES" or "PRICE" or "HEATMAP";

    /// <summary>Indicator series currently on the chart — the only ones an alert can read. Every
    /// instance, so two SMAs are two choices. Profiles are left out: their components are bins
    /// across price, not a value per bar.</summary>
    private IEnumerable<ChartSeries> IndicatorSeries =>
        Store.State.ActiveSeries
            .Where(s => !s.IsDrawing
                     && !string.IsNullOrEmpty(s.IndicatorCode)
                     && !IsPriceItself(s.IndicatorCode)
                     && !ProfileAnchoring.IsProfileCode(s.IndicatorCode)
                     && s.Components.Count > 0);

    private ChartSeries? ChosenSeries =>
        IndicatorSeries.FirstOrDefault(s => s.Id.Equals(_newAlertSeriesId, StringComparison.Ordinal));

    private IEnumerable<ComponentConfig> ComponentsOfChosenIndicator =>
        ChosenSeries?.Components ?? Enumerable.Empty<ComponentConfig>();

    private static string SeriesLabel(ChartSeries s) =>
        !string.IsNullOrWhiteSpace(s.FriendlyName) ? s.FriendlyName
        : !string.IsNullOrWhiteSpace(s.Name) ? s.Name : s.IndicatorCode;

    /// <summary>The zones the chosen component has — empty for anything without its own
    /// overbought / oversold lines (an SMA, a Bollinger band).</summary>
    private IReadOnlyList<AlertZone> ZonesOffered =>
        _newAlertTarget == AlertTarget.Indicator && ChosenSeries is { } s && !string.IsNullOrEmpty(_newAlertComponentName)
            ? AlertZones.For(s.Config, _newAlertComponentName)
            : Array.Empty<AlertZone>();

    /// <summary>
    /// The conditions that mean something for what is being watched. Price and candles cross,
    /// touch, and (candles) flip colour; they have no zones. An indicator crosses, touches and
    /// turns, and enters or exits a zone only when it HAS one.
    /// </summary>
    private IReadOnlyList<AlertCondition> ConditionsOffered
    {
        get
        {
            var list = new List<AlertCondition> { AlertCondition.CrossesAbove, AlertCondition.CrossesBelow, AlertCondition.Touches };
            if (_newAlertTarget is AlertTarget.Candle or AlertTarget.Indicator)
                list.Add(AlertCondition.ChangesDirection);
            if (ZonesOffered.Count > 0)
            {
                list.Add(AlertCondition.EntersZone);
                list.Add(AlertCondition.ExitsZone);
            }
            return list;
        }
    }

    private string ConditionLabel(AlertCondition c) => c switch
    {
        AlertCondition.CrossesAbove => "Crosses above",
        AlertCondition.CrossesBelow => "Crosses below",
        AlertCondition.Touches => _newAlertTarget == AlertTarget.Indicator
            ? "Touches (reaches the level from either side)"
            : "Touches (the bar's range reaches the level, wick included)",
        AlertCondition.ChangesDirection => _newAlertTarget == AlertTarget.Indicator
            ? "Changes direction (turns up or down)"
            : "Changes direction (candle colour flips)",
        AlertCondition.EntersZone => "Enters zone",
        AlertCondition.ExitsZone => "Exits zone",
        _ => c.ToString(),
    };

    private string ZoneLabel(AlertZone z)
    {
        double? at = ChosenSeries is { } s ? AlertZones.Threshold(s.Config, _newAlertComponentName, z) : null;
        string name = z == AlertZone.Overbought ? "Overbought" : "Oversold";
        if (at == null) return name;
        return $"{name}, {AlertDescriptions.FormatForSpeech(at.Value)} and {(z == AlertZone.Overbought ? "above" : "below")}";
    }

    private sealed record LineChoice(string Key, string Label, ChartSeries Series, ComponentConfig Component);

    /// <summary>What a line component looks like: drawn as a continuous value per bar. Markers,
    /// histograms and fills have a value but are not a line anything "touches".</summary>
    private static bool IsLine(ComponentConfig c) => c.DisplayType is
        ComponentDisplayType.Line or ComponentDisplayType.StepLine or ComponentDisplayType.Area
        or ComponentDisplayType.Gradient or ComponentDisplayType.Oscillator or ComponentDisplayType.ZeroArea;

    /// <summary>
    /// The lines a level can be. For price and candles, every line on the PRICE pane — moving
    /// averages, bands, VWAP — because only those are in price. For an indicator, the chosen
    /// indicator's own other lines: MACD against its signal, %K against %D.
    /// </summary>
    private IReadOnlyList<LineChoice> LinesOffered
    {
        get
        {
            IEnumerable<(ChartSeries S, ComponentConfig C)> pairs = _newAlertTarget == AlertTarget.Indicator
                ? (ChosenSeries is { } chosen
                    ? chosen.Components.Where(c => IsLine(c) && !c.Name.Equals(_newAlertComponentName, StringComparison.OrdinalIgnoreCase))
                                       .Select(c => (chosen, c))
                    : Enumerable.Empty<(ChartSeries, ComponentConfig)>())
                : IndicatorSeries.Where(s => AccessibleTrader.Core.Services.Accessibility.ChartPaneModel.KeyOf(s)
                                                 == AccessibleTrader.Core.Services.Accessibility.ChartPaneModel.MainPaneKey
                                             && !s.IndicatorCode.Equals("VOLUME", StringComparison.OrdinalIgnoreCase))
                                 .SelectMany(s => s.Components.Where(IsLine).Select(c => (s, c)));
            return pairs.Select(p => new LineChoice($"{p.S.Id}|{p.C.Name}", AlertDescriptions.LineName(p.S, p.C), p.S, p.C)).ToList();
        }
    }

    private LineChoice? ChosenLine => LinesOffered.FirstOrDefault(l => l.Key == _newAlertLineKey);

    // ── Keeping the cascade consistent ───────────────────────────────────────

    private AlertTarget _lastTarget = AlertTarget.Price;

    private static string TargetLabel(AlertTarget t) => t switch
    {
        AlertTarget.Price => "Price",
        AlertTarget.Candle => "Candle",
        AlertTarget.Indicator => "Indicator",
        _ => t.ToString(),
    };

    private static string ComponentLabel(ComponentConfig c) =>
        string.IsNullOrEmpty(c.DisplayName) ? c.Name : c.DisplayName;

    private static string TouchesMeaning(AlertTarget t) => t == AlertTarget.Indicator
        ? "reaching the level from either side"
        : "the bar's range reaching the level, wick included";

    private void OnTargetChanged()
    {
        // "Touches" is one option whose meaning depends on the target: a bar's range for price,
        // a reached-or-crossed value for an indicator. The option text changes with the target,
        // but a selected option's text changing is not announced by anything, so it is SAID.
        bool touchesMeaningChanged = _newAlertCondition == AlertCondition.Touches
            && (_lastTarget == AlertTarget.Indicator) != (_newAlertTarget == AlertTarget.Indicator);
        _lastTarget = _newAlertTarget;

        var said = ReconcileChoices();
        if (touchesMeaningChanged && _newAlertCondition == AlertCondition.Touches)
            said.Add($"Touches now means {TouchesMeaning(_newAlertTarget)}.");
        PrefillThreshold();
        Say(TargetLabel(_newAlertTarget), said);
    }

    private void OnIndicatorChanged()
    {
        _chosenSeriesLabel = ChosenSeries is { } s ? SeriesLabel(s) : "";

        // The component the user picked, if this indicator has it; else its first. A one-line
        // indicator has nothing to choose, so an SMA needs no second step — and nothing is said.
        var comps = ComponentsOfChosenIndicator.ToList();
        string before = _newAlertComponentName;
        var pick = comps.FirstOrDefault(c => c.Name.Equals(_wantedComponentName, StringComparison.OrdinalIgnoreCase))
                   ?? comps.FirstOrDefault();
        _newAlertComponentName = pick?.Name ?? "";

        var said = new List<string>();
        if (pick != null && comps.Count > 1 && !pick.Name.Equals(before, StringComparison.OrdinalIgnoreCase))
            said.Add(pick.Name.Equals(_wantedComponentName, StringComparison.OrdinalIgnoreCase)
                ? $"Component back to {ComponentLabel(pick)}."
                : $"Component set to {ComponentLabel(pick)}.");
        said.AddRange(ReconcileChoices());
        PrefillThreshold();
        Say(string.IsNullOrEmpty(_chosenSeriesLabel) ? "No indicator" : _chosenSeriesLabel, said);
    }

    private void OnComponentPicked(ChangeEventArgs e)
    {
        _newAlertComponentName = _wantedComponentName = e.Value?.ToString() ?? "";
        var said = ReconcileChoices();
        PrefillThreshold();
        var comp = ComponentsOfChosenIndicator.FirstOrDefault(c => c.Name.Equals(_newAlertComponentName, StringComparison.OrdinalIgnoreCase));
        Say(comp != null ? ComponentLabel(comp) : "No component", said);
    }

    private void OnConditionPicked(ChangeEventArgs e)
    {
        if (!Enum.TryParse<AlertCondition>(e.Value?.ToString(), out var c)) return;
        _newAlertCondition = _wantedCondition = c;
        Say(ConditionLabel(c), ReconcileChoices());
    }

    private void OnZonePicked(ChangeEventArgs e)
    {
        if (Enum.TryParse<AlertZone>(e.Value?.ToString(), out var z)) _newAlertZone = _wantedZone = z;
    }

    private void OnCompareWithPicked(ChangeEventArgs e)
    {
        _compareWith = _wantedCompareWith = e.Value?.ToString() == CompareLine ? CompareLine : CompareNumber;
        ReconcileChoices();
    }

    private void OnLinePicked(ChangeEventArgs e) => _newAlertLineKey = _wantedLineKey = e.Value?.ToString() ?? "";

    private void OnThresholdTyped() => _thresholdTyped = true;

    /// <summary>
    /// Brings every choice into line with the lists above it and returns what CHANGED, one
    /// sentence each — nothing is replaced silently. Each effective choice is the user's wanted
    /// one when the list offers it ("… back to …") and the list's first entry when it does not
    /// ("… changed to …"). Cody uses the form by ear: an option that silently changed under him
    /// ("Enters zone" becoming "Crosses above" when he moved from RSI to an SMA) is a different
    /// alert from the one he believes he set.
    /// </summary>
    private List<string> ReconcileChoices()
    {
        var said = new List<string>();

        if (_newAlertTarget == AlertTarget.Indicator && ChosenSeries == null && _newAlertSeriesId != "")
        {
            said.Add($"The indicator you chose, {_chosenSeriesLabel}, is no longer on the chart.");
            _newAlertSeriesId = "";
            _newAlertComponentName = "";
        }

        var conditions = ConditionsOffered;
        var condition = conditions.Contains(_wantedCondition) ? _wantedCondition : conditions[0];
        if (condition != _newAlertCondition)
        {
            said.Add(condition == _wantedCondition
                ? $"Condition back to {ConditionLabel(condition)}."
                : $"Condition changed to {ConditionLabel(condition)}.");
            _newAlertCondition = condition;
        }

        var zones = ZonesOffered;
        if (zones.Count > 0)
        {
            var zone = zones.Contains(_wantedZone) ? _wantedZone : zones[0];
            if (zone != _newAlertZone)
            {
                if (IsZoneCondition)
                    said.Add(zone == _wantedZone ? $"Zone back to {ZoneLabel(zone)}." : $"Zone changed to {ZoneLabel(zone)}.");
                _newAlertZone = zone;
            }
        }

        var lines = LinesOffered;
        string compare = lines.Count == 0 ? CompareNumber : _wantedCompareWith;
        if (compare != _compareWith)
        {
            if (UsesLevel)
                said.Add(compare == CompareLine
                    ? "Compare with back to a line on the chart."
                    : "Compare with changed to a number, because there is no line to compare with.");
            _compareWith = compare;
        }
        string lineKey = lines.Any(l => l.Key == _wantedLineKey) ? _wantedLineKey : lines.FirstOrDefault()?.Key ?? "";
        if (lineKey != _newAlertLineKey)
        {
            if (UsesLevel && _compareWith == CompareLine && _newAlertLineKey != "" && lineKey != "")
            {
                string label = lines.First(l => l.Key == lineKey).Label;
                said.Add(lineKey == _wantedLineKey ? $"Line back to {label}." : $"Line changed to {label}.");
            }
            _newAlertLineKey = lineKey;
        }
        return said;
    }

    /// <summary>
    /// One utterance for one change of a select, led by what the user landed on. Not
    /// interrupting, and complete either way: on the desktop path it queues after the screen
    /// reader's reading of the option; in the browser, where the live region is assertive and
    /// may cut that reading off, the sentence itself still says where the user is.
    /// </summary>
    private void Say(string? landedOn, List<string> said)
    {
        if (said.Count == 0) return;
        string text = string.Join(" ", said);
        if (!string.IsNullOrEmpty(landedOn)) text = $"{landedOn}. {text}";
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, text, Interrupt: false,
            Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
    }

    /// <summary>
    /// The value field starts at what is being watched is worth NOW: the last close for price
    /// and candles, the component's live value for an indicator. It used to start at 0 —
    /// Cody: "I expect the current price of that indicator to be filled in". A number the user
    /// TYPED is never overwritten — not by a change of target, indicator or component, not by
    /// reopening the dialog — until an alert is added with it; the hint beside the field still
    /// reports the current reading.
    /// </summary>
    private void PrefillThreshold()
    {
        var state = Store.State;
        int live = (state.Data?.Count ?? 0) - 1;
        double value = double.NaN;
        if (_newAlertTarget == AlertTarget.Indicator)
        {
            if (ChosenSeries is { } s && !string.IsNullOrEmpty(_newAlertComponentName))
            {
                var data = s.GetComponentData(_newAlertComponentName);
                // The live bar — not the reading cursor — or the newest value the series has.
                if (data.Length > 0) value = live >= 0 && live < data.Length ? data[live] : data[^1];
            }
        }
        else if (live >= 0)
        {
            value = state.Data![live].Close;
        }
        _currentReading = double.IsFinite(value) ? value : null;
        if (_currentReading == null || _thresholdTyped) return;
        _newAlertThresholdText = AlertDescriptions.FormatForInput(value);
    }
    private AlertDelivery _newAlertDelivery = AlertDelivery.Both;
    private bool _newAlertBreakThrough;

    // Part A — symbol scoping. Default a new alert to the on-screen chart's symbol.
    private bool _newAlertScopeToSymbol = true;
    private string? _currentSymbol;
    // Part B — per-asset webhook routing target ("" = none).
    private string _newAlertWebhookTarget = "";
    private List<string> _webhookNames = new();

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        // _eventSub is declared in ModalBase and disposed there automatically.
        _eventSub = EventBus.Subscribe<OpenAlertsEvent>(_ => InvokeAsync(ShowAsync));
        RefreshAlerts();
    }

    private async Task ShowAsync()
    {
        // Alt+J is "show me my alerts", every time. A dialog that reopens on whatever panel
        // it was left on makes the shortcut's destination depend on history.
        _view = View.Alerts;
        RefreshAlerts();
        RefreshChartContext();
        // The chart may have changed since the form was last open — an indicator removed, the
        // price moved — so the choices are re-checked and an untyped value starts at today's.
        // What the re-check replaced is said AFTER the heading has been focused, and without
        // interrupting it, so the dialog's name is not cut off by its own form.
        var replaced = ReconcileChoices();
        PrefillThreshold();
        await ShowModalAsync("alerts-title");
        Say(null, replaced);
    }

    private void RefreshChartContext()
    {
        var sym = Store.State.SymbolDisplayName;
        _currentSymbol = string.IsNullOrWhiteSpace(sym) ? null : sym;
        // Populate the webhook-target dropdown from the configured named webhooks
        // (migrating a legacy single URL to "Default").
        _webhookNames = AccessibleTrader.Core.Services.Alerts.WebhookAlertConfigLoader
            .ParseWebhooks(
                Settings.GetSetting("alerts.webhooks"),
                Settings.GetSetting("alerts.webhook.url")?.ToString(),
                Settings.GetSetting("alerts.webhook.authHeader")?.ToString())
            .Select(w => w.Name)
            .ToList();
        // Drop a stale selection if the named webhook no longer exists.
        if (!string.IsNullOrEmpty(_newAlertWebhookTarget) && !_webhookNames.Contains(_newAlertWebhookTarget))
            _newAlertWebhookTarget = "";
    }

    private void Close() => CloseModal();

    protected override string ModalName => "Alerts";

    private void RefreshAlerts()
    {
        _activeAlerts = AlertOrchestrator.GetAlerts().ToList();
    }

    private void AddAlert()
    {
        if (string.IsNullOrWhiteSpace(_newAlertName)) return;

        // Advanced mode: the tree REPLACES the simple rule. Target/Condition are
        // required record fields, so they carry placeholder values the evaluator
        // never consults when ConditionTree is set.
        var tree = _advancedCondition ? _advancedSpec.BuildConditionTree() : null;
        if (_advancedCondition && tree == null) return;

        // Stamp the full chart identity, not just the symbol. The background
        // monitors fetch by (provider, market, symbol, timeframe); with only a
        // Symbol on the record, DeriveWatches had nothing to fetch by, so an
        // alert created here was never watchable with the browser closed at all.
        var identity = Store.State.Identity;
        var chosen = _newAlertTarget == AlertTarget.Indicator && !_advancedCondition ? ChosenSeries : null;
        var line = !_advancedCondition && UsesLevel && CompareToLine ? ChosenLine : null;

        var def = new AlertDefinition
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newAlertName,
            Target = _newAlertTarget,
            Condition = _newAlertCondition,
            // A number only where the condition compares against one and no line was chosen —
            // "changes direction 0" in the alert list was the form's leftover, not the rule.
            Threshold = _advancedCondition || !UsesLevel || line != null ? null : ParsedThreshold,
            LineIndicatorCode = line?.Series.IndicatorCode,
            LineComponentName = line?.Component.Name,
            LineSeriesId = line?.Series.Id,
            Delivery = _newAlertDelivery,
            // Scope to the current chart (null = any) and route to the chosen webhook.
            Symbol = _newAlertScopeToSymbol ? _currentSymbol : null,
            Provider = _newAlertScopeToSymbol ? identity.Provider : null,
            Timeframe = _newAlertScopeToSymbol ? identity.Timeframe : null,
            Market = _newAlertScopeToSymbol ? identity.Market : null,
            WebhookTarget = string.IsNullOrWhiteSpace(_newAlertWebhookTarget) ? null : _newAlertWebhookTarget,
            ConditionTree = tree,
            BreakThroughMutes = _newAlertBreakThrough,
            // These three were never set. AlertEvaluator's Indicator arm requires both
            // IndicatorCode and ComponentName, and EvaluateZone returns false immediately for
            // a null IndicatorCode — so every Target=Indicator and every zone alert built here
            // was permanently silent while the modal said it worked.
            IndicatorCode = chosen?.IndicatorCode,
            ComponentName = chosen == null || string.IsNullOrWhiteSpace(_newAlertComponentName) ? null : _newAlertComponentName,
            SeriesId = chosen?.Id,
            Zone = IsZoneCondition && !_advancedCondition ? _newAlertZone : null,
        };

        // REFUSE an alert that cannot fire, rather than adding it and calling it live.
        // "Your alert is watching the market" is the single claim this app must never make
        // falsely, because a user who believes it stops watching themselves. Against THIS
        // chart, so "SMA enters overbought" — no SMA has an overbought line — is refused too.
        var unfireable = BackgroundWatchability.WhyUnfireable(def, Store.State.ActiveSeries.Select(s => s.Config));
        if (unfireable != null)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error,
                $"Alert not added: {unfireable}.", true));
            return;
        }

        AlertOrchestrator.AddAlert(def);

        // If the background monitors cannot evaluate this alert, SAY so now —
        // the alternative is a user closing the browser believing an alert is
        // watching the market when it is not, which is the worst failure this
        // app has. The alert still works while its chart is open.
        // On a host with no background alerts at all (the paper-only hosted terminal), the
        // caveat would describe a monitor that does not exist there — so it is not said.
        // Against THIS chart's series: a point-of-control alert needs a profile on it.
        var unwatchableReason = Demo.AllowBackgroundAlerts
            ? AccessibleTrader.Core.Services.Alerts.BackgroundWatchability.WhyUnwatchable(
                def, Store.State.ActiveSeries.Select(s => s.Config))
            : null;
        // Says what the alert WILL DO, not only that it exists: "Alert Big move added: BTC/USD
        // price touches SMA 50." The form is filled in by ear, and this sentence is the one
        // check that the cascade of choices landed where the user meant.
        string added = def.ConditionTree != null
            ? $"Alert {def.Name} added."
            : $"Alert {def.Name} added: {AlertDescriptions.Describe(def, Store.State.ActiveSeries)}.";
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            unwatchableReason == null
                ? added
                : $"{added} It works while this chart is open, but background " +
                  $"and server-side monitoring cannot watch it: {unwatchableReason}.", Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
        _newAlertName = "";
        // The typed number has been used; the next alert starts from the live reading again.
        _thresholdTyped = false;
        PrefillThreshold();
        if (_advancedCondition) _advancedSpec = new Core.Services.Strategies.EditableStrategySpec();
        RefreshAlerts();
        StateHasChanged();
    }

    // ── Part D: advanced condition tree ──────────────────────────────────────
    private bool _advancedCondition;
    private Core.Services.Strategies.EditableStrategySpec _advancedSpec = new();

    private void OnAdvancedToggled(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _advancedCondition = e.Value is bool b && b;
        StateHasChanged();
    }

    /// <summary>
    /// Deletes an alert, says so, and puts focus somewhere that still exists.
    ///
    /// <para>
    /// It used to do only the first of those. The button taking the click was inside the row
    /// being removed, so focus fell to <c>&lt;body&gt;</c> — a screen-reader user landed at the
    /// top of the document with nothing spoken and no way to tell whether the alert was gone.
    /// No confirmation, though: an alert is re-creatable from the form directly below, and a
    /// prompt on every delete is a tax on the common case. The API key profile next door is
    /// the one that cannot be re-created, and that is the one that asks.
    /// </para>
    /// </summary>
    private async Task DeleteAlert(string id, int rowIndex)
    {
        // Read the name BEFORE the removal — afterwards there is nothing to read it from.
        string name = _activeAlerts.FirstOrDefault(a => a.Id == id)?.Name ?? "Alert";

        AlertOrchestrator.RemoveAlert(id);
        RefreshAlerts();
        StateHasChanged();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _activeAlerts.Count == 0
                ? $"Alert {name} deleted. No active alerts remain."
                : $"Alert {name} deleted.", Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));

        await Task.Yield();
        // The row that took this one's place, or the last row when the deleted alert was at
        // the end. With none left the list is gone entirely, so the add form's first field is
        // the nearest thing still on screen.
        string target = _activeAlerts.Count > 0
            ? $"alert-delete-{Math.Min(rowIndex, _activeAlerts.Count - 1)}"
            : "alert-name";
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", target); }
        catch { /* focus is best-effort, exactly as in ShowModalAsync */ }
    }
}
