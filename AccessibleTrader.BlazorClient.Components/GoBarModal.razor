@*
    Alt+G — the Go bar. One text box that reaches every action in the terminal by typing.
    The registry lives in Core, so the desktop and the browser get the same commands.

    ARIA 1.2 combobox: DOM focus stays in the input, and aria-activedescendant names the
    active option. Down/Up move the active option, Tab completes to its canonical text,
    Enter runs it; Escape closes through the dispatcher like every dialog. The polite read is
    the sentence from the SAME suggestion object that produced the rendered options, 500 ms
    after the last keystroke, on the Interface tier so neither F2 nor Shift+F2 silences what
    was asked for.

    Stage 6b: the list holds options, not only 6a entries. An argument option renders its own
    spoken name ("Timeframe 4 hours", "Open MEXC BTCUSDT", "Add RSI") and Tab completes the
    canonical text the service would re-resolve ("TF 4h", "GP BTCUSDT", "IND RSI").
*@
@inherits ModalBase
@using AccessibleTrader.Core.Services.GoBar
@inject GoBarService GoBar
@inject IServiceProvider Services

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="CloseModal">
        <div class="modal-content"
             role="dialog" data-modal-name="GoBar"
             aria-modal="true"
             aria-labelledby="gobar-title"
             style="width: min(680px, 90vw); max-height: calc(100vh - 120px); overflow-y: auto;"
             @onclick:stopPropagation="true">

            <h2 id="gobar-title" tabindex="-1">Go</h2>

            <label for="gobar-input">Type a command</label>
            <input id="gobar-input"
                   type="text"
                   autocomplete="off"
                   role="combobox"
                   aria-autocomplete="list"
                   aria-expanded="@(_options.Count > 0 ? "true" : "false")"
                   aria-controls="gobar-list"
                   aria-activedescendant="@(_activeIndex >= 0 ? $"gobar-opt-{_activeIndex}" : null)"
                   value="@_input"
                   @oninput="OnInput"
                   @onkeydown="OnKeyDown"
                   @onfocus="() => _focused = true"
                   @onblur="() => _focused = false"
                   style="width: 100%; box-sizing: border-box; font-size: 1rem; padding: 6px 8px; @(_focused ? "outline: 3px solid var(--accent-color); outline-offset: 2px;" : "")" />

            <ul id="gobar-list" role="listbox" aria-label="Command suggestions"
                style="list-style: none; padding: 0; margin: 12px 0 0 0; overflow-wrap: anywhere;">
                @for (int i = 0; i < _options.Count; i++)
                {
                    var index = i;
                    var option = _options[i];
                    <li role="option"
                        id="@($"gobar-opt-{index}")"
                        aria-selected="@(index == _activeIndex ? "true" : "false")"
                        style="padding: 6px 8px; border-bottom: 1px solid var(--border-color); @(index == _activeIndex ? "background: color-mix(in srgb, var(--accent-color) 26%, transparent); font-weight: bold;" : "")"
                        @onmousedown:preventDefault="true"
                        @onclick="() => Choose(index, explicitlyChosen: true)">
                        <span>@option.Name</span>
                        @if (!string.IsNullOrEmpty(option.Help))
                        {
                            <span> — @option.Help</span>
                        }
                        @if (option.Entry is { } entry && GoBar.KeyLabel(entry.Command) is { } key)
                        {
                            <span> — @key</span>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private GoBarSuggestion _suggestion = new(Array.Empty<GoBarOption>(), "");
    private List<GoBarOption> _options = new();
    private int _activeIndex = -1;
    private string _input = "";
    private bool _focused;

    /// <summary>
    /// True once the user has moved onto an option with Up/Down (or clicked one). It is what
    /// lets the several-symbols rule distinguish Enter on the top match from a deliberate pick,
    /// and typing resets it.
    /// </summary>
    private bool _hasArrowed;

    private IDisposable? _closeSub;
    private IDisposable? _completeSub;
    private CancellationTokenSource? _readCts;
    private TimeProvider? _clock;

    /// <summary>The clock the 500 ms polite read waits on. Optional so the harness can
    /// substitute it; the real heads register TimeProvider.System.</summary>
    private TimeProvider Clock
        => _clock ??= Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;

    // ModalName stays "GoBar" (GoBarService and the modal stack match on it); heard as its heading.
    protected override string? SpokenModalName => "Go";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _eventSub = EventBus.Subscribe<OpenGoBarEvent>(e => InvokeAsync(() => ShowAsync(e.Text)));
        _closeSub = EventBus.Subscribe<CloseGoBarRequestEvent>(_ => InvokeAsync(() =>
        {
            if (_isVisible) CloseModal();
        }));
        // A bare verb asks for its value: complete the text, keep the box open.
        _completeSub = EventBus.Subscribe<GoBarCompleteRequestEvent>(e => InvokeAsync(() =>
        {
            if (!_isVisible) return;
            _input = e.Text ?? "";
            RefreshMatches();
            StartPoliteRead();
            _ = FocusInputAsync();
        }));
    }

    private async Task ShowAsync(string? text = null)
    {
        _input = "";
        _suggestion = new GoBarSuggestion(Array.Empty<GoBarOption>(), "");
        _options = new();
        _activeIndex = -1;
        _hasArrowed = false;
        _focused = false;
        CancelPoliteRead();
        await ShowModalAsync("gobar-title");

        // Opened with text already typed (NEWS from its own command): list it and read the
        // sentence, exactly as when a bare verb completes.
        if (!string.IsNullOrEmpty(text))
        {
            _input = text;
            RefreshMatches();
            StartPoliteRead();
        }

        // The user opened this to type. The heading names the box for the screen reader; the
        // input is where the hands belong.
        await FocusInputAsync();
    }

    private async Task FocusInputAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "gobar-input"); }
        catch { /* focus is best-effort; Tab still reaches it */ }
    }

    private void OnInput(ChangeEventArgs e)
    {
        _input = e.Value?.ToString() ?? "";
        _hasArrowed = false;
        RefreshMatches();
        StartPoliteRead();
    }

    private void RefreshMatches()
    {
        _suggestion = GoBar.Suggest(_input);
        _options = _suggestion.Options.ToList();
        _activeIndex = _options.Count > 0 ? 0 : -1;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.AltKey || e.CtrlKey || e.MetaKey) return;

        switch (e.Key)
        {
            case "ArrowDown":
                MoveActive(1);
                break;
            case "ArrowUp":
                MoveActive(-1);
                break;
            case "Tab":
                if (e.ShiftKey) return; // leave reverse focus order alone
                CompleteActive();
                break;
            case "Enter":
                RunActiveOrTop();
                break;
            // Escape is not handled here: keyboard.js always sends it to the dispatcher, even
            // from a text field, and the dispatcher closes the top dialog. A second close here
            // would publish a second "closed".
        }
    }

    private void MoveActive(int direction)
    {
        if (_options.Count == 0) return;
        _hasArrowed = true;

        if (_activeIndex < 0) _activeIndex = 0;
        else _activeIndex = (_activeIndex + direction + _options.Count) % _options.Count;
    }

    private void CompleteActive()
    {
        var option = ActiveOption();
        if (option == null) return;

        string? canonical = option.CanonicalText;
        if (string.IsNullOrEmpty(canonical)) return;

        _input = canonical;
        _hasArrowed = false;
        RefreshMatches();
        _ = FocusInputAsync();
    }

    private void RunActiveOrTop()
    {
        var option = ActiveOption();
        if (option == null)
        {
            // Use the SAME suggestion object the list rendered, not a second parse: two
            // calls can disagree once arguments exist.
            if (!string.IsNullOrEmpty(_suggestion.Sentence))
            {
                EventBus.Publish(new AnnouncementEvent(
                    _suggestion.Sentence, Interrupt: true, Channel: SpeechChannel.Interface));
            }
            return;
        }

        int index = _activeIndex >= 0 && _activeIndex < _options.Count ? _activeIndex : 0;
        Choose(index, explicitlyChosen: _hasArrowed);
    }

    private GoBarOption? ActiveOption()
    {
        if (_options.Count == 0) return null;
        int index = _activeIndex >= 0 && _activeIndex < _options.Count ? _activeIndex : 0;
        return _options[index];
    }

    private void Choose(int index, bool explicitlyChosen)
    {
        if (index < 0 || index >= _options.Count) return;
        GoBar.Run(_options[index], explicitlyChosen);
    }

    // ── The polite read ─────────────────────────────────────────────────────

    private void StartPoliteRead()
    {
        CancelPoliteRead();
        if (string.IsNullOrWhiteSpace(_input)) return;

        var cts = new CancellationTokenSource();
        _readCts = cts;
        _ = PoliteReadAsync(_suggestion, cts.Token);
    }

    private async Task PoliteReadAsync(GoBarSuggestion suggestion, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(500), Clock, token);
            if (token.IsCancellationRequested) return;

            string sentence = suggestion.Sentence;
            if (string.IsNullOrEmpty(sentence)) return;

            await InvokeAsync(() =>
            {
                if (token.IsCancellationRequested) return;
                // Not an interruption: the screen reader has just read the option the user is
                // standing on; this is the polite summary of what the box offers.
                EventBus.Publish(new AnnouncementEvent(
                    sentence, Interrupt: false, Channel: SpeechChannel.Interface));
            });
        }
        catch (OperationCanceledException)
        {
            // A new keystroke replaced this read.
        }
    }

    private void CancelPoliteRead()
    {
        if (_readCts == null) return;
        try { _readCts.Cancel(); } catch { /* already gone */ }
        _readCts.Dispose();
        _readCts = null;
    }

    public override void Dispose()
    {
        CancelPoliteRead();
        _closeSub?.Dispose();
        _completeSub?.Dispose();
        base.Dispose();
    }
}
