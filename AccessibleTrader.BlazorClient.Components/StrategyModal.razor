@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Strategies
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.BlazorClient.Services
@inject IStrategyModalCoordinator Coordinator
@inject IStrategyLibrary StrategyLibrary
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject AccessibleTrader.Core.Services.Strategies.ILabRunner LabRunner
@implements IDisposable

@if (_isVisible)
{
    @* Click outside the inner panel to close. *@
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="strategy-title"
             @onclick:stopPropagation="true">

            <h2 id="strategy-title" tabindex="-1">
                Strategy Manager
                <span style="font-size: 0.7rem; font-weight: 700; color: #ffb300; border: 1px solid #665500; background: #332a00; border-radius: 4px; padding: 1px 6px; margin-left: 8px; vertical-align: middle;">EXPERIMENTAL</span>
            </h2>
            <p role="note" style="margin: 6px 0 0; font-size: 0.85rem; color: #c9a227;">
                Experimental feature. Strategies and backtests are research tools — backtested
                results do not guarantee live performance, and known biases have been found and
                fixed over time. Treat signals as exploratory, not advice.
            </p>

            @* ── Tab navigation ────────────────────────────────────────────────── *@
            <div role="tablist" aria-label="Strategy sections" style="display: flex; gap: 4px; margin-top: 16px; border-bottom: 1px solid var(--border-color); padding-bottom: 4px;">
                <button role="tab"
                        id="tab-library"
                        aria-selected="@(_activeTab == "library")"
                        aria-controls="panel-library"
                        @onclick='() => _activeTab = "library"'
                        style="padding: 6px 14px; background: @(_activeTab == "library" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Library (@StrategyLibrary.All.Count)
                </button>
                <button role="tab"
                        id="tab-build"
                        aria-selected="@(_activeTab == "build")"
                        aria-controls="panel-build"
                        @onclick='() => _activeTab = "build"'
                        style="padding: 6px 14px; background: @(_activeTab == "build" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Build Setup
                </button>
                <button role="tab"
                        id="tab-active"
                        aria-selected="@(_activeTab == "active")"
                        aria-controls="panel-active"
                        @onclick='() => _activeTab = "active"'
                        style="padding: 6px 14px; background: @(_activeTab == "active" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Active (@Coordinator.ActiveStrategies.Count())
                </button>
                <button role="tab"
                        id="tab-bt"
                        aria-selected="@(_activeTab == "bt")"
                        aria-controls="panel-bt"
                        @onclick='() => _activeTab = "bt"'
                        style="padding: 6px 14px; background: @(_activeTab == "bt" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Backtest
                </button>
                <button role="tab"
                        id="tab-lab"
                        aria-selected="@(_activeTab == "lab")"
                        aria-controls="panel-lab"
                        @onclick='() => _activeTab = "lab"'
                        style="padding: 6px 14px; background: @(_activeTab == "lab" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Lab
                </button>
                <button role="tab"
                        id="tab-custom"
                        aria-selected="@(_activeTab == "custom")"
                        aria-controls="panel-custom"
                        @onclick='() => _activeTab = "custom"'
                        style="padding: 6px 14px; background: @(_activeTab == "custom" ? "#2a4a7f" : "transparent"); border: none; color: #ccc; cursor: pointer; border-radius: 4px 4px 0 0;">
                    Custom Script
                </button>
            </div>

            @* ── Build Setup tab — no-code composer (Phase 11 Session D) ───────── *@
            <section id="panel-build" role="tabpanel" aria-labelledby="tab-build"
                     hidden="@(_activeTab != "build")" style="margin-top: 20px;">
                @if (_activeTab == "build")
                {
                    <BuildSetupTab />
                }
            </section>

            @* ── Library tab ──────────────────────────────────────────────────── *@
            <section id="panel-library" role="tabpanel" aria-labelledby="tab-library"
                     hidden="@(_activeTab != "library")" style="margin-top: 20px;">
                <h3>Strategy Library</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem;">
                    Specs you've built in the Build Setup tab. Start a spec to begin running it
                    against live data; on next launch, every started spec is automatically restored.
                    Stopped specs remain in the library as templates you can edit and re-run later.
                </p>

                @if (StrategyLibrary.All.Count == 0)
                {
                    <p style="color: var(--text-muted); margin-top: 16px;">
                        No saved strategies yet. Switch to <strong>Build Setup</strong> to compose one.
                    </p>
                }
                else
                {
                    @* No recommendation is offered here, deliberately. The terminal ships the
                       TOOLS; which strategy to run is the user's decision. The auto-pick that
                       used to live here selected a Cipher-B variant per asset, and Cipher
                       confluence is one of the things the research lab specifically falsified —
                       an automatic suggestion built on a tested-null component is worse than a
                       plain list the user chooses from. See docs/STRATEGY_LIBRARY_POLICY.md. *@
                    <table style="width: 100%; table-layout: fixed; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                @* Explicit widths because the Description column holds several
                                   sentences and, left to itself, took the whole table — Name,
                                   Side and Status were rendering one character per line. *@
                                <th scope="col" style="text-align: left; padding: 4px 8px; width: 18%; min-width: 9em;">Name</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px; width: 7%; white-space: nowrap;">Side</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px; width: 9%; white-space: nowrap;">Status</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px;">Description</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px; width: 14%; white-space: nowrap;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var spec in StrategyLibrary.All)
                            {
                                bool isActive = Coordinator.ActiveStrategies.Any(a =>
                                    string.Equals(a.Strategy.Id, spec.Id, StringComparison.OrdinalIgnoreCase));
                                <tr @key="spec.Id" style="border-bottom: 1px solid #333;">
                                    <td style="padding: 6px 8px;">@spec.Name</td>
                                    <td style="padding: 6px 8px;">@spec.Side</td>
                                    <td style="padding: 6px 8px; color: @(isActive ? "#6f6" : "#888");">
                                        @(isActive ? "Active" : "Stopped")
                                    </td>
                                    <td style="padding: 6px 8px; color: var(--text-muted);">@spec.Description</td>
                                    <td style="padding: 6px 8px; white-space: nowrap;">
                                        @if (isActive)
                                        {
                                            <button @onclick="() => StopSpec(spec.Id)"
                                                    aria-label="Stop @spec.Name and clear auto-activate flag">
                                                Stop
                                            </button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => StartSpec(spec.Id)"
                                                    aria-label="Start @spec.Name and mark auto-activate so it runs on next launch">
                                                Start
                                            </button>
                                        }
                                        <button @onclick="() => DeleteSpec(spec.Id)"
                                                aria-label="Permanently delete @spec.Name from the library"
                                                style="margin-left: 6px;">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (!string.IsNullOrEmpty(_libraryMessage))
                {
                    <p role="status" style="margin-top: 8px; color: @(_libraryError ? "#f44" : "#4a4");">
                        @_libraryMessage
                    </p>
                }
            </section>

            @* ── Active strategies ─────────────────────────────────────────────── *@
            <section id="panel-active" role="tabpanel" aria-labelledby="tab-active"
                     hidden="@(_activeTab != "active")" style="margin-top: 20px;">
                <h3>Active Strategies</h3>

                @if (Coordinator.ActiveStrategies.Any())
                {
                    <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 0.9rem;">
                        <thead>
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <th scope="col" style="text-align: left; padding: 4px 8px;">Name</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px;">Mode</th>
                                <th scope="col" style="text-align: right; padding: 4px 8px;">Signals</th>
                                <th scope="col" style="text-align: right; padding: 4px 8px;">Win Rate</th>
                                <th scope="col" style="text-align: right; padding: 4px 8px;">P&amp;L</th>
                                <th scope="col" style="text-align: right; padding: 4px 8px;">Drawdown</th>
                                <th scope="col" style="text-align: left; padding: 4px 8px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var active in Coordinator.ActiveStrategies)
                            {
                                var m = active.Strategy.GetMetrics();
                                <tr @key="active.InstanceId" style="border-bottom: 1px solid #333;">
                                    <td style="padding: 6px 8px;">
                                        @active.Strategy.Name
                                        @if (active.IsPaused)
                                        {
                                            <span style="color: #fa0; font-size: 0.8rem;"> (paused)</span>
                                        }
                                    </td>
                                    <td style="padding: 6px 8px;">@active.ExecutionMode</td>
                                    <td style="padding: 6px 8px; text-align: right;">@m.TotalSignals</td>
                                    <td style="padding: 6px 8px; text-align: right;">
                                        @(m.TotalSignals == 0 ? "—" : m.WinRate.ToString("P1"))
                                    </td>
                                    <td style="padding: 6px 8px; text-align: right;">
                                        @(m.TotalSignals == 0 ? "—" : PriceFormatter.FormatPnL(m.TotalPnL))
                                    </td>
                                    <td style="padding: 6px 8px; text-align: right;">
                                        @(m.TotalSignals == 0 ? "—" : m.MaxDrawdown.ToString("P2"))
                                    </td>
                                    <td style="padding: 6px 8px; white-space: nowrap;">
                                        <button @onclick="() => TogglePause(active.InstanceId, active.IsPaused)"
                                                aria-label="@(active.IsPaused ? "Resume" : "Pause") @active.Strategy.Name strategy">
                                            @(active.IsPaused ? "Resume" : "Pause")
                                        </button>
                                        <button @onclick="() => RemoveStrategy(active.InstanceId)"
                                                aria-label="Remove @active.Strategy.Name strategy"
                                                style="margin-left: 6px;">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p style="color: var(--text-muted); margin-top: 10px;">
                        No active strategies. Switch to the <strong>Library</strong> tab and click
                        Start on a saved spec, or compose a new one in <strong>Build Setup</strong>.
                    </p>
                }
            </section>

            @* ── Backtester ────────────────────────────────────────────────────── *@
            <section id="panel-bt" role="tabpanel" aria-labelledby="tab-bt"
                     hidden="@(_activeTab != "bt")" style="margin-top: 20px;">
                <h3>Backtest</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 12px;">
                    Runs the selected library spec against the currently loaded price data with
                    full TP / stop / VPVR replay correctness.
                </p>

                <div style="display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end;">
                    <div>
                        <label for="bt-spec">Strategy:</label>
                        <select id="bt-spec"
                                value="@_btSelectedSpecId"
                                @onchange="e => _btSelectedSpecId = e.Value?.ToString() ?? string.Empty">
                            <option value="">— Select a saved spec —</option>
                            @foreach (var s in StrategyLibrary.All)
                            {
                                <option @key="s.Id" value="@s.Id">@s.Name (@s.Side)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label for="bt-capital">Starting Capital:</label>
                        <input id="bt-capital" type="number" step="any" min="1"
                               value="@_btCapital"
                               @onchange="e => double.TryParse(e.Value?.ToString(), out _btCapital)" />
                    </div>
                    <div>
                        <label for="bt-commission">Commission (%):</label>
                        <input id="bt-commission" type="number" step="0.01" min="0" max="5"
                               value="@(_btCommission * 100)"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _btCommission = v / 100.0; }" />
                    </div>
                    <div>
                        <label for="bt-slippage">Slippage (%):</label>
                        <input id="bt-slippage" type="number" step="0.01" min="0" max="5"
                               value="@(_btSlippage * 100)"
                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) _btSlippage = v / 100.0; }" />
                    </div>
                    <div>
                        <label for="bt-warmup">Warmup bars:</label>
                        <input id="bt-warmup" type="number" step="10" min="0" max="2000"
                               value="@_btWarmup"
                               title="Bars at the start of the data range that are fed to the strategy but generate no signals — lets indicators converge before evaluation begins."
                               @onchange="e => int.TryParse(e.Value?.ToString(), out _btWarmup)" />
                        <button type="button" @onclick="AutoWarmup"
                                aria-label="Auto-detect recommended warmup from the selected ConfigurableStrategy spec"
                                title="Walks the spec's condition tree, queries each indicator's stability window, and sets warmup to max × 1.2.">
                            Auto
                        </button>
                    </div>
                    <div>
                        <label for="bt-startdate">Start date (optional):</label>
                        <input id="bt-startdate" type="date"
                               value="@(_btStartDate?.ToString("yyyy-MM-dd"))"
                               title="Bars before this date are dropped from the run entirely. Leave blank to use the earliest loaded bar."
                               @onchange="e => _btStartDate = ParseDate(e.Value?.ToString())" />
                    </div>
                    <div>
                        <label for="bt-enddate">End date (optional):</label>
                        <input id="bt-enddate" type="date"
                               value="@(_btEndDate?.ToString("yyyy-MM-dd"))"
                               title="Bars after this date are dropped from the run entirely. Leave blank to use the latest loaded bar."
                               @onchange="e => _btEndDate = ParseDate(e.Value?.ToString())" />
                    </div>
                    <div style="display: flex; gap: 6px; align-items: center;">
                        <button type="button" @onclick="WalkForwardFirstHalf"
                                aria-label="Set date range to the first half of the loaded data for walk-forward testing"
                                title="Splits the loaded chart data in half by time and sets the date range to the earlier half. Run the backtest, note the metrics, then click 'Last half' and run again to compare across regimes.">
                            Walk-fwd: first half
                        </button>
                        <button type="button" @onclick="WalkForwardLastHalf"
                                aria-label="Set date range to the last half of the loaded data for walk-forward testing"
                                title="Sets the date range to the later half of the loaded data. Pair with 'first half' to detect time-localized edge decay.">
                            Walk-fwd: last half
                        </button>
                        <button type="button" @onclick="ClearDateRange"
                                aria-label="Clear the date range filter and use all loaded bars">
                            Clear range
                        </button>
                    </div>
                    <button class="primary"
                            @onclick="RunBacktestAsync"
                            disabled="@(_btRunning || string.IsNullOrEmpty(_btSelectedSpecId))"
                            aria-label="Run backtest with current settings">
                        @(_btRunning ? "Running…" : "Run Backtest")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_btMessage))
                {
                    <p role="status" style="margin-top: 8px; color: @(_btError ? "#f44" : "#888");">
                        @_btMessage
                    </p>
                }

                @if (_btResult != null)
                {
                    var m = _btResult.Metrics;
                    <div style="margin-top: 16px; background: #1a1a1a; border: 1px solid #333; padding: 14px 16px; border-radius: 4px;">
                        <h4 style="margin: 0 0 10px 0;">Results</h4>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; font-size: 0.9rem;">
                            <div><strong>Trades:</strong> @m.TotalSignals</div>
                            <div><strong>Win Rate:</strong> @(m.TotalSignals == 0 ? "—" : m.WinRate.ToString("P1"))</div>
                            <div><strong>Total P&amp;L:</strong> @PriceFormatter.FormatPnL(m.TotalPnL)</div>
                            <div><strong>Max Drawdown:</strong> @m.MaxDrawdown.ToString("P2")</div>
                            <div><strong>Sharpe Ratio:</strong> @(double.IsNaN(m.SharpeRatio) ? "—" : m.SharpeRatio.ToString("F2"))</div>
                            <div><strong>Bars used:</strong> @(_btResult.WarmupBars + _btResult.EvaluatedBars) total (@_btResult.WarmupBars warmup + @_btResult.EvaluatedBars evaluated)</div>
                        </div>
                        @if (_btResult.Trades.Any())
                        {
                            <details style="margin-top: 12px;">
                                <summary style="cursor: pointer; font-weight: 600;">Trade Log (@_btResult.Trades.Count trades)</summary>
                                <div style="max-height: 200px; overflow-y: auto; margin-top: 8px;">
                                    <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
                                        <thead>
                                            <tr style="border-bottom: 1px solid var(--border-color);">
                                                <th scope="col" style="text-align: left; padding: 3px 6px;">Entry</th>
                                                <th scope="col" style="text-align: left; padding: 3px 6px;">Side</th>
                                                <th scope="col" style="text-align: right; padding: 3px 6px;">Entry $</th>
                                                <th scope="col" style="text-align: right; padding: 3px 6px;">Exit $</th>
                                                <th scope="col" style="text-align: right; padding: 3px 6px;">P&amp;L</th>
                                                <th scope="col" style="text-align: left; padding: 3px 6px;">Exit Reason</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var t in _btResult.Trades)
                                            {
                                                <tr @key="t" style="border-bottom: 1px solid #2a2a2a; color: @(t.PnL.HasValue && t.PnL.Value >= 0 ? "#4a4" : "#f66");">
                                                    <td style="padding: 3px 6px;">@t.EntryTime.ToString("MM/dd HH:mm")</td>
                                                    <td style="padding: 3px 6px;">@t.Side</td>
                                                    <td style="padding: 3px 6px; text-align: right;">@PriceFormatter.FormatPrice(t.EntryPrice)</td>
                                                    <td style="padding: 3px 6px; text-align: right;">@(t.ExitPrice.HasValue ? PriceFormatter.FormatPrice(t.ExitPrice.Value) : "—")</td>
                                                    <td style="padding: 3px 6px; text-align: right;">@(t.PnL.HasValue ? PriceFormatter.FormatPnL(t.PnL.Value) : "—")</td>
                                                    <td style="padding: 3px 6px;">@t.ExitReason</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        }
                    </div>
                }
            </section>

            @* ── Custom C# Strategy script ─────────────────────────────────────── *@
            @* ── Lab tab — the research harness, in-app (walk-forward windows +
               battery comparison, spoken and ranked). Uses the SAME backtester and
               the SAME survivor gate (95% bootstrap CI on trade R, both halves
               positive, ≥5 trades each) as the offline StrategyLab. *@
            <section id="panel-lab" role="tabpanel" aria-labelledby="tab-lab"
                     hidden="@(_activeTab != "lab")" style="margin-top: 20px;">
                <p style="font-size: 0.85rem; color: var(--text-muted);">
                    Research tools over the loaded chart data. Results here are studies of the
                    rules, not promises — the standing EXPERIMENTAL caveat applies double.
                    Backtest settings (capital, commission, slippage, warm-up) are shared with
                    the Backtest tab.
                </p>

                <fieldset style="border:1px solid var(--border-color); padding:10px 14px; margin-bottom:14px;">
                    <legend>Walk-forward windows</legend>
                    <p style="font-size:0.85rem; color: var(--text-muted); margin-top:0;">
                        Slices the loaded data into equal chronological windows and backtests one
                        strategy in each — an edge that only exists in one window is a regime
                        artifact, not an edge.
                    </p>
                    <div class="modal-row">
                        <label for="lab-spec">Strategy</label>
                        <select id="lab-spec" @bind="_labSpecId">
                            <option value="">— choose —</option>
                            @foreach (var spec in StrategyLibrary.All)
                            {
                                <option value="@spec.Id">@spec.Name</option>
                            }
                        </select>
                    </div>
                    <div class="modal-row">
                        <label for="lab-windows">Windows</label>
                        <input id="lab-windows" type="number" min="2" max="12" value="@_labWindows"
                               @onchange="e => int.TryParse(e.Value?.ToString(), out _labWindows)" />
                        <button class="primary" @onclick="RunLabWindowsAsync"
                                disabled="@(_labRunning || string.IsNullOrEmpty(_labSpecId))"
                                aria-label="Run walk-forward windows">
                            @(_labRunning ? "Running…" : "Run windows")
                        </button>
                    </div>
                    @if (_labWindowResults.Count > 0)
                    {
                        <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                            <caption class="sr-only">Walk-forward window results</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Window</th><th scope="col">Range</th>
                                    <th scope="col">Trades</th><th scope="col">Avg R</th>
                                    <th scope="col">Win rate</th><th scope="col">Profit factor</th>
                                    <th scope="col">Max DD</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in _labWindowResults)
                                {
                                    <tr style="color:@(w.AverageR > 0 ? "#4a4" : "#f66");">
                                        <td>@w.Index</td>
                                        <td>@w.Start.ToString("MMM yy")–@w.End.ToString("MMM yy")</td>
                                        <td>@w.Trades</td>
                                        <td>@(double.IsNaN(w.AverageR) ? "—" : w.AverageR.ToString("F2"))</td>
                                        <td>@w.WinRate.ToString("P0")</td>
                                        <td>@(double.IsNaN(w.ProfitFactor) ? "—" : w.ProfitFactor.ToString("F2"))</td>
                                        <td>@w.MaxDrawdown.ToString("P1")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </fieldset>

                <fieldset style="border:1px solid var(--border-color); padding:10px 14px; margin-bottom:14px;">
                    <legend>Compare all strategies (battery)</legend>
                    <p style="font-size:0.85rem; color: var(--text-muted); margin-top:0;">
                        Backtests every saved strategy on the first and second half of the loaded
                        data. SURVIVOR means the 95% confidence lower bound on trade R is positive
                        in BOTH halves with at least 5 trades each — the research harness's gate.
                        Ranked by the weaker half, because a strategy is only as good as its
                        weaker regime.
                    </p>
                    <div class="modal-row">
                        <button class="primary" @onclick="RunLabComparisonAsync"
                                disabled="@(_labRunning || !StrategyLibrary.All.Any())"
                                aria-label="Compare all saved strategies on both halves of the data">
                            @(_labRunning ? "Running…" : $"Compare {StrategyLibrary.All.Count} strategies")
                        </button>
                    </div>
                    @if (_labComparison.Count > 0)
                    {
                        <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                            <caption class="sr-only">Strategy comparison, ranked by weaker-half confidence bound</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Rank</th><th scope="col">Strategy</th>
                                    <th scope="col">H1 trades</th><th scope="col">H1 CI-lo</th>
                                    <th scope="col">H2 trades</th><th scope="col">H2 CI-lo</th>
                                    <th scope="col">Verdict</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < _labComparison.Count; i++)
                                {
                                    var row = _labComparison[i];
                                    <tr style="color:@(row.Survivor ? "#4a4" : "#ccc");">
                                        <td>@(i + 1)</td>
                                        <td>@row.Name</td>
                                        <td>@row.TradesH1</td>
                                        <td>@FormatCi(row.CiLoH1)</td>
                                        <td>@row.TradesH2</td>
                                        <td>@FormatCi(row.CiLoH2)</td>
                                        <td>@(row.Survivor ? "SURVIVOR" : "not proven")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </fieldset>

                @if (!string.IsNullOrEmpty(_labMessage))
                {
                    <p role="status" aria-live="polite" style="color:@(_labError ? "#f66" : "#4c8");">@_labMessage</p>
                }
            </section>

            <section id="panel-custom" role="tabpanel" aria-labelledby="tab-custom"
                     hidden="@(_activeTab != "custom")" style="margin-top: 20px;">
                <h3>Custom C# Strategy</h3>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 10px;">
                    Write a C# class that implements <code>ITradingStrategy</code> (from AccessibleTrader.Sdk).
                    The class will be compiled at runtime and added to the strategy engine.
                </p>

                <details style="margin-bottom: 12px;">
                    <summary style="cursor: pointer; color: #88aaff;">Show template</summary>
                    <pre style="background:#111; padding:10px; font-size:0.8rem; overflow-x:auto; margin-top:6px; border-radius:4px; color:#ccc;">
using System.Collections.Generic;
using AccessibleTrader.Sdk.Strategies;
using AccessibleTrader.Sdk.Models;

public class MyStrategy : BaseStrategy
{
    public override string Id   => "my_strategy";
    public override string Name => "My Custom Strategy";

    protected override TradeSignal? OnBar(IReadOnlyList&lt;Ohlcv&gt; history, Dictionary&lt;string, object&gt; parameters)
    {
        // history[^1] = latest bar. Return Buy/Sell/null.
        var last = history[^1];
        if (last.Close > last.Open)
            return CreateSignal(TradeSide.Buy, last.Close, "Bullish bar");
        return null;
    }
}</pre>
                </details>

                <div style="margin-bottom: 8px;">
                    <label for="custom-script-name" style="display:block; margin-bottom:4px;">Strategy Name (display):</label>
                    <input id="custom-script-name"
                           type="text"
                           style="width: 100%; box-sizing: border-box;"
                           placeholder="e.g. My Wave Strategy"
                           value="@_customScriptName"
                           @onchange="e => _customScriptName = e.Value?.ToString() ?? string.Empty" />
                </div>

                <label for="custom-script-code" style="display:block; margin-bottom:4px;">C# Code:</label>
                <textarea id="custom-script-code"
                          rows="14"
                          style="width: 100%; box-sizing: border-box; font-family: monospace; font-size: 0.85rem; background: #111; color: #ccc; border: 1px solid var(--border-color); padding: 8px; border-radius: 4px; resize: vertical;"
                          aria-label="Custom strategy C sharp code editor"
                          value="@_customScriptCode"
                          @oninput="e => _customScriptCode = e.Value?.ToString() ?? string.Empty">
                </textarea>

                <div style="margin-top: 10px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                    <label for="custom-exec-mode">Execution mode:</label>
                    <select id="custom-exec-mode"
                            value="@_customExecMode"
                            @onchange="e => { if (Enum.TryParse<StrategyExecutionMode>(e.Value?.ToString(), out var m)) _customExecMode = m; }"
                            aria-label="Custom strategy execution mode">
                        <option value="@StrategyExecutionMode.Suggestion">Suggestion — signal only, no auto-trade</option>
                        <option value="@StrategyExecutionMode.Auto">Auto — place orders automatically</option>
                    </select>
                    <button class="primary"
                            @onclick="CompileAndAddCustomStrategyAsync"
                            disabled="@_customCompiling"
                            aria-label="Compile and add custom strategy">
                        @(_customCompiling ? "Compiling…" : "Compile & Add")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_customScriptMessage))
                {
                    <div role="status"
                         style="margin-top: 10px; padding: 8px 12px; border-radius: 4px; background: @(_customScriptError ? "#3a0000" : "#003a00"); color: @(_customScriptError ? "#f88" : "#8f8"); font-size: 0.85rem; white-space: pre-wrap;">
                        @_customScriptMessage
                    </div>
                }
            </section>

            <div style="margin-top: 28px; display: flex; justify-content: flex-end;">
                <button @onclick="Close" aria-label="Close strategy manager dialog">Close</button>
            </div>

        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private string _activeTab = "library";

    // Library tab status messages
    private string? _libraryMessage;
    private bool _libraryError;

    // Backtester state
    private string _btSelectedSpecId = string.Empty;

    // ── Lab tab state ─────────────────────────────────────────────────────────
    private string _labSpecId = string.Empty;
    private int _labWindows = 4;
    private bool _labRunning;
    private string _labMessage = string.Empty;
    private bool _labError;
    private IReadOnlyList<AccessibleTrader.Core.Services.Strategies.LabWindowResult> _labWindowResults
        = Array.Empty<AccessibleTrader.Core.Services.Strategies.LabWindowResult>();
    private IReadOnlyList<AccessibleTrader.Core.Services.Strategies.LabComparisonRow> _labComparison
        = Array.Empty<AccessibleTrader.Core.Services.Strategies.LabComparisonRow>();

    private static string FormatCi(double ci) =>
        double.IsNegativeInfinity(ci) ? "no trades" : ci.ToString("+0.00;-0.00");

    private Sdk.Strategies.BacktestConfig LabBaseConfig() => new(
        StartingCapital: _btCapital,
        CommissionRate: _btCommission,
        SlippagePercent: _btSlippage,
        WarmupBars: _btWarmup,
        ReplayProfiles: true,
        PositionSizer: null,
        StartDate: null,
        EndDate: null,
        AllowReverseOnSignal: true);

    private async Task RunLabWindowsAsync()
    {
        if (Store.State.Data == null || !Store.State.Data.Any())
        {
            _labError = true; _labMessage = "Load chart data first."; return;
        }
        _labRunning = true; _labError = false; _labMessage = "Starting…";
        try
        {
            var progress = new Progress<string>(msg => { _labMessage = msg; InvokeAsync(StateHasChanged); });
            _labWindowResults = await LabRunner.RunWindowsAsync(
                _labSpecId, Store.State.Data, Store.State, _labWindows, LabBaseConfig(), progress);

            int profitable = _labWindowResults.Count(w => w.AverageR > 0);
            int traded = _labWindowResults.Count(w => w.Trades > 0);
            _labMessage = _labWindowResults.Count == 0
                ? "No windows could be evaluated — not enough data."
                : $"Done. Profitable in {profitable} of {_labWindowResults.Count} windows"
                  + (traded < _labWindowResults.Count ? $" ({_labWindowResults.Count - traded} windows had no trades)" : "")
                  + ". An edge that lives in only one window is a regime artifact.";
        }
        catch (Exception ex)
        {
            _labError = true; _labMessage = $"Lab run failed: {ex.Message}";
        }
        finally { _labRunning = false; StateHasChanged(); }
    }

    private async Task RunLabComparisonAsync()
    {
        if (Store.State.Data == null || !Store.State.Data.Any())
        {
            _labError = true; _labMessage = "Load chart data first."; return;
        }
        _labRunning = true; _labError = false; _labMessage = "Starting…";
        try
        {
            var specs = StrategyLibrary.All.Select(sp => (sp.Id, sp.Name)).ToList();
            var progress = new Progress<string>(msg => { _labMessage = msg; InvokeAsync(StateHasChanged); });
            _labComparison = await LabRunner.CompareAsync(
                specs, Store.State.Data, Store.State, LabBaseConfig(), progress);

            var survivors = _labComparison.Where(r => r.Survivor).ToList();
            _labMessage = _labComparison.Count == 0
                ? "Nothing could be evaluated."
                : survivors.Count == 0
                    ? $"Done. {_labComparison.Count} strategies tested — no survivors on this data. That is a result, not a failure."
                    : $"Done. {survivors.Count} of {_labComparison.Count} survive both halves: "
                      + string.Join(", ", survivors.Take(3).Select(r => r.Name))
                      + (survivors.Count > 3 ? $" and {survivors.Count - 3} more." : ".");
        }
        catch (Exception ex)
        {
            _labError = true; _labMessage = $"Comparison failed: {ex.Message}";
        }
        finally { _labRunning = false; StateHasChanged(); }
    }
    private double _btCapital    = 10000.0;
    private double _btCommission = 0.001;
    private double _btSlippage   = 0.0005;
    private int    _btWarmup     = 200;
    private DateTime? _btStartDate;
    private DateTime? _btEndDate;
    private bool _btRunning;
    private BacktestResult? _btResult;
    private string? _btMessage;
    private bool _btError;

    // Custom script state
    private string _customScriptCode = string.Empty;
    private string _customScriptName = string.Empty;
    private bool _customCompiling;
    private string? _customScriptMessage;
    private bool _customScriptError;
    private StrategyExecutionMode _customExecMode = StrategyExecutionMode.Suggestion;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenStrategiesEvent>(_ =>
            InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Strategy manager") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _libraryMessage = null;
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Strategy manager"));
        StateHasChanged();
        await Task.Yield();
        try
        {
            await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "strategy-title");
        }
        catch
        {
            // Focus is best-effort; dialog is still accessible via Tab.
        }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Strategy manager"));
        StateHasChanged();
    }

    // ── Library tab handlers ─────────────────────────────────────────────────

    /// <summary>
    /// Activate a saved spec — instantiate via the factory, register with the engine, and flip
    /// the spec's <c>IsAutoActivate</c> flag so it survives the next app restart. Removes any
    /// existing engine instance with the same spec ID first to avoid duplicates (this was the
    /// silent bug where editing+re-adding a spec left two copies running).
    /// </summary>
    // 2026-04-24 refactor: every strategy-management workflow now delegates to
    // IStrategyModalCoordinator so the modal only wires buttons to single calls and
    // displays the returned result message.

    private void StartSpec(string specId)
    {
        var r = Coordinator.StartSpec(specId);
        _libraryMessage = r.Message;
        _libraryError   = !r.IsSuccess;
        StateHasChanged();
    }

    private void StopSpec(string specId)
    {
        var r = Coordinator.StopSpec(specId);
        _libraryMessage = r.Message;
        _libraryError   = !r.IsSuccess;
        StateHasChanged();
    }

    private void DeleteSpec(string specId)
    {
        // Coordinator.StopSpec handles instance removal + auto-activate clearing;
        // Library.Remove drops the spec from disk.
        Coordinator.StopSpec(specId);
        StrategyLibrary.Remove(specId);
        _libraryMessage = "Deleted.";
        _libraryError   = false;
        StateHasChanged();
    }

    // ── Active tab handlers ──────────────────────────────────────────────────

    private void TogglePause(string instanceId, bool isPaused)
    {
        Coordinator.TogglePause(instanceId, isPaused);
        StateHasChanged();
    }

    private void RemoveStrategy(string instanceId)
    {
        Coordinator.RemoveActive(instanceId);
        _libraryMessage = null;
        StateHasChanged();
    }

    /// <summary>
    /// Auto-detect the recommended warmup for the currently-selected backtest spec by walking
    /// its condition tree and asking each referenced indicator for its stability window.
    /// Now resolves the actual selected spec (not a name-match fallback like the previous version).
    /// </summary>
    private void AutoWarmup()
    {
        var (bars, r) = Coordinator.RecommendedWarmup(_btSelectedSpecId);
        _btMessage = r.Message;
        _btError   = !r.IsSuccess;
        if (r.IsSuccess && bars >= 0) _btWarmup = bars;
    }

    /// <summary>Parse a date input value (yyyy-MM-dd) safely. Empty/invalid → null.</summary>
    private static DateTime? ParseDate(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return DateTime.TryParse(raw, out var d) ? d : (DateTime?)null;
    }

    /// <summary>
    /// Compute the date that splits the loaded chart data exactly in half by bar count.
    /// Returns null when there's no data loaded. Used by the walk-forward helpers below to
    /// drop the user into a "first half" / "last half" window without making them pick dates
    /// manually — the most common walk-forward operation.
    /// </summary>
    private DateTime? GetMidpointDate()
    {
        var data = Store.State.Data;
        if (data == null || data.Count < 4) return null;
        return data[data.Count / 2].Date;
    }

    private void WalkForwardFirstHalf()
    {
        var data = Store.State.Data;
        if (data == null || data.Count < 4)
        {
            _btMessage = "Load a chart first — need at least 4 bars to split.";
            _btError = true;
            return;
        }
        _btStartDate = data[0].Date;
        _btEndDate   = data[data.Count / 2].Date;
        _btMessage   = $"Walk-forward range: first half ({_btStartDate:yyyy-MM-dd} to {_btEndDate:yyyy-MM-dd}).";
        _btError     = false;
    }

    private void WalkForwardLastHalf()
    {
        var data = Store.State.Data;
        if (data == null || data.Count < 4)
        {
            _btMessage = "Load a chart first — need at least 4 bars to split.";
            _btError = true;
            return;
        }
        _btStartDate = data[data.Count / 2].Date;
        _btEndDate   = data[data.Count - 1].Date;
        _btMessage   = $"Walk-forward range: last half ({_btStartDate:yyyy-MM-dd} to {_btEndDate:yyyy-MM-dd}).";
        _btError     = false;
    }

    private void ClearDateRange()
    {
        _btStartDate = null;
        _btEndDate   = null;
        _btMessage   = "Date range cleared. Backtest will use all loaded bars.";
        _btError     = false;
    }

    private async Task RunBacktestAsync()
    {
        _btRunning = true;
        _btResult  = null;
        _btMessage = null;
        StateHasChanged();

        try
        {
            // The proper Backtest tab honors profile replay for full correctness — the
            // Build Setup Preview button uses ReplayProfiles=false for the fast iteration path.
            var config = new BacktestConfig(
                _btCapital, _btCommission, _btSlippage, _btWarmup,
                ReplayProfiles: true,
                StartDate: _btStartDate,
                EndDate: _btEndDate);
            var (result, status) = await Coordinator.RunBacktestAsync(
                _btSelectedSpecId, Store.State.Data, config, Store.State);
            _btResult  = result;
            _btMessage = status.Message;
            _btError   = !status.IsSuccess;
        }
        finally
        {
            _btRunning = false;
            StateHasChanged();
        }
    }

    private async Task CompileAndAddCustomStrategyAsync()
    {
        _customCompiling = true;
        _customScriptMessage = null;
        StateHasChanged();

        try
        {
            var r = await Coordinator.CompileAndAddStrategyAsync(_customScriptCode, _customExecMode);
            _customScriptMessage = r.Message;
            _customScriptError   = !r.IsSuccess;
            if (r.IsSuccess) _activeTab = "active";
        }
        finally
        {
            _customCompiling = false;
            StateHasChanged();
        }
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
