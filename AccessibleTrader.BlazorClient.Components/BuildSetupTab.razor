@*
    Build Setup tab — thin coordinator that owns a single EditableStrategySpec instance and
    composes three sibling editor components:

      • ConditionTreeEditor — strategy condition tree + per-leaf / per-group editor.
      • RiskPlanEditor      — stop source, TP ladder, sizing, R:R gate, entry trigger.
      • SummaryExport       — Save / Load / Add / Preview / Read-aloud / Export / Import.

    2026-04-24 split: the original ~1100-line monolith was decomposed so each sub-editor
    has its own focused injection set and can be tested in isolation via bUnit when that
    infrastructure lands. Parent re-renders on structural spec replacement (new / load /
    import) via the SummaryExport OnSpecReplaced callback; children render themselves on
    field-level mutations since they share the Spec instance by reference.
*@

@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@implements IDisposable

<div role="tabpanel" aria-labelledby="tab-build">

    @* ── Spec metadata ───────────────────────────────────────────────────────── *@
    <fieldset style="border: 1px solid var(--border-color); padding: 10px 14px; margin-bottom: 14px;">
        <legend style="font-weight: 700; padding: 0 6px;">Strategy Identity</legend>

        <div class="modal-row">
            <label for="bs-name">Name:</label>
            <input id="bs-name" type="text" style="width: 60%;"
                   value="@_spec.Name"
                   @onchange="e => _spec.Name = e.Value?.ToString() ?? string.Empty"
                   placeholder="My Long Setup" />
        </div>

        <div class="modal-row">
            <label for="bs-desc">Description:</label>
            <input id="bs-desc" type="text" style="width: 60%;"
                   value="@_spec.Description"
                   @onchange="e => _spec.Description = e.Value?.ToString() ?? string.Empty"
                   placeholder="Optional free-form description" />
        </div>

        <div class="modal-row">
            <label for="bs-side">Side:</label>
            <select id="bs-side"
                    value="@_spec.Side"
                    @onchange="e => { if (Enum.TryParse<AccessibleTrader.Sdk.Plugins.OrderSide>(e.Value?.ToString(), out var s)) _spec.Side = s; }">
                <option value="@AccessibleTrader.Sdk.Plugins.OrderSide.Buy">Long (Buy)</option>
                <option value="@AccessibleTrader.Sdk.Plugins.OrderSide.Sell">Short (Sell)</option>
            </select>
        </div>

        @* Seed the composer with the empirically-recommended preset for the loaded
           chart (same per-asset/timeframe logic as the ★ in the strategy list).
           Loads a full editable copy — conditions and risk plan — so the user
           starts from the validated design instead of a blank tree. *@
        <div class="modal-row">
            <button id="bs-use-recommended" type="button"
                    aria-label="Use recommended preset for the loaded chart"
                    title="Loads the lab-validated strategy preset for this symbol and timeframe into the editor."
                    @onclick="UseRecommended">
                Use Recommended
            </button>
        </div>
    </fieldset>

    @* ── Child editors ───────────────────────────────────────────────────────── *@
    <ConditionTreeEditor Spec="_spec" />
    <RiskPlanEditor      Spec="_spec" />
    <SummaryExport       Spec="_spec" OnSpecReplaced="OnSpecReplaced" />
</div>

@code {
    // Single canonical source of truth for the composer UI. Children take this by
    // reference as an [Parameter] and mutate it in place — Blazor sees each field
    // change on the child's next @onchange-triggered render. Structural replacements
    // (New / Load / Import) raise OnSpecReplaced so the parent re-renders every sibling.
    private EditableStrategySpec _spec = new();

    private void OnSpecReplaced() => StateHasChanged();

    private void UseRecommended()
    {
        var state = Store.State;
        string symbol = state.Identity.Symbol ?? "";
        if (string.IsNullOrEmpty(symbol))
        {
            EventBus.Publish(new AnnouncementEvent("Load a chart first — the recommendation depends on the symbol and timeframe.", true));
            return;
        }

        var bars = state.Data?.ToList();
        var spec = _spec.Side == AccessibleTrader.Sdk.Plugins.OrderSide.Sell
            ? BuiltInStrategySeeds.GetRecommendedV23ShortSpec(symbol, state.Identity.Timeframe, bars)
            : BuiltInStrategySeeds.GetRecommendedV23LongSpec(symbol, state.Identity.Timeframe, bars);
        if (spec == null)
        {
            EventBus.Publish(new AnnouncementEvent("No recommended preset for this chart.", true));
            return;
        }

        _spec.LoadFromSpec(spec);
        StateHasChanged();
        EventBus.Publish(new AnnouncementEvent($"Loaded recommended preset: {spec.Name}. Edit freely — saving creates your own copy.", true));
    }

    public void Dispose()
    {
        // Historical _previewTimer field retained here across the refactor in case a
        // future auto-debounce-on-edit Preview hook wants to wake up; currently null.
    }
}
