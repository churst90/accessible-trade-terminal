@*
    Save / Load / Run / Export buttons + preview-result banner + status message. Extracted
    from BuildSetupTab on 2026-04-24 so the action layer has a testable home separate from
    the condition tree and risk plan editors.

    Parent owns the EditableStrategySpec; this component orchestrates the
    StrategyLibraryFacade + StrategySpecNarrator + StrategyBacktester flows via injection
    and mutates Spec in-place on Load/New/Save (which reassign LoadedId etc).
*@

@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Sdk.Strategies
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject ISignalCatalog SignalCatalog
@inject IStrategyLibrary Library
@inject IStrategyLibraryFacade LibraryFacade
@inject IConfigurableStrategyFactory Factory
@inject ISpeechManager Speech
@inject IStrategyBacktester Backtester
@inject IBacktestWarmupAnalyzer WarmupAnalyzer
@inject IWorkspaceStore Store

<fieldset style="border: 1px solid var(--border-color); padding: 10px 14px;">
    <legend style="font-weight: 700; padding: 0 6px;">Save &amp; Run</legend>

    <div style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
        <button type="button" class="primary" @onclick="SaveSpec" aria-label="Save current strategy spec to library">
            Save spec
        </button>
        <button type="button" @onclick="NewSpec" aria-label="Start a new empty strategy">
            New
        </button>

        <label for="bs-load">Load existing:</label>
        <select id="bs-load" value="@Spec.LoadedId" @onchange="OnLoadChanged">
            <option value="">— Select —</option>
            @foreach (var s in Library.All)
            {
                <option @key="s.Id" value="@s.Id">@s.Name</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(Spec.LoadedId))
        {
            <button type="button" @onclick="DeleteSpec" aria-label="Delete loaded spec">
                Delete loaded
            </button>
        }

        <button type="button" class="primary" @onclick="AddToEngine" aria-label="Register current strategy with the engine and auto-activate on next launch">
            Add to Engine
        </button>

        <button type="button" @onclick="ReadAloud" aria-label="Speak the full strategy specification aloud">
            🔊 Read aloud
        </button>

        <button type="button" @onclick="RunPreview" aria-label="Run a quick backtest preview against the loaded chart">
            Preview
        </button>

        <button type="button" @onclick="ExportToFile" aria-label="Export the current spec to a .atstrat file in app data">
            Export
        </button>

        <button type="button" @onclick="ImportFromFile" aria-label="Import the most recent .atstrat file from app data">
            Import latest
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_previewSummary))
    {
        <div role="region" aria-label="Preview results"
             style="margin-top: 10px; padding: 8px 12px; background: #1a1a1a; border: 1px solid #333; font-family: Consolas,'Courier New',monospace; font-size: 0.85rem; white-space: pre-wrap;">
            @_previewSummary
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <p role="status" style="margin-top: 8px; color: @(_isError ? "#f66" : "#6c6");">
            @_message
        </p>
    }
</fieldset>

@code {
    [Parameter, EditorRequired]
    public EditableStrategySpec Spec { get; set; } = default!;

    /// <summary>Called after a structural operation (New / Load / Import) that replaces
    /// the current spec instance's fields. Lets the parent push a fresh render pass so
    /// sibling editors rebind to the new values.</summary>
    [Parameter] public EventCallback OnSpecReplaced { get; set; }

    private string? _message;
    private bool _isError;
    private string? _previewSummary;

    private void ApplyResult(StrategyLibraryResult result)
    {
        _message = result.Message;
        _isError = !result.IsSuccess;
        if (!result.IsSuccess)
            Speech.Speak(result.Message, interrupt: true);
    }

    private async Task NotifyReplaced()
    {
        if (OnSpecReplaced.HasDelegate) await OnSpecReplaced.InvokeAsync();
    }

    private async Task SaveSpec()
    {
        ApplyResult(LibraryFacade.Save(Spec));
        await NotifyReplaced();  // LoadedId may have been promoted to a fresh guid
    }

    private async Task NewSpec()
    {
        Spec.Reset();
        _message = "New strategy.";
        _isError = false;
        _previewSummary = null;
        await NotifyReplaced();
    }

    private async Task OnLoadChanged(ChangeEventArgs e)
    {
        string id = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrEmpty(id)) return;
        ApplyResult(LibraryFacade.LoadFromLibrary(Spec, id));
        await NotifyReplaced();
    }

    private async Task DeleteSpec()
    {
        if (string.IsNullOrEmpty(Spec.LoadedId)) return;
        var result = LibraryFacade.Delete(Spec.LoadedId);
        _message = result.Message;
        _isError = !result.IsSuccess;
        if (result.IsSuccess) { Spec.Reset(); await NotifyReplaced(); }
    }

    private async Task AddToEngine()
    {
        ApplyResult(LibraryFacade.AddToEngine(Spec));
        await NotifyReplaced();
    }

    private void ReadAloud()
    {
        try
        {
            var narrator = new StrategySpecNarrator(id =>
                SignalCatalog.GetById(id)?.DisplayLabel ?? "(unset)");
            string sentence = narrator.Narrate(Spec);
            Speech.Speak(sentence, interrupt: true);
            _message = "Spoke spec.";
            _isError = false;
        }
        catch (System.Exception ex)
        {
            _message = $"Read aloud failed: {ex.Message}";
            _isError = true;
        }
    }

    private async Task RunPreview()
    {
        try
        {
            var spec = Spec.ToSpec();
            var data = Store.State.Data;
            if (data == null || data.Count < 10)
            {
                _previewSummary = "No chart loaded — load a chart first to run preview.";
                return;
            }

            int warmup = WarmupAnalyzer.RecommendedWarmup(spec);
            var config = new BacktestConfig(
                StartingCapital: spec.Risk.NotionalEquity,
                CommissionRate: 0.001,
                SlippagePercent: 0.0005,
                WarmupBars: warmup,
                ReplayProfiles: false);

            var strategy = Factory.Create(spec);
            var result = await Backtester.RunAsync(strategy, data, config, Store.State);

            string r = double.IsNaN(result.AverageR) ? "—" : result.AverageR.ToString("F2");
            string pf = double.IsNaN(result.ProfitFactor) ? "—" : result.ProfitFactor.ToString("F2");
            _previewSummary =
                $"Trades: {result.Metrics.TotalSignals}\n" +
                $"Win rate: {(result.Metrics.TotalSignals == 0 ? "—" : result.Metrics.WinRate.ToString("P1"))}\n" +
                $"Total P&L: {result.Metrics.TotalPnL:F2}\n" +
                $"Avg R: {r}    Profit factor: {pf}\n" +
                $"Max drawdown: {result.Metrics.MaxDrawdown:P1}\n" +
                $"Warmup / Evaluated: {result.WarmupBars} / {result.EvaluatedBars} bars";
        }
        catch (System.Exception ex)
        {
            _previewSummary = $"Preview failed: {ex.Message}";
        }
    }

    private void ExportToFile()
    {
        var result = LibraryFacade.Export(Spec);
        _message = result.Message;
        _isError = !result.IsSuccess;
    }

    private async Task ImportFromFile()
    {
        ApplyResult(LibraryFacade.Import(Spec));
        await NotifyReplaced();
    }
}
