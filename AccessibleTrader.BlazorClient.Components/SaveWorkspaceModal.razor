@inherits ModalBase
@inject IWorkspaceStore Store
@inject IWorkspaceLibraryService Library

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="save-workspace-title"
             @onclick:stopPropagation="true">

            <h2 id="save-workspace-title" tabindex="-1">Save Workspace</h2>

            <div class="modal-row" style="margin-top: 16px;">
                <label for="workspace-name-input">Workspace name:</label>
                <input id="workspace-name-input"
                       type="text"
                       @bind="_workspaceName"
                       @onkeydown="OnKeyDown"
                       placeholder="e.g. BTC Scalping Setup"
                       style="flex: 1;" />
            </div>

            @if (_existingProfiles.Count > 0)
            {
                <div style="margin-top: 12px;">
                    <p style="font-size: 0.85rem; color: var(--text-muted);">Existing profiles (select to overwrite):</p>
                    <ul role="listbox" aria-label="Existing workspace profiles" style="list-style: none; padding: 0; margin: 4px 0; max-height: 150px; overflow-y: auto;">
                        @foreach (var profile in _existingProfiles)
                        {
                            <li role="option"
                                tabindex="0"
                                aria-selected="@(_workspaceName == profile ? "true" : "false")"
                                style="padding: 4px 8px; cursor: pointer; @(_workspaceName == profile ? "background: #335; font-weight: bold;" : "")"
                                @onclick="() => SelectProfile(profile)"
                                @onkeydown="e => OnProfileKeyDown(e, profile)">
                                @profile
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <p role="status" style="margin-top: 8px; color: @(_isError ? "#f44" : "#4f4"); font-size: 0.9rem;">@_statusMessage</p>
            }

            <div style="display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end;">
                <button class="primary"
                        disabled="@string.IsNullOrWhiteSpace(_workspaceName)"
                        @onclick="Save">
                    Save
                </button>
                <button @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private string _workspaceName = "";
    private List<string> _existingProfiles = new();
    private string? _statusMessage;
    private bool _isError;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenSaveWorkspaceEvent>(_ => InvokeAsync(ShowAsync));
    }

    private async Task ShowAsync()
    {
        _workspaceName = "";
        _statusMessage = null;
        _isError = false;
        _existingProfiles = Library.GetAvailableProfiles();
        await ShowModalAsync("save-workspace-title");
    }

    private void SelectProfile(string name)
    {
        _workspaceName = name;
    }

    private void OnProfileKeyDown(KeyboardEventArgs e, string profile)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            _workspaceName = profile;
            StateHasChanged();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_workspaceName))
        {
            await Task.Run(() => Save());
        }
        else if (e.Key == "Escape")
        {
            Close();
        }
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(_workspaceName)) return;

        var safeName = SanitizeFileName(_workspaceName.Trim());
        if (string.IsNullOrEmpty(safeName))
        {
            _statusMessage = "Invalid workspace name.";
            _isError = true;
            return;
        }

        try
        {
            Library.SaveWorkspaceProfile(safeName, Store);
            _statusMessage = $"Workspace '{safeName}' saved.";
            _isError = false;
            EventBus.Publish(new AnnouncementEvent($"Workspace saved: {safeName}"));
            // Auto-close after a brief moment so the user hears the announcement.
            Close();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Save failed: {ex.Message}";
            _isError = true;
        }
    }

    private void Close()
    {
        CloseModal();
    }

    protected override string ModalName => "Save workspace";

    private static string SanitizeFileName(string name)
    {
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        return new string(name.Where(c => !invalid.Contains(c)).ToArray());
    }
}
