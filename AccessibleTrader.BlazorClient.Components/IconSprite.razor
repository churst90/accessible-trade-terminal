@*
    Inline SVG sprite injected once into the DOM. Every toolbar / indicator-bar
    button references symbols defined here via <use href="#icon-name">. Strokes
    are currentColor so the consuming button's CSS variant class drives the
    color via its `color` property. Stroke geometry uses rounded caps + joins
    for a modern, readable look even at 20px display sizes.

    Included once from MainLayout — additional inclusions are harmless (duplicate
    ids on <symbol> are resolved by the first occurrence) but wasteful.
*@
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"
     style="position:absolute; width:0; height:0; overflow:hidden;">

    @* ── Mode: Trading — single candlestick with wick ─────────────────── *@
    <symbol id="icon-trading" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 3 V 7"/>
        <rect x="10" y="7" width="8" height="10" rx="1.5"/>
        <path d="M14 17 V 25"/>
    </symbol>

    @* ── Mode: Analytics — line chart with anchor points ──────────────── *@
    @* Market watch — a list of rows with a magnifier, covering both the watchlist and the screen. *@
    <symbol id="icon-watchlist" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 7 H 16"/>
        <path d="M4 12 H 13"/>
        <path d="M4 17 H 11"/>
        <circle cx="19" cy="18" r="4.5"/>
        <path d="M22.4 21.4 L 25 24"/>
    </symbol>

    @* Split view — one frame divided into two panes. *@
    <symbol id="icon-split-view" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="5.5" width="21" height="17" rx="2"/>
        <path d="M14 5.5 V 22.5"/>
    </symbol>

    @* Bar replay — a play triangle with a step marker, for revealing history one bar at a time. *@
    <symbol id="icon-replay" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6 L 19 14 L 8 22 Z"/>
        <path d="M23 6 V 22"/>
    </symbol>

    <symbol id="icon-analytics" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20 L 10 14 L 15 18 L 24 7"/>
        <circle cx="4" cy="20" r="1.2" fill="currentColor"/>
        <circle cx="10" cy="14" r="1.2" fill="currentColor"/>
        <circle cx="15" cy="18" r="1.2" fill="currentColor"/>
        <circle cx="24" cy="7"  r="1.2" fill="currentColor"/>
    </symbol>

    @* ── Object Tree — hierarchical node tree ─────────────────────────── *@
    <symbol id="icon-object-tree" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="7" cy="6" r="2"/>
        <circle cx="21" cy="14" r="2"/>
        <circle cx="21" cy="22" r="2"/>
        <path d="M7 8 V 22 H 19"/>
        <path d="M7 14 H 19"/>
    </symbol>

    @* ── Trade — bidirectional arrow swap ─────────────────────────────── *@
    <symbol id="icon-trade" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 10 H 22 L 18 6"/>
        <path d="M23 18 H 6 L 10 22"/>
    </symbol>

    @* ── Order Book — stacked horizontal bars of varying length ───────── *@
    <symbol id="icon-order-book" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 7 H 18"/>
        <path d="M5 11 H 22"/>
        <path d="M5 15 H 14"/>
        <path d="M5 19 H 20"/>
        <path d="M5 23 H 10"/>
    </symbol>

    @* ── Strategies — chess knight silhouette, rounded ────────────────── *@
    <symbol id="icon-strategies" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 25 H 21 L 20 20 C 20 15 17 13 16 10 C 18 10 18.5 8 18 6.5 C 16 4.5 13 5.5 11 8 L 9 11 C 8.5 12 9 13 10 12.5 L 11 13 L 10 16 L 8.5 17.5 C 7 19 7.5 22 9 22 Z"/>
    </symbol>

    @* ── Sound Designer — ring of audio waves ─────────────────────────── *@
    <symbol id="icon-sound-designer" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="14" cy="14" r="10" opacity="0.35"/>
        <path d="M11 10 V 18"/>
        <path d="M14 7  V 21"/>
        <path d="M17 10 V 18"/>
        <path d="M8  13 V 15"/>
        <path d="M20 13 V 15"/>
    </symbol>

    @* ── Drawings — pencil on diagonal ─────────────────────────────────── *@
    <symbol id="icon-drawings" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 23 L 20 8 L 24 12 L 9 27" transform="translate(0,-4)"/>
        <path d="M16 11 L 20 15"/>
        <path d="M5 23 L 7 19"/>
    </symbol>

    @* ── API Keys — classic key silhouette ────────────────────────────── *@
    <symbol id="icon-api-keys" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="10" cy="14" r="5"/>
        <circle cx="10" cy="14" r="1.3" fill="currentColor"/>
        <path d="M15 14 H 25"/>
        <path d="M21 14 V 18"/>
        <path d="M24 14 V 17"/>
    </symbol>

    @* ── Alerts — bell outline with clapper ───────────────────────────── *@
    <symbol id="icon-alerts" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M7 20 L 21 20 L 19 17 V 12 a5 5 0 0 0 -10 0 V 17 Z"/>
        <path d="M12 23 a2 2 0 0 0 4 0"/>
        <path d="M14 4 V 6"/>
    </symbol>

    @* ── Save Workspace — downward arrow into tray ────────────────────── *@
    <symbol id="icon-save-workspace" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4 V 17 L 10 13 M 14 17 L 18 13"/>
        <path d="M5 20 V 22 a2 2 0 0 0 2 2 H 21 a 2 2 0 0 0 2 -2 V 20"/>
    </symbol>

    @* ── Load Workspace — upward arrow from tray ──────────────────────── *@
    <symbol id="icon-load-workspace" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 22 V 9 L 10 13 M 14 9 L 18 13"/>
        <path d="M5 6 V 5 a2 2 0 0 1 2 -2 H 21 a 2 2 0 0 1 2 2 V 6"/>
        <path d="M5 24 H 23"/>
    </symbol>

    @* ── Settings — rounded gear ──────────────────────────────────────── *@
    <symbol id="icon-settings" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="14" cy="14" r="3.5"/>
        <path d="M14 3 V 6 M14 22 V 25 M3 14 H 6 M22 14 H 25 M6 6 L 8.5 8.5 M19.5 19.5 L 22 22 M22 6 L 19.5 8.5 M8.5 19.5 L 6 22"/>
    </symbol>

    @* ── Help — question mark in ring ─────────────────────────────────── *@
    <symbol id="icon-help" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="14" cy="14" r="10"/>
        <path d="M11 11 a3 3 0 1 1 3 4 V 17"/>
        <circle cx="14" cy="21" r="1" fill="currentColor" stroke="none"/>
    </symbol>

    @* ── Heatmap — 3x3 grid of rounded dots with graduated opacity ───── *@
    <symbol id="icon-heatmap" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8"  cy="8"  r="1.5" fill="currentColor" stroke="none" opacity="0.4"/>
        <circle cx="14" cy="8"  r="1.5" fill="currentColor" stroke="none" opacity="0.65"/>
        <circle cx="20" cy="8"  r="1.5" fill="currentColor" stroke="none" opacity="0.4"/>
        <circle cx="8"  cy="14" r="1.5" fill="currentColor" stroke="none" opacity="0.65"/>
        <circle cx="14" cy="14" r="2"   fill="currentColor" stroke="none"/>
        <circle cx="20" cy="14" r="1.5" fill="currentColor" stroke="none" opacity="0.65"/>
        <circle cx="8"  cy="20" r="1.5" fill="currentColor" stroke="none" opacity="0.4"/>
        <circle cx="14" cy="20" r="1.5" fill="currentColor" stroke="none" opacity="0.65"/>
        <circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none" opacity="0.4"/>
    </symbol>

    @* ── Heikin Ashi — three offset rounded candle bodies ─────────────── *@
    <symbol id="icon-heikin-ashi" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5"  y="13" width="5" height="10" rx="1.5"/>
        <rect x="11.5" y="8"  width="5" height="11" rx="1.5"/>
        <rect x="18" y="4"  width="5" height="13" rx="1.5"/>
    </symbol>

    @* ── Log Scale — exponential curve in a frame ─────────────────────── *@
    <symbol id="icon-log-scale" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4 V 24 H 24"/>
        <path d="M4 22 Q 14 22 17 14 T 24 4"/>
    </symbol>

    @* ── Load (primary / play) — circled arrow right ──────────────────── *@
    <symbol id="icon-load" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="14" cy="14" r="10"/>
        <path d="M11 9 L 18 14 L 11 19 Z" fill="currentColor" stroke="none"/>
    </symbol>

    @* ── Add Indicator — plus overlaid on wave ────────────────────────── *@
    <symbol id="icon-add-indicator" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 18 Q 8 13, 14 18 T 25 14"/>
        <circle cx="21" cy="7" r="5" fill="currentColor" stroke="none" opacity="0.12"/>
        <path d="M21 4 V 10 M18 7 H 24"/>
    </symbol>

    @* ── Scripts — angle brackets / slash ─────────────────────────────── *@
    <symbol id="icon-scripts" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 8 L 4 14 L 10 20"/>
        <path d="M18 8 L 24 14 L 18 20"/>
        <path d="M16 5 L 12 23"/>
    </symbol>

    @* ── Visible — eye open ───────────────────────────────────────────── *@
    <symbol id="icon-visible" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 14 Q 14 4, 26 14 Q 14 24, 2 14 Z"/>
        <circle cx="14" cy="14" r="3"/>
        <circle cx="14" cy="14" r="0.8" fill="currentColor" stroke="none"/>
    </symbol>

    @* ── Hidden — eye crossed ─────────────────────────────────────────── *@
    <symbol id="icon-hidden" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8 Q 14 20, 24 22"/>
        <path d="M4 20 Q 10 16, 14 16"/>
        <path d="M14 16 Q 20 16, 24 10"/>
        <path d="M4 4 L 24 24"/>
    </symbol>

    @* ── Audio On — speaker with waves ────────────────────────────────── *@
    <symbol id="icon-audio-on" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11 H 8 L 14 6 V 22 L 8 17 H 4 Z"/>
        <path d="M18 10 Q 21 14, 18 18"/>
        <path d="M21 7  Q 26 14, 21 21"/>
    </symbol>

    @* ── Audio Muted — speaker with slash ─────────────────────────────── *@
    <symbol id="icon-audio-muted" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 11 H 8 L 14 6 V 22 L 8 17 H 4 Z"/>
        <path d="M18 10 L 24 18"/>
        <path d="M24 10 L 18 18"/>
    </symbol>

    @* ── AI Analyst — four-point sparkle with accent dots ─────────────── *@
    <symbol id="icon-ai-analyst" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 4 L 16 12 L 24 14 L 16 16 L 14 24 L 12 16 L 4 14 L 12 12 Z"/>
        <circle cx="22" cy="7" r="1" fill="currentColor" stroke="none"/>
        <circle cx="6" cy="22" r="1" fill="currentColor" stroke="none"/>
    </symbol>

    @* ── Journal — notebook with lines ────────────────────────────────── *@
    <symbol id="icon-journal" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="4" width="18" height="20" rx="1.5"/>
        <path d="M9 4 V 24"/>
        <path d="M13 10 H 20"/>
        <path d="M13 14 H 20"/>
        <path d="M13 18 H 18"/>
    </symbol>

    @* ── Properties — horizontal sliders ──────────────────────────────── *@
    <symbol id="icon-properties" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 8 H 24"/>
        <circle cx="11" cy="8" r="2"/>
        <path d="M4 14 H 24"/>
        <circle cx="18" cy="14" r="2"/>
        <path d="M4 20 H 24"/>
        <circle cx="9" cy="20" r="2"/>
    </symbol>

    @* ── Pan left — chevron pointing left with an axis line ────────────── *@
    <symbol id="icon-pan-left" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 7 L 8 14 L 15 21"/>
        <path d="M20 14 H 8"/>
    </symbol>

    @* ── Pan right — chevron pointing right with an axis line ──────────── *@
    <symbol id="icon-pan-right" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 7 L 20 14 L 13 21"/>
        <path d="M8 14 H 20"/>
    </symbol>

    @* ── Zoom in — magnifier with a plus ──────────────────────────────── *@
    <symbol id="icon-zoom-in" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="7"/>
        <path d="M17 17 L 23 23"/>
        <path d="M12 9 V 15"/>
        <path d="M9 12 H 15"/>
    </symbol>

    @* ── Zoom out — magnifier with a minus ────────────────────────────── *@
    <symbol id="icon-zoom-out" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="7"/>
        <path d="M17 17 L 23 23"/>
        <path d="M9 12 H 15"/>
    </symbol>

</svg>
