@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@implements IDisposable
@inject IIndicatorService IndicatorService
@inject DemoPolicy Demo
@inject ISeriesManagementService SeriesManager
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime

@if (_isVisible)
{
    @* Click outside the inner panel to close. *@
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Add indicator"
             aria-modal="true"
             aria-labelledby="modal-title"
             @onclick:stopPropagation="true"
             @ref="_dialogRef">

            <h2 id="modal-title" tabindex="-1">Add Indicator</h2>

            @* Search first, because it is how anyone who knows what they want will find it.
               There are around a hundred indicators; a category filter plus an alphabetical
               list means finding one requires knowing both its exact name and which category
               somebody else filed it under. *@
            <div class="modal-row" style="margin-top: 16px;">
                <label for="indicator-search">Search</label>
                <input id="indicator-search" type="text" value="@_search"
                       placeholder="name, or what it measures"
                       aria-describedby="indicator-count"
                       @oninput="OnSearchChanged" style="flex:1; min-width:14em;" />

                <label for="indicator-category">Category</label>
                <select id="indicator-category" @onchange="OnCategoryChanged">
                    <option value="">All categories</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="modal-row">
                <label for="indicator-name">Indicator</label>
                @* aria-describedby only while #indicator-description is actually
                   rendered (it is @if-gated on a selection) — a dangling reference
                   is skipped silently by some screen readers and flagged by others. *@
                <select id="indicator-name" size="8"
                        value="@_selectedIndicatorCode"
                        aria-describedby="@(_selectedMeta is null ? null : "indicator-description")"
                        @onchange="OnIndicatorChanged" style="flex:1; min-width:18em;">
                    @foreach (var ind in _filteredIndicators)
                    {
                        <option value="@ind.Code">@ind.Name</option>
                    }
                </select>
            </div>

            <p id="indicator-count" role="status" aria-live="polite"
               style="margin:-8px 0 10px; color:var(--text-muted); font-size:0.9em;">
                @MatchSummary
            </p>

            @* What the thing you just selected actually does. Every indicator carries a
               description in its metadata and none of it reached the one dialog where a user
               is deciding whether they want it. *@
            @if (_selectedMeta is { } meta)
            {
                <div id="indicator-description"
                     style="border-left:3px solid var(--accent-color); padding:6px 0 6px 12px; margin-bottom:12px;">
                    <strong>@meta.Name</strong>
                    <span style="color:var(--text-muted);"> — @meta.Category@(string.IsNullOrEmpty(meta.DefaultPane) ? "" : $", {meta.DefaultPane} pane")</span>
                    @if (!string.IsNullOrWhiteSpace(meta.Description))
                    {
                        <p style="margin:4px 0 0;">@meta.Description</p>
                    }
                </div>
            }

            @* Parameters for selected indicator. The input type branches on DataType:
               string parameters render as text inputs (provider names, symbol selections);
               numeric parameters render as the standard number input. Both flow through the
               same _editParams dictionary as object values, formatted by SeriesManagementService.FormatParam. *@
            @if (_selectedMeta?.Parameters?.Any() == true)
            {
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-top:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Parameters</legend>
                    @foreach (var param in _selectedMeta.Parameters)
                    {
                        <div class="modal-row">
                            <label for="param-@param.Name">@(string.IsNullOrEmpty(param.DisplayName) ? param.Name : param.DisplayName)</label>
                            @if (param.DataType == typeof(string))
                            {
                                <input id="param-@param.Name" type="text"
                                       value="@(_editParams.TryGetValue(param.Name, out var sv) ? sv?.ToString() ?? string.Empty : param.DefaultValue?.ToString() ?? string.Empty)"
                                       @onchange="e => UpdateEditParam(param.Name, e.Value?.ToString(), isString: true)" />
                            }
                            else if (param.DataType == typeof(bool))
                            {
                                @* A yes/no knob must be a checkbox. Falling through to the numeric
                                   input asked the user to type 0 or 1 into a spinner, which is
                                   unusable with a screen reader and unguessable without one. *@
                                <input id="param-@param.Name" type="checkbox"
                                       checked="@IsParamTrue(param)"
                                       @onchange="e => UpdateBoolParam(param.Name, e.Value)" />
                            }
                            else
                            {
                                <input id="param-@param.Name" type="number"
                                       step="1"
                                       value="@(GetNumericDisplay(param))"
                                       @onchange="e => UpdateEditParam(param.Name, e.Value?.ToString(), isString: false)" />
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(param.Description))
                        {
                            <p style="margin:-4px 0 10px 0; font-size:0.78rem; color:var(--text-muted);">@param.Description</p>
                        }
                    }
                </fieldset>
            }

            <div style="margin-top: 30px; display: flex; justify-content: flex-end; gap: 10px;">
                <button @onclick="Close" aria-label="Cancel, close the add indicator dialog">Cancel</button>
                <button class="primary"
                        @onclick="AddSelected"
                        aria-label="Add selected indicator to chart">Add</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private ElementReference _dialogRef;
    private string _selectedCategory = "";
    private string _search = "";
    private string _selectedIndicatorCode = "";
    private List<string> _categories = new();
    private List<IndicatorMetadata> _allIndicators = new();
    private List<IndicatorMetadata> _filteredIndicators = new();
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;

    private IndicatorMetadata? _selectedMeta;
    // Object-typed so the modal can hold both numeric and string parameter values for any
    // indicator. Numeric inputs parse to double; string inputs pass through as string.
    // The downstream factory accepts the mixed dictionary via SeriesManagementService.FormatParam.
    private Dictionary<string, object> _editParams = new();

    protected override void OnInitialized()
    {
        // IndicatorService.GetAvailableIndicators() includes VPVR, VPFR, and TPO from
        // ProfileIndicatorProvider (registered under "Volume Profile" category).
        // Do NOT add synthetic duplicates here — use the registry as the sole source of truth.
        // In the public demo the list is narrowed to the curated indicator codes.
        _allIndicators = IndicatorService.GetAvailableIndicators()
            .Where(i => Demo.IsIndicatorAllowed(i.Code))
            .Where(i => !i.IsDeprecated) // retired indicators keep working in saved
                                         // workspaces/strategies but are not offered here
            .ToList();

        _categories = _allIndicators.Select(i => i.Category).Distinct().OrderBy(c => c).ToList();
        _filteredIndicators = _allIndicators;

        if (_filteredIndicators.Any())
        {
            _selectedIndicatorCode = _filteredIndicators.First().Code;
            UpdateSelectedMeta();
        }

        // InvokeAsync ensures StateHasChanged is called on the Blazor sync context
        // even if this event is published from a non-Blazor thread.
        _eventSub = EventBus.Subscribe<OpenAddIndicatorEvent>(_ =>
            InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Add indicator") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Add indicator"));
        StateHasChanged();

        // Move keyboard focus to the dialog heading so screen readers announce the dialog title.
        await Task.Yield(); // Yield so Blazor renders the dialog before we focus it.
        try
        {
            await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "modal-title");
        }
        catch
        {
            // Focus is best-effort; the dialog is still accessible via Tab.
        }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Add indicator"));
        StateHasChanged();
    }

    private void OnCategoryChanged(ChangeEventArgs e)
    {
        _selectedCategory = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        ApplyFilter();
    }

    /// <summary>
    /// Narrows by category and by free text. The text matches the NAME and the DESCRIPTION, so
    /// "volatility" finds ATR and Bollinger Bands without the user having to know either name —
    /// which is the case the search exists for. Matching the name alone would only help people
    /// who already knew what to type.
    /// </summary>
    private void ApplyFilter()
    {
        IEnumerable<IndicatorMetadata> q = _allIndicators;

        if (!string.IsNullOrEmpty(_selectedCategory))
            q = q.Where(i => i.Category == _selectedCategory);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            string needle = _search.Trim();
            q = q.Where(i =>
                i.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || i.Code.Contains(needle, StringComparison.OrdinalIgnoreCase)
                || (i.Description?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        _filteredIndicators = q.ToList();

        // Keep the selection if it survived the filter, so typing another character does not
        // yank the description out from under someone reading it.
        if (!_filteredIndicators.Any(i => i.Code == _selectedIndicatorCode))
            _selectedIndicatorCode = _filteredIndicators.FirstOrDefault()?.Code ?? "";

        UpdateSelectedMeta();
    }

    /// <summary>
    /// Spoken as a live region on every keystroke, so a screen-reader user hears the list
    /// shrinking instead of typing into silence and discovering the result only on Tab.
    /// </summary>
    private string MatchSummary => _filteredIndicators.Count switch
    {
        0 => "No indicators match. Clear the search or pick another category.",
        1 => "1 indicator matches.",
        var n when n == _allIndicators.Count => $"{n} indicators.",
        var n => $"{n} of {_allIndicators.Count} indicators match.",
    };

    private void OnIndicatorChanged(ChangeEventArgs e)
    {
        _selectedIndicatorCode = e.Value?.ToString() ?? "";
        UpdateSelectedMeta();
    }

    private void UpdateSelectedMeta()
    {
        _selectedMeta = _allIndicators.FirstOrDefault(i => i.Code == _selectedIndicatorCode);
        // Initialize the edit dictionary from each parameter's default. String parameters
        // hold their default string directly; numeric parameters convert to double via the
        // safe IConvertible path that previously broke on string DefaultValues.
        _editParams = _selectedMeta?.Parameters
            .ToDictionary(
                p => p.Name,
                p => InitialEditValue(p))
            ?? new Dictionary<string, object>();
    }

    /// <summary>Records a checkbox change as the "true"/"false" text the parameter pipeline expects.</summary>
    private void UpdateBoolParam(string name, object? value) =>
        UpdateEditParam(name, (value is bool b && b) ? "true" : "false", isString: false);

    /// <summary>Current checked state for a bool parameter, honouring any pending edit.</summary>
    private bool IsParamTrue(IndicatorParameterMetadata p)
    {
        if (_editParams.TryGetValue(p.Name, out var v) && v != null)
        {
            string s = v.ToString() ?? "";
            if (bool.TryParse(s, out bool b)) return b;
            if (double.TryParse(s, System.Globalization.NumberStyles.Any,
                    System.Globalization.CultureInfo.InvariantCulture, out double d)) return d != 0;
        }
        return p.DefaultValue is bool db ? db
            : p.DefaultValue is IConvertible c && c.ToDouble(null) != 0;
    }

    private static object InitialEditValue(IndicatorParameterMetadata p)
    {
        if (p.DataType == typeof(string))
            return p.DefaultValue?.ToString() ?? string.Empty;
        if (p.DefaultValue is IConvertible c)
        {
            try { return c.ToDouble(System.Globalization.CultureInfo.InvariantCulture); }
            catch { return 0.0; }
        }
        return 0.0;
    }

    // Used by the numeric-input render path. We need this as a method (not a ternary in the
    // markup) because TryGetValue with an `out object` doesn't compose cleanly into a Razor
    // expression that also defaults to a double.
    private string GetNumericDisplay(IndicatorParameterMetadata p)
    {
        if (_editParams.TryGetValue(p.Name, out var val) && val is IConvertible c)
        {
            try { return c.ToDouble(System.Globalization.CultureInfo.InvariantCulture).ToString("G", System.Globalization.CultureInfo.InvariantCulture); }
            catch { /* fall through to default */ }
        }
        if (p.DefaultValue is IConvertible dc)
        {
            try { return dc.ToDouble(System.Globalization.CultureInfo.InvariantCulture).ToString("G", System.Globalization.CultureInfo.InvariantCulture); }
            catch { return "0"; }
        }
        return "0";
    }

    private void UpdateEditParam(string name, string? raw, bool isString)
    {
        if (isString)
        {
            _editParams[name] = raw ?? string.Empty;
            return;
        }
        if (double.TryParse(raw, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out double v))
        {
            _editParams[name] = v;
        }
    }

    private void AddSelected()
    {
        var meta = _allIndicators.FirstOrDefault(i => i.Code == _selectedIndicatorCode);
        if (meta == null) return;

        // Use the user-edited parameters if available; fall back to metadata defaults.
        var parameters = meta.Parameters.ToDictionary(
            p => p.Name,
            p => _editParams.TryGetValue(p.Name, out var edited)
                ? edited
                : (p.DefaultValue ?? (object)0.0));

        // RegisterSeriesFromMetadata preserves CloudFills and component styling from metadata,
        // and now accepts mixed numeric/string parameter values through FormatParam.
        SeriesManager.RegisterSeriesFromMetadata(meta, parameters);
        Close();
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
