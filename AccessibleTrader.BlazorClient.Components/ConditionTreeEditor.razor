@*
    Condition tree editor — ARIA tree + leaf/group editor fieldsets. Extracted from
    BuildSetupTab on 2026-04-24 so the composer UI has a testable home for the tree
    mutation + operator picker logic without the surrounding risk-plan and save/run
    buttons in scope.

    Owns no state of its own — mutates the shared EditableStrategySpec instance in
    place via field writes. Expand/collapse state lives on the component and does
    not round-trip through the spec (pure UI polish).
*@

@using AccessibleTrader.Sdk.Strategies
@using AccessibleTrader.Sdk.Plugins
@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Core.Services
@inject ISignalCatalog SignalCatalog
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JS

@* ── Condition tree ─────────────────────────────────────────────────────── *@
<fieldset style="border: 1px solid var(--border-color); padding: 10px 14px; margin-bottom: 14px;">
    <legend style="font-weight: 700; padding: 0 6px;">Conditions</legend>

    <div style="display: flex; gap: 6px; margin-bottom: 8px; flex-wrap: wrap;">
        <button type="button" id="cond-add-root-group" @onclick="AddRootGroup" aria-label="Add condition group at root">
            + Group at root
        </button>
        <button type="button" @onclick="AddRootLeaf" aria-label="Add condition leaf at root">
            + Leaf at root
        </button>
        <button type="button" @onclick="ClearTree" aria-label="Clear all conditions">
            Clear all
        </button>
    </div>

    @if (Spec.Root == null)
    {
        <p style="color:var(--text-muted); font-size: 0.85rem;">
            No conditions yet. Add a root group (AND / OR / NOT) and then add leaves inside it.
        </p>
    }
    else
    {
        <ul role="tree" aria-label="Strategy condition tree"
            style="list-style: none; padding-left: 0; margin: 0;">
            @RenderNode(Spec.Root, 1)
        </ul>
    }
</fieldset>

@* ── Leaf editor ─────────────────────────────────────────────────────────── *@
@if (Spec.SelectedNode != null && !Spec.SelectedNode.IsGroup)
{
    <fieldset style="border: 1px solid #4a8; padding: 10px 14px; margin-bottom: 14px;">
        <legend style="font-weight: 700; padding: 0 6px;">Edit Leaf</legend>

        <div class="modal-row">
            <label for="leaf-indicator">Indicator:</label>
            @* One option per indicator code — or, when the chart has two or more instances of
               it, one per instance ("SMA 20", "SMA 50"): the leaf binds to the instance's
               parameters, which is what lets "SMA 20 crosses SMA 50" be said at all. *@
            <select id="leaf-indicator"
                    value="@PrimarySourceValue"
                    @onchange="OnIndicatorChanged">
                <option value="">— Select indicator —</option>
                @foreach (var opt in SourceOptions(Spec.SelectedNode.SignalDescriptorId, Spec.SelectedNode.Parameters))
                {
                    <option value="@opt.Value">@opt.Label</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(SelectedIndicatorCode) && !IsIndicatorLoadedOnChart(SelectedIndicatorCode)
             && string.IsNullOrEmpty(Spec.SelectedNode.Timeframe))
        {
            <div role="alert" aria-live="polite"
                 style="margin: 4px 0 8px 0; padding: 6px 10px; background: #3a2a00; border: 1px solid #aa6; color: #ffd; font-size: 0.85rem;">
                ⚠ <strong>@SelectedIndicatorCode is not on this chart.</strong>
                The strategy will silently never fire on this leaf until you add it via Alt+A (Add Indicator).
            </div>
        }

        <div class="modal-row">
            <label for="leaf-component">Component:</label>
            <select id="leaf-component"
                    value="@Spec.SelectedNode.SignalDescriptorId"
                    @onchange="OnComponentChanged">
                <option value="">— Select component —</option>
                @foreach (var d in DescriptorsForSelectedIndicator)
                {
                    <option value="@d.Id">@d.DisplayLabel (@d.Kind)</option>
                }
            </select>
        </div>

        <div class="modal-row">
            <label for="leaf-operator">Operator:</label>
            <select id="leaf-operator"
                    value="@Spec.SelectedNode.Operator"
                    @onchange="OnOperatorChanged">
                @foreach (var op in OperatorsForSelectedKind)
                {
                    <option value="@op">@op</option>
                }
            </select>
        </div>

        @* The line a crosses-line leaf crosses. AFTER the operator that reveals it, so the next
           Tab from the operator lands on it — it used to sit above the operator, where a keyboard
           user who had just chosen CrossesAboveLine would have to go back to find it. It can be
           price or any indicator, and on its own timeframe: "close crosses above the 1w SMA 50".
           Until 2026-10 it was unreachable (the operators were never offered) and could only list
           other components of the same indicator. *@
        @if (NeedsSecondDescriptor)
        {
            <div class="modal-row">
                <label for="leaf-second-indicator">Crosses against:</label>
                <select id="leaf-second-indicator"
                        value="@SecondSourceValue"
                        @onchange="OnSecondSourceChanged">
                    <option value="">— Select line —</option>
                    @foreach (var opt in SourceOptions(Spec.SelectedNode.SecondSignalDescriptorId, Spec.SelectedNode.SecondParameters))
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </select>
            </div>

            @if (!string.IsNullOrEmpty(SecondIndicatorCode))
            {
                <div class="modal-row">
                    <label for="leaf-second-component">Line:</label>
                    <select id="leaf-second-component"
                            value="@(Spec.SelectedNode.SecondSignalDescriptorId ?? string.Empty)"
                            @onchange="e => Spec.SelectedNode!.SecondSignalDescriptorId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                        @foreach (var d in SecondDescriptors)
                        {
                            <option value="@d.Id">@d.DisplayLabel</option>
                        }
                    </select>
                </div>
            }

            <div class="modal-row">
                <label for="leaf-second-tf">Line's timeframe:</label>
                <select id="leaf-second-tf"
                        value="@(Spec.SelectedNode.SecondTimeframe ?? string.Empty)"
                        @onchange="e => Spec.SelectedNode!.SecondTimeframe = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                    <option value="">— Same as this condition —</option>
                    @foreach (var (tf, name) in Timeframes)
                    {
                        <option value="@tf">@name</option>
                    }
                </select>
            </div>
        }

        @if (NeedsValue)
        {
            <div class="modal-row">
                <label for="leaf-value">Value:</label>
                <input id="leaf-value" type="number" step="any"
                       value="@Spec.SelectedNode.Value"
                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Spec.SelectedNode!.Value = v; }" />
            </div>
        }

        @if (NeedsValue2)
        {
            <div class="modal-row">
                <label for="leaf-value2">Upper bound:</label>
                <input id="leaf-value2" type="number" step="any"
                       value="@(Spec.SelectedNode.Value2 ?? 0)"
                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Spec.SelectedNode!.Value2 = v; }" />
            </div>
        }

        @if (NeedsWithinN)
        {
            <div class="modal-row">
                <label for="leaf-within">Within last N bars:</label>
                <input id="leaf-within" type="number" step="1" min="1"
                       value="@Spec.SelectedNode.WithinNBars"
                       @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) Spec.SelectedNode!.WithinNBars = v; }" />
            </div>
        }

        @if (NeedsMinLevelStrength)
        {
            <div class="modal-row">
                <label for="leaf-minstrength">Min level strength (0.0-1.0):</label>
                <input id="leaf-minstrength" type="number" step="0.05" min="0" max="1"
                       value="@Spec.SelectedNode.MinLevelStrength"
                       @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Spec.SelectedNode!.MinLevelStrength = v; }" />
            </div>
        }

        <div class="modal-row">
            <label for="leaf-tf">Timeframe (HTF):</label>
            <select id="leaf-tf"
                    value="@(Spec.SelectedNode.Timeframe ?? string.Empty)"
                    @onchange="e => Spec.SelectedNode!.Timeframe = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()">
                <option value="">— Active chart TF —</option>
                @foreach (var (tf, name) in Timeframes)
                {
                    <option value="@tf">@name</option>
                }
            </select>
        </div>

        @if (!string.IsNullOrEmpty(Spec.SelectedNode.Timeframe) && Spec.SelectedNode.Parameters == null
             && !string.IsNullOrEmpty(SelectedIndicatorCode) && !ConditionEvaluator.IsPriceCode(SelectedIndicatorCode))
        {
            <p id="leaf-tf-defaults" style="color:var(--text-muted); font-size:0.8rem;">
                On @Spec.SelectedNode.Timeframe this uses @SelectedIndicatorCode's default settings.
                To set its period, add that instance to the chart and choose it under Indicator.
            </p>
        }

        <div class="modal-row">
            <label for="leaf-score">Score weight (0..1):</label>
            <input id="leaf-score" type="number" step="0.05" min="0" max="1"
                   value="@Spec.SelectedNode.Score"
                   @onchange="e => { if (double.TryParse(e.Value?.ToString(), out var v)) Spec.SelectedNode!.Score = v; }" />
        </div>
    </fieldset>
}
else if (Spec.SelectedNode != null && Spec.SelectedNode.IsGroup)
{
    <fieldset style="border: 1px solid #4a8; padding: 10px 14px; margin-bottom: 14px;">
        <legend style="font-weight: 700; padding: 0 6px;">Edit Group</legend>
        <div class="modal-row">
            <label for="grp-logic">Combine children with:</label>
            <select id="grp-logic"
                    value="@Spec.SelectedNode.Logic"
                    @onchange="e => { if (Enum.TryParse<LogicOperator>(e.Value?.ToString(), out var l)) Spec.SelectedNode!.Logic = l; }">
                <option value="@LogicOperator.And">AND — every child must be true</option>
                <option value="@LogicOperator.Or">OR — at least one child must be true</option>
                <option value="@LogicOperator.Not">NOT — invert the (single) child</option>
                <option value="@LogicOperator.Score">Score — fire when weighted sum ≥ threshold</option>
                <option value="@LogicOperator.Sequence">Sequence — children fire in chronological order</option>
            </select>
        </div>

        @if (Spec.SelectedNode.Logic == LogicOperator.Score)
        {
            <div class="modal-row">
                <label for="grp-score">Score threshold:</label>
                <input id="grp-score" type="number" step="0.1" min="0"
                       value="@(Spec.SelectedNode.ScoreThreshold?.ToString() ?? string.Empty)"
                       @onchange="OnScoreThresholdChanged"
                       placeholder="e.g. 3.0 (blank = OR fallback)" />
            </div>
            <p style="color:var(--text-muted); font-size:0.8rem;">
                Max possible score (immediate leaves): <strong>@MaxScoreForSelectedGroup().ToString("F1")</strong>.
                Leaves deeper in nested groups are not summed here.
            </p>
        }
        else if (Spec.SelectedNode.Logic == LogicOperator.Sequence)
        {
            <p style="color:#c90; font-size:0.8rem;">
                Children must be leaves (sub-groups are not supported inside a Sequence).
                Walks backward from the current bar and places each child in its WithinNBars
                budget, strictly chronologically.
            </p>
        }

        <p style="color:var(--text-muted); font-size:0.8rem;">
            @Spec.SelectedNode.Children.Count child node(s).
        </p>
    </fieldset>
}

@code {
    /// <summary>Shared mutable strategy-composer state owned by the parent
    /// <c>BuildSetupTab</c>. Children mutate it in place — Blazor sees the mutation on the
    /// next @onchange-triggered re-render of each child, so the parent doesn't need to
    /// react to every keystroke. Structural changes (new / load / save) are handled by the
    /// parent via direct property assignment + StateHasChanged.</summary>
    [Parameter, EditorRequired]
    public EditableStrategySpec Spec { get; set; } = default!;

    private readonly HashSet<string> _collapsedGroups = new();

    // ── Leaf-editor derived state ────────────────────────────────────────────

    private string SelectedIndicatorCode =>
        Spec.SelectedNode?.SignalDescriptorId is { } id && !string.IsNullOrEmpty(id)
            ? SignalCatalog.GetById(id)?.IndicatorCode ?? string.Empty
            : string.Empty;

    // Price first: it is what "close crosses the SMA" crosses, and it is always there — the
    // evaluator reads it from the bars when no Candles series carries it.
    private IEnumerable<string> IndicatorCodes =>
        SignalCatalog.All
            .Select(d => d.IndicatorCode)
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct(System.StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => ConditionEvaluator.IsPriceCode(c) ? 0 : 1)
            .ThenBy(c => c);

    private bool IsIndicatorLoadedOnChart(string code)
    {
        if (string.IsNullOrEmpty(code)) return false;
        if (ConditionEvaluator.IsPriceCode(code)) return true;
        return Store.State.ActiveSeries.Any(s =>
            string.Equals(s.IndicatorCode, code, System.StringComparison.OrdinalIgnoreCase));
    }

    private static readonly (string Tf, string Name)[] Timeframes =
    {
        ("5m", "5 minute"), ("15m", "15 minute"), ("30m", "30 minute"), ("1h", "1 hour"),
        ("4h", "4 hour"), ("1d", "1 day"), ("1w", "1 week"),
    };

    // ── Which series a line is: code, or instance ─────────────────────────────

    private sealed record SourceOption(string Value, string Label);

    /// <summary>The chart's indicator series with this code, in chart order.</summary>
    private List<ChartSeries> InstancesOf(string code) =>
        Store.State.ActiveSeries
            .Where(s => !s.IsDrawing && string.Equals(s.IndicatorCode, code, System.StringComparison.OrdinalIgnoreCase))
            .ToList();

    private static string InstanceName(ChartSeries s) =>
        !string.IsNullOrWhiteSpace(s.FriendlyName) ? s.FriendlyName
        : !string.IsNullOrWhiteSpace(s.Name) ? s.Name : s.IndicatorCode;

    private static string CodeLabel(string code) => code.ToUpperInvariant() switch
    {
        "CANDLES" => "Price (close, high, low)",
        "PRICE"   => "Price line (close)",
        "VOLUME"  => "Volume",
        _ => code
    };

    /// <summary>
    /// The options for an indicator picker. An instance option's value is "@" + the series id;
    /// a code option's value is the code. A code with two or more instances on the chart lists
    /// the instances instead — plus the bare code when the leaf being edited is bound to none,
    /// so a leaf saved before instances existed still shows what it reads (the first).
    /// </summary>
    private IEnumerable<SourceOption> SourceOptions(string? currentDescriptorId, IReadOnlyDictionary<string, double>? currentParameters)
    {
        string? currentCode = string.IsNullOrEmpty(currentDescriptorId) ? null : SignalCatalog.GetById(currentDescriptorId)?.IndicatorCode;
        foreach (var code in IndicatorCodes)
        {
            var instances = ConditionEvaluator.IsPriceCode(code) ? new List<ChartSeries>() : InstancesOf(code);
            if (instances.Count >= 2)
            {
                if (currentParameters == null && string.Equals(code, currentCode, System.StringComparison.OrdinalIgnoreCase))
                    yield return new SourceOption(code, $"{code} (first on chart)");
                foreach (var s in instances)
                    yield return new SourceOption("@" + s.Id, InstanceName(s));
                continue;
            }
            yield return new SourceOption(code,
                CodeLabel(code) + (IsIndicatorLoadedOnChart(code) ? "" : " (not on chart)"));
        }
    }

    /// <summary>The picker value that shows a line's current source.</summary>
    private string SourceValue(string? descriptorId, IReadOnlyDictionary<string, double>? parameters)
    {
        if (string.IsNullOrEmpty(descriptorId)) return string.Empty;
        string code = SignalCatalog.GetById(descriptorId)?.IndicatorCode ?? string.Empty;
        if (string.IsNullOrEmpty(code) || parameters == null) return code;
        var instances = InstancesOf(code);
        if (instances.Count < 2) return code;
        var match = instances.FirstOrDefault(s => ConditionEvaluator.ParametersMatch(s.Parameters, parameters));
        return match != null ? "@" + match.Id : code;
    }

    private string PrimarySourceValue => SourceValue(Spec.SelectedNode?.SignalDescriptorId, Spec.SelectedNode?.Parameters);
    private string SecondSourceValue => SourceValue(Spec.SelectedNode?.SecondSignalDescriptorId, Spec.SelectedNode?.SecondParameters);

    /// <summary>
    /// What a picker value names: the code, and the parameters to bind. An instance binds its
    /// own; a code with exactly one instance on the chart binds that one (the one an unbound leaf
    /// reads anyway — and on a higher timeframe the only way its period travels with it); a code
    /// with none, or price, binds nothing.
    /// </summary>
    private (string Code, IReadOnlyDictionary<string, double>? Parameters) ResolveSource(string value)
    {
        if (value.StartsWith('@'))
        {
            var s = Store.State.ActiveSeries.FirstOrDefault(x => x.Id == value[1..]);
            if (s == null) return (string.Empty, null);
            return (s.IndicatorCode, Copy(s.Parameters));
        }
        if (ConditionEvaluator.IsPriceCode(value)) return (value, null);
        var instances = InstancesOf(value);
        return (value, instances.Count == 1 ? Copy(instances[0].Parameters) : null);
    }

    private static IReadOnlyDictionary<string, double>? Copy(IReadOnlyDictionary<string, double> p) =>
        p.Count == 0 ? null : new Dictionary<string, double>(p);

    private string SecondIndicatorCode =>
        Spec.SelectedNode?.SecondSignalDescriptorId is { Length: > 0 } id
            ? SignalCatalog.GetById(id)?.IndicatorCode ?? string.Empty
            : string.Empty;

    /// <summary>The components the crossed line can be — every one of its indicator's, less the
    /// exact line the leaf already is (same component, instance and timeframe).</summary>
    private IEnumerable<SignalDescriptor> SecondDescriptors
    {
        get
        {
            var n = Spec.SelectedNode;
            if (n == null || string.IsNullOrEmpty(SecondIndicatorCode)) return Enumerable.Empty<SignalDescriptor>();
            return SignalCatalog.GetForIndicator(SecondIndicatorCode).Where(d => !IsSameLine(n, d.Id));
        }
    }

    private static bool IsSameLine(EditableConditionNode n, string secondId) =>
        string.Equals(n.SignalDescriptorId, secondId, System.StringComparison.OrdinalIgnoreCase)
        && SameParameters(n.Parameters, n.SecondParameters)
        && string.Equals(n.Timeframe ?? "", n.SecondTimeframe ?? n.Timeframe ?? "", System.StringComparison.Ordinal);

    private static bool SameParameters(IReadOnlyDictionary<string, double>? a, IReadOnlyDictionary<string, double>? b) =>
        (a == null || a.Count == 0) ? (b == null || b.Count == 0)
        : b != null && a.Count == b.Count && ConditionEvaluator.ParametersMatch(a, b);

    /// <summary>"SMA 50 [1w]" — a line as the tree reads it aloud.</summary>
    private string LineLabel(string? descriptorId, IReadOnlyDictionary<string, double>? parameters, string? timeframe)
    {
        var desc = string.IsNullOrEmpty(descriptorId) ? null : SignalCatalog.GetById(descriptorId);
        string label = desc?.DisplayLabel ?? "(unset)";
        if (desc != null && parameters is { Count: > 0 })
        {
            var instance = InstancesOf(desc.IndicatorCode)
                .FirstOrDefault(s => ConditionEvaluator.ParametersMatch(s.Parameters, parameters));
            label = instance != null
                ? $"{InstanceName(instance)} — {desc.ComponentName}"
                : $"{label} ({ConditionEvaluator.DescribeParameters(parameters)})";
        }
        return string.IsNullOrEmpty(timeframe) ? label : $"{label} [{timeframe}]";
    }

    private IEnumerable<SignalDescriptor> DescriptorsForSelectedIndicator
    {
        get
        {
            string code = SelectedIndicatorCode;
            if (string.IsNullOrEmpty(code)) return Enumerable.Empty<SignalDescriptor>();
            return SignalCatalog.GetForIndicator(code);
        }
    }

    private IEnumerable<LeafOperator> OperatorsForSelectedKind
    {
        get
        {
            if (Spec.SelectedNode == null) return Enumerable.Empty<LeafOperator>();
            var desc = SignalCatalog.GetById(Spec.SelectedNode.SignalDescriptorId);
            var kind = desc?.Kind;

            // The line-cross operators — "crosses another line", price or any indicator's — are
            // offered wherever the signal is a number. The evaluator has handled them since the
            // second descriptor existed; this list never named them, so the "Crosses against"
            // picker below was unreachable and "close crosses above the SMA" could not be built.
            // Not for markers: a marker is a pulse (a value or NaN), not a line.
            var fire = new[] { LeafOperator.Fired, LeafOperator.FiredWithin };
            var num  = new[] { LeafOperator.GreaterThan, LeafOperator.LessThan, LeafOperator.Between,
                               LeafOperator.CrossesAbove, LeafOperator.CrossesBelow,
                               LeafOperator.CrossesAboveLine, LeafOperator.CrossesBelowLine,
                               LeafOperator.ChangesDirection };
            var cloud = new[] { LeafOperator.AboveCloud, LeafOperator.BelowCloud, LeafOperator.InsideCloud,
                                LeafOperator.CrossesAboveLine, LeafOperator.CrossesBelowLine };
            var level = new[] { LeafOperator.PriceRejectsLevel, LeafOperator.PriceBreaksLevel,
                                LeafOperator.PriceInsideValueArea, LeafOperator.PriceOutsideValueArea,
                                LeafOperator.BarClosesAbovePoc, LeafOperator.BarClosesBelowPoc,
                                LeafOperator.WickIntoLvn };

            return kind switch
            {
                SignalKind.MarkerFire => fire.Concat(level),
                SignalKind.Cloud      => cloud.Concat(level),
                SignalKind.Oscillator => num.Concat(level),
                SignalKind.Line       => num.Concat(level),
                _ => num.Concat(level)
            };
        }
    }

    private bool NeedsValue =>
        Spec.SelectedNode != null && Spec.SelectedNode.Operator switch
        {
            LeafOperator.GreaterThan or LeafOperator.LessThan or LeafOperator.Between
                or LeafOperator.CrossesAbove or LeafOperator.CrossesBelow
                or LeafOperator.PriceRejectsLevel or LeafOperator.PriceBreaksLevel => true,
            _ => false
        };

    private bool NeedsValue2 =>
        Spec.SelectedNode != null && Spec.SelectedNode.Operator == LeafOperator.Between;

    private bool NeedsWithinN =>
        Spec.SelectedNode != null && (Spec.SelectedNode.Operator == LeafOperator.FiredWithin
                                   || Spec.SelectedNode.Operator == LeafOperator.PriceRejectsLevel
                                   || Spec.SelectedNode.Operator == LeafOperator.GreaterThanWithin
                                   || Spec.SelectedNode.Operator == LeafOperator.LessThanWithin
                                   || Spec.SelectedNode.Operator == LeafOperator.BetweenWithin
                                   || Spec.SelectedNode.Operator == LeafOperator.PercentileBelow
                                   || Spec.SelectedNode.Operator == LeafOperator.PercentileAbove);

    private bool NeedsMinLevelStrength =>
        Spec.SelectedNode != null && (Spec.SelectedNode.Operator == LeafOperator.PriceRejectsLevel
                                   || Spec.SelectedNode.Operator == LeafOperator.PriceBreaksLevel);

    private bool NeedsSecondDescriptor =>
        Spec.SelectedNode != null
        && (Spec.SelectedNode.Operator == LeafOperator.CrossesAboveLine
         || Spec.SelectedNode.Operator == LeafOperator.CrossesBelowLine);

    // ── Tree rendering ──────────────────────────────────────────────────────

    private RenderFragment RenderNode(EditableConditionNode node, int level) => __builder =>
    {
        bool isSelected = Spec.SelectedNode != null && Spec.SelectedNode.Id == node.Id;
        bool isCollapsed = node.IsGroup && _collapsedGroups.Contains(node.Id);
        string label = NodeLabel(node);

        @* No `outline: none` in the style below. This is a roving-tabindex treeitem: arrowing
           through a strategy's condition tree MOVES focus, and with the ring suppressed inline —
           where no stylesheet could put it back — nothing on screen changed as it moved. The
           selected border-left is a SELECTION cue, not a focus cue; the two are different states.
           app.css's [tabindex]:focus-visible rule now applies here. *@
        <li @key="node.Id"
            id="@TreeitemId(node)"
            role="treeitem"
            aria-level="@level"
            aria-selected="@(isSelected ? "true" : "false")"
            aria-expanded="@(node.IsGroup ? (isCollapsed ? "false" : "true") : null)"
            aria-label="@($"{label}{(isSelected ? ", selected" : "")}")"
            tabindex="@(isSelected ? 0 : -1)"
            style="margin: 4px 0; padding: 4px 6px; border-left: 3px solid @(isSelected ? "#4a8" : "#444");">

            <div style="display: flex; gap: 6px; align-items: center; flex-wrap: wrap;">
                @if (node.IsGroup)
                {
                    <button type="button"
                            data-tree-toggle="true"
                            @onclick="() => ToggleCollapsed(node)"
                            aria-label="@(isCollapsed ? $"Expand {label}" : $"Collapse {label}")"
                            style="background: transparent; color: #ddd; border: 1px solid var(--border-color); padding: 2px 6px; cursor: pointer; min-width: 24px;">
                        @(isCollapsed ? "+" : "−")
                    </button>
                }

                <button type="button"
                        data-tree-activate="true"
                        @onclick="() => SelectNode(node)"
                        aria-label="Select @label"
                        style="background: @(isSelected ? "#264" : "transparent"); color: #ddd; border: 1px solid var(--border-color); padding: 2px 8px; cursor: pointer;">
                    @label
                </button>

                @if (node.IsGroup)
                {
                    <button type="button" @onclick="() => AddChildLeaf(node)" aria-label="Add leaf inside @label">+ leaf</button>
                    <button type="button" @onclick="() => AddChildGroup(node)" aria-label="Add subgroup inside @label">+ group</button>
                }

                <button type="button" @onclick="() => DeleteNodeAsync(node)" aria-label="Delete @label">×</button>
            </div>

            @if (node.IsGroup && node.Children.Count > 0 && !isCollapsed)
            {
                <ul role="group" style="list-style: none; padding-left: 18px; margin: 0; border-left: 1px dotted #444;">
                    @foreach (var child in node.Children)
                    {
                        @RenderNode(child, level + 1)
                    }
                </ul>
            }
        </li>
    };

    private string NodeLabel(EditableConditionNode node)
    {
        if (node.IsGroup)
        {
            return $"{node.Logic} group ({node.Children.Count})";
        }
        // A crosses-line leaf names the line it crosses: "Candles — Body (close) — CrossesAboveLine
        // SMA 50 — Sma [1w]". Without it, arrowing through the tree said only "CrossesAboveLine".
        string first = LineLabel(node.SignalDescriptorId, node.Parameters, node.Timeframe);
        string opPart = node.Operator.ToString();
        if (node.Operator is LeafOperator.CrossesAboveLine or LeafOperator.CrossesBelowLine)
            return $"{first} — {opPart} {LineLabel(node.SecondSignalDescriptorId, node.SecondParameters, node.SecondTimeframe ?? node.Timeframe)}";
        return $"{first} — {opPart}";
    }

    // ── Tree mutation ────────────────────────────────────────────────────────

    private void AddRootGroup()
    {
        Spec.Root = new EditableConditionNode { IsGroup = true, Logic = LogicOperator.And };
        Spec.SelectedNode = Spec.Root;
    }

    private void AddRootLeaf()
    {
        Spec.Root = new EditableConditionNode { IsGroup = false };
        Spec.SelectedNode = Spec.Root;
    }

    private void AddChildLeaf(EditableConditionNode parent)
    {
        if (!parent.IsGroup) return;
        var leaf = new EditableConditionNode { IsGroup = false };
        parent.Children.Add(leaf);
        Spec.SelectedNode = leaf;
    }

    private void AddChildGroup(EditableConditionNode parent)
    {
        if (!parent.IsGroup) return;
        var group = new EditableConditionNode { IsGroup = true, Logic = LogicOperator.And };
        parent.Children.Add(group);
        Spec.SelectedNode = group;
    }

    private static string TreeitemId(EditableConditionNode node) => "cond-node-" + node.Id;

    // Delete is a button INSIDE the row it removes, so the focused element goes with the row and
    // the browser drops focus on <body>. Since 2026-09-24 Delete is reachable from the keyboard
    // (treeKeyboard.js used to take its Enter), so this is where a keyboard user lands: on the
    // next row, else the previous, else the parent, and that row becomes the tree's Tab stop.
    private async Task DeleteNodeAsync(EditableConditionNode node)
    {
        if (Spec.Root == null) return;
        string label = NodeLabel(node);
        EditableConditionNode? land;
        if (node == Spec.Root)
        {
            Spec.Root = null;
            Spec.SelectedNode = null;
            land = null;
        }
        else
        {
            var parent = FindParent(Spec.Root, node);
            if (parent == null) return;
            int i = parent.Children.IndexOf(node);
            parent.Children.RemoveAt(i);
            land = i < parent.Children.Count ? parent.Children[i]
                 : i > 0 ? parent.Children[i - 1]
                 : parent;
            Spec.SelectedNode = land;
        }

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, $"Deleted {label}.", true, Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
        StateHasChanged();
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("accessibleTrader.focusElement",
                land != null ? TreeitemId(land) : "cond-add-root-group");
        }
        catch (JSDisconnectedException) { }
    }

    private static EditableConditionNode? FindParent(EditableConditionNode current, EditableConditionNode target)
    {
        if (!current.IsGroup) return null;
        if (current.Children.Contains(target)) return current;
        foreach (var c in current.Children)
            if (FindParent(c, target) is { } p) return p;
        return null;
    }

    private void SelectNode(EditableConditionNode node) => Spec.SelectedNode = node;

    private void ClearTree()
    {
        Spec.Root = null;
        Spec.SelectedNode = null;
    }

    private void ToggleCollapsed(EditableConditionNode node)
    {
        if (!node.IsGroup) return;
        if (_collapsedGroups.Contains(node.Id)) _collapsedGroups.Remove(node.Id);
        else _collapsedGroups.Add(node.Id);
    }

    // ── Leaf-editor handlers ─────────────────────────────────────────────────

    private void OnIndicatorChanged(ChangeEventArgs e)
    {
        if (Spec.SelectedNode == null) return;
        var (code, parameters) = ResolveSource(e.Value?.ToString() ?? string.Empty);
        var first = SignalCatalog.GetForIndicator(code).FirstOrDefault();
        Spec.SelectedNode.SignalDescriptorId = first?.Id ?? string.Empty;
        Spec.SelectedNode.Parameters = parameters;
        // Keep a line cross a line cross when the new indicator can still be one — picking the
        // other SMA should not throw away the line it was crossing.
        bool keepCross = first != null && first.Kind != SignalKind.MarkerFire && NeedsSecondDescriptor;
        if (!keepCross)
            Spec.SelectedNode.Operator = first?.Kind == SignalKind.MarkerFire
                ? LeafOperator.Fired
                : LeafOperator.GreaterThan;
    }

    private void OnSecondSourceChanged(ChangeEventArgs e)
    {
        var n = Spec.SelectedNode;
        if (n == null) return;
        var (code, parameters) = ResolveSource(e.Value?.ToString() ?? string.Empty);
        n.SecondParameters = parameters;
        if (string.IsNullOrEmpty(code)) { n.SecondSignalDescriptorId = null; return; }
        // The first component that is not the leaf's own line: "SMA 50" against itself is no cross.
        n.SecondSignalDescriptorId = SignalCatalog.GetForIndicator(code)
            .Select(d => d.Id)
            .FirstOrDefault(id => !IsSameLine(n, id));
    }

    private void OnComponentChanged(ChangeEventArgs e)
    {
        if (Spec.SelectedNode == null) return;
        Spec.SelectedNode.SignalDescriptorId = e.Value?.ToString() ?? string.Empty;
    }

    private void OnOperatorChanged(ChangeEventArgs e)
    {
        if (Spec.SelectedNode == null) return;
        if (!Enum.TryParse<LeafOperator>(e.Value?.ToString(), out var op)) return;
        bool wasCross = NeedsSecondDescriptor;
        Spec.SelectedNode.Operator = op;
        // The pickers for the crossed line appear after this one. Focus stays here; say where
        // they are, so the change is heard and not just rendered.
        if (NeedsSecondDescriptor && !wasCross)
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                "Choose the line it crosses: Crosses against, next.", false,
                Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
    }

    private void OnScoreThresholdChanged(ChangeEventArgs e)
    {
        if (Spec.SelectedNode == null) return;
        string raw = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw)) { Spec.SelectedNode.ScoreThreshold = null; return; }
        if (double.TryParse(raw, out var v)) Spec.SelectedNode.ScoreThreshold = v;
    }

    private double MaxScoreForSelectedGroup()
    {
        if (Spec.SelectedNode == null || !Spec.SelectedNode.IsGroup) return 0.0;
        double sum = 0.0;
        foreach (var c in Spec.SelectedNode.Children)
            if (!c.IsGroup) sum += System.Math.Max(0.0, c.Score);
        return sum;
    }
}
