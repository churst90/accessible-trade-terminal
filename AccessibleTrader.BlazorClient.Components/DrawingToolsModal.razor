@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@using AccessibleTrader.Core.Services.Drawing
@implements IDisposable
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Drawing tools"
             aria-modal="true"
             aria-labelledby="drawing-tools-title"
             aria-describedby="drawing-tools-help"
             @onclick:stopPropagation="true">

            <h2 id="drawing-tools-title" tabindex="-1">Drawing Tools</h2>

            <p id="drawing-tools-help" style="margin: 8px 0 0; color: var(--text-muted);">
                The tool's first point goes on the bar you were on. Then move to each next point and press Enter. Escape cancels.
            </p>

            @foreach (var group in DrawingToolCatalog.Groups)
            {
                var headingId = "drawing-tools-group-" + group.Name.Replace(' ', '-').ToLowerInvariant();
                <section role="group" aria-labelledby="@headingId" style="margin-top: 16px;">
                    <h3 id="@headingId" style="margin: 0 0 6px; font-size: 1em;">@group.Name</h3>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        @foreach (var tool in group.Tools)
                        {
                            var hintId = "drawing-tool-hint-" + tool.Key;
                            @* The button's name is the tool's name and its point count, the words
                               it shows first; the hint is its description, so a screen reader says
                               the name, then the line after a pause, and never the hint twice. The
                               old "Select Trend Line" names put a verb in front of every one. *@
                            <button class="object-tree-item"
                                    @onclick="() => SelectTool(tool.Key)"
                                    aria-label="@($"{tool.Name}, {PointsText(tool.Points)}")"
                                    aria-describedby="@hintId"
                                    style="text-align: left;">
                                @tool.Name, @PointsText(tool.Points)
                                <span id="@hintId" aria-hidden="true" style="display: block; font-weight: normal; color: var(--text-muted); font-size: 0.9em;">@tool.Hint</span>
                            </button>
                        }
                    </div>
                </section>
            }

            <div style="margin-top: 30px; display: flex; justify-content: flex-end;">
                <button @onclick="Close" aria-label="Close drawing tools dialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;

    private static string PointsText(int n) => n == 1 ? "1 point" : $"{n} points";

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenDrawingToolsEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Drawing tools") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Drawing tools"));
        StateHasChanged();
        await Task.Yield();
        try
        {
            await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "drawing-tools-title");
        }
        catch { }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Drawing tools"));
        StateHasChanged();
    }

    private void SelectTool(string toolKey)
    {
        EventBus.Publish(new AddDrawingEvent(toolKey));
        Close();
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
