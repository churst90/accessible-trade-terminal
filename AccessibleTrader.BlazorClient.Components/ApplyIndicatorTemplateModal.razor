@inherits ModalBase
@inject IWorkspaceStore Store
@inject IIndicatorTemplateService Templates
@inject IWorkspaceInitializer WorkspaceInit

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Apply indicator template"
             aria-modal="true"
             aria-labelledby="apply-indicator-template-title"
             @onclick:stopPropagation="true">

            <h2 id="apply-indicator-template-title" tabindex="-1">Apply Indicator Template</h2>

            <p style="margin-top: 12px; font-size: 0.9rem;">
                Replaces this chart's indicators. Symbol, timeframe and drawings stay. Control plus Z undoes it.
            </p>

            @if (_templates.Count == 0)
            {
                <p role="status" style="margin-top: 16px;">No indicator templates saved yet.</p>
            }
            else
            {
                <ul role="listbox"
                    aria-label="Saved indicator templates"
                    style="list-style: none; padding: 0; margin: 16px 0; max-height: 300px; overflow-y: auto;"
                    @onkeydown="OnListKeyDown">
                    @for (int i = 0; i < _templates.Count; i++)
                    {
                        var idx = i;
                        var template = _templates[i];
                        <li role="option"
                            tabindex="@(idx == _selectedIndex ? "0" : "-1")"
                            aria-selected="@(idx == _selectedIndex ? "true" : "false")"
                            style="display: flex; justify-content: space-between; align-items: center; padding: 8px; cursor: pointer; @(idx == _selectedIndex ? "background: color-mix(in srgb, var(--accent-color) 26%, transparent); font-weight: bold;" : "") border-bottom: 1px solid var(--border-color);"
                            @onclick="() => SelectTemplate(idx)"
                            @ondblclick="() => Apply(template)">
                            <span><span>@template</span>, <span style="font-weight: normal; color: var(--text-muted);">@DescriptionOf(template)</span></span>
                            <button aria-label="@($"Delete indicator template: {template}")"
                                    style="padding: 2px 8px; font-size: 0.8rem;"
                                    @onclick="() => Delete(template)"
                                    @onclick:stopPropagation="true">
                                Delete
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <p role="status" style="margin-top: 8px; color: @(_isError ? "#f44" : "#4f4"); font-size: 0.9rem;">@_statusMessage</p>
            }

            <div style="display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end;">
                @if (_templates.Count > 0)
                {
                    <GatedButton class="primary"
                            Gate="ApplyGate"
                            OnClick="ApplySelected">
                        Apply
                    </GatedButton>
                }
                <button @onclick="Close" aria-label="Cancel, close the apply indicator template dialog">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Null when a template can be applied; otherwise why it cannot.</summary>
    private string? ApplyGate() =>
        _selectedIndex < 0 || _selectedIndex >= _templates.Count
            ? "Choose an indicator template from the list first."
            : null;

    private List<string> _templates = new();
    private Dictionary<string, string> _descriptions = new();
    private int _selectedIndex = -1;
    private string? _statusMessage;
    private bool _isError;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        _eventSub = EventBus.Subscribe<OpenApplyIndicatorTemplateEvent>(_ => InvokeAsync(ShowAsync));
    }

    private async Task ShowAsync()
    {
        _selectedIndex = -1;
        _statusMessage = null;
        _isError = false;
        _templates = Templates.GetAvailable();
        _descriptions = new();
        if (_templates.Count > 0) _selectedIndex = 0;
        await ShowModalAsync("apply-indicator-template-title");
    }

    private string DescriptionOf(string template)
    {
        if (!_descriptions.TryGetValue(template, out var text))
        {
            try { text = IndicatorTemplateService.Describe(Templates.Load(template)); }
            catch { text = "could not be read"; }
            _descriptions[template] = text;
        }
        return text;
    }

    private void SelectTemplate(int index)
    {
        _selectedIndex = index;
    }

    private void OnListKeyDown(KeyboardEventArgs e)
    {
        if (_templates.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown":
                SelectTemplate(Math.Min(_selectedIndex + 1, _templates.Count - 1));
                break;
            case "ArrowUp":
                SelectTemplate(Math.Max(_selectedIndex - 1, 0));
                break;
            case "Enter":
                if (_selectedIndex >= 0 && _selectedIndex < _templates.Count)
                    Apply(_templates[_selectedIndex]);
                break;
            case "Delete":
                if (_selectedIndex >= 0 && _selectedIndex < _templates.Count)
                    Delete(_templates[_selectedIndex]);
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private void ApplySelected()
    {
        if (_selectedIndex >= 0 && _selectedIndex < _templates.Count)
            Apply(_templates[_selectedIndex]);
    }

    private void Apply(string name)
    {
        var template = Templates.Load(name);
        if (template == null)
        {
            string missing = $"Indicator template {name} could not be read.";
            _statusMessage = missing;
            _isError = true;
            EventBus.Publish(new AnnouncementEvent(missing,
                Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
            return;
        }

        int count = WorkspaceInit.ApplyIndicatorTemplate(template, name);

        var id = Store.State.Identity;
        string chart = WorkspaceLibraryService.ChartName(id.Provider, id.Symbol, id.Timeframe);
        string applied = IndicatorTemplateService.AppliedSentence(name, chart, count, WorkspaceInit.LastRestoreNotice);
        EventBus.Publish(new AnnouncementEvent(applied,
            Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
        Close();
    }

    private void Delete(string name)
    {
        Templates.Delete(name);
        _descriptions.Remove(name);
        _templates = Templates.GetAvailable();
        if (_selectedIndex >= _templates.Count) _selectedIndex = _templates.Count - 1;
        _statusMessage = $"Indicator template deleted: {name}.";
        _isError = false;
        EventBus.Publish(new AnnouncementEvent($"Indicator template deleted: {name}.",
            Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
    }

    private void Close()
    {
        CloseModal();
    }

    protected override string ModalName => "Apply indicator template";
}
