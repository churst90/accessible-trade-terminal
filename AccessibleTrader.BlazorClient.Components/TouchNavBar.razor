@using System.Reactive.Linq
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@inject INavigationEngine Nav
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IAppSettings App
@implements IDisposable

@*
    Touch navigation toolbar (Phase C). Plain, large buttons are the single most
    robust pattern for VoiceOver/TalkBack on the web — every action reachable by
    swipe + double-tap with zero custom gesture handling — and they serve
    motor-impaired users and anyone on whom gesture recognition fails. Gestures
    must never be the only path.

    Rendered ONLY on touch-capable devices (accessibleTrader.isTouchCapable JS
    probe) — CSS `@media (pointer: coarse)` still styles it, but the C# gate keeps
    it out of the DOM entirely on desktop, where it was cluttering the screen-
    reader tab order. Keyboard/desktop users have the full shortcut set instead.
    Every button routes through the exact command the equivalent key uses, so
    speech and sonification are identical.
*@

@if (_isTouchDevice)
{
    <div class="touch-nav" role="toolbar" aria-label="Touch navigation">
        <button class="touch-nav-btn" aria-label="Previous bar"
                @onclick="@(() => Nav.ProcessNavigation("NAV_LEFT"))">
            <span aria-hidden="true">◀</span>
        </button>
        <button class="touch-nav-btn" aria-label="Next bar"
                @onclick="@(() => Nav.ProcessNavigation("NAV_RIGHT"))">
            <span aria-hidden="true">▶</span>
        </button>
        <button class="touch-nav-btn" aria-label="Previous component"
                @onclick="@(() => Nav.ProcessNavigation("NAV_COMP_UP"))">
            <span aria-hidden="true">▲</span>
        </button>
        <button class="touch-nav-btn" aria-label="Next component"
                @onclick="@(() => Nav.ProcessNavigation("NAV_COMP_DOWN"))">
            <span aria-hidden="true">▼</span>
        </button>
        <button class="touch-nav-btn" aria-label="Previous series"
                @onclick="@(() => Nav.ProcessNavigation("NAV_SERIES_PREV"))">
            <span aria-hidden="true">◁</span>
        </button>
        <button class="touch-nav-btn" aria-label="Next series"
                @onclick="@(() => Nav.ProcessNavigation("NAV_SERIES_NEXT"))">
            <span aria-hidden="true">▷</span>
        </button>
        <button class="touch-nav-btn" aria-label="Place drawing point"
                @onclick="PlaceDrawingPoint">
            <span aria-hidden="true">✚</span>
        </button>
        <button class="touch-nav-btn" aria-label="@(IsPlaying ? "Stop playback" : "Play chart")"
                aria-pressed="@(IsPlaying ? "true" : "false")"
                @onclick="TogglePlayback">
            <span aria-hidden="true">@(IsPlaying ? "■" : "▶▶")</span>
        </button>
        <button class="touch-nav-btn" aria-label="@(_exploreMode ? "Explore mode on — drag to hear bars" : "Explore mode off")"
                aria-pressed="@(_exploreMode ? "true" : "false")"
                @onclick="ToggleExplore">
            <span aria-hidden="true">@(_exploreMode ? "👆" : "✋")</span>
        </button>
        <button class="touch-nav-btn" aria-label="Chart menu"
                @onclick="OpenChartMenu">
            <span aria-hidden="true">☰</span>
        </button>
    </div>
}

@code {
    private IDisposable? _sub;
    private bool _isTouchDevice; // false until the JS probe says otherwise → not in the DOM
    private bool _exploreMode;

    // Explore-by-touch: with the mode ON, a single finger sliding across the
    // chart speaks and sonifies the bars under it instead of panning. Screen
    // reader users reach this button through the toolbar (it's a real button),
    // then use their pass-through gesture on the chart surface.
    private async Task ToggleExplore()
    {
        _exploreMode = !_exploreMode;
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.setTouchExploreMode", _exploreMode); }
        catch { /* JS not ready — the flag simply stays off engine-side */ }
        EventBus.Publish(new AnnouncementEvent(_exploreMode
            ? "Explore mode on. Drag a finger across the chart to hear each bar; lift to stop. Panning is paused."
            : "Explore mode off. Dragging pans the chart again.", true));
    }

    private bool IsPlaying => Store.State.IsPlaying || Store.State.IsPaused;

    /// <summary>Places the next anchor of the in-progress drawing at the current cursor
    /// bar — the touch-only equivalent of re-pressing the tool shortcut, so a mobile
    /// screen-reader user can complete a trend line or channel. Announces a hint if no
    /// drawing is active.</summary>
    private void PlaceDrawingPoint() => EventBus.Publish(new PlaceDrawingAnchorEvent());

    protected override void OnInitialized()
    {
        // Only the play/stop glyph depends on state — re-render on playback flips.
        _sub = Store.StateStream
            .Select(s => s.IsPlaying || s.IsPaused)
            .DistinctUntilChanged()
            .Subscribe(_ => InvokeAsync(StateHasChanged));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await EvaluateVisibilityAsync();
        // React the INSTANT the setting changes (no save button exists; changes
        // apply immediately), and re-evaluate on Settings close as a belt.
        _modeChangedSub = EventBus.Subscribe<TouchNavBarModeChangedEvent>(evt =>
        {
            _ = InvokeAsync(EvaluateVisibilityAsync);
        });
        _settingsClosedSub = EventBus.Subscribe<ModalStateChangedEvent>(e =>
        {
            if (!e.IsOpen && e.ModalName == "Settings")
                _ = InvokeAsync(EvaluateVisibilityAsync);
        });
    }

    private IDisposable? _settingsClosedSub;
    private IDisposable? _modeChangedSub;

    private async Task EvaluateVisibilityAsync()
    {
        // Explicit user override wins over any device probe — probes have been
        // wrong on desktop Linux input stacks before (2026-07-16).
        string mode = App.TouchNavBarMode;
        bool visible;
        if (mode == "show") visible = true;
        else if (mode == "hide") visible = false;
        else
        {
            try { visible = await JSRuntime.InvokeAsync<bool>("accessibleTrader.isTouchCapable"); }
            catch { visible = false; } // JS unavailable (prerender/tests): desktop-safe default
        }
        if (visible != _isTouchDevice)
        {
            _isTouchDevice = visible;
            StateHasChanged();
        }
    }

    /// <summary>Mirrors CommandDispatcher.TogglePlayback(Chart) — the Space key's
    /// semantics: second press always stops, no hanging pause state.</summary>
    private void TogglePlayback()
    {
        if (Store.State.IsPlaying || Store.State.IsPaused)
            Store.Dispatch(new SetPlaybackAction(false, PlaybackScope.Chart));
        else
            Store.Dispatch(new SetPlaybackAction(true, PlaybackScope.Chart));
    }

    /// <summary>Opens the chart context menu at its keyboard-origin position,
    /// carrying the current cursor bar for "Play from here".</summary>
    private void OpenChartMenu()
    {
        EventBus.Publish(new OpenChartContextMenuEvent(
            double.NaN, double.NaN, Store.State.CurrentDataIndex));
    }

    public void Dispose()
    {
        _sub?.Dispose();
        _settingsClosedSub?.Dispose();
        _modeChangedSub?.Dispose();
    }
}
