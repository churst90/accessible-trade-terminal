@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject DemoPolicy Demo
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Object tree"
             aria-modal="true"
             aria-labelledby="objtree-title"
             style="max-width:600px; min-height: 400px;"
             @onclick:stopPropagation="true">

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 id="objtree-title" tabindex="-1" style="margin: 0;">Object Tree</h2>
                @* Strategies are a local/desktop power feature — gated off in the demo and
                   hosted (online) builds, so don't offer the button there either. *@
                @if (Demo.AllowStrategies)
                {
                    <button class="primary" @onclick="OpenStrategies" aria-label="Manage Strategies (Alt+S)">
                        Manage Strategies
                    </button>
                }
            </div>

            @if (!Store.State.ActiveSeries.Any())
            {
                <p style="color:var(--text-muted); text-align: center; margin-top: 50px;">No series active on chart.</p>
            }
            else
            {
                <div class="tree-viewport" role="tree" aria-label="Chart Hierarchy">
                    @{
                        var panes = Store.State.ActiveSeries.GroupBy(s => s.Pane).OrderBy(p => p.Key);
                    }

                    @{ bool firstItem = true; }
                    @foreach (var pane in panes)
                    {
                        <details @key="pane.Key" open="@IsPaneOpen(pane.Key)"
                                 @ontoggle="() => OnPaneToggled(pane.Key)" class="pane-node">
                            <summary class="pane-header" role="treeitem" aria-level="1"
                                     tabindex="@(firstItem ? 0 : -1)"
                                     aria-expanded="@ExpandedAttr(IsPaneOpen(pane.Key))"
                                     aria-label="@($"Pane {pane.Key}, {pane.Count()} series")">
                                <span class="icon"></span> Pane: @pane.Key
                            </summary>

                            <div role="group" class="pane-content">
                                @foreach (var series in pane)
                                {
                                    bool isFocused = series.Id == Store.State.FocusedSeriesId;
                                    bool willInitiallyFocus = firstItem;
                                    firstItem = false;
                                    <div @key="series.Id" class="series-node @(isFocused ? "focused-series" : "")"
                                         role="treeitem"
                                         aria-level="2"
                                         tabindex="-1"
                                         aria-selected="@(isFocused ? "true" : "false")"
                                         aria-expanded="@(series.Components.Count > 0 ? ExpandedAttr(IsSeriesOpen(series.Id)) : null)"
                                         aria-label="@($"{series.FriendlyName}, {series.Components.Count} components, {(series.IsVisible ? "visible" : "hidden")}, {(series.IsMuted ? "muted" : "audible")}{(isFocused ? ", focused" : "")}")">

                                        @* aria-expanded above is null for a series with no components:
                                           a treeitem that declares itself collapsed and has nothing to
                                           reveal promises children that do not exist, and ArrowRight on it
                                           does nothing. A drawing abandoned mid-placement is exactly this —
                                           its calculator returns no components when a required anchor is
                                           null. ConditionTreeEditor already renders null for its leaves. *@
                                        <details @onclick:stopPropagation="true" class="series-details"
                                                 open="@IsSeriesOpen(series.Id)"
                                                 @ontoggle="() => OnSeriesToggled(series.Id)">
                                            <summary class="series-summary"
                                                     data-tree-activate="true"
                                                     @onclick="() => FocusSeries(series.Id)">
                                                <span class="series-name">@series.FriendlyName</span>
                                                <div class="series-actions">
                                                    @* Label states the ACTION the button performs (like IndicatorBar), with no
                                                       aria-pressed — a verb label plus a pressed state is two signals that can
                                                       contradict each other. *@
                                                    <button title="Toggle Visibility (H)"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => ToggleHide(series.Id)"
                                                            aria-label="@($"{(series.IsVisible ? "Hide" : "Show")} {series.FriendlyName}")">
                                                        @(series.IsVisible ? "Hide" : "Show")
                                                    </button>
                                                    <button title="Toggle Audio (M)"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => ToggleMute(series.Id)"
                                                            aria-label="@($"{(series.IsMuted ? "Unmute" : "Mute")} {series.FriendlyName}")">
                                                        @(series.IsMuted ? "Unmute" : "Mute")
                                                    </button>
                                                    @if (series.Id != CoreSeriesIds.Candles && series.Id != CoreSeriesIds.Price)
                                                    {
                                                        <button title="Remove" class="danger-btn"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="() => RemoveSeriesAsync(series.Id)"
                                                                aria-label="@($"Delete {series.FriendlyName}")">
                                                            Delete
                                                        </button>
                                                    }
                                                </div>
                                            </summary>

                                            <div role="group" class="component-list">
                                                @foreach (var comp in series.Components)
                                                {
                                                    var compLabel = string.IsNullOrWhiteSpace(comp.DisplayName) ? comp.Name : comp.DisplayName;
                                                    <div class="component-item" role="treeitem"
                                                         aria-level="3"
                                                         tabindex="-1"
                                                         aria-label="@($"{compLabel}, {DisplayTypeName(comp.DisplayType)}, {(comp.IsVisible ? "visible" : "hidden")}, {(comp.IsMuted ? "muted" : "audible")}")">
                                                        <span class="comp-name">@compLabel (@DisplayTypeName(comp.DisplayType))</span>
                                                        <div class="comp-actions">
                                                            @* Named per component, the way the series buttons above are.
                                                               Named by their own text they were "Hide" and "Mute" on every
                                                               row: a five-component series put five identical "Hide"
                                                               buttons in the screen reader's button list, and `title` does
                                                               not become the name when the element has text content. Each
                                                               label still OPENS with the visible word, so WCAG 2.5.3
                                                               containment holds. *@
                                                            <button class="mini-btn"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => ToggleCompHide(series.Id, comp.Name)"
                                                                    aria-label="@($"{(comp.IsVisible ? "Hide" : "Show")} {compLabel} in {series.FriendlyName}")">
                                                                @(comp.IsVisible ? "Hide" : "Show")
                                                            </button>
                                                            <button class="mini-btn"
                                                                    @onclick:stopPropagation="true"
                                                                    @onclick="() => ToggleCompMute(series.Id, comp.Name)"
                                                                    aria-label="@($"{(comp.IsMuted ? "Unmute" : "Mute")} {compLabel} in {series.FriendlyName}")">
                                                                @(comp.IsMuted ? "Unmute" : "Mute")
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    </div>
                                }
                            </div>
                        </details>
                    }
                </div>
            }

            <div class="modal-footer" style="margin-top: 20px; border-top: 1px solid #333; padding-top: 15px;">
                <div style="font-size: 0.8rem; color: var(--text-muted); flex: 1;">
                    Up and down arrows move through the tree · Right and left arrows expand and collapse ·
                    Home and End jump to first and last · Space or Enter toggles a group or focuses a series ·
                    Tab reaches the Hide, Mute and Delete buttons · Escape closes@(Demo.AllowStrategies ? " · Alt+S for Strategies" : "")
                </div>
                <button @onclick="Close" id="objtree-close" aria-label="Close object tree dialog">Close</button>
            </div>
        </div>
    </div>
}

<style>
    .tree-viewport {
        max-height: 500px;
        overflow-y: auto;
        background: #111;
        padding: 10px;
        border-radius: 4px;
    }
    .pane-node { margin-bottom: 10px; }
    .pane-header {
        padding: 8px;
        background: #222;
        cursor: pointer;
        font-weight: bold;
        border-radius: 4px;
        color: #4ec9b0;
    }
    .pane-content { padding-left: 15px; margin-top: 5px; }
    
    .series-node {
        margin: 4px 0;
        border-radius: 4px;
        border: 1px solid transparent;
    }
    .focused-series {
        background: #1e2a3a;
        border-color: #0078d4;
    }
    
    .series-summary {
        display: flex;
        align-items: center;
        padding: 6px;
        cursor: pointer;
        list-style: none;
    }
    .series-summary::-webkit-details-marker { display: none; }
    
    .series-name { flex: 1; font-weight: 500; }
    .series-actions { display: flex; gap: 4px; }
    
    .component-list {
        padding: 5px 10px 5px 30px;
        background: #161616;
        font-size: 0.9rem;
    }
    .component-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 0;
        border-bottom: 1px solid #222;
    }
    .comp-name { color: var(--text-muted); }
    .comp-actions { display: flex; gap: 2px; }

    button.mini-btn {
        padding: 2px 4px;
        font-size: 0.7rem;
        background: transparent;
        border: none;
        cursor: pointer;
    }
    
    button.danger-btn { color: #f44; background: transparent; border: none; cursor: pointer; }
    button.danger-btn:hover { background: #311; }
</style>

@code {
    private bool _isVisible;

    // ── disclosure state ─────────────────────────────────────────────────────
    //
    // role="treeitem" on a <summary> REPLACES the native disclosure mapping: the browser
    // stops exposing "expanded/collapsed" from the <details> and takes it from
    // aria-expanded instead. So the state has to be rendered, and rendering it means
    // knowing it in C# — which the component did not, because <details> is toggled by
    // three parties that never call back here: the browser (a click on the summary),
    // treeKeyboard.js (`d.open = !d.open` on Left/Right/Space), and the user's own
    // keyboard on the summary.
    //
    // The `toggle` event is the one thing all three have in common — the HTML spec fires
    // it on every open-state change however it was caused — and Blazor treats `toggle` as
    // a non-bubbling event, attaching the handler straight to the element rather than
    // delegating at the document (`toggle` does not bubble, so a delegated listener would
    // never see it). The handler flips our copy, so C# and the DOM cannot drift.
    //
    // Sets rather than per-node bools because the node list is rebuilt on every render
    // from the store; keying on pane name / series id survives a series being added or
    // removed underneath the user.
    //
    // Note the ASYMMETRY, and it is deliberate: panes render OPEN (the tree is useless
    // shut) and series render CLOSED (a component list under every series buries the
    // series names the panel exists to list). So the two sets store opposite things —
    // a pane in _closedPanes is shut, a series in _openSeries is open — and both default
    // to the empty set.
    private readonly HashSet<string> _closedPanes = new(StringComparer.Ordinal);
    private readonly HashSet<string> _openSeries = new(StringComparer.Ordinal);

    private bool IsPaneOpen(string paneKey) => !_closedPanes.Contains(paneKey);
    private bool IsSeriesOpen(string seriesId) => _openSeries.Contains(seriesId);

    private void OnPaneToggled(string paneKey)
    {
        // The toggle event carries no state — EventArgs.Empty — so this flips rather
        // than reads. That is exact: `toggle` fires if and only if the state changed.
        if (!_closedPanes.Remove(paneKey)) _closedPanes.Add(paneKey);
    }

    private void OnSeriesToggled(string seriesId)
    {
        if (!_openSeries.Remove(seriesId)) _openSeries.Add(seriesId);
    }

    /// <summary>
    /// aria-expanded takes the strings "true"/"false", never a bare boolean — Blazor renders a
    /// false bool by OMITTING the attribute, which for aria-expanded means "not expandable"
    /// rather than "collapsed". Named with the <c>…Attr</c> suffix the rest of the library uses
    /// for string-typed ARIA values (ToolbarIconButton's <c>PressedAttr</c>), which is also what
    /// <c>ModalContractScanTests.NoAriaStateAttributeIsBoundToABareBoolean</c> recognises.
    /// </summary>
    private static string ExpandedAttr(bool value) => value ? "true" : "false";

    private IDisposable? _eventSub;
    private IDisposable? _stateSub;
    private IDisposable? _closeSub;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenObjectTreeEvent>(_ => InvokeAsync(ShowAsync));
        _stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(StateHasChanged));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Object tree") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Object tree"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "objtree-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        // Both disclosure sets are dropped here, and that is deliberate rather than tidy-up.
        // They are keyed by pane NAME and series ID, neither of which is unique over time: delete
        // the RSI series and add another one in the same pane and the pane comes back — collapsed,
        // if it was collapsed when it vanished, contradicting the documented default that panes
        // open. Core series ids (`volume`, `heatmap`) are removable and re-creatable with the same
        // id, so the series set has the same problem. Clearing on close bounds both sets to one
        // sitting and puts every open back at the documented default.
        _closedPanes.Clear();
        _openSeries.Clear();
        EventBus.Publish(new ModalStateChangedEvent(false, "Object tree"));
        StateHasChanged();
    }

    private void OpenStrategies()
    {
        Close();
        EventBus.Publish(new OpenStrategiesEvent());
    }

    private void FocusSeries(string id) => Store.Dispatch(new SelectSeriesAction(id));

    private void ToggleHide(string id)
    {
        Store.Dispatch(new SelectSeriesAction(id));
        EventBus.Publish(new ToggleHideEvent());
    }

    private void ToggleMute(string id)
    {
        Store.Dispatch(new SelectSeriesAction(id));
        EventBus.Publish(new ToggleMuteEvent());
    }

    private void ToggleCompHide(string seriesId, string compName)
    {
        Store.Dispatch(new ToggleHideAction(seriesId, compName));
    }

    private void ToggleCompMute(string seriesId, string compName)
    {
        Store.Dispatch(new ToggleMuteAction(seriesId, compName));
    }

    private static string DisplayTypeName(AccessibleTrader.Sdk.Models.ComponentDisplayType dt) => dt switch
    {
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Line       => "Line",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Area       => "Area",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Oscillator => "Oscillator",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Histogram  => "Histogram",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Bar        => "Bar",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Dot        => "Dot",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Arrow      => "Arrow",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.StepLine   => "Step Line",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Gradient   => "Gradient",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Cloud      => "Cloud",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.Heatmap    => "Heatmap",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.ZeroArea   => "Oscillator",
        AccessibleTrader.Sdk.Models.ComponentDisplayType.ZeroDot    => "Dot",
        _                                                            => dt.ToString()
    };

    /// <summary>
    /// Remove a series, and put focus somewhere that still exists.
    ///
    /// <para>The Delete button lives inside the treeitem it deletes, so the element under
    /// the user's focus is removed by their own keystroke. Blazor does not move focus for
    /// you: it falls to <c>&lt;body&gt;</c> — OUTSIDE a container carrying
    /// <c>aria-modal="true"</c>, so the screen reader's buffer is still restricted to a
    /// dialog its focus is no longer in, and the next Tab restarts at the top of the
    /// dialog rather than near where the user was. Focus goes to the dialog heading, the
    /// same target the dialog uses when it opens.</para>
    /// </summary>
    private async Task RemoveSeriesAsync(string id)
    {
        var s = Store.State.ActiveSeries.FirstOrDefault(x => x.Id == id);
        if (s == null) return;

        Store.Dispatch(new RemoveSeriesAction(id));
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, $"{s.Name} removed"));
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "objtree-title"); } catch { }
    }

    public void Dispose()
    {
        _eventSub?.Dispose();
        _stateSub?.Dispose();
        _closeSub?.Dispose();
    }
}
