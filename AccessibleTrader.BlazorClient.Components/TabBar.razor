@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services
@using Microsoft.AspNetCore.Components.Web
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@implements IDisposable

@* Workspace tab switcher — rendered between the Toolbar (timeframe row) and the
   chart area. Always visible (even with a single tab) so the "+ new tab" button is
   always available — important on the web, where Ctrl+T is reserved by the browser.

   Two ways to drive it:
   • Desktop: Ctrl+Tab / Ctrl+Shift+Tab cycle tabs directly (CommandDispatcher).
   • Web: Ctrl+Tab and Ctrl+Number are reserved by the browser, so the user presses
     Ctrl+Alt+Shift+T (FocusTabBar) to move focus onto this bar, then drives it with
     ArrowLeft/Right (or Up/Down), Home/End, the number row (1-9 → tab N), Delete
     (close the active tab) and Insert / + (new tab). Implemented as an ARIA tablist
     with the activedescendant pattern: the container holds focus (tabindex 0) and
     aria-activedescendant points at the selected tab; selection follows focus, so
     each arrow press switches tabs. A web-safe global new-tab chord is Alt+Shift+N. *@

<div class="tab-bar"
     id="workspace-tabbar"
     role="tablist"
     tabindex="0"
     aria-label="Workspace tabs. Use arrow keys, Home, End, or the number row to switch; Insert to open a tab; Delete to close one."
     aria-orientation="horizontal"
     aria-activedescendant="@($"ws-tab-{Store.State.ActiveTabIndex}")"
     @onkeydown="OnKeyDown"
     @onkeydown:stopPropagation="true">

    @{ bool canClose = Store.State.TabCount > 1; }

    @foreach (var tab in GetAllTabs())
    {
        var captured = tab;
        <button @key="captured.Index"
                id="@($"ws-tab-{captured.Index}")"
                role="tab"
                aria-selected="@(captured.IsActive ? "true" : "false")"
                tabindex="-1"
                class="tab-button@(captured.IsActive ? " tab-active" : "")"
                title="Switch to tab @(captured.Index + 1)"
                @onclick="() => Store.Dispatch(new SwitchTabAction(captured.Index))">
            Tab @(captured.Index + 1): @captured.Label
            @if (canClose)
            {
                <button class="tab-close"
                        tabindex="-1"
                        aria-label="Close tab @(captured.Index + 1)"
                        @onclick:stopPropagation="true"
                        @onclick="() => Store.Dispatch(new CloseTabAction(captured.Index))">
                    ×
                </button>
            }
        </button>
    }

    @* New tab button — always present. Desktop also has Ctrl+T; everywhere Alt+Shift+N. *@
    <button class="tab-new"
            tabindex="-1"
            title="New tab (Alt+Shift+N)"
            aria-label="Open new chart tab"
            @onclick="() => Store.Dispatch(new AddTabAction())">
        +
    </button>

</div>

@code {
    private readonly List<IDisposable> _subs = new();

    private readonly record struct TabItem(int Index, string Label, bool IsActive);

    protected override void OnInitialized()
    {
        // Re-render whenever workspace state changes. Without this, tabs added from
        // outside this component's own DOM events — the Ctrl+T / Alt+Shift+N keyboard
        // command or "Open in New Tab" from the Toolbar — update Store.State but never
        // repaint the bar, so a new tab wouldn't appear until an unrelated click on the
        // bar forced Blazor to re-render. Selection changes need the same refresh.
        var stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(StateHasChanged));
        _subs.Add(stateSub);

        // Ctrl+Alt+Shift+T → CommandDispatcher publishes FocusTabBarEvent → move keyboard
        // focus onto this bar so it can be operated without the browser-reserved Ctrl+Tab.
        var focusSub = EventBus.AsObservable<FocusTabBarEvent>()
            .Subscribe(_ => InvokeAsync(async () =>
            {
                try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "workspace-tabbar"); }
                catch { /* JS bridge may not be ready during early renders or unit tests */ }
            }));
        _subs.Add(focusSub);
    }

    private IEnumerable<TabItem> GetAllTabs()
    {
        int count = Store.State.TabCount;
        int active = Store.State.ActiveTabIndex;
        var snaps = (Store.State.TabSnapshots ?? System.Collections.Immutable.ImmutableList<AccessibleTrader.Sdk.Models.TabSnapshot>.Empty)
            .ToDictionary(t => t.TabIndex);

        for (int i = 0; i < count; i++)
        {
            if (i == active)
            {
                yield return new TabItem(i, ActiveLabel(), true);
            }
            else if (snaps.TryGetValue(i, out var snap))
            {
                yield return new TabItem(i, SnapshotLabel(snap), false);
            }
            // If a slot has no snapshot (shouldn't happen), skip it rather than render a blank tab.
        }
    }

    private string ActiveLabel()
    {
        var id = Store.State.Identity;
        return string.IsNullOrEmpty(id.Symbol) ? "New Tab" : $"{id.Symbol} {id.Timeframe}";
    }

    private string SnapshotLabel(AccessibleTrader.Sdk.Models.TabSnapshot snap)
    {
        return string.IsNullOrEmpty(snap.Identity.Symbol) ? "New Tab" : $"{snap.Identity.Symbol} {snap.Identity.Timeframe}";
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        // stopPropagation on the element keeps these keys from also reaching the global
        // keyboard handler (which would treat the arrows as chart nav), so we only need
        // to act on the ones we own here. Selection follows focus: each move switches tab.
        int count = Store.State.TabCount;
        int active = Store.State.ActiveTabIndex;

        // Insert / + : open a new tab (works even with a single tab open).
        if (e.Key is "Insert" or "+" or "=")
        {
            Store.Dispatch(new AddTabAction());
            return;
        }

        // The remaining keys only make sense with more than one tab.
        if (count <= 1) return;

        // Number row: 1-9 jump straight to that tab.
        if (e.Key.Length == 1 && e.Key[0] >= '1' && e.Key[0] <= '9')
        {
            int idx = e.Key[0] - '1';
            if (idx < count && idx != active)
                Store.Dispatch(new SwitchTabAction(idx));
            return;
        }

        switch (e.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                Store.Dispatch(new SwitchTabAction((active + 1) % count));
                break;
            case "ArrowLeft":
            case "ArrowUp":
                Store.Dispatch(new SwitchTabAction((active - 1 + count) % count));
                break;
            case "Home":
                if (active != 0) Store.Dispatch(new SwitchTabAction(0));
                break;
            case "End":
                if (active != count - 1) Store.Dispatch(new SwitchTabAction(count - 1));
                break;
            case "Delete":
                Store.Dispatch(new CloseTabAction(active));
                break;
        }
    }

    public void Dispose()
    {
        foreach (var s in _subs) s.Dispose();
    }
}
