@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@implements IDisposable
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IShortcutManager ShortcutManager

@* Help modal: combined keyboard shortcut reference and usage guide.
   Content sources: docs/SHORTCUTS.md (key bindings) + docs/USER_GUIDE.md (conceptual sections).
   Opens via OpenHelpEvent from CommandDispatcher (F1 shortcut). *@

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Help"
             aria-modal="true"
             aria-labelledby="help-title"
             style="max-width:680px; max-height:80vh; overflow-y:auto;"
             @onclick:stopPropagation="true">

            <h2 id="help-title" tabindex="-1">Help — Guide &amp; Keyboard Reference</h2>

            <p style="color:var(--text-muted, #555); font-size:0.88rem; margin-top:0;">
                Accessible Trade Terminal is a fully keyboard-driven chart platform for blind and visually impaired traders.
                Use the sections below to learn how the platform works and what keys to press.
            </p>

            @* Every section title is an <h3> INSIDE its <summary>, which the HTML content model
               for <summary> allows explicitly ("phrasing content, optionally intermixed with
               heading content"). It cannot be the other way round — <summary> must be the first
               child of <details>, so wrapping it in an <h3> breaks the disclosure outright.

               This is the screen where heading navigation matters most and it had ONE heading for
               eighteen sections: 471 lines reachable only by arrowing through them. The h3 is
               styled to render exactly as the bold summary text did (display:inline, and font
               size/weight inherited from the <summary>) so nothing moves visually.

               Inline styles rather than a class on purpose: there are two copies of app.css and
               they have already drifted, so a class added to one head would leave the other's
               headings rendering at 1.17em with 1em margins.

               display:inline, and not display:contents, which renders the same. That choice was
               made against display:contents' history of removing elements from the accessibility
               tree, and it is NOT backed by a demonstration here: a sabotage swapping one for the
               other left the browser suite green, but Playwright's role queries are its own
               in-page ARIA implementation — which has explicit display:contents handling of its
               own — so that sabotage measured the harness, not the browser. display:inline is
               kept because it is the version that needs no assumption. What IS demonstrated is
               the construct itself: Chromium's real accessibility tree, read over CDP in
               LandmarkAndHeadingBrowserTests, reports all eighteen as unignored level-3 headings.
               Firefox and Orca — the stack this product is actually used on — were not tested.

               Do not add tabindex to these headings. Both Tab counters — keyboard.js's
               focusableSelector and TerminalPage.TabStopCountInTopDialogAsync — would gain 18
               stops where Enter does nothing, and the browser contract's floor would stay green. *@

            @* ── CONCEPTUAL SECTIONS (User Guide content) ────────────────────── *@

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Getting started (first chart in five steps)</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <ol style="margin:4px 0 4px 1.2em;">
                        <li>Pick a <strong>Market</strong> in the toolbar (Crypto needs no account or key).</li>
                        <li>Pick a <strong>Provider</strong> — Bitstamp for crypto works immediately.</li>
                        <li>Pick or search a <strong>Symbol</strong> (e.g. BTC/USD) and a <strong>Timeframe</strong>.</li>
                        <li>Press the <strong>Load</strong> button. The terminal announces when data is ready.</li>
                        <li>Press <strong>Ctrl+Alt+Shift+C</strong> to focus the chart, then use the
                            <strong>arrow keys</strong> to hear the bars — or press <strong>Space</strong> to play them.</li>
                    </ol>
                    <p>
                        The full quick-start walkthrough and the complete user manual ship with the
                        project as <code>docs/QUICKSTART.md</code> and <code>docs/USER_MANUAL.md</code>,
                        and are readable on the project's GitHub page.
                    </p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Understanding the Soundscape</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p>The terminal uses a <strong>Hybrid Voice</strong> system. Your screen reader provides exact data values. The sonification engine provides the <em>shape</em> of the market.</p>
                    <ul style="margin:4px 0 4px 1.2em;">
                        <li><strong>High Pitch</strong> — High price. Low pitch = low price.</li>
                        <li><strong>Gliding Tone (Continuous)</strong> — A trend or moving average; the pitch slides as price moves.</li>
                        <li><strong>Short Beep (Discrete)</strong> — A single data point such as a Volume bar.</li>
                        <li><strong>Square Wave</strong> — Point of Control (POC) on a Volume Profile.</li>
                        <li><strong>Sawtooth Texture</strong> — Liquidity Heatmap data.</li>
                        <li><strong>Chimes / Earcons</strong> — System events: order filled, connection lost, drawing anchor set, boundary reached.</li>
                        <li><strong>Left/Right Panning</strong> — Position in time. Oldest bar = left channel; newest bar = right channel.</li>
                    </ul>
                    <p>Tip: Use <strong>F3</strong> to toggle sonification on/off. Use <strong>F7 / Shift+F7</strong> to adjust chart master volume.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Volume Profile Navigation</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p>When you focus a Volume Profile (VPVR/VPFR/TPO) series using <strong>Page Up/Down</strong>:</p>
                    <ul style="margin:4px 0 4px 1.2em;">
                        <li><strong>Left/Right arrows are silenced</strong> — profiles are vertical distributions, not time series.</li>
                        <li><strong>Up/Down arrows</strong> move through price bins. Each bin is announced with price range, volume, and percentage of session total.</li>
                        <li><strong>Square Wave</strong> plays at the Point of Control (POC) — the price level with the most volume.</li>
                        <li>Your screen reader announces when you enter the <strong>Value Area</strong> (the 70% distribution zone, between VAL and VAH).</li>
                        <li>Bin types: LVN (220 Hz, sine), Normal (330 Hz), VAL (440 Hz), VAH (550 Hz), HVN (660 Hz, triangle), POC (880 Hz, sine + click transient).</li>
                    </ul>
                    <p>For Liquidity Heatmaps: Left/Right moves through time columns; Up/Down moves through price bins. Sawtooth waveform throughout.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Drawing Tools Workflow</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p>All drawing tools use <strong>Sequential Anchoring</strong> — navigate to each point and press the shortcut. No holding keys required.</p>

                    <p><strong>Trendline (Ctrl+Shift+T) — 2 anchors:</strong></p>
                    <ol style="margin:2px 0 8px 1.2em;">
                        <li>Navigate to the start point. Press <kbd>Ctrl+Shift+T</kbd>. Speech: "Anchor 1 set."</li>
                        <li>Navigate to the end point. Press <kbd>Ctrl+Shift+T</kbd>. The line is drawn.</li>
                    </ol>

                    <p><strong>Fibonacci Retracement (Ctrl+Shift+F) — 2 anchors:</strong></p>
                    <ol style="margin:2px 0 8px 1.2em;">
                        <li>Navigate to the swing High. Press <kbd>Ctrl+Shift+F</kbd>.</li>
                        <li>Navigate to the swing Low. Press <kbd>Ctrl+Shift+F</kbd>. Levels are drawn.</li>
                    </ol>

                    <p><strong>Risk/Reward Tool — 3 anchors:</strong></p>
                    <ol style="margin:2px 0 8px 1.2em;">
                        <li>Navigate to <strong>Entry</strong> price. Press the Risk/Reward shortcut. Speech: "Anchor 1 set."</li>
                        <li>Navigate to <strong>Stop Loss</strong> level. Press again. Speech: "Entry set. Navigate to take profit."</li>
                        <li>Navigate to <strong>Target</strong>. Press again. Speech announces your Risk-to-Reward ratio.</li>
                    </ol>

                    <p><strong>Anchored VWAP:</strong> Navigate to the anchor candle (e.g., a high-volume spike or news event). Press the AVWAP shortcut. A VWAP line projects forward from that point and can be navigated like any indicator.</p>

                    <p>Press <kbd>Escape</kbd> at any time to cancel an in-progress drawing.</p>

                    <p><strong>Moving an anchor afterwards — the keyboard nudge:</strong> focus the drawing with
                    <kbd>Page Up</kbd> / <kbd>Page Down</kbd>, then <kbd>Shift+Left</kbd> / <kbd>Shift+Right</kbd>
                    move the selected anchor one <em>bar</em> earlier or later (weekends and halts are stepped over) and
                    <kbd>Shift+Up</kbd> / <kbd>Shift+Down</kbd> move its price by one percent of the visible range.
                    Hold the key and you hear a tick while it moves; one sentence follows when you stop:
                    "End: 105.20 at June 15, 09:30. Trend line 2, anchor 2 of 2." <kbd>Ctrl+Alt+Shift+G</kbd> selects the
                    next anchor (the first press only says which one is selected), <kbd>Ctrl+Alt+Shift+B</kbd> snaps the
                    selected anchor to its bar's high, then low, open and close on repeated presses, and <kbd>Shift+F1</kbd>
                    names the selected anchor without moving it. A run of nudges is one <kbd>Ctrl+Z</kbd>. Exact values
                    are typed in <strong>Properties</strong>. The same six actions are in the drawing's context menu
                    (<kbd>Shift+F10</kbd>) for voice control and switch access. On a Mac with VoiceOver's modifier set to
                    Control+Option, the Ctrl+Alt+Shift chords are VoiceOver's; set the modifier to Caps Lock, or pass the
                    key through with VO+Tab.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Indicators &amp; Customization</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p>Press <strong>Alt+A</strong> (or the Indicators button in the toolbar) to open the Indicator search. Indicators are grouped by type:</p>
                    <ul style="margin:4px 0 4px 1.2em;">
                        <li><strong>Trend:</strong> Moving Averages (SMA, EMA, WMA), Ichimoku, ADX, PSAR.</li>
                        <li><strong>Momentum:</strong> RSI, MACD, Stochastics, CCI, Williams %R.</li>
                        <li><strong>Volatility:</strong> Bollinger Bands, ATR, Keltner Channels.</li>
                        <li><strong>Volume:</strong> OBV, Chaikin, VWAP, Volume bars.</li>
                        <li><strong>Profiles:</strong> Volume Profile (VPVR/VPFR), TPO/Market Profile.</li>
                    </ul>
                    <p>Once an indicator is on the chart, focus it with <strong>Page Up/Down</strong>. Press <strong>P</strong> to open its properties. Press <strong>H</strong> to toggle visibility. Press <strong>M</strong> to toggle audio mute. Press <strong>Delete</strong> to remove it — and if that was a mistake, <strong>Ctrl+Z</strong> brings it back. Ctrl+Z also reverses an accidentally dragged drawing anchor; <strong>Ctrl+Y</strong> redoes.</p>
                    <p>Use <strong>F5/Shift+F5</strong> to cycle the focused component's volume. <strong>F6/Shift+F6</strong> for the full series. <strong>F7/Shift+F7</strong> for chart master volume.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Market watch — watchlists &amp; the screener</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p>Press <strong>Alt+M</strong>, or the <strong>Watch</strong> button on the toolbar's first row. Three tabs:</p>
                    <ul style="margin:4px 0 4px 1.2em;">
                        <li><strong>Watchlists</strong> — named, ordered lists of symbols. Pick symbols from the
                            provider's real list through the same Market → Provider → Sub-type → Symbol cascade the
                            toolbar uses; the chart you were looking at is pre-filled. Type in <strong>Filter
                            symbols</strong> to narrow a long list — the count under the picker tells you how many are
                            showing out of how many exist — and use <strong>Add all shown</strong> to build a list fast.</li>
                        <li><strong>Build a screen</strong> — add filter rows (indicator → component → condition →
                            values) and choose whether all must be true, any may be, or enough by weight. Only the
                            value boxes the chosen condition uses appear, and each row is restated in plain English
                            underneath so you can check it in one read.</li>
                        <li><strong>Run screener</strong> — pick a saved screen, a watchlist and a timeframe, then
                            press Run. Results are a table you can move through cell by cell. Symbols that could not
                            be evaluated are always shown, never dropped.</li>
                    </ul>
                    <p><strong>Bars of history per symbol</strong> must exceed the warmup of the slowest indicator you
                       reference, or every symbol reports "not enough history". 500 covers everything that ships.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Structure, value zones &amp; the respect report</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p><strong>Market Structure</strong> is on your charts by default. It marks swing highs (red
                       square) and lows (green square), labels each higher or lower than the last, and adds a
                       <strong>Break of Structure</strong> (amber X) for continuation and a <strong>Change of
                       Character</strong> (larger purple X) for the first evidence a trend may be over. Turn it off in
                       Settings → Analysis if you would rather add it per chart. The squares-and-crosses family is
                       deliberate: Value Deviation owns triangles, dots and diamonds, so the two never look alike on
                       one chart.</p>
                    <p><em>Read it as context, not as an entry.</em> A swing mark sits on its pivot bar but cannot be
                       identified until five more bars have failed to exceed it, so it appears where you could never
                       have traded.</p>
                    <p><strong>Value Deviation</strong> (add it from the Indicator dialog) marks where price reversed
                       relative to value — a rolling volume profile's point of control. Below value marks a support
                       zone, above it a resistance zone, across five tiers per side carried in shape, colour and pitch.
                       Its <strong>Show tiers from</strong> setting is the density control — it defaults to 2, and
                       raising it to 3 or 4 clears a busy weekly chart. It hides glyphs only; speech still reports
                       every tier.</p>
                    <p><strong>Respect report</strong> — <strong>Alt+R</strong>, or the <strong>Levels</strong> toolbar
                       button. Measures which levels and moving averages this market actually holds: hold rate, touch
                       count, median reaction in ATR, support-versus-resistance split, and how long ago. Wicks through
                       and straight back count as holds — that is a sweep, the level working. Leave "only lines with at
                       least N touches" ticked; two touches and a 100% hold rate is two coincidences.</p>
                </div>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Bar replay</h3></summary>
                <div style="padding:8px 0 4px; font-size:0.9rem; line-height:1.6;">
                    <p><strong>Bar replay</strong> hides everything after the bar you are on and gives it back one bar
                       at a time, so you can practise reading a market without hindsight. Start and stop with
                       <strong>Ctrl+Alt+Shift+P</strong> (or <strong>F11</strong> on the desktop) or the
                       <strong>Replay</strong> toolbar button; <strong>F9</strong> reveals the next bar,
                       <strong>Shift+F9</strong> takes one back, <strong>F10</strong> auto-advances. Indicators
                       recompute on the revealed bars only, so they read what they would have read then.</p>
                </div>
            </details>

            @* ── KEYBOARD REFERENCE (Shortcut tables) ─────────────────────── *@

            <details open style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Chart Navigation</h3></summary>
                <table class="shortcuts-table">
                    <thead><tr><th>Key</th><th>Action</th><th>Speech Feedback</th></tr></thead>
                    <tbody>
                        <tr><td>← / →</td><td>Move cursor one bar left or right</td><td>Bar data (price, indicators)</td></tr>
                        <tr><td>↑ / ↓</td><td>Switch component within the focused series</td><td>Component value</td></tr>
                        <tr><td>Page Up / Page Down</td><td>Switch to previous or next series</td><td>Series name and component count</td></tr>
                        <tr><td>Home</td><td>Jump to first visible bar (viewport start)</td><td>Bar data</td></tr>
                        <tr><td>End</td><td>Jump to last visible bar (viewport end)</td><td>Bar data</td></tr>
                        <tr><td>\</td><td>Snap to live (newest) bar</td><td>Bar data</td></tr>
                        <tr><td>[ / ]</td><td>Pan viewport left or right</td><td>"Viewing X bars from…"</td></tr>
                        <tr><td>- / =</td><td>Zoom out (more bars) / zoom in (fewer bars)</td><td>"Viewing X bars from…"</td></tr>
                        <tr><td>Shift+[ / Shift+]</td><td>Decrease / increase panning step percentage</td><td>"Panning step: N percent"</td></tr>
                        <tr><td>Ctrl+← / Ctrl+→</td><td>Jump to previous / next trendline crossing</td><td>"Trendline crossing" or "No crossing found"</td></tr>
                        <tr><td>Alt+Page Up / Alt+Page Down</td><td>Move to the previous / next pane — the next Y axis up or down the chart</td><td>Series name, then the pane name at the end</td></tr>
                        <tr><td>Ctrl+↑ / Ctrl+↓</td><td>Walk the components of the strip you are in, across every series in the pane</td><td>Component value</td></tr>
                        <tr><td>Alt+Shift+/</td><td>Describe this pane: what each axis measures, its range, and the step between gridlines</td><td>"Main pane, 1 of 3. Y axis, price: 94,000 to 98,000…"</td></tr>
                        <tr><td>, / .</td><td>Step to the previous / next chart-formation edge</td><td>Edge name and bar data</td></tr>
                        <tr><td>;</td><td>Cycle the chosen formation under the cursor</td><td>Formation name</td></tr>
                        <tr><td>Shift+;</td><td>Clear the chosen formation</td><td>"Formation focus cleared"</td></tr>
                        <tr><td>Ctrl+Alt+Shift+C</td><td>Focus chart area and speak context summary</td><td>Symbol + context summary</td></tr>
                    </tbody>
                </table>
            </details>

            <details style="margin-bottom:12px;">
