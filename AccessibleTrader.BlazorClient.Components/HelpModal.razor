            @*
                Orientation, tabs and workspaces. These were absent from this dialog until
                2026-08-26 while docs/SHORTCUTS.md carried all of them — which is the worst
                shape the drift can take, because the in-app help is the copy a user reaches
                without leaving the terminal. ShortcutHelpParityTests now fails the build if
                a default binding is missing from either.
            *@
            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Orientation &amp; recovery</h3></summary>
                <table class="shortcuts-table">
                    <thead><tr><th>Key</th><th>Action</th></tr></thead>
                    <tbody>
                        <tr><td>Ctrl+Alt+Shift+Y</td><td>Speak the chart layout — what is on screen and where</td></tr>
                        <tr><td>Alt+Shift+/</td><td>Speak THIS pane — what its axes measure, their ranges, and the step between gridlines</td></tr>
                        <tr><td>Ctrl+Alt+Shift+K</td><td>Show all components (undo every hide)</td></tr>
                        <tr><td>Ctrl+Alt+Shift+U</td><td>Unmute all components (undo every mute)</td></tr>
                        <tr><td>Ctrl+Alt+Shift+M</td><td>Speak the background monitoring summary</td></tr>
                    </tbody>
                </table>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Chart tabs &amp; workspaces</h3></summary>
                <p style="font-size:0.82rem; color:var(--text-muted,#666); margin:4px 0 8px;">
                    Browsers reserve Ctrl+T and Ctrl+Tab for their own tabs, so the web host also
                    binds Alt+Shift+N (new chart tab) and Ctrl+Alt+Shift+T (focus the tab bar and
                    drive it with the arrow keys). Both chords work on every head.
                </p>
                <table class="shortcuts-table">
                    <thead><tr><th>Key</th><th>Action</th></tr></thead>
                    <tbody>
                        <tr><td>Ctrl+T / Alt+Shift+N</td><td>New chart tab</td></tr>
                        <tr><td>Ctrl+W</td><td>Close the active chart tab</td></tr>
                        <tr><td>Ctrl+Tab / Ctrl+Shift+Tab</td><td>Next / previous chart tab (desktop)</td></tr>
                        <tr><td>Ctrl+Alt+Shift+T</td><td>Focus the tab bar (web-safe; then arrows, Home, End, Delete)</td></tr>
                        <tr><td>Ctrl+Alt+Shift+W</td><td>Save the workspace</td></tr>
                        <tr><td>Ctrl+Alt+W</td><td>Load a workspace</td></tr>
                        <tr><td>Ctrl+Alt+Shift+L</td><td>Load a chart</td></tr>
                        <tr><td>Ctrl+Alt+Shift+I</td><td>Open My Data (cached history and stored files)</td></tr>
                    </tbody>
                </table>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Quick trade (keyboard order entry)</h3></summary>
                <p style="font-size:0.82rem; color:var(--text-muted,#666); margin:4px 0 8px;">
                    Three-modifier chords, deliberately: these move money and must be impossible to
                    hit by accident. Nothing is sent until you are armed, and the stop is set before
                    the size — the size is computed <em>from</em> the stop distance. See
                    <strong>docs/SHORTCUTS.md</strong> for the full workflow.
                </p>
                <table class="shortcuts-table">
                    <thead><tr><th>Key</th><th>Action</th></tr></thead>
                    <tbody>
                        <tr><td>Ctrl+Alt+Shift+X</td><td>Set the stop at the focused bar's price — do this first</td></tr>
                        <tr><td>Ctrl+Alt+Shift+1 / Ctrl+Alt+Shift+2 / Ctrl+Alt+Shift+3</td><td>Arm at risk tier 1, 2 or 3</td></tr>
                        <tr><td>Ctrl+Alt+Shift+0</td><td>Disarm — cancel the armed quick trade</td></tr>
                        <tr><td>Ctrl+Alt+Shift+Q</td><td>Speak the current arm status (tier, stop, computed size)</td></tr>
                        <tr><td>Shift+Enter</td><td>Place the armed order as a limit at the focused price</td></tr>
                        <tr><td>Ctrl+Enter</td><td>Place the armed order at market</td></tr>
                    </tbody>
                </table>
            </details>

            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">Drawing tool shortcuts</h3></summary>
                <p style="font-size:0.82rem; color:var(--text-muted,#666); margin:4px 0 8px;">
                    On the Linux web host, every <strong>Ctrl+Shift+&lt;letter&gt;</strong> drawing chord below is
                    remapped to <strong>Alt+Shift+&lt;letter&gt;</strong> (Firefox reserves several Ctrl+Shift chords).
                    Same letter, same tool. The <strong>All Keyboard Shortcuts (Live — from current profile)</strong> section at
                    the END of this dialog always shows the bindings actually in effect on this host.
                </p>
                <table class="shortcuts-table">
                    <thead><tr><th>Key</th><th>Action</th></tr></thead>
                    <tbody>
                        <tr><td>Ctrl+Shift+T</td><td>Draw trend line (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+H</td><td>Draw horizontal level (1 anchor)</td></tr>
                        <tr><td>Ctrl+Shift+V</td><td>Draw vertical line (1 anchor)</td></tr>
                        <tr><td>Ctrl+Shift+C</td><td>Draw channel (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+F</td><td>Draw Fibonacci retracement (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+E</td><td>Draw Fibonacci extension (3 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+J</td><td>Draw angle Fibonacci (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+R</td><td>Draw rectangle (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+A</td><td>Draw Andrews' Pitchfork (3 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+G</td><td>Draw Gann Fan (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+B</td><td>Draw Gann Box (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+P</td><td>Draw Risk/Reward zone (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+W</td><td>Draw Anchored VWAP (1 anchor)</td></tr>
                        <tr><td>Shift+Left / Shift+Right</td><td>Nudge the focused drawing's selected anchor one bar earlier / later</td></tr>
                        <tr><td>Shift+Up / Shift+Down</td><td>Nudge the selected anchor's price up / down by 1% of the visible range</td></tr>
                        <tr><td>Ctrl+Alt+Shift+G</td><td>Select the next anchor of the focused drawing (first press says which is selected)</td></tr>
                        <tr><td>Ctrl+Alt+Shift+B</td><td>Snap the selected anchor to its bar's high, low, open or close (repeat to cycle)</td></tr>
                        <tr><td>Ctrl+Shift+M</td><td>Measure tool — reads distance and % change (2 anchors)</td></tr>
                        <tr><td>Ctrl+Shift+L</td><td>Draw text label</td></tr>
                        <tr><td>Escape</td><td>Cancel drawing in progress</td></tr>
                    </tbody>
                </table>
            </details>

            @* ── Live Shortcut Reference (auto-generated from ShortcutManager) ─── *@
            <details style="margin-bottom:12px;">
                <summary style="cursor:pointer; font-weight:700; padding:4px 0;"><h3 style="display:inline; font-size:inherit; font-weight:inherit; margin:0;">All Keyboard Shortcuts (Live — from current profile)</h3></summary>
                <p style="font-size:0.82rem; color:var(--text-muted,#666); margin:4px 0 8px;">
                    This table is generated live from the active shortcut profile (@ShortcutManager.CurrentProfile.Name).
                    It always matches the actual key bindings in use, including any user customisations.
                </p>
                <table class="shortcuts-table" style="font-size:0.82rem;">
                    <thead><tr><th>Key Combination</th><th>Command</th></tr></thead>
                    <tbody>
                        @foreach (var binding in ShortcutManager.GetAllBindings())
                        {
                            <tr>
                                <td style="white-space:nowrap; font-family:monospace;">@binding.DisplayString</td>
                                <td>@FormatCommandName(binding.Description)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>

            <div class="modal-footer">
                <button id="help-close" @onclick="Close" aria-label="Close help dialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenHelpEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Help") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Help"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "help-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Help"));
        StateHasChanged();
    }

    /// <summary>Converts a PascalCase SystemCommand name into readable text (e.g. "NavLeft" → "Nav Left").</summary>
    private static string FormatCommandName(string name)
    {
        if (string.IsNullOrEmpty(name)) return name;
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < name.Length; i++)
        {
            if (i > 0 && char.IsUpper(name[i]) && !char.IsUpper(name[i - 1]))
                sb.Append(' ');
            sb.Append(name[i]);
        }
        return sb.ToString();
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
