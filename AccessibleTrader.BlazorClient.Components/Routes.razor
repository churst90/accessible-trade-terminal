@*
    AppAssembly resolves to this RCL itself, which is where every @page lives
    (Pages/Home.razor today; future routable components stay here too). The
    router scans this assembly for @page directives, so the MAUI host doesn't
    need to pass anything in. If a future host adds host-local routable
    components, parameterize this with [Parameter] AdditionalAssemblies.
*@
<Router AppAssembly="typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <p role="alert">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>
