@using System.Globalization
@using AccessibleTrader.Core.Services.Charts
@inherits ModalBase
@inject IWorkspaceStore Store

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Brick settings"
             aria-modal="true"
             aria-labelledby="chart-type-settings-title"
             @onclick:stopPropagation="true">

            <h2 id="chart-type-settings-title" tabindex="-1">Brick settings</h2>

            <p style="margin-top: 12px; font-size: 0.9rem;">
                The box is the price move that makes one brick. ATR follows the market's own
                range; a fixed size never changes.
            </p>

            <fieldset style="margin-top: 12px; border: none; padding: 0;">
                <legend>Renko box</legend>
                <label style="display: block;">
                    <input id="renko-box-atr" type="radio" name="renko-box-mode"
                           checked="@(_mode == RenkoBoxMode.Atr)"
                           @onchange="() => SetMode(RenkoBoxMode.Atr)" />
                    ATR
                </label>
                <label style="display: block;">
                    <input id="renko-box-fixed" type="radio" name="renko-box-mode"
                           checked="@(_mode == RenkoBoxMode.Fixed)"
                           @onchange="() => SetMode(RenkoBoxMode.Fixed)" />
                    Fixed size
                </label>
            </fieldset>

            @if (_mode == RenkoBoxMode.Atr)
            {
                <div class="modal-row" style="margin-top: 12px;">
                    <label for="renko-atr-length">ATR length:</label>
                    <input id="renko-atr-length"
                           type="number"
                           min="1"
                           max="200"
                           step="1"
                           @bind="_atrLengthText"
                           @onkeydown="OnKeyDown"
                           style="width: 8em;" />
                </div>
            }
            else
            {
                <div class="modal-row" style="margin-top: 12px;">
                    <label for="renko-box-size">Box size:</label>
                    <input id="renko-box-size"
                           type="number"
                           min="0"
                           step="any"
                           @bind="_boxSizeText"
                           @onkeydown="OnKeyDown"
                           style="width: 10em;" />
                </div>
            }

            @if (_mode == RenkoBoxMode.Atr)
            {
                <p id="renko-box-preview" role="status" style="margin-top: 8px; font-size: 0.9rem;">
                    @BoxPreview()
                </p>
            }

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <p role="status" style="margin-top: 8px; color: @(_isError ? "#f44" : "#4f4"); font-size: 0.9rem;">@_statusMessage</p>
            }

            <div style="display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end;">
                <button class="primary" @onclick="Apply">Apply</button>
                <button @onclick="Close" aria-label="Cancel, close the brick settings dialog">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private RenkoBoxMode _mode = RenkoBoxMode.Atr;
    private string _atrLengthText = "14";
    private string _boxSizeText = "";
    private string? _statusMessage;
    private bool _isError;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        _eventSub = EventBus.Subscribe<OpenChartTypeSettingsEvent>(_ => InvokeAsync(ShowAsync));
    }

    protected override string ModalName => "Brick settings";

    private async Task ShowAsync()
    {
        var state = Store.State;
        _mode = state.Renko.Mode;
        _atrLengthText = state.Renko.AtrLength.ToString(CultureInfo.InvariantCulture);
        _boxSizeText = (state.BrickBoxSize > 0 ? state.BrickBoxSize
            : state.Renko.BoxSize > 0 ? state.Renko.BoxSize : 0)
            .ToString("0.##########", CultureInfo.InvariantCulture);
        _statusMessage = null;
        _isError = false;
        await ShowModalAsync("chart-type-settings-title");
    }

    private void SetMode(RenkoBoxMode mode)
    {
        _mode = mode;
        _statusMessage = null;
        _isError = false;
    }

    /// <summary>What the ATR setting would freeze right now, from the tab's real bars.</summary>
    private string BoxPreview()
    {
        if (!int.TryParse(_atrLengthText, NumberStyles.Integer, CultureInfo.InvariantCulture, out int length)
            || length < 1 || length > 200)
            return "Enter an ATR length from 1 to 200.";

        var state = Store.State;
        return BrickChartBuilder.TryResolveBox(
            state.MarketBars, new RenkoSettings(RenkoBoxMode.Atr, 0, length), out double box, out _)
            ? $"Resolved box: {AccessibleTrader.BlazorClient.Services.PriceFormatter.FormatPrice(box)}."
            : $"ATR {length} needs at least {length + 2} bars; this chart has {state.MarketBars.Count}.";
    }

    private void Apply()
    {
        var state = Store.State;

        int atrLength = 14;
        if (!int.TryParse(_atrLengthText, NumberStyles.Integer, CultureInfo.InvariantCulture, out atrLength)
            || atrLength < 1 || atrLength > 200)
        {
            Refuse("ATR length must be between 1 and 200.", "renko-atr-length");
            return;
        }

        double boxSize = 0;
        if (_mode == RenkoBoxMode.Fixed
            && (!double.TryParse(_boxSizeText, NumberStyles.Number, CultureInfo.InvariantCulture, out boxSize)
                || !double.IsFinite(boxSize) || boxSize <= 0))
        {
            Refuse("A Renko box must be a positive price.", "renko-box-size");
            return;
        }

        var settings = new RenkoSettings(_mode, boxSize, atrLength);
        if (!BrickChartSpeech.TryPlan(state, settings, out _, out string? refusal))
        {
            // A box too small for the loaded moves is a box-size problem; too little history is
            // an ATR-length problem. Focus the control the user can change.
            string target = _mode == RenkoBoxMode.Atr
                && (refusal?.Contains("needs at least", StringComparison.Ordinal) ?? false)
                ? "renko-atr-length"
                : _mode == RenkoBoxMode.Fixed ? "renko-box-size" : "renko-atr-length";
            Refuse(refusal ?? "That Renko box cannot be drawn.", target);
            return;
        }

        Store.Dispatch(new SetRenkoSettingsAction(settings));
        Close();
    }

    private void Refuse(string sentence, string focusElementId)
    {
        _statusMessage = sentence;
        _isError = true;
        EventBus.Publish(new AnnouncementEvent(sentence,
            Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.Interface));
        StateHasChanged();
        _ = FocusAsync(focusElementId);
    }

    private async Task FocusAsync(string elementId)
    {
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", elementId); }
        catch { /* best effort, as the modal base's heading focus is */ }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Apply();
        else if (e.Key == "Escape") Close();
    }

    private void Close() => CloseModal();
}
