@inherits ModalBase
@inject IWorkspaceStore Store
@inject IWorkspaceLibraryService Library
@inject IWorkspaceInitializer WorkspaceInit

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="load-workspace-title"
             @onclick:stopPropagation="true">

            <h2 id="load-workspace-title" tabindex="-1">Load Workspace</h2>

            @if (_profiles.Count == 0)
            {
                <p role="status" style="margin-top: 16px;">No saved workspaces found. Use Save Workspace (Ctrl+Alt+Shift+W) to create one.</p>
            }
            else
            {
                <ul role="listbox"
                    aria-label="Saved workspace profiles"
                    style="list-style: none; padding: 0; margin: 16px 0; max-height: 300px; overflow-y: auto;"
                    @onkeydown="OnListKeyDown">
                    @for (int i = 0; i < _profiles.Count; i++)
                    {
                        var idx = i;
                        var profile = _profiles[i];
                        <li role="option"
                            tabindex="@(idx == _selectedIndex ? "0" : "-1")"
                            aria-selected="@(idx == _selectedIndex ? "true" : "false")"
                            style="display: flex; justify-content: space-between; align-items: center; padding: 8px; cursor: pointer; @(idx == _selectedIndex ? "background: #335; font-weight: bold;" : "") border-bottom: 1px solid var(--border-color);"
                            @onclick="() => SelectProfile(idx)"
                            @ondblclick="() => LoadProfile(profile)">
                            <span>@profile</span>
                            <button aria-label="@($"Delete workspace: {profile}")"
                                    style="padding: 2px 8px; font-size: 0.8rem;"
                                    @onclick="() => DeleteProfile(profile)"
                                    @onclick:stopPropagation="true">
                                Delete
                            </button>
                        </li>
                    }
                </ul>
            }

            @if (!string.IsNullOrEmpty(_statusMessage))
            {
                <p role="status" style="margin-top: 8px; color: @(_isError ? "#f44" : "#4f4"); font-size: 0.9rem;">@_statusMessage</p>
            }

            <div style="display: flex; gap: 8px; margin-top: 16px; justify-content: flex-end;">
                @if (_profiles.Count > 0)
                {
                    <button class="primary"
                            disabled="@(_selectedIndex < 0 || _selectedIndex >= _profiles.Count)"
                            @onclick="LoadSelected">
                        Load
                    </button>
                }
                <button @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private List<string> _profiles = new();
    private int _selectedIndex = -1;
    private string? _statusMessage;
    private bool _isError;

    protected override void OnInitialized()
    {
        base.OnInitialized(); // arms ModalBase's CloseTopModalEvent (Escape) subscription
        _eventSub = EventBus.Subscribe<OpenLoadWorkspaceEvent>(_ => InvokeAsync(ShowAsync));
    }

    private async Task ShowAsync()
    {
        _selectedIndex = -1;
        _statusMessage = null;
        _isError = false;
        _profiles = Library.GetAvailableProfiles();
        if (_profiles.Count > 0) _selectedIndex = 0;
        await ShowModalAsync("load-workspace-title");
    }

    private void SelectProfile(int index)
    {
        _selectedIndex = index;
    }

    private void OnListKeyDown(KeyboardEventArgs e)
    {
        if (_profiles.Count == 0) return;

        switch (e.Key)
        {
            case "ArrowDown":
                _selectedIndex = Math.Min(_selectedIndex + 1, _profiles.Count - 1);
                break;
            case "ArrowUp":
                _selectedIndex = Math.Max(_selectedIndex - 1, 0);
                break;
            case "Enter":
                if (_selectedIndex >= 0 && _selectedIndex < _profiles.Count)
                    LoadProfile(_profiles[_selectedIndex]);
                break;
            case "Delete":
                if (_selectedIndex >= 0 && _selectedIndex < _profiles.Count)
                    DeleteProfile(_profiles[_selectedIndex]);
                break;
            case "Escape":
                Close();
                break;
        }
    }

    private void LoadSelected()
    {
        if (_selectedIndex >= 0 && _selectedIndex < _profiles.Count)
            LoadProfile(_profiles[_selectedIndex]);
    }

    private void LoadProfile(string name)
    {
        try
        {
            var config = Library.LoadProfile(name);
            if (config == null)
            {
                _statusMessage = $"Could not load '{name}'.";
                _isError = true;
                return;
            }

            // Close all existing tabs by resetting to initial state.
            // We need to clear everything and rebuild from the saved config.
            ResetWorkspaceState();

            // Restore the full workspace (all tabs, series, display toggles).
            WorkspaceInit.RestoreWorkspace(config);

            EventBus.Publish(new AnnouncementEvent($"Workspace loaded: {name}"));
            Close();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Load failed: {ex.Message}";
            _isError = true;
        }
    }

    private void ResetWorkspaceState()
    {
        // Close all tabs down to one, then clear the remaining tab's series.
        var state = Store.State;

        // Remove all inactive tab snapshots by closing them.
        while (Store.State.TabCount > 1)
        {
            var snapshots = Store.State.TabSnapshots;
            if (snapshots != null && snapshots.Count > 0)
            {
                Store.Dispatch(new CloseTabAction(snapshots[0].TabIndex));
            }
            else
            {
                break;
            }
        }

        // Clear all series on the remaining active tab.
        var seriesToRemove = Store.State.ActiveSeries.Select(s => s.Id).ToList();
        foreach (var id in seriesToRemove)
        {
            Store.Dispatch(new RemoveSeriesAction(id));
        }

        // Reset identity.
        Store.Dispatch(new SetIdentityAction(ChartIdentity.Empty));
    }

    private void DeleteProfile(string name)
    {
        Library.DeleteProfile(name);
        _profiles = Library.GetAvailableProfiles();
        if (_selectedIndex >= _profiles.Count) _selectedIndex = _profiles.Count - 1;
        _statusMessage = $"'{name}' deleted.";
        _isError = false;
        EventBus.Publish(new AnnouncementEvent($"Workspace deleted: {name}"));
    }

    private void Close()
    {
        CloseModal();
    }

    protected override string ModalName => "Load workspace";
}
