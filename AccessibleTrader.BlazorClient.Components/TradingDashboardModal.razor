@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@using AccessibleTrader.Core.Services.Trading
@using Microsoft.AspNetCore.Components.Web
@using AccessibleTrader.Sdk.Plugins
@using AccessibleTrader.Sdk.Enums
@using AccessibleTrader.BlazorClient.Services
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject PortfolioValuationService Portfolio
@inject IDataService Data
@inject ILogger<TradingDashboardModal> _layoutLogger
@inject IOrderExecutionService OrderService
@inject IApiKeyService ApiKeyService
@inject ISettingsManager Settings
@inject IJSRuntime JSRuntime
@inject DemoPolicy Demo
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Trading dashboard"
             aria-modal="true"
             aria-labelledby="trade-title"
             style="max-width:800px; min-height: 600px;"
             @onclick:stopPropagation="true">

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h2 id="trade-title" tabindex="-1" style="margin: 0;">Trading Dashboard</h2>
                
                @if (_availableKeys.Any())
                {
                    <div class="key-selector">
                        <label for="key-select" style="font-size: 0.8rem; color: var(--text-muted); margin-right: 8px;">Switch API Key:</label>
                        <select id="key-select" value="@_activeKeyNickname" @onchange="OnKeyChanged" style="padding: 4px; background: #222; color: #fff; border: 1px solid var(--border-color);">
                            @foreach (var key in _availableKeys)
                            {
                                <option value="@key.Nickname">@key.Nickname (@key.Environment)</option>
                            }
                        </select>
                    </div>
                }
            </div>

            @{
                // The "this provider cannot trade" wall used to replace the WHOLE dialog,
                // which is the chart coupling in its purest form: a data-only chart in
                // the front tab hid an account full of live positions on other venues.
                // It now replaces the order TICKET only — that is the part a venue
                // without order execution genuinely cannot offer — and the account
                // column renders regardless, because those positions exist whatever
                // chart happens to be focused.
            }
            @if (_paperMode)
            {
                <div class="alert-box" style="background:#332a00; color:#ffb300; border:1px solid #665500; font-weight:bold; padding:10px; border-radius:4px; margin-bottom:15px;">📄 PAPER TRADING — simulated orders, no real funds.</div>
            }
            else if (_isLiveEnvironment)
            {
                <div class="alert-box danger">⚠ LIVE TRADING — Real funds at risk.</div>
            }

                <div class="dashboard-grid">
                    @* Left Column: Market & Order Entry *@
                    <div class="dash-col">
                        @if (_tradingNotSupported)
                        {
                            <section class="panel">
                                <h3>Place Order</h3>
                                <div class="alert-box warning" style="text-align: center; padding: 20px;">
                                    <div style="font-size: 2rem; margin-bottom: 15px;" aria-hidden="true">🚫</div>
                                    <p>
                                        @(string.IsNullOrEmpty(Store.State.Identity.Provider)
                                          ? "No chart is focused, so there is nothing to place an order on. Your accounts are shown alongside."
                                          : $"The current provider {Store.State.Identity.Provider} does not support order execution.")
                                    </p>
                                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 10px;">
                                        @(string.IsNullOrEmpty(Store.State.Identity.Provider)
                                          ? "Open a chart to place an order. Cancelling orders and closing positions works from here either way."
                                          : "Switch to a supported exchange (for example Binance, Coinbase or Alpaca) to place orders. Cancelling orders and closing positions on your existing accounts works from here either way.")
                                    </p>
                                </div>
                            </section>
                        }
                        else
                        {
                        <section class="panel">
                            <h3>Market: @(Store.State.Identity.Symbol ?? "—")</h3>
                            <div class="market-stats">
                                <div class="stat"><span>Price</span><strong>@GetLastPrice()</strong></div>
                                @* "Env: None" was accurate and meaningless — it is what shows when no API keys are
   configured, which is a thing the user can act on and "None" does not tell them. *@
<div class="stat"><span>Mode</span><strong>@(_paperMode ? "Paper (simulated)" : (_availableKeys.Any() ? (_isLiveEnvironment ? "Live" : "Paper") : "No API key"))</strong></div>
                            </div>
                        </section>

                        <section class="panel order-entry">
                            <h3>Place Order</h3>
                            <div class="entry-row side-row" role="group" aria-label="Order side">
                                <button class='side-btn buy @(_orderSide == "Buy" ? "active" : "")' aria-pressed="@(_orderSide == "Buy" ? "true" : "false")" @onclick='() => { _orderSide = "Buy"; VoidReviewIfArmed("Side"); }'>
                                    <span class="side-arrow" aria-hidden="true">▲</span>BUY
                                </button>
                                <button class='side-btn sell @(_orderSide == "Sell" ? "active" : "")' aria-pressed="@(_orderSide == "Sell" ? "true" : "false")" @onclick='() => { _orderSide = "Sell"; VoidReviewIfArmed("Side"); }'>
                                    <span class="side-arrow" aria-hidden="true">▼</span>SELL
                                </button>
                            </div>
                            
                            @* Beside the symbol, not buried in settings, because it changes what
                               every other control here means — leverage, margin mode, reduce-only
                               and hedge-mode position side are all futures concepts, and the same
                               symbol can price differently on the two books. Only shown when the
                               provider genuinely has more than one, which it is asked rather than
                               assumed. *@
                            @if (_subTypes.Count > 1)
                            {
                                <div class="entry-row">
                                    <label for="order-market">Market</label>
                                    <select id="order-market" aria-label="Market type for this order" @bind="_subType"
                                            @oninput='() => VoidReviewIfArmed("Market type")'>
                                        @foreach (var st in _subTypes)
                                        {
                                            <option value="@st">@st</option>
                                        }
                                    </select>
                                </div>
                            }

                            @* Quantity is the field that decides whether this ticket can be sent
                               at all, and until 2026-09-02 clearing it just made the Submit button
                               VANISH — a control removed from the tab order and from the screen
                               reader's button list, with nothing said and no way to find out which
                               field had done it. The state now lives on the field that caused it:
                               aria-required says it must be filled BEFORE the user gets there, and
                               aria-invalid plus the message say so afterwards. *@
                            <div class="entry-row">
                                <label for="order-qty">Quantity</label>
                                <input id="order-qty" type="number" step="0.01" aria-label="Order quantity"
                                       aria-required="true"
                                       aria-invalid="@(QtyInvalid ? "true" : "false")"
                                       aria-describedby="@(QtyInvalid ? "order-qty-err" : null)"
                                       @bind="_orderQty"
                                       @oninput='() => VoidReviewIfArmed("Quantity")' />
                                @if (QtyInvalid)
                                {
                                    <span id="order-qty-err" class="field-error">@QtyErrorText</span>
                                }
                            </div>

                            <div class="entry-row">
                                <label for="order-type">Type</label>
                                <select id="order-type" aria-label="Order type" @bind="_orderType"
                                        @oninput='() => VoidReviewIfArmed("Order type")'>
                                    <option value="Market">Market</option>
                                    <option value="Limit">Limit</option>
                                    <option value="Stop-Market">Stop-Market</option>
                                    <option value="Stop-Limit">Stop-Limit</option>
                                    <option value="Take-Profit-Market">Take-Profit-Market</option>
                                    <option value="Take-Profit-Limit">Take-Profit-Limit</option>
                                </select>
                            </div>

                            @if (NeedsTrigger)
                            {
                                <div class="entry-row">
                                    <label for="trigger-price">Trigger Price</label>
                                    <input id="trigger-price" type="number" step="any" aria-label="Trigger price" @bind="_triggerPrice"
                                           @oninput='() => VoidReviewIfArmed("Trigger price")' />
                                </div>
                            }

                            @if (NeedsLimit)
                            {
                                <div class="entry-row">
                                    <label for="limit-price">Limit Price</label>
                                    <input id="limit-price" type="number" step="any" aria-label="Limit price" @bind="_limitPrice"
                                           @oninput='() => VoidReviewIfArmed("Limit price")' />
                                </div>
                                @* Both are gated: an IOC order silently sent as GTC rests when it
                                   was meant to vanish, and a maker-only order sent as a taker pays
                                   the wrong fee. Neither failure is visible at the moment it
                                   happens, which is why the control must be absent rather than
                                   present and ignored. *@
                                @if (_caps.HasFlag(ProviderCapabilities.TimeInForce))
                                {
                                <div class="entry-row">
                                    <label for="order-tif">Time in force</label>
                                    <select id="order-tif" aria-label="Time in force" @bind="_tif"
                                            @oninput='() => VoidReviewIfArmed("Time in force")'>
                                        <option value="GTC">GTC — good till canceled</option>
                                        <option value="IOC">IOC — immediate or cancel</option>
                                        <option value="FOK">FOK — fill or kill</option>
                                    </select>
                                </div>
                                }
                                @if (_caps.HasFlag(ProviderCapabilities.PostOnly))
                                {
                                <div class="entry-row">
                                    <label for="post-only">Post-only (maker)</label>
                                    <input id="post-only" type="checkbox" checked="@_postOnly"
                                           @onchange='e => { _postOnly = e.Value is bool b && b; VoidReviewIfArmed("Post-only"); }' />
                                </div>
                                }
                            }

                            @if (IsEntryType)
                            {
                                <div class="entry-row">
                                    <label for="stop-loss">Stop Loss</label>
                                    <input id="stop-loss" type="number" step="any" aria-label="Stop loss price, optional" @bind="_stopLoss" placeholder="Optional"
                                           @oninput='() => VoidReviewIfArmed("Stop loss")' />
                                </div>

                                <div class="entry-row">
                                    <label for="take-profit">Take Profit</label>
                                    <input id="take-profit" type="number" step="any" aria-label="Take profit price, optional" @bind="_takeProfit" placeholder="Optional"
                                           @oninput='() => VoidReviewIfArmed("Take profit")' />
                                </div>

                                <div class="entry-row">
                                    <label for="risk-pct">Risk % of balance</label>
                                    <input id="risk-pct" type="number" step="0.1" min="0" aria-label="Risk % of balance, used for position sizing" @bind="_riskPct" placeholder="Optional" />
                                    <button type="button" @onclick="SizeFromRisk" aria-label="Size quantity from risk and stop">Size</button>
                                </div>

                                @if (_caps.HasFlag(ProviderCapabilities.TrailingStop))
                                {
                                <div class="entry-row">
                                    <label for="trail-mode">Trailing stop</label>
                                    <select id="trail-mode" aria-label="Trailing stop mode" @bind="_trailMode"
                                            @oninput='() => VoidReviewIfArmed("Trailing stop mode")'>
                                        <option value="None">None</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                    </select>
                                    @if (_trailMode != "None")
                                    {
                                        <input type="number" step="any" min="0" aria-label="Trailing stop distance" @bind="_trailValue" placeholder="@(_trailMode == "Percent" ? "%" : "amount")"
                                               @oninput='() => VoidReviewIfArmed("Trailing stop distance")' />
                                    }
                                </div>

                                <div class="entry-row">
                                    <label for="trailtp-mode">Trailing take-profit</label>
                                    <select id="trailtp-mode" aria-label="Trailing take-profit mode" @bind="_trailTpMode"
                                            @oninput='() => VoidReviewIfArmed("Trailing take-profit mode")'>
                                        <option value="None">None</option>
                                        <option value="Percent">Percent</option>
                                        <option value="Amount">Amount</option>
                                    </select>
                                    @if (_trailTpMode != "None")
                                    {
                                        <input type="number" step="any" min="0" aria-label="Trailing take-profit distance" @bind="_trailTpValue" placeholder="@(_trailTpMode == "Percent" ? "%" : "amount")"
                                               @oninput='() => VoidReviewIfArmed("Trailing take-profit distance")' />
                                    }
                                </div>
                                @if (_trailTpMode != "None")
                                {
                                    <div class="entry-row">
                                        <label for="trailtp-activation">TP activation price</label>
                                        <input id="trailtp-activation" type="number" step="any" aria-label="TP activation price for the trailing take-profit, optional" @bind="_trailTpActivation" placeholder="Optional"
                                               @oninput='() => VoidReviewIfArmed("Activation price")' />
                                    </div>
                                }
                                }
                            }

                            @* These four used to share one gate — SupportsMarginTrading — and so
                               appeared and disappeared together regardless of which the provider
                               actually honoured. They are four unrelated features: MEXC honours
                               cross/isolated but our code never set leverage per order, Binance
                               honours hedge-mode position side and reduce-only, and an equity
                               broker with margin has none of the three. Each now gates on its own
                               capability. *@
                            @if (_caps.HasFlag(ProviderCapabilities.IsolatedMargin))
                            {
                                <div class="entry-row">
                                    <label for="margin-type-select">Margin</label>
                                    @* The option text says what each mode DOES, because the two words
                                       alone assume the trader already knows which one can take the rest
                                       of the account with it — and this is the control that decides
                                       that. Isolated leads and is the default: it is the mode that caps
                                       the loss at this one position, and it is what the paper broker
                                       has always done, so a user who never touches this control gets
                                       the behaviour their account already had. *@
                                    <select id="margin-type-select"
                                            aria-label="Margin mode for this order"
                                            @bind="_marginType"
                                            @oninput='() => VoidReviewIfArmed("Margin mode")'>
                                        <option value="Isolated">Isolated — loss capped at this position's collateral</option>
                                        <option value="Cross">Cross — draws on the whole balance, and takes it</option>
                                    </select>
                                </div>
                            }

                            @* MaxLeverage as well as the flag: a provider that declares Leverage
                               but caps at 1x offers a selector with one position. *@
                            @if (_caps.HasFlag(ProviderCapabilities.Leverage) && _maxLeverage > 1)
                            {
                                <div class="entry-row">
                                    <label for="leverage-input">Leverage</label>
                                    <input id="leverage-input" type="number" min="1" max="@_maxLeverage" step="1"
                                           aria-label="Leverage multiplier"
                                           @bind="_leverage"
                                           @oninput='() => VoidReviewIfArmed("Leverage")' />
                                    <span style="font-size:0.8rem; color:var(--text-muted);">×&nbsp;(max @_maxLeverage)</span>
                                </div>
                            }

                            @if (_caps.HasFlag(ProviderCapabilities.HedgeMode))
                            {
                                <div class="entry-row">
                                    <label for="pos-side">Position side</label>
                                    <select id="pos-side" aria-label="Position side" @bind="_positionSide"
                                            @oninput='() => VoidReviewIfArmed("Position side")'>
                                        <option value="BOTH">One-way</option>
                                        <option value="LONG">Long</option>
                                        <option value="SHORT">Short</option>
                                    </select>
                                </div>
                            }

                            @if (_caps.HasFlag(ProviderCapabilities.ReduceOnly))
                            {
                                <div class="entry-row">
                                    <label for="reduce-only">Reduce-only</label>
                                    <input id="reduce-only" type="checkbox" checked="@_reduceOnly"
                                           @onchange='e => { _reduceOnly = e.Value is bool b && b; VoidReviewIfArmed("Reduce-only"); }' />
                                </div>
                            }

                            @if (_reviewArmed)
                            {
                                <div class="entry-row" role="group" aria-label="Confirm live order">
                                    @* Disabled on the SAME condition as the plain button, not just
                                       _orderInFlight. With only the in-flight latch, clearing the
                                       quantity to 0 left Confirm enabled while SubmitOrder's own
                                       `if (!CanSubmit) return;` bailed in silence — a live-order
                                       button that does nothing and says nothing, which
                                       BeginOrderAction's comment calls the worst available outcome
                                       on a screen nobody can see.

                                       The size and symbol are in the VISIBLE label, not only in the
                                       spoken review. The focus announcement is the one thing that
                                       reaches the user in every speech configuration and in braille,
                                       at any verbosity — so the number about to be sent is carried by
                                       the control itself rather than by a live region that may have
                                       been interrupted. aria-label EXTENDS the visible text rather
                                       than replacing it, per WCAG 2.5.3 Label in Name: containment,
                                       not equality.

                                       GatedButton rather than `disabled`: the refusal condition is
                                       unchanged and SubmitOrder's own `if (!CanSubmit) return;`
                                       still stands behind it, but the armed live order is precisely
                                       the moment a vanished button is worst — the user has heard the
                                       review, is reaching for Confirm, and under `disabled` finds
                                       nothing there and no account of why. *@
                                    <GatedButton ElementId="order-confirm-live"
                                            class="@SubmitButtonClass"
                                            Gate="SubmitGate" Channel="SpeechChannel.Critical"
                                            aria-label="@($"Confirm {_orderSide} {PriceFormatter.FormatQuantity(_orderQty)} {Store.State.Identity.Symbol}, {_orderType.ToLowerInvariant()} order. Sends to the live account.")"
                                            OnClick="SubmitOrder">Confirm @_orderSide @PriceFormatter.FormatQuantity(_orderQty) @Store.State.Identity.Symbol</GatedButton>
                                    <button type="button" @onclick="CancelReview" aria-label="Cancel, do not submit the live order">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <GatedButton class="@SubmitButtonClass"
                                             Gate="SubmitGate" Channel="SpeechChannel.Critical"
                                             OnClick="SubmitOrder">
                                    Submit @_orderSide Order
                                </GatedButton>
                            }

                            @if (!string.IsNullOrEmpty(_orderStatus))
                            {
                                <div class='status-msg @(_orderError ? "error" : "success")'>@_orderStatus</div>
                            }

                            @* ── OCO pair (one cancels the other) ─────────────────
                               Shown only when the pair is genuinely LINKED somewhere:
                               the paper broker (terminal-enforced) or an exchange
                               with native OCO (Binance spot — exchange-enforced, so
                               the link holds even with the terminal offline). Flag-
                               only providers stay hidden: no unlinked "pairs". *@
                            @if (_supportsOco)
                            {
                                <section aria-labelledby="oco-title" style="margin-top:14px; border-top:1px solid var(--border-color); padding-top:10px;">
                                    <h3 id="oco-title">OCO pair — one cancels the other</h3>
                                    <p style="color:var(--text-muted); font-size:0.9em; margin:4px 0 8px;">
                                        Two resting orders, same side and quantity: a limit and a stop.
                                        Whichever executes first cancels the other. Sell above/below to
                                        bracket an exit; buy above/below to bracket a breakout entry.
                                    </p>
                                    <div class="modal-row">
                                        <label for="oco-side">Side:</label>
                                        <select id="oco-side" @bind="_ocoSide">
                                            <option value="Sell">Sell (exit / take profit + stop)</option>
                                            <option value="Buy">Buy (breakout + pullback entry)</option>
                                        </select>
                                    </div>
                                    @* All three are required and all three gate the button. The
                                       last rule is the one nobody guesses: a limit and a stop at the
                                       SAME price cannot be a pair, because neither can be the one
                                       that fills first and cancels the other. Under `disabled` that
                                       rule was unstateable — the button was simply gone. *@
                                    @* aria-required, but NOT aria-invalid for being empty. All
                                       three of these default to 0, so binding invalid to "is it
                                       still zero" made a pristine OCO panel announce "Quantity,
                                       invalid entry. Limit price, invalid entry. Stop trigger,
                                       invalid entry." before the user had typed a character.
                                       aria-invalid means REJECTED, not blank — required is what
                                       says a blank one will not do — so the only thing marked
                                       here is the pair rule, which is a judgement on values the
                                       user actually entered. *@
                                    <div class="modal-row">
                                        <label for="oco-qty">Quantity:</label>
                                        <input id="oco-qty" type="number" step="any" min="0"
                                               aria-required="true"
                                               @bind="_ocoQty" />
                                    </div>
                                    <div class="modal-row">
                                        <label for="oco-limit">Limit price (the favorable side):</label>
                                        <input id="oco-limit" type="number" step="any" min="0"
                                               aria-required="true"
                                               aria-invalid="@(OcoPairInvalid ? "true" : "false")"
                                               aria-describedby="@(OcoPairInvalid ? "oco-pair-err" : null)"
                                               @bind="_ocoLimitPrice" />
                                    </div>
                                    <div class="modal-row">
                                        <label for="oco-stop">Stop trigger (the protective side):</label>
                                        <input id="oco-stop" type="number" step="any" min="0"
                                               aria-required="true"
                                               aria-invalid="@(OcoPairInvalid ? "true" : "false")"
                                               aria-describedby="@(OcoPairInvalid ? "oco-pair-err" : null)"
                                               @bind="_ocoStopPrice" />
                                    </div>
                                    @if (OcoPairInvalid)
                                    {
                                        @* One message, both fields — the defect is the PAIR, and
                                           either field is the one to change. *@
                                        <span id="oco-pair-err" class="field-error">@OcoPairErrorText</span>
                                    }
                                    <GatedButton class="submit-btn"
                                                 Gate="OcoGate" Channel="SpeechChannel.Critical"
                                                 OnClick="SubmitOcoPair"
                                                 aria-label="Place OCO pair: limit and stop, one cancels the other">
                                        Place OCO pair
                                    </GatedButton>
                                    @if (!string.IsNullOrEmpty(_ocoStatus))
                                    {
                                        <div class='status-msg @(_ocoError ? "error" : "success")' role="status">@_ocoStatus</div>
                                    }
                                </section>
                            }
                        </section>
                        }
                    </div>

                    @* Right Column: Order Book & Account *@
                    <div class="dash-col">
                        <section class="panel account-data">
                            @* Positions first: "what am I actually holding?" is the question this dashboard is
                               opened to answer, and it used to open on Balances with the order book above it,
                               so the one thing a trader wants was below the fold and behind a click.

                               The order book is a tab rather than a permanent fixture — it is reference
                               data that refreshes every two seconds and it was crowding out the account.
                               The dedicated Alt+B panel and the toolbar button are unchanged. *@
                            <div class="tabs-mini" role="tablist" aria-label="Account data" aria-orientation="horizontal"
                                 @onkeydown="OnTabListKeyDown">
                                <button role="tab" id="acct-tab-positions" aria-selected="@(_accountTab == "Positions" ? "true" : "false")" aria-controls="acct-panel" class="@(_accountTab == "Positions" ? "active" : "")" @onclick='() => SelectAccountTab("Positions")'>Positions</button>
                                <button role="tab" id="acct-tab-balances" aria-selected="@(_accountTab == "Balances" ? "true" : "false")" aria-controls="acct-panel" class="@(_accountTab == "Balances" ? "active" : "")" @onclick='() => SelectAccountTab("Balances")'>Balances</button>
                                <button role="tab" id="acct-tab-orders" aria-selected="@(_accountTab == "Orders" ? "true" : "false")" aria-controls="acct-panel" class="@(_accountTab == "Orders" ? "active" : "")" @onclick='() => SelectAccountTab("Orders")'>Orders</button>
                                <button role="tab" id="acct-tab-history" aria-selected="@(_accountTab == "History" ? "true" : "false")" aria-controls="acct-panel" class="@(_accountTab == "History" ? "active" : "")" @onclick='() => SelectAccountTab("History")'>History</button>
                                <button role="tab" id="acct-tab-book" aria-selected="@(_accountTab == "Book" ? "true" : "false")" aria-controls="acct-panel" class="@(_accountTab == "Book" ? "active" : "")" @onclick='() => SelectAccountTab("Book")'>Order Book</button>
                            </div>
                            
                            <div id="acct-panel" class="account-content" role="tabpanel" aria-labelledby="@($"acct-tab-{_accountTab.ToLowerInvariant()}")">
                                @if (_accountTab == "Balances")
                                {
                                    @* The summary leads, because "what is this worth" is the question
                                       the tab is opened to answer and it was the one thing the table
                                       could not say. When the total is partial it says so here rather
                                       than quietly excluding a holding from a number people act on.
                                       One per account: two venues' holdings added into a single
                                       sentence would be a number the user cannot act on anywhere. *@
                                    @foreach (var acct in _accounts)
                                    {
                                        var snap = PortfolioFor(acct);
                                        @if (snap is { TotalCount: > 0 })
                                        {
                                            <p class="portfolio-summary" role="status">
                                                @(_accounts.Count > 1 ? acct.DisplayName + ": " : "")@PortfolioValuationService.Summarise(snap)
                                            </p>
                                        }
                                    }
                                    <table class="mini-table">
                                        <caption class="sr-only">Account balances and value</caption>
                                        <thead><tr>
                                            <th scope="col">Asset</th><th scope="col">Exchange</th>
                                            <th scope="col">Free</th><th scope="col">Locked</th>
                                            <th scope="col">Value</th><th scope="col">Share</th><th scope="col">Day</th>
                                        </tr></thead>
                                        <tbody>
                                            @foreach (var row in _balances.Where(r => r.Balance.Free > 0 || r.Balance.Locked > 0))
                                            {
                                                var b = row.Balance;
                                                var snap = PortfolioFor(row.Account);
                                                var v = snap?.Assets.FirstOrDefault(a => a.Asset == b.Asset);
                                                <tr @key="@($"{row.Account.Slug}:{b.Asset}")">
                                                    <td>@b.Asset</td>
                                                    <td>@row.Account.DisplayName</td>
                                                    <td>@PriceFormatter.FormatQuantity(b.Free)</td>
                                                    <td>@PriceFormatter.FormatQuantity(b.Locked)</td>
                                                    @* An unpriceable holding shows WHY, never a zero.
                                                       A zero here would read as "worth nothing", which
                                                       is a different and much worse claim. *@
                                                    <td>@(v is null ? "—"
                                                          : v.IsPriced ? PriceFormatter.FormatPrice(v.Value ?? 0)
                                                          : "unpriced")</td>
                                                    <td>@(snap is not null && PortfolioValuationService.AllocationPercent(v ?? new AssetValuation(b.Asset, 0, null, null, null, "x"), snap) is double p
                                                          ? p.ToString("0.#") + "%" : "—")</td>
                                                    <td class='@(v?.DayChangePct >= 0 ? "plus" : "minus")'>
                                                        @(v?.DayChangePct is double d ? (d >= 0 ? "+" : "") + d.ToString("0.##") + "%" : "—")
                                                    </td>
                                                </tr>
                                            }
                                            @if (!_balances.Any(r => r.Balance.Free > 0 || r.Balance.Locked > 0))
                                            {
                                                <tr><td colspan="7">@(_balancesNote ?? "No balances.")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                    @TabNote(_balancesNote, _balances.Any(r => r.Balance.Free > 0 || r.Balance.Locked > 0))
                                    @foreach (var acct in _accounts)
                                    {
                                        var snap = PortfolioFor(acct);
                                        @if (snap is { IsComplete: false })
                                        {
                                            <p class="portfolio-note">
                                                @(_accounts.Count > 1 ? acct.DisplayName + ": " : "")The total covers @snap.PricedCount of @snap.TotalCount assets.
                                                @string.Join(", ", snap.Assets.Where(a => !a.IsPriced).Select(a => $"{a.Asset}: {a.Unpriced}"))
                                            </p>
                                        }
                                    }
                                }
                                else if (_accountTab == "Positions")
                                {
                                    <table class="mini-table">
                                        <caption class="sr-only">Open positions</caption>
                                        @* The leading column is the instrument AS HELD — "BTCUSDT isolated 1x" —
                                           rather than a bare symbol, and Direction is spelled out rather than
                                           left to the sign of the quantity. Both were reachable before only by
                                           reading across ten columns and noticing a minus sign, which is the
                                           kind of thing a sighted glance does for free and a screen reader
                                           does not. Leverage folds into the first cell for the same reason:
                                           the mode and the multiplier are one fact about how far this can go
                                           wrong, and they were columns one and eight. *@
                                        <thead><tr><th scope="col">Instrument</th><th scope="col">Direction</th><th scope="col">Exchange</th><th scope="col">Quantity</th><th scope="col">Avg price</th><th scope="col">Value</th><th scope="col">Unrealized P&amp;L</th><th scope="col">Stop loss</th><th scope="col">Take profit</th><th scope="col">Liq. price</th><th scope="col">Action</th></tr></thead>
                                        <tbody>
                                            @foreach (var row in _positions)
                                            {
                                                var p = row.Position;
                                                <tr @key="@($"{row.Account.Slug}:{p.Symbol}")">
                                                    <td>@PositionLabel.Instrument(p)</td>
                                                    <td>@PositionLabel.Direction(p)</td>
                                                    <td>@row.Account.DisplayName</td>
                                                    <td>@SymbolAssets.WithBaseUnit(p.Quantity, p.Symbol, PriceFormatter.FormatQuantity(p.Quantity))</td>
                                                    <td>@PriceFormatter.FormatPrice(p.AveragePrice)</td>
                                                    <td>@PriceFormatter.FormatPrice(p.MarketValue)</td>
                                                    <td class='@(p.UnrealizedPnL >= 0 ? "plus" : "minus")'>@PriceFormatter.FormatPnL(p.UnrealizedPnL)</td>
                                                    @* Stop and target are the two numbers that decide what a position can cost
                                                       and what it can make, and they were the two the table did not show. Each
                                                       cell is a button that becomes a field: type, press Enter, and the value
                                                       is checked against the current price before anything is sent. *@
                                                    <td>@RenderProtective(row, ProtectiveLevel.StopLoss)</td>
                                                    <td>@RenderProtective(row, ProtectiveLevel.TakeProfit)</td>
                                                    <td>@(p.LiquidationPrice > 0 ? PriceFormatter.FormatPrice(p.LiquidationPrice) : "—")</td>
                                                    @* Verb first, and the subject named. "Close" alone gave no clue whether
                                                       it closed the position or the dialog, and a row full of identical
                                                       "Close" buttons is unnavigable by button list.

                                                       TWO buttons, and each one's order type is in its name. A single
                                                       Close whose behaviour changed with a price field somewhere else
                                                       would be a control that does two different things to two presses
                                                       that felt the same. *@
                                                    <td>
                                                        <GatedButton aria-label="@($"Close position at market, {PositionLabel.Direction(p)} {PositionLabel.Instrument(p)} on {row.Account.DisplayName}")" Gate="InFlightGate" Channel="SpeechChannel.Critical" OnClick="() => ClosePosition(row)">Close position</GatedButton>
                                                        @if (IsClosingAtLimit(row))
                                                        {
                                                            <input id="@LimitCloseFieldId(row)"
                                                                   type="text"
                                                                   style="width:110px;"
                                                                   autofocus
                                                                   aria-label="@($"Limit price to close {PositionLabel.Instrument(p)} on {row.Account.DisplayName}. Type a price and press Enter. Escape leaves the position open.")"
                                                                   value="@_closeLimitText"
                                                                   @oninput="e => _closeLimitText = e.Value?.ToString() ?? string.Empty"
                                                                   @onkeydown="e => OnLimitCloseKeyAsync(e, row)" />
                                                        }
                                                        else
                                                        {
                                                            @* No "…" in the visible text: the ellipsis is a sighted
                                                               convention for "opens further input", and it is read as
                                                               "dot dot dot" or dropped entirely. The label says it. *@
                                                            <GatedButton aria-label="@($"Close at limit, {PositionLabel.Direction(p)} {PositionLabel.Instrument(p)} on {row.Account.DisplayName}. Opens a price field.")" Gate="InFlightGate" Channel="SpeechChannel.Critical" OnClick="() => BeginLimitClose(row)">Close at limit</GatedButton>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                            @if (!_positions.Any())
                                            {
                                                @* An empty table on a spot venue reads as a bug, or
                                                   worse as "your position has gone". On spot there is
                                                   no positions concept: what you hold IS your balance,
                                                   so say that and point at the tab that has it. *@
                                                <tr><td colspan="11">
                                                    @(_positionsNote
                                                      ?? (IsSpotOnly
                                                          ? "This provider is spot only, so it has no separate positions — what you hold is shown on the Balances tab."
                                                          : "No open positions."))
                                                </td></tr>
                                            }
                                        </tbody>
                                    </table>
                                    @TabNote(_positionsNote, _positions.Any())
                                }
                                else if (_accountTab == "Orders")
                                {
                                    <table class="mini-table">
                                        <caption class="sr-only">Open orders</caption>
                                        @* Symbol and Exchange lead, and neither column existed. The tab used
                                           to be filtered to the focused chart's symbol, so one symbol was the
                                           only possibility and naming it looked redundant — but the filter was
                                           an exact string match, so orders resting on BTC/USD vanished while a
                                           BTCUSDT chart was up and the tab read as "you have no orders". With
                                           the filter gone, a resting limit order is unreadable without knowing
                                           what it is on and where. *@
                                        <thead><tr><th scope="col">Symbol</th><th scope="col">Exchange</th><th scope="col">Side</th><th scope="col">Type</th><th scope="col">Quantity</th><th scope="col">Price</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                                        <tbody>
                                            @foreach (var row in _openOrders)
                                            {
                                                var o = row.Order;
                                                <tr @key="@($"{row.Account.Slug}:{o.Id}")">
                                                    <td>@o.Symbol</td>
                                                    <td>@row.Account.DisplayName</td>
                                                    <td>@o.Side</td>
                                                    <td>@o.Type</td>
                                                    <td>@PriceFormatter.FormatQuantity(o.Quantity)</td>
                                                    <td>@PriceFormatter.FormatPrice(o.Price)</td>
                                                    <td>@o.Status</td>
                                                    @* Visible text, not "✕": that character is announced as "times",
                                                       as "ex", or skipped entirely depending on the screen reader and
                                                       its punctuation level, and a button whose name might be nothing
                                                       at all is the worst control on a money screen. *@
                                                    <td><GatedButton aria-label="@($"Cancel order, {o.Side} {o.Type} {PriceFormatter.FormatQuantity(o.Quantity)} {o.Symbol} on {row.Account.DisplayName}")" Gate="InFlightGate" Channel="SpeechChannel.Critical" OnClick="() => CancelOrder(row)">Cancel order</GatedButton></td>
                                                </tr>
                                            }
                                            @if (!_openOrders.Any())
                                            {
                                                <tr><td colspan="8">@(_openOrdersNote ?? "No open orders.")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                    @TabNote(_openOrdersNote, _openOrders.Any())
                                }
                                else if (_accountTab == "History")
                                {
                                    <table class="mini-table">
                                        <caption class="sr-only">Trade history</caption>
                                        <thead><tr><th scope="col">Time</th><th scope="col">Symbol</th><th scope="col">Exchange</th><th scope="col">Side</th><th scope="col">Quantity</th><th scope="col">Price</th><th scope="col">P&amp;L</th><th scope="col">Fee</th></tr></thead>
                                        <tbody>
                                            @foreach (var row in _fills)
                                            {
                                                var f = row.Fill;
                                                <tr @key="@($"{row.Account.Slug}:{f.Id}")">
                                                    <td>@f.FilledAt.ToLocalTime().ToString("HH:mm:ss")</td>
                                                    <td>@f.Symbol</td>
                                                    <td>@row.Account.DisplayName</td>
                                                    <td>@f.Side</td>
                                                    <td>@PriceFormatter.FormatQuantity(f.Quantity)</td>
                                                    <td>@PriceFormatter.FormatPrice(f.Price)</td>
                                                    <td class='@(f.RealizedPnL >= 0 ? "plus" : "minus")'>@(f.RealizedPnL != 0 ? PriceFormatter.FormatPnL(f.RealizedPnL) : "—")</td>
                                                    <td>@PriceFormatter.FormatPrice(f.Fee)</td>
                                                </tr>
                                            }
                                            @if (!_fills.Any())
                                            {
                                                <tr><td colspan="8">@(_fillsNote ?? "No trade history.")</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                    @TabNote(_fillsNote, _fills.Any())
                                }
                                else if (_accountTab == "Book")
                                {
                                <section class="panel order-book" aria-labelledby="ob-heading-dash">
                                    <h3 id="ob-heading-dash">Order Book</h3>

                                    @if (_bookLoading)
                                    {
                                        <p style="font-size:0.85rem; color:var(--text-muted);">Loading order book…</p>
                                    }
                                    else
                                    {
                                        @* No aria-live here: the book refreshes every 2s and a live region
                                           would re-announce the spread endlessly. The order book reads on
                                           demand (Tab through it) and via the dedicated Alt+B panel. *@
                                        <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 6px;">
                                            Spread: <strong>@GetSpread()</strong>
                                        </p>

                                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                                            <section aria-labelledby="ob-asks-dash">
                                                <h4 id="ob-asks-dash" style="font-size:0.8rem; color:#f44; margin:0 0 4px;">Asks</h4>
                                                <table role="table" aria-label="Ask orders" style="width:100%; border-collapse:collapse; font-size:0.8rem; font-family:monospace;">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col" style="text-align:left; padding:2px 4px; border-bottom:1px solid #333;">Price</th>
                                                            <th scope="col" style="text-align:right; padding:2px 4px; border-bottom:1px solid #333;">Size</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var ask in _asks.TakeLast(5))
                                                        {
                                                            <tr>
                                                                <td style="padding:2px 4px; color:#f44;">@AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(ask.Price)</td>
                                                                <td style="padding:2px 4px; text-align:right;">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(ask.Quantity)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </section>

                                            <section aria-labelledby="ob-bids-dash">
                                                <h4 id="ob-bids-dash" style="font-size:0.8rem; color:#4f4; margin:0 0 4px;">Bids</h4>
                                                <table role="table" aria-label="Bid orders" style="width:100%; border-collapse:collapse; font-size:0.8rem; font-family:monospace;">
                                                    <thead>
                                                        <tr>
                                                            <th scope="col" style="text-align:left; padding:2px 4px; border-bottom:1px solid #333;">Price</th>
                                                            <th scope="col" style="text-align:right; padding:2px 4px; border-bottom:1px solid #333;">Size</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var bid in _bids.Take(5))
                                                        {
                                                            <tr>
                                                                <td style="padding:2px 4px; color:#4f4;">@AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(bid.Price)</td>
                                                                <td style="padding:2px 4px; text-align:right;">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(bid.Quantity)</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </section>
                                        </div>
                                    }
                                </section>
                                }
                            </div>
                        </section>
                    </div>
                </div>

                <div class="modal-footer">
                    <button @onclick="RefreshAccount">Refresh</button>
                    <button @onclick="Close" aria-label="Close trading dashboard dialog">Close</button>
                </div>
        </div>
    </div>
}

<style>
    .dashboard-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .panel { background: #1a1a1a; border: 1px solid #333; border-radius: 4px; padding: 12px; margin-bottom: 15px; }
    .panel h3 { margin: 0 0 10px 0; font-size: 0.9rem; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid #333; padding-bottom: 5px; }
    
    .market-stats { display: flex; gap: 20px; }
    .stat { display: flex; flex-direction: column; }
    .stat span { font-size: 0.75rem; color: var(--text-muted); }
    .stat strong { font-size: 1.1rem; color: #4ec9b0; }

    .order-entry .entry-row { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .order-entry label { flex: 1; font-size: 0.85rem; }
    .order-entry input, .order-entry select { background: #222; border: 1px solid var(--border-color); color: #fff; padding: 5px; border-radius: 3px; width: 120px; }

    /* Large, high-contrast circular BUY/SELL controls. Unselected dims to make
       the active side unmistakable at a glance; a thick focus ring keeps it
       obvious for keyboard users. aria-pressed conveys the same state to screen
       readers (see markup). */
    .side-row { justify-content: center; gap: 22px; margin-bottom: 16px; }
    .side-btn {
        width: 96px; height: 96px; border-radius: 50%;
        border: 3px solid transparent;
        display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 2px; font-weight: 800; font-size: 1.05rem; letter-spacing: 0.5px;
        cursor: pointer; opacity: 1;
        transition: transform .08s ease, box-shadow .12s ease, background .12s ease, opacity .12s ease;
    }
    .side-btn .side-arrow { font-size: 1.1rem; line-height: 1; }
    /* Unselected still carries its own colour, tinted and outlined rather than greyed out.
       A grey disc at half opacity next to a solid green one reads as "SELL is unavailable",
       which on an order form is a dangerous thing to imply — the user is one glance away
       from concluding they cannot close a position. */
    .side-btn.buy  { color: #77ff77; background: rgba(0, 143, 62, 0.22);  border-color: rgba(0, 230, 118, 0.55); }
    .side-btn.sell { color: #ff6b6b; background: rgba(192, 0, 27, 0.22); border-color: rgba(255, 82, 82, 0.55); }
    /* Selected fills solid and gains a ring, so the difference is fill-versus-outline —
       a shape difference, not only a brightness one. */
    .side-btn.buy.active  { background: #008f3e; color: #fff; border-color: #00e676; box-shadow: 0 0 0 4px rgba(0,230,118,0.35); }
    .side-btn.sell.active { background: #c0001b; color: #fff; border-color: #ff5252; box-shadow: 0 0 0 4px rgba(255,82,82,0.35); }
    .side-btn:hover { transform: scale(1.04); filter: brightness(1.15); }
    .side-btn:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

    .submit-btn { width: 100%; padding: 12px; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; margin-top: 10px; }
    .submit-btn.buy { background: #008f3e; color: #fff; }
    .submit-btn.sell { background: #c00; color: #fff; }
    .submit-btn:disabled { background: #444; color: #777; cursor: not-allowed; }

    .order-book .book-container { font-family: 'Consolas', monospace; font-size: 0.85rem; }
    .book-half { display: flex; flex-direction: column; }
    .book-row { display: flex; justify-content: space-between; padding: 2px 0; }
    .asks .price { color: #f44; }
    .bids .price { color: #4f4; }
    .book-spread { text-align: center; padding: 5px; background: #222; margin: 5px 0; color: var(--text-muted); font-size: 0.8rem; }

    .tabs-mini { display: flex; gap: 5px; margin-bottom: 10px; }
    .tabs-mini button { background: transparent; border: none; color: var(--text-muted); font-size: 0.8rem; cursor: pointer; padding: 2px 5px; }
    .tabs-mini button.active { color: #0078d4; border-bottom: 1px solid #0078d4; }
    
    .mini-table { width: 100%; font-size: 0.85rem; border-collapse: collapse; }
    .mini-table td { padding: 4px 0; border-bottom: 1px solid #222; }
    .tab-note { font-size: 0.8rem; color: var(--text-muted); margin: 6px 0 0; }
    .plus { color: #4f4; }
    .minus { color: #f44; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

    .alert-box { padding: 10px; border-radius: 4px; font-weight: bold; margin-bottom: 15px; }
    .alert-box.warning { background: #443300; color: #ffcc00; border: 1px solid #665500; }
    .alert-box.danger { background: #440000; color: #ff4444; border: 1px solid #660000; }

    .status-msg { margin-top: 10px; padding: 8px; border-radius: 4px; font-size: 0.85rem; }
    .status-msg.success { background: #003311; color: #4f4; }
    .status-msg.error { background: #330000; color: #f44; }
</style>

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private System.Threading.Timer? _refreshTimer;

    // Order entry
    private string _orderSide   = "Buy";
    private double _orderQty    = 1.0;
    private string _orderType   = "Market";
    private double _limitPrice   = 0;
    private double _triggerPrice = 0;
    private double _stopLoss      = 0;
    private double _takeProfit    = 0;
    private double _riskPct       = 0;
    private string _trailMode     = "None";
    private double _trailValue    = 0;
    private string _trailTpMode   = "None";
    private double _trailTpValue  = 0;
    private double _trailTpActivation = 0;
    private string _tif           = "GTC";
    private bool   _reduceOnly;
    private bool   _postOnly;
    private string _positionSide  = "BOTH";
    // Isolated, not Cross. Cross is the mode that lets one position take the rest of
    // the account with it, and a default nobody chose should not be the one with the
    // larger blast radius. It also matches what the paper broker did before it
    // honoured the field at all, so no existing account changes behaviour by
    // accident.
    private string _marginType  = "Isolated";
    private double _leverage    = 1.0;
    private string? _orderStatus;
    private bool _orderError;

    // Margin / leverage state
    /// <summary>
    /// Whether the connected provider honours this capability. Every control in the
    /// ticket is drawn through this, and every field on the outgoing signal is set
    /// through it, so the two can never drift apart — a drawn control that sends
    /// nothing and a sent field with no control are the same defect seen from
    /// opposite ends.
    /// </summary>
    private bool Can(ProviderCapabilities c) => _caps.HasFlag(c);

    /// <summary>
    /// True when this provider has no positions concept at all — a spot venue,
    /// where what you hold IS your balance. Used to say so on the Positions tab
    /// instead of showing an empty table, which reads as a bug or, worse, as
    /// "your position is gone".
    /// </summary>
    private string? _balancesNote, _positionsNote, _openOrdersNote, _fillsNote;

    /// <summary>Valuation per account slug. One venue's holdings summed into another's
    /// would be a total the user cannot act on in either place.</summary>
    private Dictionary<string, PortfolioSnapshot?> _portfolios = new();

    private PortfolioSnapshot? PortfolioFor(TradingAccount a) =>
        _portfolios.TryGetValue(a.Slug, out var s) ? s : null;

    /// <summary>
    /// Which book the order goes to — "Spot", "Futures", and whatever else a venue
    /// declares. It belongs beside the symbol rather than in settings because it
    /// changes what every other control on the ticket MEANS: leverage, margin mode,
    /// reduce-only and hedge-mode position side are futures concepts, and the same
    /// symbol can price differently on the two books.
    /// </summary>
    private string _subType = "";
    private List<string> _subTypes = new();

    /// <summary>
    /// What the portfolio is measured in. USD rather than the venue's own quote so
    /// a mixed account does not silently add USDT to EUR — the price source treats
    /// the dollar stablecoins as interchangeable for valuation only.
    /// </summary>
    private const string PortfolioQuote = "USD";

    /// <summary>
    /// What to say in place of a table when a read did not return data. Null when
    /// the read succeeded — an empty table is then the honest answer, because the
    /// account really does hold nothing.
    /// </summary>
    /// <summary>
    /// The "why some of this is missing" note, shown BESIDE rows rather than only in
    /// place of them.
    ///
    /// <para>
    /// The empty-table note has always existed, and it was enough while the dialog
    /// showed one account: no rows and a reason meant the read failed. With several
    /// accounts it stopped being enough — one venue timing out while another returns
    /// rows produced a table full of data and no mention that a whole account was
    /// missing from it, which is the "a failed read renders as you-have-none" defect
    /// wearing a different hat. The note is worse when the table looks complete.
    /// </para>
    /// </summary>
    private RenderFragment? TabNote(string? note, bool hasRows) => note == null || !hasRows ? null : builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddAttribute(1, "class", "tab-note");
        builder.AddAttribute(2, "role", "status");
        builder.AddContent(3, note);
        builder.CloseElement();
    };

    private static string? EmptyNote<T>(ProviderResult<List<T>> r) => r.Kind switch
    {
        ResultKind.Ok           => null,
        ResultKind.NotSupported => r.Reason,
        ResultKind.NotPermitted => $"Not permitted — {r.Reason}",
        ResultKind.Unavailable  => $"Unavailable — {r.Reason}",
        _                       => $"Could not be read — {r.Reason}. This is NOT a statement that you have none.",
    };

    /// <summary>
    /// True when NO connected account has a positions concept — every one of them is
    /// a spot venue, where what you hold IS your balance. Judged across the accounts
    /// rather than off the focused chart: with a spot chart in front and a futures
    /// account connected, the old reading told the user their venue has no positions
    /// while the tab sat there holding one.
    /// </summary>
    private bool IsSpotOnly =>
        _accountCaps.Count > 0
        && _accountCaps.Values.All(c => !c.HasFlag(ProviderCapabilities.MarginTrading)
                                     && !c.HasFlag(ProviderCapabilities.FuturesTrading));

    /// <summary>
    /// What the ORDER TICKET is gated on: the capabilities of the chart's provider,
    /// because that is the venue an order placed here goes to. Deliberately separate
    /// from <see cref="_accountCaps"/>, which describes the accounts being VIEWED —
    /// the ticket stays chart-bound (you place an order on the symbol you are looking
    /// at) while the account views do not.
    /// </summary>
    private ProviderCapabilities _caps;

    /// <summary>Capabilities per account slug, for the account views.</summary>
    private Dictionary<string, ProviderCapabilities> _accountCaps = new();
    private double _maxLeverage = 1.0;
    private bool   _bookLoading;
    private bool   _bookEverLoaded;

    // ── Account data ─────────────────────────────────────────────────────────
    //
    // Every row carries the account it came from. That is the whole decoupling: a
    // Cancel or a Close reads its venue off the row it was pressed on, so neither
    // one has to ask what chart is focused — and the answer to that question was
    // wrong for anyone holding positions on a venue other than the one in front.
    private List<TradingAccount> _accounts  = new();
    private List<AccountBalance>  _balances   = new();
    private List<AccountPosition> _positions  = new();
    private List<AccountOrder>    _openOrders = new();
    private List<AccountFill>     _fills      = new();
    private bool            _reviewArmed;
    private List<OrderBookEntry> _bids = new();
    private List<OrderBookEntry> _asks = new();
    
    private List<ApiKeyConfig> _availableKeys = new();
    private string _activeKeyNickname = "";
    
    // Positions is what a trader opens this dashboard to see.
    private string _accountTab = "Positions";

    // Tab ids in visual order, so the arrow handler and the markup cannot drift apart.
    private static readonly string[] TabIds = { "acct-tab-positions", "acct-tab-balances", "acct-tab-orders", "acct-tab-history", "acct-tab-book" };
    private static readonly string[] TabKeys = { "Positions", "Balances", "Orders", "History", "Book" };

    /// <summary>
    /// Arrow / Home / End across the tab row. Selection follows focus, per WAI-ARIA:
    /// the key both switches the tab and moves focus onto it, so a screen reader
    /// announces the tab the user actually arrived at. The rule itself lives in
    /// TablistNavigator — eight tablists, one answer.
    /// </summary>
    private async Task OnTabListKeyDown(KeyboardEventArgs e)
    {
        int current = Array.IndexOf(TabKeys, _accountTab);
        int? target = TablistNavigator.Target(e.Key, current, TabKeys.Length);
        if (target == null) return;

        _accountTab = TabKeys[target.Value];
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", TabIds[target.Value]); }
        catch { /* best-effort focus, as everywhere else */ }
    }

    private bool _isLiveEnvironment;
    private bool _tradingNotSupported;
    private bool _paperMode;

    // ── The submit gate ──────────────────────────────────────────────────────
    // ONE expression, read two ways: GatedButton calls it to decide whether to draw
    // the button as unavailable and what to say when it is pressed anyway, and
    // CanSubmit is defined as "the gate is open". They cannot drift, which matters
    // because a reason that names the wrong cause — "Enter a quantity above zero"
    // for a block that is really the in-flight latch — is worse than no reason: it
    // sends the user to edit a field that was never the problem.
    //
    // Order is deliberate. The in-flight latch leads because it is the only cause
    // that clears on its own, so "wait" is the correct instruction even when a field
    // is also empty. Nothing to trade comes before the quantity, because a quantity
    // is not the thing to fix on a chart with no symbol.

    /// <summary>Null when the ticket can be sent; otherwise why it cannot.</summary>
    private string? SubmitGate()
    {
        if (_orderInFlight) return "An order is already being sent. Wait for it to finish.";
        if (string.IsNullOrEmpty(Store.State.Identity.Symbol)
            || string.IsNullOrEmpty(Store.State.Identity.Provider))
            return "No chart symbol is loaded, so there is nothing to trade.";
        if (_orderQty <= 0) return "Enter a quantity above zero.";
        return null;
    }

    private bool CanSubmit => SubmitGate() is null;

    // Built in C# rather than interpolated in the attribute: a COMPONENT attribute
    // (unlike an element one) cannot mix literal text and a C# expression at all.
    private string SubmitButtonClass => "submit-btn " + _orderSide.ToLowerInvariant();

    /// <summary>Drives aria-invalid on the Quantity field, and the message beneath it.</summary>
    private bool QtyInvalid => _orderQty <= 0;

    private const string QtyErrorText = "Enter a quantity above zero.";

    // ── The in-flight latch ──────────────────────────────────────────────────
    // Set for the whole duration of any call that PLACES or CANCELS something,
    // and cleared in a finally. Without it the submit button stayed enabled
    // across the await, so a second Enter re-entered the handler and placed a
    // second live order — and pressing Enter twice on a button is not an exotic
    // slip for a screen-reader user, it is Tuesday.
    //
    // One latch rather than one per control, deliberately: the terminal has a
    // single keyboard focus, so there is no real workflow where a user cancels
    // an order *while* an order is being submitted, and one flag can be read
    // correctly at a glance. It is a UI guard, not the safety net —
    // GeneralOrderService's dedup gate is what catches a double-fire this
    // component never sees (a keyboard macro, a second tab, a strategy).
    private bool _orderInFlight;

    /// <summary>
    /// Claims the latch, or speaks the refusal and returns false.
    ///
    /// <para>A silent return is the defect: the user pressed a button and the terminal
    /// did nothing, which is indistinguishable from a dead control.</para>
    /// </summary>
    private bool BeginOrderAction(string what)
    {
        if (_orderInFlight)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"Still working on the previous order. {what} was not sent — wait for the result.", true));
            return false;
        }
        _orderInFlight = true;
        StateHasChanged();
        return true;
    }

    private void EndOrderAction()
    {
        _orderInFlight = false;
        StateHasChanged();
    }

    // Which optional fields the chosen order type needs. Stop/TP types use a
    // Trigger Price and are the order itself; Market/Limit are "entry" types that
    // can carry attached bracket Stop Loss / Take Profit.
    private bool NeedsLimit   => _orderType is "Limit" or "Stop-Limit" or "Take-Profit-Limit";
    private bool NeedsTrigger => _orderType is "Stop-Market" or "Stop-Limit" or "Take-Profit-Market" or "Take-Profit-Limit";
    private bool IsEntryType  => _orderType is "Market" or "Limit";

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenTradingDashboardEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Trading dashboard") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _orderStatus = null;
        // Nothing half-confirmed is resumable by reopening, and this is asserted on the way IN
        // as well as on the way out: Close() is not the only path that ends a dialog, and the
        // failure mode is a Confirm button rendered with no review behind it.
        ResetLiveReview();
        // Hosted/demo: real-money trading is desktop-only, so force paper mode regardless of
        // the saved setting. (There are also no live broker keys in these modes — the API-keys
        // modal is gated off — so this is belt-and-suspenders over the no-keys backstop.)
        _paperMode = !Demo.AllowLiveTrading
            || (Settings.GetSetting("trading.paperTradingMode")?.ToObject<bool>() ?? false);

        // No chart is not a reason to refuse to open. It used to be: this method
        // returned here, so pressing Alt+T with no chart focused produced a dialog
        // that never became visible and never said why. The accounts exist whether or
        // not a chart is up, and they are what this dialog is for. Only the ORDER
        // TICKET needs a chart, and it says so itself.
        var provider = Store.State.Identity.Provider ?? "";
        bool supported = !string.IsNullOrEmpty(provider)
                      && await OrderService.SupportsTradingAsync(provider);
        _tradingNotSupported = !supported;

        _availableKeys = string.IsNullOrEmpty(provider)
            ? new List<ApiKeyConfig>()
            : await ApiKeyService.GetKeysForProviderAsync(provider);
        var active = _availableKeys.FirstOrDefault(k => k.IsActive) ?? _availableKeys.FirstOrDefault();
        _activeKeyNickname = active?.Nickname ?? "";

        _caps           = supported ? await OrderService.GetCapabilitiesAsync(provider) : ProviderCapabilities.None;

        // Ask the provider which books it has rather than assuming Spot/Futures.
        // Venues differ, and a hardcoded pair would offer futures on exchanges that
        // have none and miss anything they call something else.
        string marketType = (Store.State.Identity.Market ?? "").Split('|')[0];
        _subTypes = supported ? await Data.GetSupportedSubTypesAsync(provider, marketType) : new List<string>();
        string fromChart = (Store.State.Identity.Market ?? "").Contains('|')
            ? Store.State.Identity.Market!.Split('|')[1] : "";
        _subType = _subTypes.Contains(fromChart) ? fromChart : (_subTypes.FirstOrDefault() ?? "");
        _supportsOco    = supported && await OrderService.SupportsOcoPairsAsync(provider);
        _maxLeverage    = supported ? await OrderService.GetMaxLeverageAsync(provider) : 1.0;
        _leverage       = Can(ProviderCapabilities.Leverage) ? Math.Min(_leverage, _maxLeverage) : 1.0;

        _limitPrice  = GetCurrentPrice();
        _isVisible   = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Trading dashboard"));
        StateHasChanged();

        // Focus moves to the title whether or not this venue supports trading —
        // the dialog opened either way, and a keyboard user parked on the chart
        // would otherwise never hear it. Only the trading-only work is gated.
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "trade-title"); } catch { }

        await LoadAccountDataAsync();
        await RefreshBookAsync();

        // Refreshes the order book AND the account. The account used to be loaded once, when the
        // dashboard opened, and never again — so unrealised P&L was frozen at whatever it happened
        // to be at that moment, and a position opened while the dashboard was up never appeared.
        // A P&L that looks live and is not is worse than one that is obviously stale.
        //
        // First tick at 2000, not 0. The two loads above have just run; a zero due-time repeated
        // both of them milliseconds later, so opening the dashboard fired eight account reads
        // instead of four and re-rendered the dialog again while the open was still settling.
        _refreshTimer = new System.Threading.Timer(async _ => await InvokeAsync(RefreshLiveAsync), null, 2000, 2000);
    }

    // ── Protective levels on the positions table ────────────────────────────
    //
    // Position (the SDK record every provider returns) carries no stop or target, and widening it
    // would break every plugin. It does not need to: a protective order IS an open order, so the
    // levels are derived from the open-orders list by matching symbol and order type. That also
    // means what the table shows is the order that actually exists at the venue, rather than a
    // remembered intention that may have been cancelled behind our back.

    /// <summary>Which cell, if any, is currently being edited. Keyed by account as
    /// well as symbol: the same symbol can be held on two venues, and editing one
    /// row's stop must not open the other row's field.</summary>
    private (string Slug, string Symbol, ProtectiveLevel Level)? _editing;
    private string _editText = "";

    /// <summary>
    /// The resting order that IS this position's stop or target.
    ///
    /// <para>
    /// Matched within the position's own account. Since the orders list stopped being
    /// filtered to one chart it can hold the same symbol from two venues, and a stop
    /// resting on Kraken displayed against a Binance position would be a protective
    /// level the position does not have — read as protection, and edited by
    /// cancelling a stop on the wrong exchange.
    /// </para>
    /// </summary>
    private OpenOrder? ProtectiveOrderFor(AccountPosition row, ProtectiveLevel level)
    {
        bool wantStop = level == ProtectiveLevel.StopLoss;
        return _openOrders.FirstOrDefault(r =>
            r.Account.Slug == row.Account.Slug &&
            string.Equals(r.Order.Symbol, row.Position.Symbol, StringComparison.OrdinalIgnoreCase) &&
            (wantStop
                ? r.Order.Type is OrderType.StopMarket or OrderType.StopLimit
                : r.Order.Type is OrderType.TakeProfitMarket or OrderType.TakeProfitLimit))?.Order;
    }

    private RenderFragment RenderProtective(AccountPosition row, ProtectiveLevel level) => builder =>
    {
        var p = row.Position;
        bool isEditing = _editing.HasValue
            && _editing.Value.Slug == row.Account.Slug
            && _editing.Value.Symbol == p.Symbol && _editing.Value.Level == level;

        var existing = ProtectiveOrderFor(row, level);
        string name = level == ProtectiveLevel.StopLoss ? "stop loss" : "take profit";
        string shown = existing != null ? PriceFormatter.FormatPrice(existing.Price) : "not set";

        if (isEditing)
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "type", "text");
            builder.AddAttribute(2, "value", _editText);
            builder.AddAttribute(3, "aria-label", $"{name} for {p.Symbol}. Type a price and press Enter. Escape cancels.");
            builder.AddAttribute(4, "style", "width:110px;");
            builder.AddAttribute(5, "autofocus", true);
            builder.AddAttribute(6, "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(this, e => _editText = e.Value?.ToString() ?? ""));
            builder.AddAttribute(7, "onkeydown",
                EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnProtectiveKeyAsync(e, row, level)));
            builder.CloseElement();
            return;
        }

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "class", "link-button");
        // The label carries the distance as well as the price, because "63,300" alone does not say
        // whether that stop is prudent or a hair away — and on a screen reader there is no glance.
        builder.AddAttribute(3, "aria-label", existing != null
            ? $"{name} {PriceFormatter.FormatPrice(existing.Price)}, {ProtectiveLevelValidator.DistanceFromPrice(existing.Price, CurrentPriceFor(p))}. Activate to edit."
            : $"No {name} set for {p.Symbol}. Activate to add one.");
        builder.AddAttribute(4, "onclick",
            EventCallback.Factory.Create(this, () => BeginEdit(row, level, existing)));
        builder.AddContent(5, shown);
        builder.CloseElement();
    };

    private void BeginEdit(AccountPosition row, ProtectiveLevel level, OpenOrder? existing)
    {
        _editing = (row.Account.Slug, row.Position.Symbol, level);
        _editText = existing != null
            ? existing.Price.ToString("0.########", System.Globalization.CultureInfo.InvariantCulture)
            : "";
        StateHasChanged();
    }

    private async Task OnProtectiveKeyAsync(KeyboardEventArgs e, AccountPosition row, ProtectiveLevel level)
    {
        if (e.Key == "Escape")
        {
            _editing = null;
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, "Left unchanged."));
            StateHasChanged();
            return;
        }
        if (e.Key != "Enter") return;

        await CommitProtectiveAsync(row, level);
    }

    /// <summary>The current price the level is judged against.</summary>
    private double CurrentPriceFor(Position p)
    {
        var st = Store.State;
        if (st.Data != null && st.Data.Count > 0 &&
            string.Equals(st.Identity.Symbol, p.Symbol, StringComparison.OrdinalIgnoreCase))
            return (double)st.Data[st.Data.Count - 1].Close;

        // Fall back to the position's own mark, which is what the venue last valued it at.
        return p.Quantity != 0 ? Math.Abs(p.MarketValue / p.Quantity) : p.AveragePrice;
    }

    /// <summary>
    /// Validates, then replaces the protective order: cancel the old one, place the new one.
    ///
    /// <para>
    /// Cancel-then-place rather than a modify call, because <c>IOrderExecutionService</c> has no
    /// modify and inventing one per provider is a larger change than this warrants. The order matters
    /// — placing first could leave two stops on one position, and two stops is worse than none for
    /// the few seconds it takes to notice.
    /// </para>
    /// </summary>
    private async Task CommitProtectiveAsync(AccountPosition row, ProtectiveLevel level)
    {
        var p = row.Position;
        bool isLong = p.Quantity > 0;
        var check = ProtectiveLevelValidator.Validate(_editText, level, isLong, CurrentPriceFor(p));

        if (!check.Ok)
        {
            // Stay in the field so the value can be corrected rather than retyped.
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, check.Message, true));
            StateHasChanged();
            return;
        }

        // The venue is the position's own, not the focused chart's. This used to read
        // Store.State.Identity.Provider and refuse with "No trading provider for this
        // chart" — a refusal about a chart, on a control attached to a position that
        // knows perfectly well where it lives.
        string provider = row.Account.ProviderName;

        var existing = ProtectiveOrderFor(row, level);
        if (existing != null)
            await OrderService.CancelOrderAsync(provider, existing.Id, p.Symbol);

        // A protective order closes the position, so it is the opposite side and the same quantity.
        var exitSide = isLong ? OrderSide.Sell : OrderSide.Buy;
        var signal = new TradeSignal(
            Symbol: p.Symbol,
            Side: exitSide,
            Quantity: Math.Abs(p.Quantity),
            Type: level == ProtectiveLevel.StopLoss ? OrderType.StopMarket : OrderType.TakeProfitMarket,
            Price: null,
            StopLoss: level == ProtectiveLevel.StopLoss ? check.Value : null,
            TakeProfit: level == ProtectiveLevel.TakeProfit ? check.Value : null);

        var placement = await OrderService.PlaceOrderAsync(provider, signal);

        _editing = null;
        await LoadAccountDataAsync();

        EventBus.Publish(placement.Succeeded
            ? new FeedbackRequestEvent(FeedbackType.StateChange, check.Message)
            : new FeedbackRequestEvent(FeedbackType.Error, placement.FailureMessage!, true));
        StateHasChanged();
    }

    /// <summary>
    /// Which accounts this user can trade — the question that replaced "what chart am
    /// I looking at?".
    ///
    /// <para>
    /// Paper mode is one account and it belongs to no venue: the paper broker is
    /// returned for any provider name at all. It is named <c>"Paper"</c> rather than
    /// left blank because <c>SupportsTradingAsync</c> refuses an empty string before
    /// the routing that would have ignored it.
    /// </para>
    ///
    /// <para>
    /// <b>A key that can withdraw is never enumerated.</b> Nothing on the trading path
    /// may touch a withdrawal credential, so such a profile does not become an account
    /// here even when it is active and its provider trades — see the doc comment on
    /// <c>ApiKeyConfig.AllowsWithdrawal</c>.
    /// </para>
    /// </summary>
    private async Task<List<TradingAccount>> EnumerateAccountsAsync()
    {
        if (_paperMode)
            return new List<TradingAccount> { new("Paper", "Paper", "paper", IsPaper: true) };

        List<ApiKeyConfig> keys;
        try { keys = await ApiKeyService.GetAllKeysAsync(); }
        catch (Exception ex)
        {
            _layoutLogger?.LogWarning(ex, "Could not enumerate trading accounts.");
            return new List<TradingAccount>();
        }

        var usable = keys.Where(k => k.IsActive && !k.AllowsWithdrawal).ToList();
        var accounts = new List<TradingAccount>();
        foreach (var provider in usable.Select(k => k.Provider)
                                       .Distinct(StringComparer.OrdinalIgnoreCase)
                                       .Where(p => !string.IsNullOrEmpty(p))
                                       .OrderBy(p => p, StringComparer.OrdinalIgnoreCase))
        {
            if (!await OrderService.SupportsTradingAsync(provider)) continue;

            // The nickname only earns its place when there is more than one key for
            // this venue; otherwise "Kraken (main)" is a longer way to say "Kraken"
            // in a column that is read on every row.
            var forProvider = usable.Where(k => string.Equals(k.Provider, provider, StringComparison.OrdinalIgnoreCase)).ToList();
            string display = forProvider.Count > 1
                ? $"{provider} ({(forProvider.FirstOrDefault(k => k.Nickname == _activeKeyNickname) ?? forProvider[0]).Nickname})"
                : provider;
            accounts.Add(new TradingAccount(provider, display, Slugify(provider), IsPaper: false));
        }
        return accounts;
    }

    private static string Slugify(string s) =>
        new string(s.Select(ch => char.IsLetterOrDigit(ch) ? char.ToLowerInvariant(ch) : '-').ToArray());

    /// <summary>Everything one account has to say, and why any of it is missing.</summary>
    private sealed record AccountData(
        TradingAccount Account,
        List<AccountBalance> Balances, List<AccountPosition> Positions,
        List<AccountOrder> Orders, List<AccountFill> Fills,
        string? BalancesNote, string? PositionsNote, string? OrdersNote, string? FillsNote,
        ProviderCapabilities Caps, PortfolioSnapshot? Portfolio);

    private async Task LoadAccountDataAsync()
    {
        // Before anything reads it: a user who toggled paper mode off in Settings
        // while this dialog stayed open must not have their live venues enumerated
        // under a stale paper flag, or the reverse.
        RefreshTradingEnvironment();

        _accounts = await EnumerateAccountsAsync();
        if (_accounts.Count == 0)
        {
            // The one thing worse than an empty account view is an empty account view
            // that does not say it is empty because nothing is connected.
            _balances = new(); _positions = new(); _openOrders = new(); _fills = new();
            _portfolios = new(); _accountCaps = new();
            const string none = "No trading account is connected. Add an API key in the API keys "
                              + "modal, or turn on paper trading in Settings.";
            _balancesNote = _positionsNote = _openOrdersNote = _fillsNote = none;
            StateHasChanged();
            return;
        }

        // Concurrently, with each account's failure isolated: one venue timing out
        // costs that venue's rows and nothing else. Serially, a single slow exchange
        // held up every other account's data behind it.
        var loaded = await Task.WhenAll(_accounts.Select(LoadOneAccountAsync));

        _balances   = loaded.SelectMany(a => a.Balances).ToList();
        _positions  = loaded.SelectMany(a => a.Positions).ToList();
        _openOrders = loaded.SelectMany(a => a.Orders).ToList();
        _fills      = loaded.SelectMany(a => a.Fills).OrderByDescending(r => r.Fill.FilledAt).ToList();

        _portfolios  = loaded.ToDictionary(a => a.Account.Slug, a => a.Portfolio);
        _accountCaps = loaded.ToDictionary(a => a.Account.Slug, a => a.Caps);

        _balancesNote   = CombineNotes(loaded.Select(a => (a.Account, a.BalancesNote)));
        _positionsNote  = CombineNotes(loaded.Select(a => (a.Account, a.PositionsNote)));
        _openOrdersNote = CombineNotes(loaded.Select(a => (a.Account, a.OrdersNote)));
        _fillsNote      = CombineNotes(loaded.Select(a => (a.Account, a.FillsNote)));

        StateHasChanged();
    }

    /// <summary>
    /// One account's four reads. Nothing here throws: a provider that falls over
    /// reports it as a note on its own tabs, which is the difference between "this
    /// venue could not be read" and "you have nothing", and a trader acts differently
    /// on each.
    /// </summary>
    private async Task<AccountData> LoadOneAccountAsync(TradingAccount account)
    {
        string provider = account.ProviderName;
        try
        {
            // NOT filtered by the focused chart's symbol. That filter was an exact
            // string match, so a user with BTC/USD orders and a BTCUSDT chart saw an
            // empty Orders tab and could not cancel them — while the Positions tab,
            // which takes no symbol, showed the position they could not act on.
            var balancesTask  = OrderService.GetBalancesAsync(provider);
            var positionsTask = OrderService.GetPositionsAsync(provider);
            var ordersTask    = OrderService.GetOpenOrdersAsync(provider, null);
            var fillsTask     = OrderService.GetFillsAsync(provider);
            var capsTask      = OrderService.GetCapabilitiesAsync(provider);
            await Task.WhenAll(balancesTask, positionsTask, ordersTask, fillsTask, capsTask);

            var balances  = await balancesTask;
            var positions = await positionsTask;
            var orders    = await ordersTask;
            var fills     = await fillsTask;

            var balanceList = balances.OrElse(new List<Balance>());

            // Valued after the balances land, and never allowed to take the tab down
            // with it — a pricing outage must cost the value column, not the balances.
            PortfolioSnapshot? snapshot = null;
            try { snapshot = await Portfolio.ValueAsync(provider, balanceList, PortfolioQuote); }
            catch (Exception ex)
            {
                _layoutLogger?.LogWarning(ex, "Portfolio valuation failed for {Provider}", provider);
            }

            return new AccountData(account,
                balanceList.Select(b => new AccountBalance(account, b)).ToList(),
                positions.OrElse(new List<Position>()).Select(p => new AccountPosition(account, p)).ToList(),
                orders.OrElse(new List<OpenOrder>()).Select(o => new AccountOrder(account, o)).ToList(),
                fills.OrElse(new List<TradeFill>()).Select(f => new AccountFill(account, f)).ToList(),
                EmptyNote(balances), EmptyNote(positions), EmptyNote(orders), EmptyNote(fills),
                await capsTask, snapshot);
        }
        catch (Exception ex)
        {
            _layoutLogger?.LogWarning(ex, "Account read failed for {Provider}", provider);
            string note = $"Could not be read — {ex.Message}. This is NOT a statement that you have none.";
            return new AccountData(account, new(), new(), new(), new(),
                note, note, note, note, ProviderCapabilities.None, null);
        }
    }

    /// <summary>
    /// The per-tab "why it is empty" note, across however many accounts there are.
    /// With one account it reads exactly as it always did; with several, each note is
    /// attributed, because "could not be read" is only actionable once you know which
    /// venue could not be read.
    /// </summary>
    private string? CombineNotes(IEnumerable<(TradingAccount Account, string? Note)> notes)
    {
        var real = notes.Where(n => !string.IsNullOrEmpty(n.Note)).ToList();
        if (real.Count == 0) return null;
        // Attribution is keyed on how many accounts EXIST, not on how many of them
        // had something to say: with three venues connected and one unreachable, an
        // unattributed "could not be read" names none of them and is unactionable.
        return _accounts.Count <= 1
            ? real[0].Note
            : string.Join(" ", real.Select(n => $"{n.Account.DisplayName}: {n.Note}"));
    }

    /// <summary>
    /// Recomputes <c>_paperMode</c> and <c>_isLiveEnvironment</c> from the LIVE paper-trading
    /// setting. Both are otherwise cached when the modal opens; if the user toggled paper mode
    /// OFF in Settings (F12 / Settings modal) while this dashboard stayed open, the stale cache
    /// would skip the live-order confirmation at submit while GeneralOrderService — which reads
    /// the setting live — routed the order to the REAL broker. Always call this before the live
    /// gate so a real-money order can never go out unconfirmed with the badge still showing Paper.
    /// </summary>
    private void RefreshTradingEnvironment()
    {
        _paperMode = !Demo.AllowLiveTrading
            || (Settings.GetSetting("trading.paperTradingMode")?.ToObject<bool>() ?? false);
        var activeKey = _availableKeys.FirstOrDefault(k => k.Nickname == _activeKeyNickname);
        _isLiveEnvironment = !_paperMode && activeKey?.Environment == "Live";
    }

    /// <summary>
    /// One tick of the live refresh: the book, and the account behind it.
    ///
    /// <para>
    /// The account read is skipped while a protective level is being edited — repainting the table
    /// under someone mid-edit would throw away what they had typed, and doing it every two seconds
    /// would make the field unusable.
    /// </para>
    /// </summary>
    private async Task RefreshLiveAsync()
    {
        await RefreshBookAsync();
        // Any inline field open means someone is mid-type. Repainting the table under
        // them throws away what they had typed, and doing it every two seconds makes
        // the field unusable — which on the limit-close field means the exit never
        // gets placed.
        if (_editing.HasValue || _closingAtLimit.HasValue) return;
        try { await LoadAccountDataAsync(); } catch { /* a transient read must not kill the timer */ }
        StateHasChanged();
    }

    private async Task RefreshBookAsync()
    {
        if (!_isVisible) return;
        var provider = Store.State.Identity.Provider;
        var symbol = Store.State.Identity.Symbol;
        if (string.IsNullOrEmpty(provider) || string.IsNullOrEmpty(symbol)) return;

        if (!_bookEverLoaded)
        {
            _bookLoading = true;
            StateHasChanged();
        }

        var (bids, asks) = await OrderService.GetOrderBookAsync(provider, symbol);
        _bids = bids;
        _asks = asks;
        _bookLoading = false;
        _bookEverLoaded = true;
        StateHasChanged();
    }

    private async Task OnKeyChanged(ChangeEventArgs e)
    {
        _activeKeyNickname = e.Value?.ToString() ?? "";
        await ApiKeyService.SetActiveKeyAsync(_activeKeyNickname);
        
        // Announce key change
        var key = _availableKeys.FirstOrDefault(k => k.Nickname == _activeKeyNickname);
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, $"Switched to API key {key?.Nickname} ({key?.Environment})", true));
        
        await LoadAccountDataAsync();
    }

    private async Task RefreshAccount() => await LoadAccountDataAsync();

    /// <summary>
    /// The balances of the account an order from the TICKET would be placed on — the
    /// chart's venue, or the single paper account. Empty when no account matches,
    /// which is the honest answer: there is nothing to size from.
    /// </summary>
    private IEnumerable<Balance> TicketBalances()
    {
        var account = _accounts.FirstOrDefault(a => a.IsPaper)
                   ?? _accounts.FirstOrDefault(a => string.Equals(
                          a.ProviderName, Store.State.Identity.Provider, StringComparison.OrdinalIgnoreCase));
        if (account == null) return Enumerable.Empty<Balance>();
        return _balances.Where(r => r.Account.Slug == account.Slug).Select(r => r.Balance);
    }

    private void SelectAccountTab(string tab)
    {
        _accountTab = tab;
        int count = tab switch
        {
            "Positions" => _positions.Count,
            "Orders"    => _openOrders.Count,
            "History"   => _fills.Count,
            "Balances"  => _balances.Count(r => r.Balance.Free > 0 || r.Balance.Locked > 0),
            _           => 0
        };
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, $"{tab}, {count}", true));
        StateHasChanged();
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Trading dashboard"));
        // Both inline editors are abandoned, not remembered. A half-typed limit price
        // that came back on the next open would be a price chosen for a market that
        // has since moved, sitting one Enter away from a live exit.
        _editing = null;
        _closingAtLimit = null;
        // And the armed live-order review, for the same reason and more sharply. It used to
        // survive: arm a review on BTC, press Escape, load an ETH chart, press Alt+T — the
        // dialog reopened with the Confirm/Cancel pair already rendered, but ShowAsync had
        // blanked _orderStatus, so NOTHING was spoken and nothing was on screen to explain
        // it. One Enter then sent a live ETH order that had never been reviewed at all.
        ResetLiveReview();
        _refreshTimer?.Dispose();
        _refreshTimer = null;
        StateHasChanged();
    }

    private async Task SubmitOrder()
    {
        if (!CanSubmit) return;
        // Never trust the open-time paper/live cache for the confirmation gate — the user may
        // have toggled paper mode off in Settings while this modal stayed open (see
        // RefreshTradingEnvironment). Recompute from the live setting first.
        bool wasPaper = _paperMode;
        RefreshTradingEnvironment();
        if (wasPaper != _paperMode) StateHasChanged(); // keep the Env badge honest too
        // Live orders get a spoken review + explicit confirm; paper submits directly.
        if (_isLiveEnvironment && !_paperMode && !_reviewArmed)
        {
            await ArmLiveReview();
            return;
        }

        // THE BACKSTOP. The per-control void above catches an edit as it is typed; this catches
        // everything it cannot see — a control added to this ticket later with no hook, a chart
        // symbol change under the dialog (Symbol and Provider go out with the order and are not
        // ticket fields at all), a programmatic write like the Size button. Comparing the whole
        // built signal rather than a list of fields is what makes that guarantee hold without
        // anyone maintaining the list.
        if (_reviewArmed
            && (BuildSignal() != _reviewedSignal
                || (Store.State.Identity.Provider ?? "") != _reviewedProvider))
        {
            await ArmLiveReview("Ticket changed since the review. Nothing was sent.");
            return;
        }
        // Direction check on the attached bracket, BEFORE anything is sent. A stop on
        // the wrong side of the market is not caught by every venue: several accept it
        // and trigger it immediately, so the entry closes itself at market having paid
        // two fees. ProtectiveLevelValidator has held this rule since it was written and
        // had exactly one caller — the position table's inline editor — so the ticket,
        // the one place a bracket is typed from scratch, was never checked.
        if (!ValidateTicketProtectiveLevels()) return;

        if (!BeginOrderAction($"{_orderSide} {Store.State.Identity.Symbol}")) return;
        ResetLiveReview();
        _orderStatus = "Submitting…";
        _orderError  = false;
        StateHasChanged();

        try
        {
            var signal = BuildSignal();

            var placement = await OrderService.PlaceOrderAsync(Store.State.Identity.Provider!, signal);

            // This line used to be `result.StartsWith("ORDER_FAILED") || result.StartsWith("PROVIDER_NOT")`,
            // a private third recogniser that matched neither of the other two. It missed
            // ORDER_DUPLICATE_SUPPRESSED — the routine screen-reader double-Enter — and announced
            // "Order placed" for an order the dedup gate had just refused to send, along with both
            // ORDER_REJECTED_* codes and ORDER_UNCERTAIN. The classification now happens once, in
            // OrderPlacement, and this component consumes it.
            _orderError  = !placement.Succeeded;
            // Paper orders skip the live review, so the sector-stacking hint (warn-only,
            // never blocking) rides along with the fill confirmation instead.
            string sectorHint = !_orderError
                ? AccessibleTrader.Core.Services.SectorClassifier.BuildSectorHint(
                      Store.State.Identity.Symbol, _positions.Select(r => r.Position.Symbol)) ?? ""
                : "";
            if (sectorHint.Length > 0) sectorHint = " " + sectorHint;
            string placed = $"Order placed. {_orderSide} {PriceFormatter.FormatQuantity(_orderQty)} {Store.State.Identity.Symbol}, {_orderType.ToLowerInvariant()}.{sectorHint}";
            // Same rule as ClosePosition: a rejection carries its reason, and the reason is the
            // part the user can act on. "Order rejected" alone sends them back to guess.
            _orderStatus = _orderError
                ? placement.RefusalAnnouncement($"Order rejected for {Store.State.Identity.Symbol}.")
                : placed;

            // COHERENT SPEECH ANNOUNCEMENT
            // OrderEvent on the success path. Error already reached Critical and could not be
            // silenced; Info landed on Manual, which F2 mutes — so with speech off this terminal
            // spoke every rejection and no confirmation, and the user could not tell a placed
            // order from a button that had not registered. Every ASYNCHRONOUS outcome (fill,
            // partial, stop, take-profit, reject, cancel, expiry, replace) is already on this
            // channel; the synchronous acknowledgement was the only one that was not, and it is
            // the one the user pressed the button for.
            EventBus.Publish(new FeedbackRequestEvent(
                _orderError ? FeedbackType.Error : FeedbackType.Info, _orderStatus, true,
                Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.OrderEvent));

            if (!_orderError) await LoadAccountDataAsync();
        }
        catch (Exception ex)
        {
            _orderError  = true;
            _orderStatus = $"Order failed: {ex.Message}";
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, _orderStatus, true));
        }
        finally
        {
            EndOrderAction();
        }
    }


    /// <summary>
    /// The order this ticket currently describes, exactly as it would go to the venue.
    ///
    /// <para>
    /// Extracted from <c>SubmitOrder</c> so that the LIVE REVIEW and the SUBMIT that follows
    /// it are built by the same code. The review is the only rendering of the order a blind
    /// trader gets before it is sent, which makes "what was read aloud" and "what is sent"
    /// two values that must be comparable — and comparing hand-picked FIELDS does not work
    /// here, because half of them are conditioned on capability and order type as the signal
    /// is assembled (<c>NeedsLimit</c>, <c>IsEntryType</c>, <c>Can(...)</c>). A raw field
    /// snapshot would refuse a Market order because a limit price the venue never sees had
    /// been edited. <c>TradeSignal</c> is a record, so comparing two of them is exact and
    /// costs nothing, and every field added to the ticket in future is covered without
    /// anyone remembering to add it to a list.
    /// </para>
    /// </summary>
    private TradeSignal BuildSignal()
    {
        var side  = _orderSide == "Sell" ? OrderSide.Sell : OrderSide.Buy;
        var type  = _orderType switch
        {
            "Limit"              => OrderType.Limit,
            "Stop-Market"        => OrderType.StopMarket,
            "Stop-Limit"         => OrderType.StopLimit,
            "Take-Profit-Market" => OrderType.TakeProfitMarket,
            "Take-Profit-Limit"  => OrderType.TakeProfitLimit,
            _                    => OrderType.Market
        };
        double? price   = NeedsLimit   ? _limitPrice   : (double?)null;
        double? trigger = NeedsTrigger ? _triggerPrice : (double?)null;
        double? sl  = IsEntryType && _stopLoss   > 0 ? _stopLoss   : (double?)null;
        double? tp  = IsEntryType && _takeProfit > 0 ? _takeProfit : (double?)null;
        // Gated on the SAME capability that decides whether the control is drawn.
        // The two must agree: a field set here but ignored by the provider is the
        // silent half of the same defect as a control drawn over nothing — the
        // order goes out looking like the one that was asked for.
        double? lev = Can(ProviderCapabilities.Leverage) && _leverage > 1 ? _leverage : null;
        TrailMode? trailMode = _trailMode switch { "Percent" => TrailMode.Percent, "Amount" => TrailMode.Amount, _ => (TrailMode?)null };
        double? trailVal = IsEntryType && trailMode != null && _trailValue > 0 ? _trailValue : (double?)null;
        string? tif = NeedsLimit && Can(ProviderCapabilities.TimeInForce) ? _tif : null;
        string? posSide = Can(ProviderCapabilities.HedgeMode) && _positionSide != "BOTH" ? _positionSide : null;
        TrailMode? trailTpMode = _trailTpMode switch { "Percent" => TrailMode.Percent, "Amount" => TrailMode.Amount, _ => (TrailMode?)null };
        double? trailTpVal = IsEntryType && trailTpMode != null && _trailTpValue > 0 ? _trailTpValue : (double?)null;
        double? trailTpAct = trailTpVal != null && _trailTpActivation > 0 ? _trailTpActivation : (double?)null;

        // The market type the ticket is set to. TradeSignal.SubType has existed
        // since the contract was written and nothing ever set it from here — the
        // value was inferred from the chart's identity, so the futures book was
        // unreachable unless you had already loaded a futures chart.
        string? subType = string.IsNullOrEmpty(_subType) ? null : _subType;

        return new TradeSignal(
            Symbol:     Store.State.Identity.Symbol!,
            Side:       side,
            Quantity:   _orderQty,
            Type:       type,
            Price:      price,
            StopLoss:   sl,
            TakeProfit: tp,
            Leverage:     lev,
            SubType:      subType,
            MarginType:     Can(ProviderCapabilities.IsolatedMargin) ? _marginType : null,
            TriggerPrice:   trigger,
            TrailStopMode:  trailVal != null ? trailMode : null,
            TrailStopValue: trailVal,
            TrailTpMode:    trailTpVal != null ? trailTpMode : null,
            TrailTpValue:   trailTpVal,
            TrailTpActivation: trailTpAct,
            TimeInForce:    tif,
            ReduceOnly:     Can(ProviderCapabilities.ReduceOnly) && _reduceOnly,
            PostOnly:       NeedsLimit && Can(ProviderCapabilities.PostOnly) && _postOnly,
            PositionSide:   posSide);
    }

    /// <summary>
    /// Checks the ticket's typed stop loss and take profit against the direction of the
    /// order and the current price, speaking the refusal and leaving the field for the
    /// user to correct.
    ///
    /// <para>
    /// Only entry types carry a bracket, and only a positive value is a value: the two
    /// fields are otherwise ignored (matching how <c>sl</c>/<c>tp</c> are built below).
    /// With no current price the validator declines to judge, and that is reported as
    /// such rather than silently letting the order through.
    /// </para>
    /// </summary>
    private bool ValidateTicketProtectiveLevels()
    {
        if (!IsEntryType) return true;
        if (_stopLoss <= 0 && _takeProfit <= 0) return true;

        bool isLong = _orderSide != "Sell";
        // A limit entry is judged against ITS OWN price — that is the level the position
        // will be opened at, and a stop 5% below spot can still be above a limit entry
        // placed 10% lower. Market entries are judged against the live price.
        double reference = NeedsLimit && _limitPrice > 0 ? _limitPrice : GetCurrentPrice();

        foreach (var (value, level) in new[]
        {
            (_stopLoss,   ProtectiveLevel.StopLoss),
            (_takeProfit, ProtectiveLevel.TakeProfit),
        })
        {
            if (value <= 0) continue;
            var check = ProtectiveLevelValidator.Validate(
                value.ToString(System.Globalization.CultureInfo.InvariantCulture),
                level, isLong, reference);
            if (check.Ok) continue;

            _orderError  = true;
            _orderStatus = $"Order not sent. {check.Message}";
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, _orderStatus, true));
            StateHasChanged();
            return false;
        }
        return true;
    }

    /// <summary>
    /// Cancels the order on the account it is resting on.
    ///
    /// <para>
    /// This method used to open <c>var provider = Store.State.Identity.Provider; if
    /// (string.IsNullOrEmpty(provider)) return;</c> — the reported bug, twice over.
    /// The venue came from whatever chart was focused rather than from the order, so
    /// with no chart up it returned in silence: the user pressed Cancel and the
    /// terminal did nothing and said nothing, which is indistinguishable from a dead
    /// control and is the worst available outcome on a screen nobody can see. The
    /// row now carries its own account, so there is no guess left to make and no
    /// early return left to be silent about.
    /// </para>
    /// </summary>
    private async Task CancelOrder(AccountOrder row)
    {
        string symbol = row.Order.Symbol;
        if (!BeginOrderAction($"Cancel {symbol}")) return;

        try
        {
            bool ok = await OrderService.CancelOrderAsync(row.Account.ProviderName, row.Order.Id, symbol);
            EventBus.Publish(new FeedbackRequestEvent(
                ok ? FeedbackType.StateChange : FeedbackType.Error,
                ok ? $"Order canceled. {symbol} on {row.Account.DisplayName}."
                   : $"Cancel failed for {symbol} on {row.Account.DisplayName}.", true));

            if (ok) await LoadAccountDataAsync();
        }
        finally
        {
            EndOrderAction();
        }
    }

    // Derive order quantity from a risk budget: risk a percentage of the quote
    // balance over the distance from entry to the stop. Needs a stop loss and a
    // price (limit price for limit-style orders, otherwise the live price).
    private void SizeFromRisk()
    {
        double price  = NeedsLimit && _limitPrice > 0 ? _limitPrice : GetCurrentPrice();

        // The account's CASH, in the currency this instrument is quoted in — not the
        // largest balance of any asset, which is what this line used to be. An account
        // holding 50,000 DOGE and 300 USDT sized every trade from 50,000: roughly 166×
        // too large, silently, from a button labelled "Size from risk". If the quote
        // currency is not held, fall back to the largest single cash line rather than to
        // a made-up number, and say which currency was used.
        string quote = SymbolAssets.QuoteOf(Store.State.Identity.Symbol ?? "") ?? "";
        // Only the account this order would actually go to. The balances list now
        // spans every connected venue, and sizing a Kraken order from the cash sitting
        // on Binance produces a position the destination account cannot fund — a
        // number that looks like risk management and is not.
        var cash = TicketBalances()
            .Where(b => AccessibleTrader.Core.Services.Trading.QuickTradeEquity.IsCashAsset(b.Asset))
            .Select(b => (b.Asset, Amount: b.Free))
            .ToList();
        var chosen = cash.FirstOrDefault(c => string.Equals(c.Asset, quote, StringComparison.OrdinalIgnoreCase));
        if (chosen.Amount <= 0 && cash.Count > 0)
            chosen = cash.OrderByDescending(c => c.Amount).ThenBy(c => c.Asset, StringComparer.Ordinal).First();
        double equity = chosen.Amount;

        double perUnit = Math.Abs(price - _stopLoss);
        if (_stopLoss <= 0 || price <= 0 || equity <= 0 || _riskPct <= 0 || perUnit <= 0)
        {
            // Say which input is missing. "Set a stop loss, a price, and a risk percent"
            // sent a user to check three fields that were all fine when the real reason
            // was an account holding no cash the sizer recognises.
            string why = equity <= 0 && _stopLoss > 0 && price > 0 && _riskPct > 0
                ? "No cash balance to size from — the account holds no currency this sizer recognises."
                : "Set a stop loss, a price, and a risk percent first.";
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, why, true));
            return;
        }
        // Round DOWN, not to nearest: rounding half-away-from-zero can put the sized
        // quantity above the risk budget the user just asked to stay inside.
        _orderQty = Math.Floor(equity * _riskPct / 100.0 / perUnit * 1e6) / 1e6;
        // The Size button changes the quantity WITHOUT the user typing in the field, so no
        // @oninput hook on the ticket can see it. Voiding here keeps the rule whole: the
        // number in the review is the number that goes out, however it got there.
        VoidReviewIfArmed("Quantity");
        if (_orderQty <= 0)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"{_riskPct} percent of {PriceFormatter.FormatPrice(equity)} {chosen.Asset} over that stop distance "
                + "is less than the smallest size this sizer can express. Widen the risk or move the stop closer.", true));
            return;
        }
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Sized {PriceFormatter.FormatQuantity(_orderQty)} from {_riskPct} percent risk on "
            + $"{PriceFormatter.FormatPrice(equity)} {chosen.Asset}.", true));
    }

    // ── OCO pair state + submit ─────────────────────────────────────────────
    // Pairing/rollback/sanity all live in IOrderExecutionService.PlaceOcoPairAsync
    // (native on supporting exchanges, terminal-grouped on paper); the modal just
    // collects the four fields and speaks the outcome.
    private string _ocoSide = "Sell";
    private double _ocoQty;
    private double _ocoLimitPrice;
    private double _ocoStopPrice;
    private string? _ocoStatus;
    private bool _ocoError;
    private bool _supportsOco;

    /// <summary>
    /// Null when the OCO pair can be placed; otherwise why it cannot. The last clause is
    /// the rule nobody guesses from the form: a limit and a stop at the SAME price cannot
    /// be a pair, because neither can be the one that fills first and cancels the other.
    /// Under `disabled` that rule was unstateable — the button was simply not there.
    /// </summary>
    private string? OcoGate()
    {
        if (_orderInFlight) return "An order is already being sent. Wait for it to finish.";
        if (_ocoQty <= 0) return "Enter an OCO quantity above zero.";
        if (_ocoLimitPrice <= 0) return "Enter a limit price above zero.";
        if (_ocoStopPrice <= 0) return "Enter a stop trigger above zero.";
        if (_ocoLimitPrice == _ocoStopPrice) return OcoPairErrorText;
        return null;
    }

    private bool CanSubmitOco => OcoGate() is null;

    /// <summary>
    /// The one OCO rule that is a judgement on entered values rather than a blank field: a limit
    /// and a stop at the SAME price cannot be a pair. Both prices must be filled in before it can
    /// be true, so it never fires on an untouched form.
    /// </summary>
    private bool OcoPairInvalid =>
        _ocoLimitPrice > 0 && _ocoStopPrice > 0 && _ocoLimitPrice == _ocoStopPrice;

    private const string OcoPairErrorText =
        "The limit price and the stop trigger must differ. One cancels the other, so at the same "
        + "price neither can fill first.";

    /// <summary>
    /// The gate on every per-row action — closing a position, cancelling an order. All of
    /// them share the one in-flight latch, so all of them share one reason.
    /// </summary>
    private string? InFlightGate() =>
        _orderInFlight ? "An order is already being sent. Wait for it to finish." : null;

    private async Task SubmitOcoPair()
    {
        // Defence in depth, matching SubmitOrder's own `if (!CanSubmit) return;`.
        // GatedButton refuses the click before it gets here, but aria-disabled stops
        // nothing in the DOM and this handler is now reachable from anywhere a click
        // can be synthesised.
        if (!CanSubmitOco) return;
        var provider = Store.State.Identity.Provider;
        var symbol = Store.State.Identity.Symbol;
        if (string.IsNullOrEmpty(provider) || string.IsNullOrEmpty(symbol)) return;
        if (!BeginOrderAction($"OCO pair for {symbol}")) return;

        var side = _ocoSide == "Buy" ? OrderSide.Buy : OrderSide.Sell;
        bool ok;
        string message;
        try
        {
            (ok, message) = await OrderService.PlaceOcoPairAsync(
                provider, symbol, side, _ocoQty, _ocoLimitPrice, _ocoStopPrice);
        }
        finally
        {
            EndOrderAction();
        }

        _ocoError = !ok;
        _ocoStatus = ok
            ? $"OCO pair resting: {_ocoSide} {PriceFormatter.FormatQuantity(_ocoQty)} {symbol} — " +
              $"limit {PriceFormatter.FormatPrice(_ocoLimitPrice)}, stop {PriceFormatter.FormatPrice(_ocoStopPrice)}. {message}"
            : message;
        EventBus.Publish(new FeedbackRequestEvent(ok ? FeedbackType.Info : FeedbackType.Error, _ocoStatus, true));
        if (ok) await LoadAccountDataAsync();
    }

    /// <summary>
    /// Close at market. One of exactly two close buttons, and it is always a market
    /// order — see <see cref="CloseAsync"/> for why that is a rule rather than a
    /// default.
    /// </summary>
    private Task ClosePosition(AccountPosition row) => CloseAsync(row, limitPrice: null);

    /// <summary>
    /// Close with a resting limit order at the typed price. The other close button.
    /// </summary>
    private Task ClosePositionAtLimit(AccountPosition row, double limitPrice) =>
        CloseAsync(row, limitPrice);

    // Close (or reduce-to-flat) a position by submitting an opposing order, on the
    // account the position is held in rather than on whatever chart is up.
    //
    // TWO BUTTONS, NOT ONE BUTTON WITH A MODE. `Close position` is market and always
    // market; `Close at limit` is a limit and always a limit. A single control whose
    // order type depends on whether some other field happens to be filled in is a
    // control that behaves differently on two presses that felt identical — which is
    // the exact failure mode this dialog already had, and it is worse on a screen
    // where the state deciding it cannot be seen at a glance.
    private async Task CloseAsync(AccountPosition row, double? limitPrice)
    {
        var p = row.Position;
        string provider = row.Account.ProviderName;
        if (Math.Abs(p.Quantity) < 1e-12)
        {
            // Was a silent return. A flat row should not be closable at all, but if
            // one is reached — a stale snapshot between refreshes — saying so beats
            // a button that does nothing.
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"{p.Symbol} is already flat — nothing to close.", true));
            return;
        }
        if (!BeginOrderAction($"Close {p.Symbol}")) return;

        var side = p.Quantity > 0 ? OrderSide.Sell : OrderSide.Buy;

        // The book to close on — spot or futures — taken from the chart ONLY when the
        // chart is actually looking at this position. It used to be taken from the
        // focused chart unconditionally, so closing a spot holding while a futures
        // chart was in front routed the exit to the futures book, where the position
        // is not. Null means "the venue's default", which is what it always was for
        // anyone with no market suffix.
        string? subType = null;
        var id = Store.State.Identity;
        if (string.Equals(id.Provider, provider, StringComparison.OrdinalIgnoreCase)
            && string.Equals(id.Symbol, p.Symbol, StringComparison.OrdinalIgnoreCase)
            && (id.Market ?? "").Contains('|'))
            subType = id.Market!.Split('|')[1];

        // ReduceOnly is UNCONDITIONAL here, and is not gated on the capability flag
        // the way the ticket's checkbox is. `p` is a snapshot from a timer-refreshed
        // list: hold 1.0 BTC with a stop, let the stop fire down to 0.4, press Close
        // on the stale row, and a plain sell 1.0 closes 0.4 and OPENS A 0.6 SHORT —
        // while the user hears "Closing BTC/USDT. Sell 1.0." A button called Close
        // must never be able to open a position. On a venue that ignores the flag the
        // order is unchanged; on one that honours it the overshoot is clipped, which
        // is the entire point.
        //
        // It matters MORE on the limit path, not less: a resting exit can sit on the
        // book for days while the position it was meant to close is taken out by a
        // stop, and without the flag the survivor opens a fresh position in the
        // opposite direction at a price the trader picked for a completely different
        // trade. Same flag, same line, both paths.
        var signal = new TradeSignal(
            Symbol: p.Symbol, Side: side, Quantity: Math.Abs(p.Quantity),
            Type: limitPrice is null ? OrderType.Market : OrderType.Limit,
            Price: limitPrice,
            SubType: subType, ReduceOnly: true);

        OrderPlacement placement;
        try
        {
            placement = await OrderService.PlaceOrderAsync(provider, signal);
        }
        finally
        {
            EndOrderAction();
        }
        bool err = !placement.Succeeded;
        EventBus.Publish(new FeedbackRequestEvent(err ? FeedbackType.Error : FeedbackType.Info,
            // Say WHY, not just that it failed. The provider returns a reason after the colon
            // ("insufficient paper balance — …", "no live price for symbol — …") and this line
            // used to throw it away, announcing a bare "Close failed for BTC/USD." A refusal a
            // user can act on and a refusal that looks like a dead end are the same event with
            // different words, and for a screen-reader user the actionable half is the half
            // that was being dropped. RefusalAnnouncement also drops the "Close failed" framing
            // for an uncertain close, which may well have gone through.
            err ? placement.RefusalAnnouncement($"Close failed for {p.Symbol}.")
                // The limit case says RESTING, not "closing". A limit exit that has not
                // filled has not closed anything, and a confirmation that sounds like it
                // did is how a trader walks away from a position they believe is gone.
                : limitPrice is double lp
                    ? $"Close order resting. {(side == OrderSide.Sell ? "Sell" : "Buy")} "
                      + $"{PriceFormatter.FormatQuantity(Math.Abs(p.Quantity))} {p.Symbol} "
                      + $"at limit {PriceFormatter.FormatPrice(lp)}. The position is still open until it fills."
                    : $"Closing {p.Symbol}. {(side == OrderSide.Sell ? "Sell" : "Buy")} {PriceFormatter.FormatQuantity(Math.Abs(p.Quantity))}.",
            true));
        if (!err) await LoadAccountDataAsync();
    }

    // ── Close at limit: the inline price field ──────────────────────────────
    //
    // Same shape as the stop/target editors two columns over — a button that becomes
    // a field, Enter commits, Escape cancels — because a second interaction idiom on
    // one table is a second thing to learn for no reason.

    /// <summary>Which row, if any, is typing a limit close price. Keyed by account as
    /// well as symbol: the same symbol can be held on two venues.</summary>
    private (string Slug, string Symbol)? _closingAtLimit;
    private string _closeLimitText = "";

    private bool IsClosingAtLimit(AccountPosition row) =>
        _closingAtLimit is { } c && c.Slug == row.Account.Slug && c.Symbol == row.Position.Symbol;

    private async Task BeginLimitClose(AccountPosition row)
    {
        _closingAtLimit = (row.Account.Slug, row.Position.Symbol);
        // Seeded from the position's own mark rather than left blank: it is the number
        // the trader is deciding around, and typing a full price from scratch on a
        // screen reader is slower than editing one.
        _closeLimitText = PriceFormatter.FormatPrice(CurrentPriceFor(row.Position))
            .Replace(",", "").Replace("$", "");
        StateHasChanged();
        await Task.Yield();
        // focusElement, not `autofocus` alone: it retries across animation frames, which
        // is what made the Alt+T fix work in a real browser.
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", LimitCloseFieldId(row)); }
        catch { /* best-effort focus, as everywhere else */ }
    }

    private static string LimitCloseFieldId(AccountPosition row) =>
        $"close-limit-{row.Account.Slug}-{new string(row.Position.Symbol.Where(char.IsLetterOrDigit).ToArray())}";

    private async Task OnLimitCloseKeyAsync(KeyboardEventArgs e, AccountPosition row)
    {
        if (e.Key == "Escape")
        {
            _closingAtLimit = null;
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"Left open. No close order was placed for {row.Position.Symbol}."));
            StateHasChanged();
            return;
        }
        if (e.Key != "Enter") return;

        // Parsed, not validated for direction. A limit exit on the near side of the
        // market is a marketable limit — a legitimate way to pay the spread for a fast
        // fill — so the only refusals here are "that is not a price" and "that is not
        // positive", and both of them speak.
        var parsed = ProtectiveLevelValidator.ParsePrice(_closeLimitText);
        if (!parsed.Ok)
        {
            // Stay in the field so the value can be corrected rather than retyped.
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, parsed.Message, true));
            StateHasChanged();
            return;
        }

        _closingAtLimit = null;
        await ClosePositionAtLimit(row, parsed.Value);
    }

    // ── Live-order safety: the spoken review, and keeping it true ────────────
    //
    // For a sighted trader the ticket stays on screen under the Confirm button. For a blind
    // trader the SPOKEN REVIEW *is* the ticket — it is the only rendering of the order they
    // get before it reaches the venue. That makes this a WCAG 3.3.4 mechanism (Error
    // Prevention, Legal/Financial: "a mechanism is available for reviewing, confirming and
    // correcting information before finalizing"), and it had the one flaw that turns such a
    // mechanism into a hazard: it could go stale without saying so.
    //
    // Arm at 1 BTC, Tab back, type 5, press Confirm — 5 went to the venue while the review
    // had said 1, and the user had no way to know. Demonstrated end to end in
    // LiveOrderReviewStalenessTests before this was written.
    //
    // WithdrawModal solved the same problem first and its comment states the rule:
    // "What was read aloud must be exactly what is sent."

    /// <summary>
    /// The signal the review was spoken against, and the venue it was going to. Null
    /// whenever no review is armed — including after a close, which is the point:
    /// an armed confirmation must never survive the dialog it was armed in.
    /// </summary>
    private TradeSignal? _reviewedSignal;
    private string       _reviewedProvider = "";

    /// <summary>
    /// Disarms the review and forgets what it was spoken against.
    ///
    /// <para>
    /// ONE method rather than the same three assignments at each of the five sites that need
    /// them, and that is a test-visibility decision as much as a tidiness one. The first cut
    /// wrote them out in both <c>Close()</c> and <c>ShowAsync()</c>; a sabotage run then showed
    /// that deleting either copy left <c>AnArmedReviewDoesNotSurviveCloseAndReopen</c> GREEN,
    /// because the survivor still cleared the flag before the reopen rendered. Two independent
    /// copies of a safety reset mask each other, so neither is pinned and the guard cannot fail
    /// for its own reason. With one method there is one line to delete and the guard reddens.
    /// </para>
    /// </summary>
    private void ResetLiveReview()
    {
        _reviewArmed      = false;
        _reviewedSignal   = null;
        _reviewedProvider = "";
    }

    /// <summary>The one-line spoken review of the order the ticket currently describes.</summary>
    private string BuildReviewText()
    {
        double price = NeedsLimit && _limitPrice > 0 ? _limitPrice : GetCurrentPrice();
        double cost = _orderQty * price;
        double fee = cost * 0.0004;
        string sl = IsEntryType && _stopLoss > 0 ? $" Stop {PriceFormatter.FormatPrice(_stopLoss)}." : "";
        string tp = IsEntryType && _takeProfit > 0 ? $" Target {PriceFormatter.FormatPrice(_takeProfit)}." : "";
        return $"Confirm: {_orderSide} {PriceFormatter.FormatQuantity(_orderQty)} {Store.State.Identity.Symbol}, {_orderType.ToLowerInvariant()}.{sl}{tp} Estimated cost {PriceFormatter.FormatPrice(cost)}, fee {PriceFormatter.FormatPrice(fee)}.{BuildRiskWarnings(price)} Confirm or cancel.";
    }

    /// <summary>
    /// Speaks the review and requires an explicit confirm. <paramref name="prefix"/> carries
    /// the reason when this is a RE-arm after a stale ticket was refused.
    ///
    /// <para>
    /// The prefix is composed into the same utterance rather than published as a second event,
    /// because two Speak calls inside one Blazor event handler do not produce two
    /// announcements: the handler renders once and only the last write to the live region
    /// reaches the DOM. The note on <c>FeedbackType.Navigation</c> in
    /// <c>AccessibilityFeedbackCoordinator</c> records the same trap.
    /// </para>
    ///
    /// <para>
    /// Focus moves BEFORE the review is spoken. Arming destroys the button the user is
    /// standing on — the markup swaps "Submit" for "Confirm"/"Cancel" — so focus was landing
    /// on &lt;body&gt; in a 2,000-line dialog immediately after arming a real-money order.
    /// Speaking first and focusing after would not help: the screen reader announces the newly
    /// focused control on the focus event and that announcement cuts off whatever is in the
    /// live region, clipping the review at its first word.
    /// </para>
    /// </summary>
    private async Task ArmLiveReview(string? prefix = null)
    {
        _reviewArmed      = true;
        _reviewedSignal   = BuildSignal();
        _reviewedProvider = Store.State.Identity.Provider ?? "";
        _orderError       = false;
        _orderStatus      = string.IsNullOrEmpty(prefix)
            ? BuildReviewText()
            : prefix + " " + BuildReviewText();
        StateHasChanged();

        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "order-confirm-live"); }
        catch { /* focus is best-effort, as everywhere else; Tab still reaches it */ }

        // OrderEvent, not the Manual tier this used to inherit from StateChange. The review is
        // the readback for an irreversible money action, and on Manual F2 silenced it — so with
        // speech off, arming said NOTHING and the next Enter sent a live order with no readback
        // at all, while a rejection (Error -> Critical) was still spoken. Order outcomes are
        // "the one feedback you never miss"; the confirmation prompt for one belongs with them.
        EventBus.Publish(new FeedbackRequestEvent(
            FeedbackType.StateChange, _orderStatus, true,
            Channel: AccessibleTrader.Core.Services.Accessibility.SpeechChannel.OrderEvent));
    }

    /// <summary>
    /// Voids an armed review because <paramref name="what"/> was edited, and says so.
    ///
    /// <para>
    /// Called from the ticket's own <c>@oninput</c>/<c>@onclick</c> hooks, so the user learns at
    /// the keystroke rather than at the confirm. It is deliberately a VOID and not a disable of
    /// the inputs: "I armed it, now I want to change the size" is the ordinary recovery, and
    /// disabling fifteen controls would take them out of the tab order and have NVDA read them
    /// as unavailable — indistinguishable from a broken dialog for someone who cannot see that
    /// a Confirm button appeared. WithdrawModal voids for the same reason.
    /// </para>
    ///
    /// <para>
    /// Manual channel, unlike the review itself: nothing was sent, so this is not an outcome,
    /// and a user who pressed F2 asked for quiet. The recovery announces itself anyway — the
    /// Confirm button is gone and focus lands back on "Submit ... Order".
    /// </para>
    /// </summary>
    private void VoidReviewIfArmed(string what)
    {
        if (!_reviewArmed) return;
        ResetLiveReview();
        _orderError = false;
        // Not "canceled": CancelReview already owns that word, and two different events must
        // not share a verb in a dialog that spends money.
        _orderStatus = $"{what} changed. The review no longer matches — nothing was sent. "
                     + $"Press Submit {_orderSide} Order to review again.";
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, _orderStatus, true));
        StateHasChanged();
    }

    /// <summary>
    /// Warn-only risk hints appended to the pre-submit review — the terminal never
    /// blocks a trade the user wants, it just makes sure they heard the risk first.
    ///   1. Liquidation buffer: on leveraged entries, the estimated liquidation
    ///      distance (~1/leverage, less a 10% maintenance/fee haircut) should be at
    ///      least TWICE the stop distance so the exchange can never close the trade
    ///      before the stop does.
    ///   2. Sector stacking: correlated open positions (BTC+ETH, gold+silver,
    ///      SPY+QQQ) count toward one 2%-per-sector risk budget.
    /// </summary>
    private string BuildRiskWarnings(double entryPrice)
    {
        var warnings = new System.Text.StringBuilder();

        if (IsEntryType && _leverage > 1 && entryPrice > 0)
        {
            // Isolated-margin approximation: liquidation ~ entry ± entry/leverage,
            // haircut 10% for maintenance margin and fees. Real exchange liq prices
            // differ per venue; this is a deliberate conservative estimate.
            double liqDistancePct = (1.0 / _leverage) * 0.90 * 100.0;
            if (_stopLoss > 0)
            {
                double stopDistancePct = Math.Abs(entryPrice - _stopLoss) / entryPrice * 100.0;
                if (liqDistancePct <= stopDistancePct)
                    warnings.Append($" WARNING: at {_leverage:0.#}x leverage, estimated liquidation " +
                                    $"({liqDistancePct:0.#} percent away) is CLOSER than your stop " +
                                    $"({stopDistancePct:0.#} percent) — the exchange would close this " +
                                    $"trade before your stop fires. Reduce leverage.");
                else if (liqDistancePct < stopDistancePct * 2)
                    warnings.Append($" Caution: estimated liquidation {liqDistancePct:0.#} percent away " +
                                    $"is within two stop-distances (stop {stopDistancePct:0.#} percent). " +
                                    $"Little margin for slippage or gaps.");
            }
            else
            {
                warnings.Append($" Caution: {_leverage:0.#}x leverage with no stop set — estimated " +
                                $"liquidation only {liqDistancePct:0.#} percent from entry.");
            }
        }

        var hint = AccessibleTrader.Core.Services.SectorClassifier.BuildSectorHint(
            Store.State.Identity.Symbol,
            _positions.Select(r => r.Position.Symbol));
        if (hint != null) warnings.Append(' ').Append(hint);

        return warnings.ToString();
    }

    private void CancelReview()
    {
        ResetLiveReview();
        _orderStatus = "Order canceled before submit.";
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, _orderStatus, true));
    }

    private string GetLastPrice()
    {
        var data = Store.State.Data;
        if (data == null || !data.Any()) return "—";
        return PriceFormatter.FormatPrice(data[^1].Close);
    }

    private double GetCurrentPrice()
    {
        if (Store.State.Data == null || !Store.State.Data.Any()) return 0;
        return Store.State.Data.Last().Close;
    }

    private string GetSpread()
    {
        if (!_bids.Any() || !_asks.Any()) return "—";
        double spread = _asks[0].Price - _bids[0].Price;
        return PriceFormatter.FormatPrice(spread);
    }

    public void Dispose()
    {
        _eventSub?.Dispose();
        _closeSub?.Dispose();
        _refreshTimer?.Dispose();
    }
}
