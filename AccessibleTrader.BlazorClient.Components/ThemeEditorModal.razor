@*
    Theme editor — every colour the application can draw, in one place.

    The form is GENERATED from ThemeFields.All rather than hand-written. Thirty-odd
    hand-wired pickers guarantee that the next colour added to ChartTheme is themeable
    in the renderer and invisible here, which is the exact gap this dialog exists to
    close. One entry in the table and it appears in this dialog, in saved theme files,
    and in the round-trip tests together.

    Accessibility notes:
      • Each section is a fieldset with a legend, so a screen reader can jump between
        Top bar / Chart area / Candles / Overlays / Bottom bar / Dialogs / Text.
      • Every picker carries a description that says what the colour actually affects.
        "Gridlines, minor" means nothing on its own; the hint is the control.
      • Changes apply live so a sighted user sees them, and every change is announced
        so a screen-reader user knows it took.
      • Contrast is measured with the WCAG ratio (ThemeContrastChecks) and reported inline,
        never auto-corrected. A text pair below 4.5:1 stops Save; see ContrastProblems below.
*@
@inherits ModalBase
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Theming
@using AccessibleTrader.Sdk.Enums
@using AccessibleTrader.Sdk.Theming
@using SkiaSharp
@inject IThemeLibrary Themes
@inject ThemeService ThemeService
@inject ISettingsManager Settings

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="CloseModal">
        <div class="modal-content" role="dialog" data-modal-name="ThemeEditor" aria-modal="true"
             aria-labelledby="theme-editor-title" @onclick:stopPropagation="true"
             style="max-width: 820px;">

            <h2 id="theme-editor-title" tabindex="-1">Customise theme</h2>

            @if (!string.IsNullOrEmpty(_status))
            {
                <div role="status" aria-live="polite" style="margin:8px 0;">@_status</div>
            }

            <fieldset style="border:1px solid var(--border-color); padding:10px 14px; margin-bottom:14px;">
                <legend style="font-weight:700; padding:0 6px;">This theme</legend>

                <div class="modal-row">
                    <label for="te-name">Name</label>
                    <input id="te-name" type="text" @bind="_name" style="width:40%;" />

                    <label for="te-base">Starts from</label>
                    <select id="te-base" @bind="_basedOn" @bind:after="RebaseAsync">
                        @foreach (var t in Enum.GetValues<ThemeType>())
                        {
                            <option value="@t">@Pretty(t)</option>
                        }
                    </select>
                </div>
                <p style="margin:2px 0 0; color:var(--text-muted); font-size:0.9em;">
                    Anything you don't change comes from the theme it starts from, so a later
                    update to that theme carries through.
                    @if (_preset is { } p && p.Overrides.Count > 0)
                    {
                        <text> You've changed @p.Overrides.Count of @ThemeFields.All.Count colours.</text>
                    }
                </p>
            </fieldset>

            @{ var problems = ContrastProblems; bool anyProblem = problems is { Count: > 0 }; }
            @* The live region is always in the tree and only its children change, because a
               region inserted already populated is announced inconsistently. *@
            <div role="status" aria-live="polite" id="te-contrast"
                 style="@(anyProblem ? "border:1px solid var(--border-color); border-radius:4px; padding:8px 12px; margin-bottom:14px;" : "")">
                @if (anyProblem)
                {
                    <strong>Hard to read:</strong>
                    <ul style="margin:6px 0 0 1.1em; padding:0;">
                        @foreach (var problem in problems!)
                        {
                            <li>@problem.What@(problem.Severity == ThemeContrastChecks.Severity.Blocking ? " Fix this before saving." : "")</li>
                        }
                    </ul>
                }
            </div>

            @foreach (var group in Enum.GetValues<ThemeGroup>())
            {
                <fieldset style="border:1px solid var(--border-color); padding:10px 14px; margin-bottom:14px;">
                    <legend style="font-weight:700; padding:0 6px;">@ThemeFields.GroupLabel(group)</legend>

                    @foreach (var field in ThemeFields.InGroup(group))
                    {
                        var f = field;
                        var current = f.Get(_preview);
                        bool overridden = _preset?.Overrides.ContainsKey(f.Key) == true;
                        // A colour behind a blocking pair is marked invalid and described by the
                        // problem box, so the refusal is discoverable AT the field, not only after Save.
                        bool blocked = anyProblem && problems!.Any(p => p.Severity == ThemeContrastChecks.Severity.Blocking && p.FieldKey == f.Key);
                        string describedBy = blocked ? $"te-hint-{f.Key} te-contrast" : $"te-hint-{f.Key}";

                        <div class="modal-row" style="align-items:flex-start;">
                            <label for="te-@f.Key" style="min-width:190px;">
                                @f.Label@(overridden ? " •" : "")
                            </label>

                            <input id="te-@f.Key" type="color"
                                   value="@Hex(current)"
                                   aria-describedby="@describedBy"
                                   aria-invalid="@(blocked ? "true" : "false")"
                                   @onchange="e => SetField(f, e.Value?.ToString())" />

                            <input type="text" value="@Hex(current)" style="width:9em;"
                                   aria-label="@f.Label hex value"
                                   aria-describedby="@describedBy"
                                   aria-invalid="@(blocked ? "true" : "false")"
                                   @onchange="e => SetField(f, e.Value?.ToString())" />

                            @if (f.Optional)
                            {
                                <button type="button" @onclick="() => ClearField(f)"
                                        aria-label="Clear @f.Label — use a flat colour instead of a gradient">
                                    Flat
                                </button>
                            }
                            @if (overridden)
                            {
                                <button type="button" @onclick="() => RevertField(f)"
                                        aria-label="Revert @f.Label to the base theme">Revert</button>
                            }
                        </div>
                        <p id="te-hint-@f.Key" style="margin:-8px 0 12px 200px; color:var(--text-muted); font-size:0.88em;">
                            @f.Description
                        </p>
                    }
                </fieldset>
            }

            <fieldset style="border:1px solid var(--border-color); padding:10px 14px; margin-bottom:14px;">
                <legend style="font-weight:700; padding:0 6px;">Share</legend>
                <div class="modal-row">
                    <button type="button" @onclick="CopyForSharing">Copy theme text</button>
                    <button type="button" @onclick="PasteShared">Paste a theme</button>
                </div>
                @if (_shareText != null)
                {
                    <label for="te-share" class="visually-hidden">Theme text</label>
                    <textarea id="te-share" rows="5" style="width:100%;" @bind="_shareText"></textarea>
                    <p style="margin:4px 0 0; color:var(--text-muted); font-size:0.88em;">
                        Copy this out to share the theme, or paste someone else's in and press
                        "Paste a theme".
                    </p>
                }
            </fieldset>

            <div style="display:flex; justify-content:space-between; margin-top:14px;">
                <button type="button" @onclick="RevertAll"
                        aria-label="Reset all changes and go back to the base theme">Reset all</button>
                <span>
                    <button type="button" @onclick="CloseModal" aria-label="Cancel, close the theme editor dialog">Cancel</button>
                    <button type="button" class="primary" @onclick="SaveAndApply">Save and use</button>
                </span>
            </div>
        </div>
    </div>
}

@code {
    private ThemePreset? _preset;
    private ChartTheme _preview = default!;
    private string _name = "";
    private ThemeType _basedOn = ThemeType.SteelGray;
    private string? _status;
    private string? _shareText;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _eventSub = EventBus.Subscribe<OpenThemeEditorEvent>(e => InvokeAsync(() => ShowAsync(e.PresetId)));
    }

    private async Task ShowAsync(string? presetId)
    {
        _status = null;
        _shareText = null;

        // Editing an existing theme, or starting one from whatever is on screen now — which is
        // the common case, since people customise the thing they are already looking at.
        _preset = string.IsNullOrEmpty(presetId) ? null : Themes.GetById(presetId!);
        if (_preset == null)
        {
            _basedOn = ThemeService.Current.ThemeType;
            _preset = ThemePreset.Create($"My {Pretty(_basedOn)}", _basedOn);
        }
        else
        {
            _basedOn = _preset.BasedOn;
        }

        _name = _preset.Name;
        Recompute();
        await ShowModalAsync("theme-editor-title");
    }

    /// <summary>Rebuilds the previewed theme from the base plus the current overrides.</summary>
    private void Recompute() => _preview = _preset!.ApplyTo(BaseTheme(_basedOn));

    // The base theme WITHOUT the user's appearance preferences layered on — see BaseThemeResolver
    // for why the editor needs a different view of a theme than the running application does.
    private static ChartTheme BaseTheme(ThemeType type) => BaseThemeResolver.Resolve(type);

    private async Task RebaseAsync()
    {
        _preset = _preset! with { BasedOn = _basedOn };
        Recompute();
        Announce($"Now starting from {Pretty(_basedOn)}. Your changes are kept.");
        await Task.CompletedTask;
    }

    private void SetField(ThemeField field, string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex) || !ThemePreset.TryParseColor(hex!, out var colour))
        {
            Announce("That isn't a colour. Use a hex value like #3A4048.");
            return;
        }

        _preset = _preset!.With(field.Key, colour);
        Recompute();
        Announce($"{field.Label} set to {ThemePreset.ToHex(colour)}.");
    }

    private void ClearField(ThemeField field)
    {
        _preset = _preset!.With(field.Key, null);
        Recompute();
        Announce($"{field.Label} cleared — flat instead of a gradient.");
    }

    private void RevertField(ThemeField field)
    {
        _preset = _preset!.WithoutOverride(field.Key);
        Recompute();
        Announce($"{field.Label} back to the base theme.");
    }

    private void RevertAll()
    {
        _preset = _preset! with { Overrides = new Dictionary<string, string?>() };
        Recompute();
        Announce("All colours back to the base theme.");
    }

    /// <summary>
    /// The pairings that will be hard to read, measured with the WCAG contrast ratio, and NOT
    /// corrected.
    ///
    /// <para>
    /// The list of pairs lives in <see cref="ThemeContrastChecks"/>, and the test suite runs that
    /// same list over every built-in theme, which is what makes a preset safe by construction
    /// rather than by assertion. Text pairs (toolbar, dialog, secondary, axis labels, primary
    /// button ink) below 4.5:1 stop Save and use — a theme whose dialog text cannot be read is
    /// not a theme anyone meant to keep. Candles below 3:1 and a gridline as loud as the price
    /// data are reported and left to the person: they may be building for a projector, a
    /// photosensitivity, or a screenshot, and silently recolouring a choice they made is worse
    /// than showing the number and letting them decide.
    /// </para>
    ///
    /// <para>
    /// Until 2026-09-02 this measured squared Euclidean RGB distance against a threshold of
    /// 12,000, which waved through #0000ff on #000000 (distance 65,025) — a pair that is 2.44:1
    /// and unreadable. Nothing in the app had ever computed a contrast ratio.
    /// </para>
    /// </summary>
    private IReadOnlyList<ThemeContrastChecks.Finding>? ContrastProblems =>
        _preview == null ? null : ThemeContrastChecks.Failures(_preview);

    private void CopyForSharing()
    {
        _shareText = Themes.Export(_preset! with { Name = _name });
        Announce("Theme text ready to copy.");
    }

    private void PasteShared()
    {
        var imported = Themes.Import(_shareText ?? "");
        if (imported == null) { Announce("That text isn't a theme."); return; }

        _preset = imported;
        _name = imported.Name;
        _basedOn = imported.BasedOn;
        Recompute();
        Announce($"Loaded {imported.Name}. Press Save and use to keep it.");
    }

    private void SaveAndApply()
    {
        if (string.IsNullOrWhiteSpace(_name)) { Announce("Give the theme a name first."); return; }

        // Read out every blocking pair with its number, so the person knows which colour to
        // move and by roughly how much, then leave the dialog open on it.
        var blocking = ContrastProblems?
            .Where(p => p.Severity == ThemeContrastChecks.Severity.Blocking)
            .Select(p => p.What)
            .ToList();
        if (blocking is { Count: > 0 })
        {
            Announce("Not saved. " + string.Join(" ", blocking));
            return;
        }

        var saved = _preset! with { Name = _name.Trim(), BasedOn = _basedOn };
        Themes.Upsert(saved);
        ThemeService.SetCustomTheme(saved);
        EventBus.Publish(new RedrawEvent());
        Announce($"{saved.Name} saved and applied.");
        CloseModal();
    }

    private static string Hex(SKColor? c) => c is { } v ? ThemePreset.ToHex(v)[..7] : "#000000";

    private static string Pretty(ThemeType t) => t switch
    {
        ThemeType.SteelGray         => "Steel Gray",
        ThemeType.Blackout          => "Blackout",
        ThemeType.Classic           => "Classic",
        ThemeType.AmberCrt          => "Amber CRT",
        ThemeType.Walnut            => "Walnut",
        ThemeType.Paper             => "Paper",
        ThemeType.MidnightBlue      => "Midnight Blue",
        ThemeType.HighContrastDark  => "High Contrast Dark",
        ThemeType.HighContrastLight => "High Contrast Light",
        ThemeType.SoftDark          => "Soft Dark",
        ThemeType.Solarized         => "Solarized",
        ThemeType.Braille           => "Braille Optimized",
        _                           => t.ToString(),
    };

    private void Announce(string message)
    {
        _status = message;
        EventBus.Publish(new AnnouncementEvent(message, true));
    }
}
