@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@inject IEventBus EventBus
@inject ISoundPatchLibrary PatchLibrary
@inject ISonificationManager SonificationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="sound-designer-title"
             style="max-width: 760px; min-height: 560px;"
             @onclick:stopPropagation="true">

            <h2 id="sound-designer-title" tabindex="-1">Sound Designer</h2>

            <div style="display: flex; gap: 16px; height: 460px;">

                @* ── Patch List ──────────────────────────────────────────────── *@
                <div style="width: 200px; display: flex; flex-direction: column; gap: 8px;">
                    <h3 style="margin: 0; font-size: 0.9rem;">Patches</h3>
                    <div role="listbox"
                         aria-label="Sound patches"
                         style="flex: 1; overflow-y: auto; border: 1px solid #555; border-radius: 4px;">
                        @foreach (var patch in _patches)
                        {
                            var pid = patch.Id;
                            <div role="option"
                                 aria-selected="@(patch.Id == _selectedId ? "true" : "false")"
                                 tabindex="0"
                                 class="patch-list-item @(patch.Id == _selectedId ? "selected" : "")"
                                 style="padding: 6px 10px; cursor: pointer; background: @(patch.Id == _selectedId ? "#334" : "transparent");"
                                 @onclick="() => SelectPatch(pid)"
                                 @onkeydown="e => OnPatchKeyDown(e, pid)">
                                @patch.Name
                            </div>
                        }
                        @if (!_patches.Any())
                        {
                            <div style="padding: 10px; color: #888; font-style: italic;">No patches yet</div>
                        }
                    </div>
                    <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                        <button @onclick="NewPatch" aria-label="New patch">+ New</button>
                        <button @onclick="ClonePatch" disabled="@(_selectedPatch == null)" aria-label="Clone selected patch">Clone</button>
                        <button @onclick="DeletePatch" disabled="@(_selectedPatch == null)" aria-label="Delete selected patch"
                                style="color: #f88;">Delete</button>
                    </div>
                </div>

                @* ── Editor ──────────────────────────────────────────────────── *@
                <div style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;">
                    @if (_selectedPatch != null)
                    {
                        <fieldset>
                            <legend>Identity</legend>
                            <div class="modal-row">
                                <label for="sd-name">Name</label>
                                <input id="sd-name" type="text" value="@_editName"
                                       @onchange="e => _editName = e.Value?.ToString() ?? _editName" />
                            </div>
                            <div class="modal-row">
                                <label for="sd-desc">Description</label>
                                <input id="sd-desc" type="text" value="@_editDescription"
                                       @onchange="e => _editDescription = e.Value?.ToString() ?? _editDescription" />
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>Oscillators</legend>
                            @for (int li = 0; li < _editOscillators.Count; li++)
                            {
                                var idx = li;
                                var layer = _editOscillators[idx];
                                <div class="osc-layer" style="border: 1px solid #444; border-radius: 4px; padding: 6px; margin-bottom: 6px;">
                                    <div class="modal-row">
                                        <label for="sd-wave-@idx">Oscillator @(idx + 1)</label>
                                        <select id="sd-wave-@idx" value="@layer.Waveform"
                                                @onchange="e => layer.Waveform = e.Value?.ToString() ?? layer.Waveform">
                                            <option value="sine">Sine</option>
                                            <option value="square">Square</option>
                                            <option value="sawtooth">Sawtooth</option>
                                            <option value="triangle">Triangle</option>
                                            <option value="noise">Noise</option>
                                        </select>
                                        <button @onclick="() => RemoveOscillator(idx)"
                                                disabled="@(_editOscillators.Count <= 1)"
                                                aria-label="Remove oscillator @(idx + 1)" style="color: #f88;">Remove</button>
                                    </div>
                                    <div class="modal-row">
                                        <label for="sd-gain-@idx">Level (@layer.Gain.ToString("P0"))</label>
                                        <input id="sd-gain-@idx" type="range" min="0" max="1" step="0.05"
                                               value="@layer.Gain"
                                               @onchange="e => { if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var g)) layer.Gain = g; }"
                                               aria-valuenow="@layer.Gain" aria-valuemin="0" aria-valuemax="1" />
                                    </div>
                                    <div class="modal-row">
                                        <label for="sd-ratio-@idx">Freq Ratio</label>
                                        <input id="sd-ratio-@idx" type="number" min="0.1" max="8" step="0.05"
                                               value="@layer.FreqRatio"
                                               @onchange="e => { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var r)) layer.FreqRatio = r; }" />
                                    </div>
                                    <div class="modal-row">
                                        <label for="sd-noise-@idx">Noise Blend (@layer.NoiseAmount.ToString("P0"))</label>
                                        <input id="sd-noise-@idx" type="range" min="0" max="1" step="0.05"
                                               value="@layer.NoiseAmount"
                                               @onchange="e => { if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n)) layer.NoiseAmount = n; }"
                                               aria-valuenow="@layer.NoiseAmount" aria-valuemin="0" aria-valuemax="1" />
                                    </div>
                                    <div class="modal-row">
                                        <label for="sd-noisetype-@idx">Noise Colour</label>
                                        <select id="sd-noisetype-@idx" value="@layer.NoiseType"
                                                @onchange="e => layer.NoiseType = e.Value?.ToString() ?? layer.NoiseType">
                                            <option value="pink">Pink</option>
                                            <option value="white">White</option>
                                            <option value="brown">Brown</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            <button @onclick="AddOscillator" aria-label="Add oscillator">+ Add Oscillator</button>
                        </fieldset>

                        <fieldset>
                            <legend>Mix</legend>
                            <div class="modal-row">
                                <label for="sd-freq">Base Freq (Hz)</label>
                                <input id="sd-freq" type="number" min="20" max="8000" step="1"
                                       value="@_editBaseFrequency"
                                       @onchange="e => double.TryParse(e.Value?.ToString(), out _editBaseFrequency)" />
                            </div>
                            <div class="modal-row">
                                <label for="sd-freqmult">Freq Multiplier</label>
                                <input id="sd-freqmult" type="number" min="0.1" max="8" step="0.1"
                                       value="@_editFreqMultiplier"
                                       @onchange="e => double.TryParse(e.Value?.ToString(), out _editFreqMultiplier)" />
                            </div>
                            <div class="modal-row">
                                <label for="sd-vol">Volume (@_editVolume.ToString("P0"))</label>
                                <input id="sd-vol" type="range" min="0" max="1" step="0.05"
                                       value="@_editVolume"
                                       @onchange="e => float.TryParse(e.Value?.ToString(), out _editVolume)"
                                       aria-valuenow="@_editVolume" aria-valuemin="0" aria-valuemax="1" />
                            </div>
                        </fieldset>

                        <fieldset>
                            <legend>Envelope</legend>
                            <div class="modal-row">
                                <label for="sd-env">Type</label>
                                <select id="sd-env" value="@_editEnvelopeType"
                                        @onchange="e => _editEnvelopeType = e.Value?.ToString() ?? _editEnvelopeType">
                                    <option value="Sustain">Sustain (ADSR)</option>
                                    <option value="Ping">Ping (exponential decay)</option>
                                </select>
                            </div>
                            <div class="modal-row">
                                <label for="sd-dur">Duration (s)</label>
                                <input id="sd-dur" type="number" min="0.05" max="5" step="0.05"
                                       value="@_editDuration"
                                       @onchange="e => double.TryParse(e.Value?.ToString(), out _editDuration)" />
                            </div>
                        </fieldset>

                        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px;">
                            <button @onclick="PreviewPatch" aria-label="Preview current patch settings">
                                &#9654; Preview
                            </button>
                            <button @onclick="ApplyEdits" aria-label="Save patch changes">
                                Save Patch
                            </button>
                            <button @onclick="ExportPatch" aria-label="Export patch as JSON">
                                Export JSON
                            </button>
                        </div>
                    }
                    else
                    {
                        <p style="color: #888; font-style: italic;">Select or create a patch to edit.</p>
                    }
                </div>
            </div>

            @* ── Earcon Assignments ──────────────────────────────────────────── *@
            <details style="margin-top: 16px;">
                <summary style="cursor: pointer; font-weight: bold; padding: 4px 0;">
                    Earcon Assignments
                </summary>
                <table role="table" style="width: 100%; border-collapse: collapse; margin-top: 8px; font-size: 0.85rem;">
                    <caption class="visually-hidden">Assign sound patches to feedback earcons</caption>
                    <thead>
                        <tr>
                            <th style="text-align: left; padding: 4px 8px; border-bottom: 1px solid #555;">Earcon</th>
                            <th style="text-align: left; padding: 4px 8px; border-bottom: 1px solid #555;">Assigned Patch</th>
                            <th style="padding: 4px 8px; border-bottom: 1px solid #555;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var earcon in _earconKeys)
                        {
                            string? assigned = PatchLibrary.EarconOverrides.EarconPatchIds.TryGetValue(earcon, out var pid2) ? pid2 : null;
                            string assignedName = _patches.FirstOrDefault(p => p.Id == assigned)?.Name ?? "(default)";
                            var earconKey = earcon;
                            <tr>
                                <td style="padding: 4px 8px;">@earcon</td>
                                <td style="padding: 4px 8px;">
                                    <select aria-label="Patch for @earcon earcon"
                                            value="@(assigned ?? "")"
                                            @onchange="e => SetEarconPatch(earconKey, e.Value?.ToString())">
                                        <option value="">(default sound)</option>
                                        @foreach (var p in _patches)
                                        {
                                            <option value="@p.Id">@p.Name</option>
                                        }
                                    </select>
                                </td>
                                <td style="padding: 4px 8px;">
                                    @if (assigned != null)
                                    {
                                        var assignedId = assigned;
                                        <button @onclick="() => PreviewPatchById(assignedId)"
                                                aria-label="Preview @earcon patch">&#9654;</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>

            @* ── Import ──────────────────────────────────────────────────────── *@
            <details style="margin-top: 8px;">
                <summary style="cursor: pointer; font-weight: bold; padding: 4px 0;">Import Patch JSON</summary>
                <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 6px;">
                    <textarea id="sd-import-json" rows="4" style="width: 100%; font-family: monospace; font-size: 0.8rem;"
                              placeholder="Paste SoundPatch JSON here..."
                              @bind="_importJson"></textarea>
                    <div style="display: flex; gap: 8px;">
                        <button @onclick="ImportPatch">Import</button>
                        @if (!string.IsNullOrEmpty(_importFeedback))
                        {
                            <span role="status" aria-live="polite" style="color: @(_importSuccess ? "#8f8" : "#f88");">
                                @_importFeedback
                            </span>
                        }
                    </div>
                </div>
            </details>

            <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
                <button @onclick="Close" aria-label="Close sound designer">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _sub;
    private IDisposable? _closeSub;

    private List<SoundPatch> _patches = new();
    private string? _selectedId;
    private SoundPatch? _selectedPatch;

    // Editor working copies
    private string _editName = "";
    private string _editDescription = "";
    private List<OscillatorLayer> _editOscillators = new();
    private double _editBaseFrequency = 440;
    private double _editFreqMultiplier = 1.0;
    private float _editVolume = 1.0f;
    private string _editEnvelopeType = "Sustain";
    private double _editDuration = 0.3;

    // Import
    private string _importJson = "";
    private string _importFeedback = "";
    private bool _importSuccess;

    private static readonly string[] _earconKeys =
        { "Boundary", "Info", "Error", "Success", "Retry", "NewBar", "Connected", "Disconnected" };

    protected override void OnInitialized()
    {
        _sub = EventBus.AsObservable<OpenSoundDesignerEvent>()
            .Subscribe(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Sound designer") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _patches = PatchLibrary.GetPatches().ToList();
        if (_patches.Any() && _selectedId == null) SelectPatch(_patches[0].Id);
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Sound designer"));
        StateHasChanged();
        await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "sound-designer-title");
    }

    private void OnPatchKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") SelectPatch(id);
    }

    private void SelectPatch(string id)
    {
        _selectedId = id;
        _selectedPatch = _patches.FirstOrDefault(p => p.Id == id);
        if (_selectedPatch == null) return;
        _editName           = _selectedPatch.Name;
        _editDescription    = _selectedPatch.Description;
        _editOscillators    = _selectedPatch.EffectiveLayers().Select(o => o.Clone()).ToList();
        _editBaseFrequency  = _selectedPatch.BaseFrequency;
        _editFreqMultiplier = _selectedPatch.FreqMultiplier;
        _editVolume         = _selectedPatch.Volume;
        _editEnvelopeType   = _selectedPatch.EnvelopeType;
        _editDuration       = _selectedPatch.DurationSeconds;
    }

    private void NewPatch()
    {
        var p = new SoundPatch { Name = "New Patch" };
        PatchLibrary.AddPatch(p);
        _patches = PatchLibrary.GetPatches().ToList();
        SelectPatch(p.Id);
    }

    private void ClonePatch()
    {
        if (_selectedPatch == null) return;
        var clone = _selectedPatch.Clone();
        PatchLibrary.AddPatch(clone);
        _patches = PatchLibrary.GetPatches().ToList();
        SelectPatch(clone.Id);
    }

    private void DeletePatch()
    {
        if (_selectedId == null) return;
        PatchLibrary.RemovePatch(_selectedId);
        _patches = PatchLibrary.GetPatches().ToList();
        _selectedId = null;
        _selectedPatch = null;
        if (_patches.Any()) SelectPatch(_patches[0].Id);
    }

    /// <summary>Builds a SoundPatch from the current editor working copy (does not persist).</summary>
    private SoundPatch BuildPatchFromEdits(string id)
    {
        var layers = _editOscillators.Select(o => o.Clone()).ToList();
        if (layers.Count == 0) layers.Add(new OscillatorLayer());
        return new SoundPatch
        {
            Id              = id,
            Name            = _editName,
            Description     = _editDescription,
            Oscillators     = layers,
            // Mirror the first layer into the legacy scalar fields so any consumer that still
            // reads Waveform/NoiseAmount directly stays consistent with the layered timbre.
            Waveform        = layers[0].Waveform,
            NoiseAmount     = layers[0].NoiseAmount,
            BaseFrequency   = _editBaseFrequency,
            FreqMultiplier  = _editFreqMultiplier,
            Volume          = _editVolume,
            EnvelopeType    = _editEnvelopeType,
            DurationSeconds = _editDuration,
        };
    }

    private void AddOscillator()
        => _editOscillators.Add(new OscillatorLayer { Waveform = "sine", Gain = 0.5f, FreqRatio = 1.0 });

    private void RemoveOscillator(int idx)
    {
        if (idx >= 0 && idx < _editOscillators.Count && _editOscillators.Count > 1)
            _editOscillators.RemoveAt(idx);
    }

    private void ApplyEdits()
    {
        if (_selectedPatch == null) return;
        var updated = BuildPatchFromEdits(_selectedPatch.Id);
        PatchLibrary.UpdatePatch(updated);
        _patches = PatchLibrary.GetPatches().ToList();
        _selectedPatch = updated;
    }

    private void PreviewPatch()
    {
        if (_selectedPatch == null) return;
        SonificationManager.PlayPatch(BuildPatchFromEdits(_selectedPatch.Id));
    }

    private void PreviewPatchById(string id)
    {
        var patch = PatchLibrary.GetPatch(id);
        if (patch == null) return;
        SonificationManager.PlayPatch(patch);
    }

    private async Task ExportPatch()
    {
        if (_selectedPatch == null) return;
        ApplyEdits();
        string json = PatchLibrary.ExportPatchJson(_selectedPatch);
        string filename = $"{_selectedPatch.Name.Replace(' ', '_')}.json";
        await JSRuntime.InvokeVoidAsync("accessibleTrader.downloadCsv", filename, json);
    }

    private void ImportPatch()
    {
        if (string.IsNullOrWhiteSpace(_importJson)) return;
        var patch = PatchLibrary.ImportPatchJson(_importJson);
        if (patch == null) { _importFeedback = "Invalid JSON"; _importSuccess = false; return; }
        PatchLibrary.AddPatch(patch);
        _patches = PatchLibrary.GetPatches().ToList();
        SelectPatch(patch.Id);
        _importJson = "";
        _importFeedback = $"Imported: {patch.Name}";
        _importSuccess = true;
    }

    private void SetEarconPatch(string earconKey, string? patchId)
    {
        if (string.IsNullOrEmpty(patchId))
            PatchLibrary.EarconOverrides.EarconPatchIds.Remove(earconKey);
        else
            PatchLibrary.EarconOverrides.EarconPatchIds[earconKey] = patchId;
        PatchLibrary.SaveEarconOverrides();
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Sound designer"));
    }

    public void Dispose() { _sub?.Dispose(); _closeSub?.Dispose(); }
}
