@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services.Audio
@using AccessibleTrader.Sdk.Models
@using System.Collections.Immutable
@inject IWorkspaceStore Store
@inject ISeriesManagementService SeriesManager
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IIndicatorPreferencesService IndicatorPrefs
@inject IIndicatorService IndicatorService
@inject IIndicatorModelFactory Factory
@inject ISoundPatchLibrary PatchLibrary
@inject ISoundPatchRegistry PatchRegistry
@inject ISonificationManager SonificationManager
@implements IDisposable

@if (_isVisible && _series != null)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog" data-modal-name="Properties"
             aria-modal="true"
             aria-labelledby="props-title"
             style="max-width:600px; min-height: 500px;"
             @onclick:stopPropagation="true">

            <h2 id="props-title" tabindex="-1">Properties — @_series.FriendlyName</h2>

            <div class="tabs-header" role="tablist" aria-orientation="horizontal" @onkeydown="OnTabListKeyDown">
                <button role="tab" id="props-tab-general"
                        class="@(_activeTab == "General" ? "active" : "")"
                        aria-selected="@(_activeTab == "General" ? "true" : "false")"
                        aria-controls="props-tabpanel"
                        @onclick='() => _activeTab = "General"'>General</button>
                <button role="tab" id="props-tab-appearance"
                        class="@(_activeTab == "Appearance" ? "active" : "")"
                        aria-selected="@(_activeTab == "Appearance" ? "true" : "false")"
                        aria-controls="props-tabpanel"
                        @onclick='() => _activeTab = "Appearance"'>Appearance</button>
                <button role="tab" id="props-tab-sonification"
                        class="@(_activeTab == "Sonification" ? "active" : "")"
                        aria-selected="@(_activeTab == "Sonification" ? "true" : "false")"
                        aria-controls="props-tabpanel"
                        @onclick='() => _activeTab = "Sonification"'>Sonification</button>
                <button role="tab" id="props-tab-speech"
                        class="@(_activeTab == "Speech" ? "active" : "")"
                        aria-selected="@(_activeTab == "Speech" ? "true" : "false")"
                        aria-controls="props-tabpanel"
                        @onclick='() => _activeTab = "Speech"'>Speech</button>
            </div>

            <div class="tab-content" role="tabpanel"
                 id="props-tabpanel"
                 aria-labelledby="@ActiveTabId">
                @switch (_activeTab)
                {
                    case "General":
                        <div class="scroll-area">
                            @if (_params.Any() || _stringParams.Any() || _anchorRangeText != null)
                            {
                                <fieldset>
                                    <legend>Indicator Parameters</legend>
                                    @* Text-valued knobs — comparison symbol, MA type, pivot
                                       period, threshold mode. Same text input AddIndicatorModal
                                       uses, so a parameter reads and edits the same way whether
                                       the series is being created or adjusted. *@
                                    @foreach (var key in _stringParams.Keys.ToList())
                                    {
                                        var spm = _paramMeta.FirstOrDefault(p =>
                                            p.Name.Equals(key, StringComparison.OrdinalIgnoreCase));
                                        var sDisplayName = spm != null && !string.IsNullOrEmpty(spm.DisplayName)
                                            ? spm.DisplayName : key;

                                        <div class="modal-row">
                                            <label for="prop-@key">@sDisplayName</label>
                                            <input id="prop-@key" type="text"
                                                   value="@_stringParams[key]"
                                                   @onchange="e => UpdateStringParam(key, e.Value?.ToString())" />
                                        </div>
                                        @if (spm != null && !string.IsNullOrEmpty(spm.Description))
                                        {
                                            <p style="margin:-4px 0 8px 0; font-size:0.78rem; color:var(--text-muted);">@spm.Description</p>
                                        }
                                    }
                                    @foreach (var key in _params.Keys.ToList())
                                    {
                                        var pm = _paramMeta.FirstOrDefault(p =>
                                            p.Name.Equals(key, StringComparison.OrdinalIgnoreCase));
                                        var displayName = pm != null && !string.IsNullOrEmpty(pm.DisplayName)
                                            ? pm.DisplayName : key;
                                        var step = pm?.Step?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "any";
                                        var minAttr = pm?.MinValue?.ToString(System.Globalization.CultureInfo.InvariantCulture);
                                        var maxAttr = pm?.MaxValue?.ToString(System.Globalization.CultureInfo.InvariantCulture);

                                        <div class="modal-row">
                                            <label for="prop-@key">@displayName</label>
                                            @if (pm != null && pm.DataType == typeof(bool))
                                            {
                                                @* Yes/no knobs render as checkboxes here too. A 0/1
                                                   spinner is unusable with a screen reader. *@
                                                <input id="prop-@key" type="checkbox"
                                                       checked="@(_params[key] != 0)"
                                                       @onchange="e => UpdateBoolParam(key, e.Value)" />
                                            }
                                            else
                                            {
                                                <input id="prop-@key" type="number"
                                                       step="@step"
                                                       min="@minAttr"
                                                       max="@maxAttr"
                                                       value="@_params[key]"
                                                       @onchange="e => UpdateParam(key, e.Value?.ToString())" />
                                            }
                                        </div>
                                        @if (pm != null && !string.IsNullOrEmpty(pm.Description))
                                        {
                                            <p style="margin:-4px 0 8px 0; font-size:0.78rem; color:var(--text-muted);">@pm.Description</p>
                                        }
                                    }
                                    @* A fixed-range profile's anchor. Two parameters the user never
                                       typed — Unix seconds captured from the viewport when the profile
                                       was added — used to be listed here as editable numbers under the
                                       raw names "AnchorStart" and "AnchorEnd", which read as nonsense
                                       and invited a typo that moved the profile onto a different stretch
                                       of chart. Now a sentence, and the values ride through Apply
                                       untouched. *@
                                    @if (_anchorRangeText != null)
                                    {
                                        <p id="prop-anchor-range" style="margin:4px 0 8px 0; font-size:0.85rem;">@_anchorRangeText</p>
                                    }
                                </fieldset>
                            }

                            @* Announcement scope. Only meaningful for a series that HAS marker
                               signals — a plain line has nothing to call out from elsewhere. *@
                            @if (!_series.IsDrawing && _series.Components.Any(c => c.SignalSpeechTemplate != null))
                            {
                                <fieldset>
                                    <legend>Announcements</legend>
                                    <div class="modal-row">
                                        <label>
                                            <input type="checkbox" checked="@_series.AnnounceAcrossSeries"
                                                   @onchange="e => _series.AnnounceAcrossSeries = (bool)(e.Value ?? true)" />
                                            Announce this indicator's signals while another series has focus
                                        </label>
                                    </div>
                                    <p style="margin:-4px 0 8px 0; font-size:0.78rem; color:var(--text-muted);">
                                        On by default. Leave it on for signals worth hearing anywhere on the chart —
                                        support zones, structure breaks, divergences. Turn it off for an indicator
                                        whose output only means something while you are reading that indicator, so it
                                        does not talk over you elsewhere. This series always speaks its own signals
                                        when it is the one you are navigating.
                                    </p>
                                </fieldset>
                            }

                            @* A drawing's name is what navigation announces, what the object tree
                               lists and what an alert refers to. "Trendline 3" tells a user nothing;
                               "Weekly resistance from the January high" tells them why they drew it.
                               For a keyboard user moving between a dozen drawings by ear, this is
                               the difference between a list and an inventory. *@
                            @if (_series.IsDrawing)
                            {
                                <fieldset>
                                    <legend>Name</legend>
                                    <div class="modal-row">
                                        <label for="drawing-name">What this drawing is</label>
                                        <input id="drawing-name" type="text" value="@_series.FriendlyName"
                                               placeholder="e.g. Weekly resistance from the January high"
                                               @onchange="e => RenameDrawing(e.Value?.ToString())" />
                                    </div>
                                    <p style="margin:-4px 0 8px 0; font-size:0.78rem; color:var(--text-muted);">
                                        Spoken when you move to this drawing, and shown in the object tree.
                                        Leave it blank to go back to the automatic name.
                                    </p>
                                </fieldset>
                            }

                            @if (_series.IsDrawing && _series.Drawing != null)
                            {
                                @* THE keyboard route to a drawing's geometry. Every field here is
                                   the only way a user who cannot make a ten-pixel mouse drag can
                                   correct a shape they have already placed.

                                   Driven by DrawingAnchorSchema rather than by per-type conditions
                                   written here: the four conditions this replaced covered nine of
                                   the sixteen drawing types and never slot 3, so a Risk/Reward, an
                                   Andrews Pitchfork, a Gann Fan, a Gann Box, an Angle Fib, a
                                   Measure Tool and an Anchored VWAP had no editable coordinates at
                                   all, and a Fib Extension's projection origin and a text label's
                                   price were unreachable. The schema is checked against what the
                                   calculators actually dereference, so a new drawing type gets its
                                   editors by existing. *@
                                <fieldset>
                                    <legend>Drawing Coordinates</legend>
                                    @foreach (var field in AccessibleTrader.Core.Services.Drawing.DrawingAnchorSchema.For(_series.Drawing.Type))
                                    {
                                        @* @key on (axis, slot), not on the loop index. Opening this dialog
                                           for a second drawing while it is already up diffs one type's field
                                           list against another's POSITIONALLY without it — a trend line's
                                           [price, date, price, date] against a risk/reward's [price, price,
                                           price] — which turns index 1 into a `type` swap from datetime-local
                                           to number on a live element that still holds a value. *@
                                        var slot = field.Slot;
                                        var fieldId = field.Axis == AccessibleTrader.Core.Services.Drawing.DrawingAnchorAxis.Price
                                            ? $"drawing-price-{slot}" : $"drawing-date-{slot}";
                                        if (field.Axis == AccessibleTrader.Core.Services.Drawing.DrawingAnchorAxis.Price)
                                        {
                                            <div class="modal-row" @key="(field.Axis, slot)">
                                                <label for="@fieldId">@field.Label</label>
                                                <input id="@fieldId" type="number" step="any"
                                                       value="@AnchorPrice(slot)"
                                                       aria-invalid="@InvalidAttr(fieldId)"
                                                       @onchange='e => UpdateDrawingPrice(slot, fieldId, field.Label, e.Value?.ToString())'
                                                       @onblur='() => AnnounceCoordinate(fieldId, field.Label, slot, field.Axis)' />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="modal-row" @key="(field.Axis, slot)">
                                                <label for="@fieldId">@field.Label</label>
                                                <input id="@fieldId" type="datetime-local"
                                                       value="@AnchorDateForInput(slot)"
                                                       aria-invalid="@InvalidAttr(fieldId)"
                                                       @onchange='e => UpdateDrawingDate(slot, fieldId, field.Label, e.Value?.ToString())'
                                                       @onblur='() => AnnounceCoordinate(fieldId, field.Label, slot, field.Axis)' />
                                            </div>
                                        }
                                    }
                                </fieldset>
                            }
                        </div>
                        break;

                    case "Appearance":
                        <div class="scroll-area">
                            @if (_series.Components.Count > 3)
                            {
                                <div class="modal-row" style="margin-bottom:12px;">
                                    <label for="comp-picker-appearance">Component</label>
                                    <select id="comp-picker-appearance"
                                            value="@_selectedComponentName"
                                            @onchange='e => _selectedComponentName = e.Value?.ToString() ?? ""'
                                            aria-label="Select component to configure">
                                        <option value="">All Components</option>
                                        @foreach (var c in _series.Components)
                                        {
                                            <option value="@c.Name">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            }
                            @foreach (var comp in _series.Components.Where(c =>
                                string.IsNullOrEmpty(_selectedComponentName) || c.Name == _selectedComponentName))
                            {
                                @* Every control in this fieldset is named twice over, the way
                                   RiskPlanEditor's ladder rungs are: the id/for pair attaches the
                                   visible word to its own field, and the aria-label adds the
                                   component, because "Thickness" repeated down every component
                                   is a wall of identical names in a screen reader's form-field
                                   list. Each aria-label keeps the visible words inside it
                                   (WCAG 2.5.3). The id is derived from the component name, so it
                                   cannot collide across the @foreach. *@
                                var cid = "app-" + Slug(comp.Name);
                                <fieldset>
                                    <legend>Component: @comp.Name</legend>
                                    @if (comp.DisplayType == AccessibleTrader.Sdk.Models.ComponentDisplayType.Candle
                                        || comp.DisplayType == AccessibleTrader.Sdk.Models.ComponentDisplayType.Bar)
                                    {
                                        <div class="modal-row">
                                            <label for="@(cid)-bull-color">Bullish Color</label>
                                            <input id="@(cid)-bull-color" type="color" aria-label="Bullish Color for @comp.Name" value="@comp.ColorHex" @onchange='e => SetComponentColor(comp, e.Value?.ToString() ?? "#00CC44")' />
                                        </div>
                                        <div class="modal-row">
                                            <label for="@(cid)-bear-color">Bearish Color</label>
                                            <input id="@(cid)-bear-color" type="color" aria-label="Bearish Color for @comp.Name" value="@comp.ColorHexSecondary" @onchange='e => comp.ColorHexSecondary = e.Value?.ToString() ?? "#CC2200"' />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="modal-row">
                                            <label for="@(cid)-color">Color</label>
                                            <input id="@(cid)-color" type="color" aria-label="Color for @comp.Name" value="@comp.ColorHex" @onchange='e => SetComponentColor(comp, e.Value?.ToString() ?? "#FFF")' />
                                        </div>
                                    }
                                    <div class="modal-row">
                                        <label for="@(cid)-thickness">Thickness (@comp.Thickness.ToString("F1"))</label>
                                        <input id="@(cid)-thickness" type="range" min="0.5" max="10" step="0.5" aria-label="Thickness for @comp.Name" value="@comp.Thickness" @onchange='e => comp.Thickness = float.Parse(e.Value?.ToString() ?? "1")' />
                                    </div>
                                    <div class="modal-row">
                                        <label for="@(cid)-dash">Dash Style</label>
                                        <select id="@(cid)-dash" aria-label="Dash Style for @comp.Name" value="@comp.DashStyle" @onchange='e => comp.DashStyle = Enum.Parse<DashStyle>(e.Value?.ToString() ?? "Solid")'>
                                            @foreach (var style in Enum.GetValues<DashStyle>())
                                            {
                                                <option value="@style">@style</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="modal-row">
                                        <label>
                                            <input type="checkbox" checked="@comp.IsVisible" @onchange="e => comp.IsVisible = (bool)(e.Value ?? true)" />
                                            Visible
                                        </label>
                                    </div>

                                    @* ── Color Rules ──────────────────────────────────────────── *@
                                    <div style="margin-top:10px; border-top:1px solid #222; padding-top:8px;">
                                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px;">
                                            <span style="font-size:0.78rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em;">
                                                Color Rules <span style="font-weight:normal;">(first match wins, overrides static color)</span>
                                            </span>
                                            <button style="font-size:0.75rem; padding:2px 8px;"
                                                    @onclick="() => AddColorRule(comp)"
                                                    aria-label="Add color rule">+ Add</button>
                                        </div>
                                        @if (!comp.ColorRules.Any())
                                        {
                                            <p style="font-size:0.8rem; color:var(--text-muted); margin:0 0 4px 0;">No rules — static color above is always used.</p>
                                        }
                                        @for (int ri = 0; ri < comp.ColorRules.Count; ri++)
                                        {
                                            var rIdx = ri;
                                            var rule = comp.ColorRules[rIdx];
                                            <div class="modal-row" style="flex-wrap:wrap; gap:4px; align-items:center; margin-bottom:4px;">
                                                <select aria-label="Color rule condition"
                                                        value="@rule.Condition"
                                                        @onchange='e => ReplaceColorRule(comp, rIdx, rule with { Condition = Enum.Parse<ColorCondition>(e.Value?.ToString() ?? "AboveZero") })'>
                                                    @foreach (var cond in Enum.GetValues<ColorCondition>())
                                                    {
                                                        <option value="@cond" selected="@(rule.Condition == cond)">@cond</option>
                                                    }
                                                </select>
                                                @if (rule.Condition is ColorCondition.AboveLevel or ColorCondition.BelowLevel)
                                                {
                                                    <input type="number" step="any" value="@rule.Level"
                                                           style="width:65px;"
                                                           aria-label="Level threshold"
                                                           @onchange='e => ReplaceColorRule(comp, rIdx, rule with { Level = double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double lv) ? lv : 0.0 })' />
                                                }
                                                <input type="color" value="@rule.ColorHex"
                                                       aria-label="Rule color"
                                                       @onchange='e => ReplaceColorRule(comp, rIdx, rule with { ColorHex = e.Value?.ToString() ?? "#FFFFFF" })' />
                                                <button style="padding:1px 6px; font-size:0.8rem;"
                                                        aria-label="Remove rule"
                                                        @onclick="() => RemoveColorRule(comp, rIdx)">✕</button>
                                            </div>
                                        }
                                    </div>
                                </fieldset>
                            }

                            @if (_series.CloudFills.Any())
                            {
                                <fieldset>
                                    <legend>Cloud Fills</legend>
                                    @{ int fillIndex = 0; }
                                    @foreach (var fill in _series.CloudFills)
                                    {
                                        var fid = $"fill-{fillIndex++}";
                                        <div style="border-bottom: 1px solid #333; padding-bottom: 8px; margin-bottom: 8px;">
                                            <div class="modal-row" style="font-weight:bold; margin-bottom:4px;">
                                                <span>@fill.DisplayName</span>
                                                <label style="margin-left:auto;">
                                                    <input type="checkbox" checked="@fill.IsVisible" @onchange="e => fill.IsVisible = (bool)(e.Value ?? true)" />
                                                    Visible
                                                </label>
                                            </div>
                                            <div class="modal-row">
                                                <label for="@(fid)-bull">Bullish Fill</label>
                                                <input id="@(fid)-bull" type="color" aria-label="Bullish Fill for @fill.DisplayName" value="@fill.BullishColorHex" @onchange='e => fill.BullishColorHex = e.Value?.ToString() ?? "#26A69A"' />
                                            </div>
                                            <div class="modal-row">
                                                <label for="@(fid)-bear">Bearish Fill</label>
                                                <input id="@(fid)-bear" type="color" aria-label="Bearish Fill for @fill.DisplayName" value="@fill.BearishColorHex" @onchange='e => fill.BearishColorHex = e.Value?.ToString() ?? "#EF5350"' />
                                            </div>
                                        </div>
                                    }
                                </fieldset>
                            }

                            <fieldset>
                                    <legend>Reference Levels</legend>
                                    @if (!_series.Levels.Any())
                                    {
                                        <p>No reference levels on this series yet.</p>
                                    }
                                    @{ int levelIndex = 0; }
                                    @foreach (var level in _series.Levels)
                                    {
                                        @* Index first, then the name: two levels can share a name
                                           ("Level" placed twice), and a name can carry spaces,
                                           which an id cannot. *@
                                        var lid = $"lvl-{levelIndex++}-{Slug(level.Name)}";
                                        <div style="border-bottom: 1px solid #333; padding-bottom: 10px; margin-bottom: 10px;">
                                            <div class="modal-row" style="font-weight:bold; margin-bottom:4px;">
                                                <span>@level.Name@(level.IsUserDefined ? " (yours)" : "")</span>
                                                <label style="margin-left:auto;">
                                                    <input type="checkbox" checked="@level.IsVisible"
                                                           @onchange='e => level.IsVisible = (bool)(e.Value ?? true)' />
                                                    Visible
                                                </label>
                                                <button type="button" class="btn-secondary"
                                                        aria-label="@($"Remove level {level.Name}")"
                                                        @onclick="() => RemoveLevel(level)">Remove</button>
                                            </div>
                                            <div class="modal-row">
                                                <label for="@(lid)-value">Value</label>
                                                <input id="@(lid)-value" type="number" step="any" aria-label="Value of level @level.Name" value="@level.Value"
                                                       @onchange='e => { if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out double v)) level.Value = v; }' />
                                                <label for="@(lid)-color">Color</label>
                                                <input id="@(lid)-color" type="color" aria-label="Color of level @level.Name" value="@level.ColorHex"
                                                       @onchange='e => level.ColorHex = e.Value?.ToString() ?? "#888"' />
                                                <select value="@level.DashStyle" style="width:80px;"
                                                        aria-label="Line style of level @level.Name"
                                                        @onchange='e => level.DashStyle = Enum.Parse<DashStyle>(e.Value?.ToString() ?? "Dash")'>
                                                    @foreach (var style in Enum.GetValues<DashStyle>()) { <option value="@style">@style</option> }
                                                </select>
                                            </div>
                                            <div class="modal-row">
                                                <label for="@(lid)-thick">Thickness</label>
                                                <input id="@(lid)-thick" type="range" min="0.5" max="5" step="0.5" aria-label="Thickness of level @level.Name"
                                                       value="@level.Thickness"
                                                       @onchange='e => { if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out float tv)) level.Thickness = tv; }' />
                                                <span>@level.Thickness.ToString("0.#") pixels</span>
                                            </div>
                                            <div class="modal-row">
                                                <label>
                                                    <input type="checkbox" checked="@level.PlayEarcon"
                                                           @onchange='e => level.PlayEarcon = (bool)(e.Value ?? false)' />
                                                    Play Earcon on Crossing
                                                </label>
                                                @if (level.PlayEarcon)
                                                {
                                                    <label>Vol @((level.EarconVolume * 100).ToString("F0"))%</label>
                                                    <input type="range" min="0" max="1" step="0.05" value="@level.EarconVolume"
                                                           aria-label="Earcon volume"
                                                           @onchange='e => { if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out float ev)) level.EarconVolume = ev; }' />
                                                }
                                            </div>
                                            @if (level.PlayEarcon)
                                            {
                                                @* Which crossings to report. This used to be decided by sniffing the
                                                   level's NAME for "Overbought"/"Oversold", and any level that matched
                                                   neither was silently skipped — so the checkbox above did nothing at
                                                   all on a level you placed yourself. *@
                                                <div class="modal-row">
                                                    <label for="@(lid)-dir">Report crossings</label>
                                                    <select id="@(lid)-dir" style="width:200px;" aria-label="Report crossings of level @level.Name"
                                                            @onchange='e => level.CrossDirection = Enum.Parse<LevelCrossDirection>(e.Value?.ToString() ?? "Auto")'>
                                                        <option value="Auto" selected="@(level.CrossDirection == LevelCrossDirection.Auto)">Automatic (@level.EffectiveCrossDirection)</option>
                                                        <option value="Both" selected="@(level.CrossDirection == LevelCrossDirection.Both)">Either direction</option>
                                                        <option value="Above" selected="@(level.CrossDirection == LevelCrossDirection.Above)">Only rising through</option>
                                                        <option value="Below" selected="@(level.CrossDirection == LevelCrossDirection.Below)">Only falling through</option>
                                                    </select>
                                                </div>
                                            }
                                            <div class="modal-row">
                                                <label for="@(lid)-zone">Zone Texture @((level.ZoneNoiseAmount * 100).ToString("F0"))%</label>
                                                <input id="@(lid)-zone" type="range" min="0" max="1" step="0.05" aria-label="Zone Texture of level @level.Name" value="@level.ZoneNoiseAmount"
                                                       @onchange='e => { if (float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out float nv)) level.ZoneNoiseAmount = nv; }' />
                                                <label for="@(lid)-zone-type">Noise</label>
                                                <select id="@(lid)-zone-type" value="@level.ZoneNoiseType" style="width:75px;"
                                                        aria-label="Zone noise type of level @level.Name"
                                                        @onchange='e => level.ZoneNoiseType = e.Value?.ToString() ?? "pink"'>
                                                    <option value="white">White</option>
                                                    <option value="pink">Pink</option>
                                                    <option value="brown">Brown</option>
                                                </select>
                                            </div>
                                        </div>
                                    }
                                    <div class="modal-row">
                                        <button type="button" class="btn-secondary" @onclick="AddLevelHere">
                                            Add a level at the cursor
                                        </button>
                                        <span>Or press 0 on the chart. Pressing 0 again where one of your levels sits removes it.</span>
                                    </div>
                                </fieldset>
                        </div>
                        break;

                    case "Speech":
                        @* Per-component speech templates. Edits live on ComponentConfig.SpeechTemplate
                           (continuous line/oscillator narration) and ComponentConfig.SignalSpeechTemplate
                           (one-shot marker narration, e.g. Cipher B Blue Dot fires). Values persist with
                           the workspace JSON; leaving a field blank falls back to the provider's
                           metadata default. Resetting clears the config field and repopulates from
                           IndicatorComponentMetadata on next save. *@
                        <div class="scroll-area">
                            <fieldset>
                                <legend>Available Tokens</legend>
                                <p style="font-size:0.78rem; color:var(--text-muted); margin:0 0 6px 0;">
                                    Continuous templates (line / oscillator / band):
                                    <code>{name}</code>, <code>{type}</code>, <code>{value}</code>,
                                    <code>{value:F2}</code>, <code>{value:price}</code>,
                                    <code>{trend}</code>, <code>{zone}</code>
                                </p>
                                <p style="font-size:0.78rem; color:var(--text-muted); margin:0;">
                                    Signal (marker) templates:
                                    <code>{name}</code>, <code>{price}</code>. Empty template on a marker = silent.
                                </p>
                            </fieldset>

                            @if (_series.Components.Count > 3)
                            {
                                <div class="modal-row" style="margin-bottom:12px;">
                                    <label for="comp-picker-speech">Component</label>
                                    <select id="comp-picker-speech"
                                            value="@_selectedComponentName"
                                            @onchange='e => _selectedComponentName = e.Value?.ToString() ?? ""'
                                            aria-label="Select component to configure speech for">
                                        <option value="">All Components</option>
                                        @foreach (var c in _series.Components)
                                        {
                                            <option value="@c.Name">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @foreach (var comp in _series.Components.Where(c =>
                                string.IsNullOrEmpty(_selectedComponentName) || c.Name == _selectedComponentName))
                            {
                                var defaults = GetComponentSpeechDefaults(comp.Name);
                                bool isMarker = comp.DisplayType is ComponentDisplayType.Dot
                                    or ComponentDisplayType.Diamond
                                    or ComponentDisplayType.Cross
                                    or ComponentDisplayType.Arrow
                                    or ComponentDisplayType.TriangleUp
                                    or ComponentDisplayType.TriangleDown
                                    or ComponentDisplayType.Square;

                                <fieldset>
                                    <legend>Speech: @comp.Name</legend>

                                    <div class="modal-row" style="flex-direction:column; align-items:stretch;">
                                        <label for="speech-tmpl-@comp.Name" style="flex:none; margin-bottom:3px;">
                                            Continuous template
                                        </label>
                                        <textarea id="speech-tmpl-@comp.Name"
                                                  rows="2"
                                                  style="width:100%; background:#222; border:1px solid var(--border-color); color:#fff; padding:4px; border-radius:2px; font-family:monospace;"
                                                  aria-label="Continuous speech template for @comp.Name"
                                                  placeholder="@(defaults.Continuous ?? "{name}. {type}. {value}.")"
                                                  @onchange='e => comp.SpeechTemplate = e.Value?.ToString() ?? ""'>@comp.SpeechTemplate</textarea>
                                        @if (!string.IsNullOrEmpty(defaults.Continuous))
                                        {
                                            <p style="margin:2px 0 4px 0; font-size:0.75rem; color:var(--text-muted);">
                                                Default: <code>@defaults.Continuous</code>
                                            </p>
                                        }
                                        <button style="font-size:0.75rem; padding:2px 8px; align-self:flex-end;"
                                                @onclick="() => ResetSpeechTemplate(comp, signal: false)"
                                                aria-label="Reset continuous template for @comp.Name to default">
                                            Reset to default
                                        </button>
                                    </div>

                                    @if (isMarker)
                                    {
                                        <div class="modal-row" style="flex-direction:column; align-items:stretch; margin-top:8px;">
                                            <label for="signal-tmpl-@comp.Name" style="flex:none; margin-bottom:3px;">
                                                Signal template (fires on marker)
                                            </label>
                                            <textarea id="signal-tmpl-@comp.Name"
                                                      rows="2"
                                                      style="width:100%; background:#222; border:1px solid var(--border-color); color:#fff; padding:4px; border-radius:2px; font-family:monospace;"
                                                      aria-label="Signal speech template for @comp.Name"
                                                      placeholder="@(defaults.Signal ?? "(silent)")"
                                                      @onchange='e => comp.SignalSpeechTemplate = string.IsNullOrWhiteSpace(e.Value?.ToString()) ? null : e.Value?.ToString()'>@comp.SignalSpeechTemplate</textarea>
                                            @if (!string.IsNullOrEmpty(defaults.Signal))
                                            {
                                                <p style="margin:2px 0 4px 0; font-size:0.75rem; color:var(--text-muted);">
                                                    Default: <code>@defaults.Signal</code>
                                                </p>
                                            }
                                            <button style="font-size:0.75rem; padding:2px 8px; align-self:flex-end;"
                                                    @onclick="() => ResetSpeechTemplate(comp, signal: true)"
                                                    aria-label="Reset signal template for @comp.Name to default">
                                                Reset to default
                                            </button>
                                        </div>
                                    }
                                </fieldset>
                            }
                        </div>
                        break;

                    case "Sonification":
                        <div class="scroll-area">
                            <div class="modal-row">
                                <label for="son-master-volume">Master Series Volume</label>
                                <input id="son-master-volume" type="range" min="0" max="1" step="0.05" value="@_series.Volume" @onchange='e => _series.Volume = float.Parse(e.Value?.ToString() ?? "1")' />
                                <span>@((_series.Volume * 100).ToString("F0"))%</span>
                            </div>

                            @if (_series.Components.Count > 3)
                            {
                                <div class="modal-row" style="margin-bottom:12px;">
                                    <label for="comp-picker-sonification">Component</label>
                                    <select id="comp-picker-sonification"
                                            value="@_selectedComponentName"
                                            @onchange='e => _selectedComponentName = e.Value?.ToString() ?? ""'
                                            aria-label="Select component to configure">
                                        <option value="">All Components</option>
                                        @foreach (var c in _series.Components)
                                        {
                                            <option value="@c.Name">@c.Name</option>
                                        }
                                    </select>
                                </div>
                            }

                            @foreach (var comp in _series.Components.Where(c =>
                                string.IsNullOrEmpty(_selectedComponentName) || c.Name == _selectedComponentName))
                            {
                                @* Named twice over, as on the Appearance tab — see the note there. *@
                                var sid = "son-" + Slug(comp.Name);
                                <fieldset>
                                    <legend>Acoustics: @comp.Name</legend>
                                    <div class="modal-row">
                                        <label for="@(sid)-patch">Sound Patch</label>
                                        <select id="@(sid)-patch" value="@(comp.SoundPatchId ?? "")"
                                                @onchange="e => comp.SoundPatchId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()"
                                                aria-label="Sound patch for @comp.Name">
                                            <option value="">(manual — use controls below)</option>
                                            @foreach (var opt in PatchOptions())
                                            {
                                                <option value="@opt.Value">@opt.Label</option>
                                            }
                                        </select>
                                        <button type="button" @onclick="() => PreviewComponentPatch(comp.SoundPatchId)"
                                                aria-label="Preview patch for @comp.Name">&#9654;</button>
                                    </div>
                                    @if (IsDirectional(comp))
                                    {
                                        var dir = DirectionLabels(comp);
                                        <div class="modal-row">
                                            <label for="@(sid)-bull-patch">@dir.Up</label>
                                            <select id="@(sid)-bull-patch" value="@(comp.BullishSoundPatchId ?? "")"
                                                    @onchange="e => comp.BullishSoundPatchId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()"
                                                    aria-label="@dir.Up for @comp.Name">
                                                <option value="">(use Sound Patch above)</option>
                                                @foreach (var opt in PatchOptions())
                                                {
                                                    <option value="@opt.Value">@opt.Label</option>
                                                }
                                            </select>
                                            <button type="button" @onclick="() => PreviewComponentPatch(comp.BullishSoundPatchId)"
                                                    aria-label="Preview bullish patch for @comp.Name">&#9654;</button>
                                        </div>
                                        <div class="modal-row">
                                            <label for="@(sid)-bear-patch">@dir.Down</label>
                                            <select id="@(sid)-bear-patch" value="@(comp.BearishSoundPatchId ?? "")"
                                                    @onchange="e => comp.BearishSoundPatchId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : e.Value!.ToString()"
                                                    aria-label="@dir.Down for @comp.Name">
                                                <option value="">(use Sound Patch above)</option>
                                                @foreach (var opt in PatchOptions())
                                                {
                                                    <option value="@opt.Value">@opt.Label</option>
                                                }
                                            </select>
                                            <button type="button" @onclick="() => PreviewComponentPatch(comp.BearishSoundPatchId)"
                                                    aria-label="Preview bearish patch for @comp.Name">&#9654;</button>
                                        </div>
                                    }
                                    <p style="font-size:0.75rem; color:var(--text-muted); margin:2px 0 8px;">
                                        Patches are built in the Sound Designer and live-link here — edit a patch there and
                                        every component using it updates.
                                        @if (IsDirectional(comp))
                                        {
                                            <text>@DirectionLabels(comp).Hint</text>
                                        }
                                        Leave a field blank to fall back to the Sound Patch, then the manual controls below.
                                    </p>
                                    <div class="modal-row">
                                        <label for="@(sid)-waveform">Waveform (Instrument)</label>
                                        <select id="@(sid)-waveform" aria-label="Waveform (Instrument) for @comp.Name" value="@comp.Waveform" @onchange='e => comp.Waveform = e.Value?.ToString() ?? "sine"'>
                                            <option value="sine">Sine (Soft)</option>
                                            <option value="triangle">Triangle (Mellow)</option>
                                            <option value="sawtooth">Sawtooth (Bright)</option>
                                            <option value="square">Square (Hollow)</option>
                                        </select>
                                    </div>
                                    <div class="modal-row">
                                        <label for="@(sid)-volume">Volume</label>
                                        <input id="@(sid)-volume" type="range" min="0" max="1" step="0.05" aria-label="Volume for @comp.Name" value="@comp.Volume" @onchange='e => comp.Volume = float.Parse(e.Value?.ToString() ?? "1")' />
                                        <span>@((comp.Volume * 100).ToString("F0"))%</span>
                                    </div>
                                    <div class="modal-row">
                                        <label for="@(sid)-freq">Base Frequency (Hz)</label>
                                        <input id="@(sid)-freq" type="number" step="10" min="50" max="2000" aria-label="Base Frequency (Hz) for @comp.Name" value="@comp.BaseFrequency" @onchange='e => comp.BaseFrequency = double.Parse(e.Value?.ToString() ?? "440")' />
                                    </div>
                                    <div class="modal-row">
                                        <label for="@(sid)-noise">Noise Texture (@(comp.NoiseAmount.ToString("F2")))</label>
                                        <input id="@(sid)-noise" type="range" min="0" max="1" step="0.05" value="@comp.NoiseAmount"
                                               aria-label="Noise Texture amount for @comp.Name"
                                               @onchange='e => comp.NoiseAmount = float.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out float nv) ? nv : 0f' />
                                        <span style="min-width:32px;">@((comp.NoiseAmount * 100).ToString("F0"))%</span>
                                    </div>
                                    <div class="modal-row">
                                        <label>
                                            <input type="checkbox" checked="@(!comp.IsMuted)" @onchange="e => comp.IsMuted = !(bool)(e.Value ?? true)" />
                                            Audio Enabled
                                        </label>
                                    </div>
                                </fieldset>
                            }
                        </div>
                        break;
                }
            </div>

            <div class="modal-footer">
                <button @onclick="Close" aria-label="Cancel, close the properties dialog">Cancel</button>
                @if (_series != null && !_series.IsDrawing && !string.IsNullOrEmpty(_series.Config?.IndicatorCode))
                {
                    <button title="Save current appearance and sonification as persistent defaults for this indicator type"
                            @onclick="SaveAsDefaults">Save as Defaults</button>
                    <button title="Discard all customisations and reload fresh metadata defaults for this indicator"
                            @onclick="ResetToDefaults">Reset to Defaults</button>
                }
                @* "Save", not "Apply Changes": one vocabulary across every dialog that can
                   commit — Save writes and closes, Cancel and Escape discard. *@
                <button class="primary" id="props-save" @onclick="Apply"
                        aria-label="Save the series properties">Save</button>
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p role="alert" class="error-text">@_error</p>
            }
        </div>
    </div>
}

<style>
    .tabs-header { display: flex; border-bottom: 1px solid #333; margin-bottom: 15px; }
    .tabs-header button {
        flex: 1; padding: 10px; background: transparent; border: none; border-bottom: 2px solid transparent;
        color: var(--text-muted); cursor: pointer; font-weight: bold;
    }
    .tabs-header button.active { color: #0078d4; border-bottom-color: #0078d4; }
    
    .tab-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .scroll-area { overflow-y: auto; padding-right: 10px; }
    
    fieldset { border: 1px solid #333; border-radius: 4px; padding: 10px; margin-bottom: 15px; }
    legend { padding: 0 5px; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; }
    
    .modal-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .modal-row label { flex: 1; font-size: 0.9rem; }
    .modal-row input[type="number"], .modal-row input[type="text"], .modal-row select { 
        background: #222; border: 1px solid var(--border-color); color: #fff; padding: 4px; border-radius: 2px;
    }
    
    .error-text { color: #f44; font-size: 0.85rem; margin-top: 10px; }
</style>

@code {
    private bool _isVisible;
    private string _activeTab = "General";

    // Tab ids in visual order, so the arrow handler and the markup cannot drift apart.
    private static readonly string[] TabIds = { "props-tab-general", "props-tab-appearance", "props-tab-sonification", "props-tab-speech" };
    private static readonly string[] TabKeys = { "General", "Appearance", "Sonification", "Speech" };

    /// <summary>
    /// Arrow / Home / End across the tab row. Selection follows focus, per WAI-ARIA:
    /// the key both switches the tab and moves focus onto it, so a screen reader
    /// announces the tab the user actually arrived at. The rule itself lives in
    /// TablistNavigator — eight tablists, one answer.
    /// </summary>
    private async Task OnTabListKeyDown(KeyboardEventArgs e)
    {
        int current = Array.IndexOf(TabKeys, _activeTab);
        int? target = TablistNavigator.Target(e.Key, current, TabKeys.Length);
        if (target == null) return;

        _activeTab = TabKeys[target.Value];
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", TabIds[target.Value]); }
        catch { /* best-effort focus, as everywhere else */ }
    }


    private string ActiveTabId => _activeTab switch
    {
        "General"      => "props-tab-general",
        "Appearance"   => "props-tab-appearance",
        "Sonification" => "props-tab-sonification",
        "Speech"       => "props-tab-speech",
        _              => "props-tab-general",
    };
    private string _selectedComponentName = "";  // "" = show all components
    private ChartSeries? _series;
    private Dictionary<string, double> _params = new();

    /// <summary>Parameters shown as a sentence rather than a field, and written back on Apply
    /// exactly as they were read: today, a fixed-range profile's anchor timestamps.</summary>
    private readonly Dictionary<string, double> _pinnedParams = new();
    private string? _anchorRangeText;

    /// <summary>
    /// Lifts a fixed-range profile's <c>AnchorStart</c>/<c>AnchorEnd</c> out of the editable
    /// parameter list and describes them instead. They are Unix seconds captured from the
    /// viewport when the profile was added — a value the user did not type and should not be
    /// asked to edit as a number. See <see cref="AccessibleTrader.Core.Services.ProfileAnchoring"/>.
    /// </summary>
    private void PinProfileAnchor()
    {
        _pinnedParams.Clear();
        _anchorRangeText = null;
        if (_series == null) return;

        string code = _series.Config?.IndicatorCode ?? string.Empty;
        bool fixedProfile = _series.IsProfile
            && !AccessibleTrader.Core.Services.ProfileAnchoring.FollowsViewport(code);
        if (!fixedProfile) return;

        foreach (var key in new[] {
            AccessibleTrader.Core.Services.ProfileAnchoring.AnchorStartParam,
            AccessibleTrader.Core.Services.ProfileAnchoring.AnchorEndParam })
        {
            if (_params.TryGetValue(key, out var v))
            {
                _pinnedParams[key] = v;
                _params.Remove(key);
            }
        }

        if (_pinnedParams.TryGetValue(AccessibleTrader.Core.Services.ProfileAnchoring.AnchorStartParam, out var from)
            && _pinnedParams.TryGetValue(AccessibleTrader.Core.Services.ProfileAnchoring.AnchorEndParam, out var to)
            && from > 0 && to > 0)
        {
            if (to < from) (from, to) = (to, from);
            var start = DateTimeOffset.FromUnixTimeSeconds((long)from).UtcDateTime;
            var end = DateTimeOffset.FromUnixTimeSeconds((long)to).UtcDateTime;
            int barSeconds = 0;
            try { barSeconds = AccessibleTrader.Sdk.Configuration.TimeframeUtility.ToSeconds(Store.State.Identity.Timeframe ?? ""); }
            catch { /* an unknown timeframe just means "spell out both ends" */ }
            string range = barSeconds > 0
                ? AccessibleTrader.Core.Services.Accessibility.SpeechTimeFormatter.FormatBarRange(start, end, barSeconds)
                : $"{AccessibleTrader.Core.Services.Accessibility.SpeechTimeFormatter.FormatLongDate(start)} to {AccessibleTrader.Core.Services.Accessibility.SpeechTimeFormatter.FormatLongDate(end)}";
            _anchorRangeText = $"Anchored to the bars from {range}. The range was captured when this profile "
                             + "was added; to anchor a different stretch, add a new fixed-range profile while viewing it.";
        }
        else
        {
            _anchorRangeText = "Fixed range, anchored to every bar loaded when it was added.";
        }
    }
    private Dictionary<string, string> _stringParams = new();
    private List<IndicatorParameterMetadata> _paramMeta = new();
    private string? _error;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenPropertiesEvent>(ev => InvokeAsync(() => ShowAsync(ev.SeriesId)));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Properties") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync(string? overrideId)
    {
        var id = overrideId ?? Store.State.FocusedSeriesId;
        var original = Store.State.ActiveSeries.FirstOrDefault(s => s.Id == id);
        if (original == null) return;

        // Clone so changes are only applied when clicking "Apply"
        _series = original.Clone();
        
        _params = _series.Parameters != null
            ? new Dictionary<string, double>(_series.Parameters)
            : new Dictionary<string, double>();
        PinProfileAnchor();
        _stringParams = _series.StringParameters != null
            ? new Dictionary<string, string>(_series.StringParameters)
            : new Dictionary<string, string>();

        // Look up parameter metadata for display names, descriptions, and validation.
        _paramMeta = new();
        if (!string.IsNullOrEmpty(_series.Config?.IndicatorCode))
        {
            var allMeta = IndicatorService.GetAvailableIndicators();
            var meta = allMeta.FirstOrDefault(m =>
                m.Code.Equals(_series.Config.IndicatorCode, StringComparison.OrdinalIgnoreCase));
            if (meta?.Parameters != null)
                _paramMeta = meta.Parameters;
        }

        // Seed every declared string parameter the series has not set yet with its metadata
        // default, so the knob is visible and editable the first time the dialog is opened.
        // Without this a string parameter only appears after it has already been changed —
        // which, for a series created before the parameter existed, is never.
        foreach (var pm in _paramMeta)
        {
            if (pm.DataType == typeof(string) && !_stringParams.ContainsKey(pm.Name))
                _stringParams[pm.Name] = pm.DefaultValue?.ToString() ?? string.Empty;
        }

        _error = null;
        _activeTab = "General";
        _selectedComponentName = "";

        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Properties"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "props-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Properties"));
        StateHasChanged();
    }

    /// <summary>
    /// True when a component has a bullish/bearish (green/red) colour, so per-direction patches make
    /// sense: candles, bars, histograms/volume bars, and any polarity-coloured component. Plain lines,
    /// areas, and single-colour markers don't get the green/red options.
    /// </summary>
    private static bool IsDirectional(ComponentConfig comp) =>
        comp.UsePolarityColoring
        || comp.DisplayType is ComponentDisplayType.Candle
            or ComponentDisplayType.CandleColor
            or ComponentDisplayType.Bar
            or ComponentDisplayType.Histogram
            or ComponentDisplayType.ZeroDot
            or ComponentDisplayType.ZeroArea
            or ComponentDisplayType.Oscillator;

    /// <summary>
    /// Labels for the two-patch split, matched to what the engine ACTUALLY splits
    /// on (see DefaultSonificationStrategy): oscillators split at the visible
    /// midline (RSI 50), zero-anchored shapes at their baseline, price bars by
    /// candle direction. "Bullish/bearish" is only shown where it is true.
    /// </summary>
    private static (string Up, string Down, string Hint) DirectionLabels(ComponentConfig comp) =>
        comp.DisplayType == ComponentDisplayType.Oscillator
            ? ("Above midline patch", "Below midline patch",
               "Above/below patches split at the middle of the pane's range (RSI 50). The overbought/oversold zone texture from Reference Levels still plays on top of any patch.")
        : comp.DisplayType is ComponentDisplayType.Histogram or ComponentDisplayType.ZeroDot or ComponentDisplayType.ZeroArea
          || comp.UsePolarityColoring
            ? ("Positive patch", "Negative patch",
               "Positive/negative patches split at the zero (baseline) line.")
            : ("Green (bullish) patch", "Red (bearish) patch",
               "Green/red patches let up-bars and down-bars sound different.");

    /// <summary>Selectable sound patches: built-in registry bells, factory instrument
    /// voices (the sound-theme bank), then user Sound Designer patches.</summary>
    private IEnumerable<(string Value, string Label)> PatchOptions()
    {
        var ids = PatchRegistry.GetPatchIds();
        if (ids != null)
            foreach (var id in ids.OrderBy(x => x))
                yield return (id, "Built-in: " + Prettify(id));
        foreach (var v in AccessibleTrader.Core.Services.Audio.SoundThemes.FactoryPatches.Values.OrderBy(p => p.Name))
            yield return (v.Id, "Voice: " + v.Name);
        var user = PatchLibrary.GetPatches();
        if (user != null)
            foreach (var p in user)
                yield return (p.Id, p.Name);
    }

    /// <summary>
    /// A component or level name as an id fragment. Names carry spaces and punctuation
    /// ("Signal Line", "Oversold zone"); an id cannot, and a <c>for</c> that points at an
    /// invalid id is the orphan-label defect in a new coat.
    /// </summary>
    private static string Slug(string s) =>
        new string(s.Select(ch => char.IsLetterOrDigit(ch) ? char.ToLowerInvariant(ch) : '-').ToArray());

    private static string Prettify(string id) =>
        string.Join(' ', id.Split('_').Select(w => w.Length == 0 ? w : char.ToUpper(w[0]) + w.Substring(1)));

    private void PreviewComponentPatch(string? patchId)
    {
        if (string.IsNullOrEmpty(patchId)) return;

        // User Sound Designer patch: play it directly.
        var lib = PatchLibrary.GetPatch(patchId);
        if (lib != null) { SonificationManager.PlayPatch(lib); return; }

        // Built-in (registry) bell: synthesize an equivalent multi-layer patch and audition it through
        // the SAME PlayPatch path — a Ping-decay bell with the harmonic and detuned partials, so the
        // preview actually sounds like the bell (not a bare tone).
        if (PatchRegistry.TryGetPatch(patchId, out var reg))
        {
            const double baseFreq = 523.25; // C5
            var preview = new AccessibleTrader.Sdk.Models.SoundPatch
            {
                BaseFrequency   = baseFreq,
                Volume          = 0.5f,
                EnvelopeType    = "Ping",
                DurationSeconds = System.Math.Clamp(reg.DefaultDecayMs / 1000.0, 0.15, 1.0),
                Oscillators     = new List<OscillatorLayer>
                {
                    new() { Waveform = reg.BaseWaveform, Gain = 1f, FreqRatio = 1.0 },
                },
            };
            if (reg.HarmonicAmount > 0f)
                preview.Oscillators.Add(new OscillatorLayer
                {
                    Waveform = reg.BaseWaveform, Gain = reg.HarmonicAmount, FreqRatio = reg.HarmonicFreqMultiplier,
                });
            if (reg.IsDetuned)
                preview.Oscillators.Add(new OscillatorLayer
                {
                    Waveform = reg.BaseWaveform, Gain = 0.7f, FreqRatio = (baseFreq + reg.DetuneIntervalHz) / baseFreq,
                });
            SonificationManager.PlayPatch(preview);
        }
    }

    /// <summary>Checkbox change → the 1/0 the parameter dictionary stores.</summary>
    private void UpdateBoolParam(string key, object? value) =>
        UpdateParam(key, (value is bool b && b) ? "1" : "0");

    private void UpdateStringParam(string key, string? raw) => _stringParams[key] = raw ?? string.Empty;

    private void UpdateParam(string key, string? raw)
    {
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out double v))
            return;

        // Clamp to metadata bounds if defined.
        var pm = _paramMeta.FirstOrDefault(p =>
            p.Name.Equals(key, StringComparison.OrdinalIgnoreCase));
        if (pm?.MinValue.HasValue == true && v < pm.MinValue.Value) v = pm.MinValue.Value;
        if (pm?.MaxValue.HasValue == true && v > pm.MaxValue.Value) v = pm.MaxValue.Value;

        _params[key] = v;
    }

    private void Apply()
    {
        if (_series == null) return;

        _series.Parameters.Clear();
        foreach (var kvp in _params) _series.Parameters[kvp.Key] = kvp.Value;
        // The anchor is not in _params (see PinProfileAnchor); without this line Apply would
        // erase it and a fixed-range profile would quietly become a whole-history one.
        foreach (var kvp in _pinnedParams) _series.Parameters[kvp.Key] = kvp.Value;
        _series.StringParameters.Clear();
        foreach (var kvp in _stringParams) _series.StringParameters[kvp.Key] = kvp.Value;

        // Replace only the edited series in the full list — UpdateSeriesAction does a bulk
        // replace of ActiveSeries, so passing a single-element list wipes all other series.
        var updatedList = Store.State.ActiveSeries
            .Select(s => s.Id == _series.Id ? _series : s)
            .ToImmutableList();
        Store.Dispatch(new UpdateSeriesAction(updatedList));
        SeriesManager.PersistWorkspace();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"{_series.FriendlyName} properties applied"));
        
        // Trigger a recalculation if parameters changed
        EventBus.Publish(new IndicatorUpdatedEvent(_series.Id));
        
        Close();
    }

    /// <summary>
    /// Regenerates all component configs from fresh indicator metadata, clearing any stale
    /// workspace overrides and user preferences. Useful when provider defaults have changed
    /// (e.g. new waveform or color defaults in CipherB) and the running series is still using
    /// an old workspace save.
    /// </summary>
    private void ResetToDefaults()
    {
        if (_series == null) return;
        var indicatorCode = _series.Config?.IndicatorCode;
        if (string.IsNullOrEmpty(indicatorCode)) return;

        var meta = IndicatorService.GetAvailableIndicators()
            .FirstOrDefault(m => m.Code == indicatorCode);
        if (meta == null) return;

        // Wipe persisted preferences so Layer 3 is empty → pure metadata defaults.
        IndicatorPrefs.ClearPreferences(indicatorCode);

        // Build parameter list from current series (preserves user-set periods etc.)
        var paramList = _series.Parameters
            .Select(kvp => (kvp.Key, kvp.Value.ToString()))
            .Concat(_series.StringParameters.Select(kvp => (kvp.Key, kvp.Value)))
            .ToList();

        // CreateSeriesFromMetadata with no workspace overrides → Layer 1 only.
        var freshSeries = Factory.CreateSeriesFromMetadata(
            meta, _series.FriendlyName, _series.Pane ?? "", paramList,
            new System.Collections.Generic.List<ComponentConfig>());

        // Splice fresh component configs into the cloned series (preserves ID / pane / params).
        if (_series.Config == null) return;
        _series.Config.Components.Clear();
        foreach (var c in freshSeries.Components)
            _series.Config.Components.Add(c);

        // Re-inject level defaults from the provider (prefs were cleared above so Layer 3 is empty).
        SeriesManager.ResetLevelsToProviderDefaults(_series);

        // Apply immediately — no need for user to click Apply.
        var updatedList = Store.State.ActiveSeries
            .Select(s => s.Id == _series.Id ? _series : s)
            .ToImmutableList();
        Store.Dispatch(new UpdateSeriesAction(updatedList));
        SeriesManager.PersistWorkspace();
        EventBus.Publish(new IndicatorUpdatedEvent(_series.Id));
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"{_series.FriendlyName} reset to defaults"));

        StateHasChanged();
    }

    /// <summary>
    /// Deletes a reference level.
    ///
    /// <para>
    /// Until 2026-08-04 there was no way to remove a level from anywhere in the application. A stray
    /// one added by an accidental keypress was permanent — which is how a level at zero, sitting on
    /// the price series, went on breaking a maintainer's y-axis at every launch.
    /// </para>
    /// </summary>
    private void RemoveLevel(LevelConfig level)
    {
        if (_series == null) return;

        Store.Dispatch(new RemoveLevelAction(_series.Id, level.Name));
        _series.Levels.Remove(level);

        SeriesManager.PersistWorkspace();
        EventBus.Publish(new IndicatorUpdatedEvent(_series.Id));
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, $"{level.Name} removed"));
        StateHasChanged();
    }

    /// <summary>
    /// Adds a level from the dialog, at the same place the <c>0</c> key would put one — the cursor's
    /// price on a price pane, zero on an oscillator.
    ///
    /// <para>
    /// The placement decision lives in <c>ReferenceLevelPlacement</c> so that the button and the key
    /// cannot drift apart, and so the rule that a level must be in the units of its pane is stated
    /// once rather than in two places that might disagree.
    /// </para>
    /// </summary>
    private void AddLevelHere()
    {
        if (_series == null) return;

        var state = Store.State;
        int cursor = state.CurrentDataIndex;
        double cursorPrice = state.Data != null && cursor >= 0 && cursor < state.Data.Count
            ? (double)state.Data[cursor].Close
            : double.NaN;

        var level = AccessibleTrader.Core.Services.Input.ReferenceLevelPlacement.For(
            _series.Pane, cursorPrice, _series.Levels, out string reason);

        if (level == null)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error, reason, true));
            return;
        }

        Store.Dispatch(new AddLevelAction(_series.Id, level));
        _series.Levels.Add(level);

        SeriesManager.PersistWorkspace();
        EventBus.Publish(new IndicatorUpdatedEvent(_series.Id));
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, reason));
        StateHasChanged();
    }

    private void SaveAsDefaults()
    {
        if (_series == null) return;
        var indicatorCode = _series.Config?.IndicatorCode;
        if (string.IsNullOrEmpty(indicatorCode)) return;

        // Build ComponentPreference list from the current (potentially edited) component state.
        var prefs = _series.Components
            .Where(c => c.DisplayType != ComponentDisplayType.Level)
            .Select(c => new ComponentPreference
            {
                Name              = c.Name,
                ColorHex          = c.ColorHex,
                ColorHexSecondary = c.ColorHexSecondary,
                Thickness         = c.Thickness,
                DashStyle         = c.DashStyle,
                Waveform          = c.Waveform,
                EnvelopeType      = c.EnvelopeType,
                Volume            = c.Volume,
                FreqMultiplier    = c.FreqMultiplier,
                BaseFrequency     = c.BaseFrequency,
                NoiseAmount       = c.NoiseAmount,
                IsVisible         = c.IsVisible,
            })
            .ToList();

        IndicatorPrefs.SavePreferences(indicatorCode, prefs);

        // Also persist the current level audio/display settings as type defaults for future fresh adds.
        foreach (var level in _series.Levels)
        {
            IndicatorPrefs.SaveLevelPreference(indicatorCode, new LevelPreference
            {
                Name            = level.Name,
                Value           = level.Value,
                IsVisible       = level.IsVisible,
                PlayEarcon      = level.PlayEarcon,
                EarconVolume    = level.EarconVolume,
                ZoneNoiseAmount = level.ZoneNoiseAmount,
                ZoneNoiseType   = level.ZoneNoiseType,
                ColorHex        = level.ColorHex,
                Thickness       = level.Thickness,
                DashStyle       = level.DashStyle,
                CrossDirection  = level.CrossDirection,
            });
        }

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Defaults saved for {_series.FriendlyName}"));
    }

    // Speech template helpers
    //
    // The "default" for a speech template is the value the indicator provider declares on
    // IndicatorComponentMetadata.SpeechTemplate / DefaultSignalSpeechTemplate. We surface it
    // next to the editor so the user can see what the shipped behaviour is, and the Reset
    // button below restores the config field back to that default. Looking it up lazily per
    // render is fine — GetAvailableIndicators() is already cached by IndicatorService.
    private (string? Continuous, string? Signal) GetComponentSpeechDefaults(string componentName)
    {
        var code = _series?.Config?.IndicatorCode;
        if (string.IsNullOrEmpty(code)) return (null, null);
        var meta = IndicatorService.GetAvailableIndicators()
            .FirstOrDefault(m => m.Code.Equals(code, StringComparison.OrdinalIgnoreCase));
        var compMeta = meta?.Components?.FirstOrDefault(c =>
            c.Name.Equals(componentName, StringComparison.OrdinalIgnoreCase));
        return (compMeta?.SpeechTemplate, compMeta?.DefaultSignalSpeechTemplate);
    }

    private void ResetSpeechTemplate(ComponentConfig comp, bool signal)
    {
        var (cont, sig) = GetComponentSpeechDefaults(comp.Name);
        if (signal)
        {
            comp.SignalSpeechTemplate = sig; // null = silent / no-signal default
        }
        else
        {
            // Continuous templates fall back to SpeechFormatter's generic fallback if the
            // provider didn't declare one, so reset to empty rather than the fallback string —
            // keeps persistence clean and lets future metadata default changes propagate.
            comp.SpeechTemplate = cont ?? "";
        }
    }

    // Color Rule helpers
    // Recolouring by hand pins the choice: price action otherwise follows the active theme, and
    // a theme switch would silently undo a deliberate edit.
    private static void SetComponentColor(ComponentConfig comp, string hex)
    {
        comp.ColorHex = hex;
        comp.IsUserStyled = true;
    }

    private static void SetComponentColorSecondary(ComponentConfig comp, string hex)
    {
        comp.ColorHexSecondary = hex;
        comp.IsUserStyled = true;
    }

    private void AddColorRule(ComponentConfig comp)
        => comp.ColorRules.Add(new ColorRule { Condition = ColorCondition.AboveZero, ColorHex = "#26A69A" });

    private void ReplaceColorRule(ComponentConfig comp, int idx, ColorRule updated)
        => comp.ColorRules[idx] = updated;

    private void RemoveColorRule(ComponentConfig comp, int idx)
        => comp.ColorRules.RemoveAt(idx);

    // Drawing coordinate helpers. Which fields exist is DrawingAnchorSchema's answer, not this
    // file's; these only read and write the slot the schema named.
    private double? AnchorPrice(int slot) => slot switch
    {
        1 => _series?.Drawing?.AnchorPrice1,
        2 => _series?.Drawing?.AnchorPrice2,
        3 => _series?.Drawing?.AnchorPrice3,
        _ => null,
    };

    private DateTime? AnchorDate(int slot) => slot switch
    {
        1 => _series?.Drawing?.AnchorDate1,
        2 => _series?.Drawing?.AnchorDate2,
        3 => _series?.Drawing?.AnchorDate3,
        _ => null,
    };

    /// <summary>
    /// Rename a drawing so navigation announces something meaningful.
    ///
    /// <para>
    /// Both <c>Name</c> and <c>FriendlyName</c> are set. Navigation speech reads <c>Name</c> — for
    /// indicators that is deliberate, because <c>FriendlyName</c> carries baked-in parameter values
    /// ("RSI 14") that are noise during navigation. A drawing has no parameters, so the two should
    /// simply agree, and setting only one would leave the announcement and the object tree
    /// disagreeing about what the same object is called.
    /// </para>
    ///
    /// <para>
    /// Blank restores the automatic name rather than leaving an unnamed drawing, because a series
    /// with an empty name is announced as silence — which is indistinguishable from the navigation
    /// having failed.
    /// </para>
    /// </summary>
    private void RenameDrawing(string? raw)
    {
        // The rename box only renders inside `@if (_isVisible && _series != null)`, so this is
        // unreachable in the running app — but a late @onchange from a box the modal has already
        // closed behind is exactly the shape that has bitten elsewhere, and an unguarded
        // dereference here would take the whole render loop down rather than drop one rename.
        if (_series == null) return;

        string name = (raw ?? "").Trim();
        if (name.Length == 0)
            name = _series.Drawing?.Type.ToString() ?? "Drawing";

        _series.Config.Name = name;
        _series.Config.FriendlyName = name;
        EventBus.Publish(new AnnouncementEvent($"Renamed to {name}.", true));
    }

    // Fields whose last edit was REJECTED. `aria-invalid` is the signal the 2026-09-03 error-state
    // work established for exactly this: the value was submitted and refused. Without it a number
    // box that would not parse keeps showing the text the user typed while the drawing still holds
    // the old coordinate, and nothing on the screen says so.
    private readonly HashSet<string> _rejectedCoordinates = new(StringComparer.Ordinal);

    private string? InvalidAttr(string fieldId) => _rejectedCoordinates.Contains(fieldId) ? "true" : null;

    /// <summary>
    /// The date as the INPUT should show it — the user's own zone.
    ///
    /// <para>Anchor dates are bar stamps, and every spoken date in this app goes through
    /// <c>SpeechTimeFormatter</c>, which resolves a stamp into the user's zone (treating an
    /// Unspecified kind as UTC, because that is what every provider path produces). The input
    /// rendered the raw stored value instead, so for any user not on UTC the field showed one
    /// time and the rest of the terminal said another about the same anchor. Both ends go
    /// through the same conversion now, and <see cref="ParseDateFromInput"/> is its inverse.</para>
    /// </summary>
    private string? AnchorDateForInput(int slot)
    {
        var stored = AnchorDate(slot);
        return stored is null
            ? null
            : AccessibleTrader.Core.Services.Accessibility.SpeechTimeFormatter.ToDisplay(stored.Value)
                .ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>
    /// Read a <c>datetime-local</c> value back into a stored stamp.
    ///
    /// <para>Invariant culture and <c>AssumeLocal</c> are both load-bearing. The control always
    /// emits ISO-8601; parsing it under the ambient culture puts a non-Gregorian default calendar
    /// (ar-SA, th-TH) into the wrong year, and the price half of this pair already pins invariant.
    /// The wall-clock the user typed is in THEIR zone, so it is specified as Local and stored as
    /// UTC — which is what <c>SpeechTimeFormatter.ToDisplay</c> will convert back.</para>
    /// </summary>
    private static bool ParseDateFromInput(string? raw, out DateTime storedUtc)
    {
        storedUtc = default;
        if (!DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.AssumeLocal, out var local)) return false;
        storedUtc = DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime();
        return true;
    }

    /// <summary>
    /// Write one coordinate. The readback is on BLUR, not here — see
    /// <see cref="AnnounceCoordinate"/>.
    ///
    /// <para>The geometry itself is recomputed by Apply, which publishes
    /// <c>IndicatorUpdatedEvent</c>; <c>DataOrchestrationService</c> answers that with a forced
    /// full recalculation, and <c>IndicatorOrchestrator</c>'s drawings branch runs
    /// <c>CalculateDrawingData</c> over the new anchors before the redraw. That chain was traced
    /// rather than assumed — a review reported this path as a silent no-op and it is not one.</para>
    /// </summary>
    private void UpdateDrawingPrice(int anchor, string fieldId, string label, string? raw)
    {
        if (_series?.Drawing == null) return;
        if (!double.TryParse(raw, System.Globalization.NumberStyles.Any,
                System.Globalization.CultureInfo.InvariantCulture, out double v))
        {
            _rejectedCoordinates.Add(fieldId);
            return;
        }
        _rejectedCoordinates.Remove(fieldId);
        var d = _series.Drawing;
        if (anchor == 1) d.AnchorPrice1 = v;
        else if (anchor == 2) d.AnchorPrice2 = v;
        else if (anchor == 3) d.AnchorPrice3 = v;
    }

    /// <summary>
    /// The date half. It had no <c>anchor == 3</c> branch while the price half did, so the moment
    /// a slot-3 date editor rendered — Andrews Pitchfork is the one type that needs one — the
    /// price would have saved and the date would have gone nowhere, with no error and nothing
    /// spoken. The asymmetry was invisible while no such editor existed.
    /// </summary>
    private void UpdateDrawingDate(int anchor, string fieldId, string label, string? raw)
    {
        if (_series?.Drawing == null) return;
        if (!ParseDateFromInput(raw, out DateTime dt))
        {
            _rejectedCoordinates.Add(fieldId);
            return;
        }
        _rejectedCoordinates.Remove(fieldId);
        var d = _series.Drawing;
        if (anchor == 1) d.AnchorDate1 = dt;
        else if (anchor == 2) d.AnchorDate2 = dt;
        else if (anchor == 3) d.AnchorDate3 = dt;
    }

    /// <summary>
    /// Say what the field ended up holding, ONCE, when the user leaves it.
    ///
    /// <para>This was on <c>@onchange</c> and it flooded. Chromium fires <c>change</c> on every
    /// arrow-key step of a number input and on every segment step of a datetime-local one, and
    /// <c>AnnouncementEvent</c> interrupts by default — so walking an hour segment from 00 to 14
    /// produced fourteen announcements, each cutting off the one before, and the user heard
    /// thirteen fragments and one sentence. Same shape as the narrator's nine Speak calls per
    /// scan, closed 2026-09-02. Blur is the commit point for both control types and happens
    /// once.</para>
    ///
    /// <para>It reads the STORED value rather than what was typed, so it doubles as the report on
    /// a rejected edit: a value that would not parse leaves the model alone and this says so,
    /// rather than quoting the raw text back — which for a number input is the empty string,
    /// because the browser never hands over unparseable content in the first place.</para>
    /// </summary>
    private void AnnounceCoordinate(
        string fieldId, string label, int slot,
        AccessibleTrader.Core.Services.Drawing.DrawingAnchorAxis axis)
    {
        if (_series?.Drawing == null) return;

        if (_rejectedCoordinates.Contains(fieldId))
        {
            EventBus.Publish(new AnnouncementEvent(
                $"{label} not changed. The value was not accepted.", true));
            return;
        }

        if (axis == AccessibleTrader.Core.Services.Drawing.DrawingAnchorAxis.Price)
        {
            var p = AnchorPrice(slot);
            if (p is null) return;
            EventBus.Publish(new AnnouncementEvent(
                $"{label} {AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(p.Value)}.", true));
        }
        else
        {
            var d = AnchorDate(slot);
            if (d is null) return;
            EventBus.Publish(new AnnouncementEvent(
                $"{label} {AccessibleTrader.Core.Services.Accessibility.SpeechTimeFormatter.Format(d.Value, "MMMM dd, HH:mm")}.", true));
        }
    }

    public void Dispose() { _eventSub?.Dispose(); _closeSub?.Dispose(); }
}
