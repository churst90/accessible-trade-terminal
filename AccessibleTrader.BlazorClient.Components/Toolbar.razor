@using AccessibleTrader.Core.Models
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Services.Analysis
@using AccessibleTrader.Core.Services.Rendering
@using Microsoft.Extensions.DependencyInjection
@using AccessibleTrader.Sdk.Enums
@using AccessibleTrader.Sdk.Models
@using AccessibleTrader.Sdk.Plugins
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IMarketOrchestrator MarketOrchestrator
@inject ILogger<Toolbar> Logger
@inject DemoPolicy Demo
@inject IViewportManager Viewport
@inject IServiceProvider Services
@implements IDisposable

@* ── Per-tab "mode" helper: true when the current tab is showing an OHLCV
    trading provider (candles/volume/price). On analytics tabs (SingleValueLine),
    trading-only controls — Strategies, Drawings, Heatmap, Heikin Ashi, Log Scale
    — are hidden because they don't apply to scalar metrics. The check reads
    state.CurrentDataShape, which is set by WorkspaceInitializer on every load. *@

@* Main toolbar. All controls are flat Tab stops — no role="radiogroup" or nested
   focus traps — so screen readers in both browse mode and application mode can
   reach every control with Tab/Shift+Tab without switching interaction modes.

   No role="toolbar". That flat-Tab decision above is deliberate and correct, and
   role="toolbar" contradicted it twice over. First, an explicit role OVERRIDES the
   element's implicit one, so <nav role="toolbar"> exposed a toolbar and not a
   navigation landmark — and this is the app's primary chrome, so pressing D in NVDA
   gave banner/main/contentinfo and could not reach the ~25 controls here at all.
   Second, role="toolbar" is an ARIA promise of roving tabindex and arrow-key
   traversal, which is precisely the model the comment above says was rejected on
   purpose: it told assistive tech to expect arrows that do nothing.
   Dropping the role recovers the landmark, withdraws the false promise, and changes
   no runtime behaviour whatsoever. *@
<nav class="toolbar" style="flex-direction: column; gap: 4px;" aria-label="Main toolbar">

    @* ── Row 1: Chart setup | Analysis | Workspace | Meta ────────────────
       Trading and Analytics are no longer a mode toggle here — the two are unified.
       Pick "Analytics" in the Market dropdown (Row 2) to chart economic/on-chain/
       derivatives/sentiment data; everything else is a tradeable market. *@
    <div style="display:flex; flex-wrap:wrap; align-items:center;">

        @* ── Chart setup: what you PUT on the chart ─────────────────────── *@
        <div class="toolbar-group">
            <ToolbarIconButton Icon="object-tree" Label="Object tree" Variant="neutral"
                              Tooltip="Open object tree, Alt plus O"
                              OnClick="() => EventBus.Publish(new OpenObjectTreeEvent())" />
            @if (IsTradingTab)
            {
                <ToolbarIconButton Icon="drawings" Label="Drawings" Variant="data"
                                  Tooltip="Open drawing tools, Alt plus D"
                                  OnClick="() => EventBus.Publish(new OpenDrawingToolsEvent())" />
            }
            @if (Demo.AllowSoundDesigner)
            {
                <ToolbarIconButton Icon="sound-designer" Label="Sound designer" Variant="neutral"
                                  Tooltip="Open sound designer, Alt plus W"
                                  OnClick="() => EventBus.Publish(new OpenSoundDesignerEvent())" />
            }
        </div>

        @* ── Analysis: what you DO with the chart ───────────────────────── *@
        <div class="toolbar-group">
            @if (Demo.AllowTrading)
            {
                <ToolbarIconButton Icon="trade" Label="Trade dashboard" Variant="action"
                                  Tooltip="Open trade dashboard, Alt plus T"
                                  OnClick="() => EventBus.Publish(new OpenTradingDashboardEvent())" />
            }
            @if (Demo.AllowOrderBook)
            {
                <ToolbarIconButton Icon="order-book" Label="Order book" Variant="neutral"
                                  Tooltip="Open order book, Alt plus B"
                                  OnClick="() => EventBus.Publish(new OpenOrderBookEvent())" />
            }
            @if (IsTradingTab && Demo.AllowStrategies)
            {
                <ToolbarIconButton Icon="strategies" Label="Strategies" Variant="thought"
                                  Tooltip="Open strategies, Alt plus S"
                                  OnClick="() => EventBus.Publish(new OpenStrategiesEvent())" />
            }
            @if (!Demo.IsDemo)
            {
                <ToolbarIconButton Icon="watchlist" Label="Watch lists" Variant="data"
                                  Tooltip="Open watch lists and screener, Alt plus M"
                                  OnClick="() => EventBus.Publish(new OpenWatchlistEvent())" />
            }
            @if (IsTradingTab)
            {
                <ToolbarIconButton Icon="analytics" Label="Levels" Variant="thought"
                                  Tooltip="Open level respect report, Alt plus R"
                                  OnClick="() => EventBus.Publish(new OpenLevelReportEvent())" />
            }
            <ToolbarIconButton Icon="journal" Label="Trade journal" Variant="neutral"
                              Tooltip="Open trade journal, Control plus Alt plus Shift plus J"
                              OnClick="() => EventBus.Publish(new OpenJournalEvent())" />
            @if (Demo.AllowAiAnalyst)
            {
                <ToolbarIconButton Icon="ai-analyst" Label="AI analyst" Variant="thought"
                                  Tooltip="Open AI analyst, Control plus Alt plus Shift plus A"
                                  OnClick="() => EventBus.Publish(new OpenAIAnalystEvent())" />
            }
            @if (Demo.AllowAlerts)
            {
                <ToolbarIconButton Icon="alerts" Label="Alerts" Variant="warning"
                                  Tooltip="Open alerts, Alt plus J"
                                  OnClick="() => EventBus.Publish(new OpenAlertsEvent())" />
            }
            @if (Demo.AllowApiKeysModal)
            {
                <ToolbarIconButton Icon="api-keys" Label="API keys" Variant="neutral"
                                  Tooltip="Open API keys, Alt plus K"
                                  OnClick="() => EventBus.Publish(new OpenApiKeysEvent())" />
            }
            @* Present only when the connected provider genuinely has a wallet API.
               That is `provider is IWalletProvider` — a compiler-enforced fact, not
               a declared flag — so this button cannot appear over nothing. Equity
               brokers are not crypto custodians and never show it. *@
            @if (_hasWallet)
            {
                <ToolbarIconButton Icon="api-keys" Label="Deposit" Variant="neutral"
                                  Tooltip="Show a deposit address for this exchange"
                                  OnClick="() => EventBus.Publish(new OpenWalletEvent())" />
            }
            @* Present only when a withdrawal is actually possible: the provider
               implements IWithdrawalProvider AND a withdrawal-enabled key profile
               exists. Both are checked by CanWithdrawAsync — showing the button on
               capability alone would open a dialog whose every path is a refusal. *@
            @if (_canWithdraw)
            {
                <ToolbarIconButton Icon="api-keys" Label="Withdraw" Variant="warning"
                                  Tooltip="Withdraw funds to an address saved at the venue"
                                  OnClick="() => EventBus.Publish(new OpenWithdrawEvent())" />
            }
        </div>

        @* ── Workspace persistence ──────────────────────────────────────── *@
        @if (Demo.AllowWorkspaceSaveLoad)
        {
            <div class="toolbar-group">
                <ToolbarIconButton Icon="save-workspace" Label="Save workspace" Variant="neutral"
                                  Tooltip="Save workspace, Control plus Alt plus Shift plus W"
                                  OnClick="() => EventBus.Publish(new OpenSaveWorkspaceEvent())" />
                <ToolbarIconButton Icon="load-workspace" Label="Load workspace" Variant="neutral"
                                  Tooltip="Load workspace, Control plus Alt plus W"
                                  OnClick="() => EventBus.Publish(new OpenLoadWorkspaceEvent())" />
            </div>
        }

        @* ── Meta: app-level, always last ────────────────────────────── *@
        <div class="toolbar-group">
            @if (Demo.AllowSettingsModal)
            {
                <ToolbarIconButton Icon="settings" Label="Settings" Variant="neutral"
                                  Tooltip="Open settings, F12"
                                  OnClick="() => EventBus.Publish(new OpenSettingsEvent())" />
            }
            <ToolbarIconButton Icon="help" Label="Help" Variant="neutral"
                              Tooltip="Open help, F1"
                              OnClick="() => EventBus.Publish(new OpenHelpEvent())" />
        </div>

    </div>

    @* ── Row 2: Market pipeline | separator | Visual toggles ─────────────── *@
    <div style="display:flex; flex-wrap:wrap; gap:6px; align-items:center;">

        @* ── Market Pipeline ──────────────────────────────────────────────── *@
        <label for="market-select">Market:</label>
        <select id="market-select"
                aria-label="Select market"
                @onchange="OnMarketChanged"
                value="@MarketOrchestrator.SelectedMarket">
            @foreach (var m in MarketOrchestrator.AvailableMarkets)
            {
                <option value="@m" selected="@(m == MarketOrchestrator.SelectedMarket)">@FormatMarketLabel(m)</option>
            }
        </select>

        @* Analytics type (Economic / OnChain / Derivatives / Sentiment) — shown only
           when the "Analytics" umbrella is the selected market. Sits between Market and
           Provider so the cascade reads Market → Analytics type → Provider → Symbol. *@
        @if (IsAnalyticsMarketSelected)
        {
            <label for="analytics-type-select">Analytics type:</label>
            <select id="analytics-type-select"
                    aria-label="Select analytics type"
                    @onchange="OnAnalyticsTypeChanged"
                    value="@MarketOrchestrator.SelectedAnalyticsType">
                @foreach (var a in MarketOrchestrator.AvailableAnalyticsTypes)
                {
                    <option value="@a" selected="@(a == MarketOrchestrator.SelectedAnalyticsType)">@a</option>
                }
            </select>
        }

        <label for="provider-select">Provider:</label>
        <select id="provider-select"
                aria-label="Select data provider"
                @onchange="OnProviderChanged"
                value="@MarketOrchestrator.SelectedProvider">
            @foreach (var p in MarketOrchestrator.AvailableProviders)
            {
                <option value="@p" selected="@(p == MarketOrchestrator.SelectedProvider)">@p</option>
            }
        </select>

        @* Sub-type (Spot / Futures) — only shown when provider supports multiple sub-types *@
        @if (MarketOrchestrator.AvailableSubTypes.Count > 1)
        {
            <label for="subtype-select">Type:</label>
            <select id="subtype-select"
                    aria-label="Select market sub-type (Spot or Futures)"
                    @onchange="OnSubTypeChanged"
                    value="@MarketOrchestrator.SelectedSubType">
                @foreach (var st in MarketOrchestrator.AvailableSubTypes)
                {
                    <option value="@st" selected="@(st == MarketOrchestrator.SelectedSubType)">@st</option>
                }
            </select>
        }

        <label for="symbol-select">Symbol:</label>
        @* max-width so a long ticker — an options contract, or the API-key sentinel — cannot
           widen the control enough to reflow the toolbar rows. The full value is still in the
           tooltip and in what the screen reader reads. *@
        <select id="symbol-select"
                aria-label="Select symbol"
                aria-describedby="@(NeedsApiKey ? "symbol-key-help" : null)"
                title="@(NeedsApiKey ? AccessibleTrader.Core.Services.MarketOrchestrator.ApiKeyRequiredHelp : MarketOrchestrator.SelectedSymbol)"
                style="max-width: 22ch;"
                @onchange="OnSymbolChanged"
                value="@MarketOrchestrator.SelectedSymbol">
            @foreach (var s in MarketOrchestrator.AvailableSymbols)
            {
                <option value="@s" selected="@(s == MarketOrchestrator.SelectedSymbol)">@s</option>
            }
        </select>
        @if (NeedsApiKey)
        {
            @* Next to the Load button rather than crammed into the dropdown.

               The reason sentence is a DESCRIPTION, not the button's name. It used to be
               the aria-label, which made the accessible name a 99-character paragraph that
               did not contain the visible words "Add key" — a WCAG 2.5.3 failure and a
               2.4.6 one, since a button list read the whole sentence as the row. It was
               also the `title` at the same time, so a screen reader announced name then
               description and said it twice.

               It now lives once, in a hidden span that BOTH the button and the symbol
               dropdown point at with aria-describedby — the dropdown pointed at the button
               itself before, so the select's description was computed from the button's
               name and moved with it. *@
            <button type="button" class="warning"
                    aria-describedby="symbol-key-help"
                    @onclick="() => EventBus.Publish(new OpenApiKeysEvent())">Add key</button>
            <span id="symbol-key-help" class="visually-hidden">@AccessibleTrader.Core.Services.MarketOrchestrator.ApiKeyRequiredHelp</span>
        }

        <div class="toolbar-separator" aria-hidden="true"></div>

        @* ── Custom timeframe composer ────────────────────────────────────
           Multiplier + unit inputs compose a timeframe string like "4h", "15m", "2w".
           Quick-pick buttons (from AvailableTimeframes) fill the fields in one click.
           Hidden in the public demo, which exposes only the 4h/1d quick-picks.
           SINGLE-TIMEFRAME PROVIDERS (most analytics feeds are daily-only): the whole
           timeframe area is hidden — composer AND quick-picks — because there is
           nothing to choose. The timeframe still shows in the tab title and chart
           announcements, so the user always knows what they're on. A provider that
           declares NO timeframes (unknown support) keeps the composer. *@
        @if (MarketOrchestrator.AvailableTimeframes.Count != 1)
        {
            @if (!Demo.IsDemo)
            {
                <label for="tf-mult">Time:</label>
                <input id="tf-mult"
                       type="number"
                       min="1"
                       max="999"
                       aria-label="Time multiplier for the timeframe"
                       style="width:4rem;"
                       value="@_tfMult"
                       @onchange="OnTfMultChanged" />
                <label for="tf-unit" class="visually-hidden">Timeframe unit</label>
                <select id="tf-unit"
                        aria-label="Timeframe unit"
                        @onchange="OnTfUnitChanged"
                        value="@_tfUnit">
                    <option value="m" selected="@(_tfUnit == "m")">min</option>
                    <option value="h" selected="@(_tfUnit == "h")">hr</option>
                    <option value="d" selected="@(_tfUnit == "d")">day</option>
                    <option value="w" selected="@(_tfUnit == "w")">wk</option>
                    <option value="M" selected="@(_tfUnit == "M")">mo</option>
                </select>
            }
            @if (MarketOrchestrator.AvailableTimeframes.Count > 1)
            {
                <div style="display:inline-flex; flex-wrap:wrap; gap:3px;">
                    @foreach (var tf in MarketOrchestrator.AvailableTimeframes)
                    {
                        <button style="padding:2px 5px; font-size:0.8rem;"
                                aria-label="Set timeframe to @tf"
                                title="Set timeframe to @tf"
                                @onclick="() => ApplyQuickPickTimeframe(tf)">@tf</button>
                    }
                </div>
            }
        }

        @* My Data: contextual import affordance — appears only when the user's
           own market is selected (also on Ctrl+Alt+Shift+I from anywhere). *@
        @if (IsMyDataMarketSelected)
        {
            <ToolbarIconButton Icon="load-workspace" Label="Import" Variant="neutral"
                              Tooltip="Import a CSV data file, Control plus Alt plus Shift plus I"
                              OnClick="() => EventBus.Publish(new OpenMyDataEvent())" />
        }

        <ToolbarIconButton Icon="load" Label="Load chart" Variant="action" Primary="true"
                          ElementId="toolbar-load-btn"
                          Gate="LoadGate"
                          Tooltip="Load chart for the selected symbol"
                          OnClick="LoadChart" />

        @if (_loadError != null)
        {
            <span role="alert" style="color: #f44; font-size: 0.85rem; margin-left: 8px;">@_loadError</span>
        }

        @* ── Chart view controls (pan / zoom) ──────────────────────────────
           Mouse-accessible equivalents of the keyboard viewport commands. Routed
           through IViewportManager so they behave exactly like the keys: pan-left
           triggers proactive history backfill and each action emits descriptive
           spoken feedback. Not gated by IsTradingTab — panning/zooming applies to
           analytics line charts too. Disabled until data is loaded. *@
        <div class="toolbar-separator" aria-hidden="true"></div>
        <div class="toolbar-group" role="group" aria-label="Chart view">
            <ToolbarIconButton Icon="pan-left" Label="Pan left" Variant="neutral"
                              Gate="ChartDataGate"
                              Tooltip="Pan left, back in time, Left arrow"
                              OnClick="PanLeft" />
            <ToolbarIconButton Icon="pan-right" Label="Pan right" Variant="neutral"
                              Gate="ChartDataGate"
                              Tooltip="Pan right, forward in time, Right arrow"
                              OnClick="PanRight" />
            <ToolbarIconButton Icon="zoom-in" Label="Zoom in" Variant="neutral"
                              Gate="ChartDataGate"
                              Tooltip="Zoom in, Plus key"
                              OnClick="ZoomIn" />
            <ToolbarIconButton Icon="zoom-out" Label="Zoom out" Variant="neutral"
                              Gate="ChartDataGate"
                              Tooltip="Zoom out, Minus key"
                              OnClick="ZoomOut" />
        </div>

        @* ── Visual Toggles (trading-only) ───────────────────────────────── *@
        @if (IsTradingTab)
        {
            <div class="toolbar-group">
                <ToolbarIconButton Icon="heatmap" Label="Heatmap" Variant="data"
                                  IsToggleOn="@(IsHeatmapVisible == "true")"
                                  Tooltip="Toggle liquidity heatmap, Alt plus H"
                                  OnClick="AddHeatmap" />
                <ToolbarIconButton Icon="heikin-ashi" Label="Heikin Ashi" Variant="data"
                                  IsToggleOn="@(Store.State.IsHeikinAshi)"
                                  Tooltip="Toggle Heikin Ashi candles"
                                  OnClick="() => Store.Dispatch(new ToggleHeikinAshiAction())" />
                <ToolbarIconButton Icon="log-scale" Label="Log scale" Variant="data"
                                  IsToggleOn="@(Store.State.IsLogScale)"
                                  Tooltip="Toggle the logarithmic price scale"
                                  OnClick="() => Store.Dispatch(new ToggleLogScaleAction())" />
                <ToolbarIconButton Icon="split-view" Label="Split view" Variant="data"
                                  IsToggleOn="@IsSplitActive"
                                  Tooltip="Toggle split view, a second chart beside this one, Control plus Alt plus Shift plus S"
                                  OnClick="ToggleSplit" />
                <ToolbarIconButton Icon="replay" Label="Replay" Variant="data"
                                  IsToggleOn="@IsReplayActive"
                                  Tooltip="Toggle bar replay, step forward one bar at a time, Control plus Alt plus Shift plus P"
                                  OnClick="ToggleReplay" />
            </div>
        }

    </div>

</nav>

@* ── Shape-change confirmation dialog ─────────────────────────────────────
    Shown when the user clicks Load and the new provider's shape differs from
    the current tab's shape AND the current tab has non-core content (indicators
    or drawings) that would be stripped. Gives three options: Continue (destructive
    — strip everything non-core and load), Open in New Tab (preserves the current
    tab and loads into a fresh one), or Cancel. Inline rather than a separate
    modal component to keep the change surgical.

    It is inline but it is still a modal, and until 2026-08-29 it behaved like neither. It
    published no ModalStateChangedEvent, so the dispatcher's modal stack never knew it was
    open — Escape went to the chart instead, and MainLayout (which arms the Tab trap off that
    same event) never trapped Tab, so Tab walked out of a confirmation the user had not
    answered. It moved no focus either, so a screen-reader user was left standing on the Load
    button with a destructive prompt unread on screen. On MAUI the SkiaSharp canvas is hidden
    by that same event, so this drew UNDERNEATH the chart. ModalContractScanTests scanned for
    role="dialog" only and could not see any of it; it now covers alertdialog too. *@
@if (_showSwitchWarning)
{
    <div role="alertdialog" data-modal-name="ShapeChangeWarning" aria-modal="true"
         aria-labelledby="switchWarnTitle" aria-describedby="switchWarnBody"
         style="position:fixed; top:30%; left:50%; transform:translateX(-50%);
                background:#222; color:#eee; padding:16px 20px; border:2px solid #ff8c00;
                border-radius:6px; z-index:9999; max-width:480px; box-shadow:0 4px 20px rgba(0,0,0,0.6);">
        @* tabindex="-1" so the heading can take programmatic focus — that is what makes a
           screen reader read the dialog's name and, via aria-describedby, what it is about. *@
        <h3 id="switchWarnTitle" tabindex="-1" style="margin-top:0; color:#ff8c00;">Switching to analytics</h3>
        <p id="switchWarnBody" style="margin:8px 0;">
            This provider returns scalar metric data, not OHLCV. Loading it on the current
            tab will remove @_stripCount indicator(s) and drawing(s). Trading-mode tools
            don't apply to analytics metrics.
        </p>
        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:12px;">
            <button class="primary" @onclick="ConfirmSwitchDestructive"
                    title="Strip indicators and drawings, then load">
                Continue (strip &amp; load)
            </button>
            <button @onclick="ConfirmSwitchNewTab"
                    title="Open the analytics view in a new tab so the current tab is preserved">
                Open in New Tab
            </button>
            <button @onclick="CancelSwitch" aria-label="Cancel, keep the current tab as it is"
                    title="Don't load — keep current tab as is">
                Cancel
            </button>
        </div>
    </div>
}

@code {
    private IDisposable? _pipelineSub;
    private IDisposable? _loadChartSub;
    private IDisposable? _stateSub;
    private IDisposable? _splitSub;
    private IDisposable? _replaySub;
    private IDisposable? _apiKeysSub;
    private IDisposable? _switchWarnSub;
    private string? _loadError;

    // ── Custom timeframe composer state ──────────────────────────────────
    private int    _tfMult = 1;
    private string _tfUnit = "h";
    private string _tfString => $"{_tfMult}{_tfUnit}";

    // Disable Load when no symbol is selected or the API-key sentinel is showing.
    private bool CanLoad =>
        !string.IsNullOrEmpty(MarketOrchestrator.SelectedSymbol)
        && MarketOrchestrator.SelectedSymbol != AccessibleTrader.Core.Services.MarketOrchestrator.ApiKeyRequiredSentinel;

    // ── Split view / bar replay toggles ──────────────────────────────────
    // Resolved through the service provider rather than @inject so the toolbar still
    // renders in hosts (and unit tests) that don't stand up the chart-rendering graph;
    // a missing service leaves the button present but inert rather than throwing at
    // component-initialisation time and taking the whole toolbar with it.
    private ISplitViewCoordinator? SplitView => Services.GetService<ISplitViewCoordinator>();
    private IReplayService?        Replay    => Services.GetService<IReplayService>();

    // ── Deposit button ───────────────────────────────────────────────────
    // Whether the CURRENT provider implements IWalletProvider. Recomputed on every
    // workspace change because switching provider changes the answer, and cached in
    // a field because the check is async and the render path is not.
    private bool _hasWallet;
    private bool _canWithdraw;
    private string _walletCheckedFor = "";

    private async Task RefreshWalletAsync()
    {
        string provider = Store.State.Identity.Provider ?? "";
        if (provider != _walletCheckedFor)
        {
            _walletCheckedFor = provider;
            var wallet = Services.GetService<AccessibleTrader.Core.Services.Trading.WalletService>();
            // Resolved through the service provider for the same reason as the two
            // above: a host that does not stand up trading should lose the button,
            // not the whole toolbar.
            _hasWallet = wallet is not null
                      && !string.IsNullOrEmpty(provider)
                      && await wallet.HasWalletAsync(provider);

            // Withdraw is gated harder than Deposit: capability AND a
            // withdrawal-enabled key profile. Key changes re-run this through the
            // ApiKeysChangedEvent subscription below, which clears the per-provider
            // cache — so the button appears the moment the profile is saved.
            var withdrawals = Services.GetService<AccessibleTrader.Core.Services.Trading.WithdrawalService>();
            _canWithdraw = withdrawals is not null
                        && !string.IsNullOrEmpty(provider)
                        && await withdrawals.CanWithdrawAsync(provider);
        }
        StateHasChanged();
    }

    private bool IsSplitActive  => SplitView?.IsEnabled ?? false;
    private bool IsReplayActive => Replay?.IsActive ?? false;

    // Published as events rather than called directly so the button and the keyboard
    // shortcut go down exactly one code path — including the spoken confirmation the
    // services emit, which a direct call would bypass.
    private void ToggleSplit()  => EventBus.Publish(new SplitViewCommandEvent(SplitViewCommand.Toggle));
    private void ToggleReplay() => EventBus.Publish(new ReplayCommandEvent(ReplayCommand.Toggle));

    // True when the selected provider needs a key it hasn't got, so the symbol list is the
    // sentinel rather than real symbols.
    private bool NeedsApiKey =>
        MarketOrchestrator.SelectedSymbol
            == AccessibleTrader.Core.Services.MarketOrchestrator.ApiKeyRequiredSentinel;

    private string IsHeatmapVisible => Store.State.ActiveSeries.Any(s => s.IndicatorCode == "HEATMAP" && s.IsVisible) ? "true" : "false";

    // True when the "Analytics" umbrella is the selected market, so the Analytics-type
    // dropdown (Economic/OnChain/…) is surfaced between Market and Provider.
    private bool IsAnalyticsMarketSelected =>
        string.Equals(MarketOrchestrator.SelectedMarket,
                      AccessibleTrader.Core.Services.MarketOrchestrator.AnalyticsMarket,
                      StringComparison.OrdinalIgnoreCase);

    // ── Chart view controls (pan / zoom) ─────────────────────────────────
    // Pan/zoom are no-ops with no data, so the buttons disable until a chart loads.
    private bool HasChartData => Store.State.Data.Count > 0;

    /// <summary>Null when the Load button will do something; otherwise why it will not.</summary>
    private string? LoadGate() =>
          string.IsNullOrEmpty(MarketOrchestrator.SelectedSymbol)
            ? "Choose a symbol first."
        : MarketOrchestrator.SelectedSymbol == AccessibleTrader.Core.Services.MarketOrchestrator.ApiKeyRequiredSentinel
            ? "This provider needs an API key before it can list symbols. Add one in API Keys."
        : null;

    /// <summary>Null when the pan and zoom buttons have a chart to act on; otherwise why not.</summary>
    private string? ChartDataGate() =>
        HasChartData ? null : "No chart is loaded yet. Choose a symbol and press Load.";

    // Route through IViewportManager exactly like NavigationEngine's keyboard commands
    // (VIEW_PAN_LEFT/RIGHT, VIEW_ZOOM_IN/OUT) so mouse and keyboard behave identically,
    // including pan-left history backfill and descriptive spoken feedback.
    private void PanLeft()  => Viewport.HandlePan(-1, Store.State.Data.ToList());
    private void PanRight() => Viewport.HandlePan(1,  Store.State.Data.ToList());

    private bool IsMyDataMarketSelected =>
        string.Equals(MarketOrchestrator.SelectedMarket,
            AccessibleTrader.Sdk.Enums.MarketType.MyData.ToString(), StringComparison.OrdinalIgnoreCase);

    // Market identity strings stay the raw enum names; only the LABEL is
    // humanized ("MyData" reads badly in speech and print).
    private static string FormatMarketLabel(string market) =>
        market == "MyData" ? "My Data" : market;
    private void ZoomIn()   => Viewport.HandleZoom("IN",  Store.State.Data.ToList());
    private void ZoomOut()  => Viewport.HandleZoom("OUT", Store.State.Data.ToList());

    protected override void OnInitialized()
    {
        // Re-render whenever market/provider/symbol/timeframe lists change.
        _pipelineSub = MarketOrchestrator.PipelineUpdated
            .Subscribe(_ => InvokeAsync(StateHasChanged));

        // And whenever the WORKSPACE changes, because several controls read their state straight
        // out of the store: Pan and Zoom disable on Store.State.Data.Count, and Heatmap, Heikin
        // and Log show pressed state from the store's own flags. Without this the toolbar only
        // repainted when something unrelated happened to fire, so pan and zoom could sit greyed
        // out over a chart full of data, and toggling Heikin from the keyboard left the button
        // showing the opposite of the truth. A control that lies about its own state is worse
        // than one that is missing.
        _stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(RefreshWalletAsync));

        // Saving or removing a key can change the answer to CanWithdrawAsync for
        // the CURRENT provider — and RefreshWalletAsync caches per provider name,
        // so without this the Withdraw button would not appear until the user
        // switched providers. Add the withdrawal profile, close the modal, and the
        // button must simply be there.
        _apiKeysSub = EventBus.Subscribe<ApiKeysChangedEvent>(_ => InvokeAsync(() =>
        {
            _walletCheckedFor = "";
            return RefreshWalletAsync();
        }));

        // Keyboard "Load chart" (Ctrl+Alt+Shift+L) — same path as the Load button,
        // including the shape-change pre-flight warning. Spoken refusal instead of
        // a silent no-op when the market cascade isn't complete yet.
        // The Split and Replay buttons show pressed state, and both are also reachable
        // from the keyboard, so the toolbar has to repaint when the change came from
        // somewhere else. The services flip their own state on the same events, so this
        // deliberately re-renders AFTER them by hopping through InvokeAsync.
        _splitSub  = EventBus.Subscribe<SplitViewCommandEvent>(_ => InvokeAsync(StateHasChanged));
        _replaySub = EventBus.Subscribe<ReplayCommandEvent>(_ => InvokeAsync(StateHasChanged));

        // Escape closes the shape-change confirmation, and Escape means CANCEL: it is the
        // non-destructive branch, and a dialog that warns about stripping the user's work
        // must not treat "get me out of here" as consent to strip it.
        _switchWarnSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_showSwitchWarning && e.ModalName == "ShapeChangeWarning")
                InvokeAsync(CloseSwitchWarningAsync);
        });

        _loadChartSub = EventBus.Subscribe<LoadChartRequestedEvent>(_ => InvokeAsync(async () =>
        {
            if (!CanLoad)
            {
                EventBus.Publish(new AnnouncementEvent(
                    "Cannot load yet. Choose a market, provider, and symbol first.", true));
                return;
            }
            await LoadChart();
            StateHasChanged();
        }));

        // Parse the existing SelectedTimeframe to seed the composer fields.
        ParseTimeframe(MarketOrchestrator.SelectedTimeframe);

        // Kick off the initial cascade (market → provider → symbol → timeframe).
        _ = InitPipelineAsync();
    }

    /// <summary>Parses a timeframe string like "4h", "15m", "1d" into mult+unit fields.</summary>
    private void ParseTimeframe(string? tf)
    {
        if (string.IsNullOrWhiteSpace(tf)) return;
        var m = System.Text.RegularExpressions.Regex.Match(tf, @"^(\d+)([mhdwM])$");
        if (m.Success && int.TryParse(m.Groups[1].Value, out int mult) && mult >= 1)
        {
            _tfMult = mult;
            _tfUnit = m.Groups[2].Value;
        }
    }

    private async Task InitPipelineAsync()
    {
        try
        {
            await MarketOrchestrator.RefreshPipelineAsync();

            // Public demo: the whitelist has already narrowed the cascade to
            // Bitstamp · BTC/USD · 1d, so open that chart automatically — a visitor
            // should land on a live chart, not a blank canvas.
            if (Demo.IsDemo && CanLoad)
            {
                ParseTimeframe(MarketOrchestrator.SelectedTimeframe);
                await MarketOrchestrator.LoadChartAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            _loadError = "Could not load market data.";
            Logger.LogError(ex, "Pipeline init failed.");
            await InvokeAsync(StateHasChanged);
        }
    }

