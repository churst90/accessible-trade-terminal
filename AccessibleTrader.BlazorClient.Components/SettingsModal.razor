@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Sdk.Enums
@using AccessibleTrader.Sdk.Analysis
@using Newtonsoft.Json.Linq
@using System.Reflection
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject IDataExportService DataExporter
@inject IWorkspaceLibraryService WorkspaceLibrary
@inject ISeriesManagementService SeriesManager
@inject IShortcutManager ShortcutService
@inject ISettingsManager Settings
@inject IAppSettings App
@inject AccessibleTrader.Core.Services.Theming.IThemeLibrary Themes
@inject IServiceProvider ServiceProvider
@inject DemoPolicy Demo
@inject IPaperTradingProvider Paper
@inject IRuntimePlatform Platform
@inject AccessibleTrader.Core.Services.Workspace.IBackgroundMonitoringService Monitoring
@inject AccessibleTrader.Core.Services.Feeds.IBackgroundTabFeedService TabFeeds
@inject ITerminalResetService TerminalReset
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Cancel">
        <div class="modal-content"
             role="dialog" data-modal-name="Settings"
             aria-modal="true"
             aria-labelledby="settings-title"
             style="max-width:660px;"
             @onclick:stopPropagation="true">

            <h2 id="settings-title" tabindex="-1">Settings</h2>

            @* ── Tab list ──────────────────────────────────────────────────── *@
            @* Settings search (Phase D second pass): filters a registry of every
               setting by label/keywords; choosing a result jumps to its tab and
               focuses the control. Cognitive-accessibility item — nobody should
               need to memorise which of six tabs holds a setting. *@
            <div class="modal-row" style="margin-bottom:10px;">
                <label for="s-search">Search settings</label>
                @* aria-describedby only while #s-search-count is actually rendered
                   (the results region is @if-gated on a non-empty query). *@
                <input id="s-search" type="search"
                       value="@_searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="e.g. speech, theme, alerts"
                       aria-describedby="@(string.IsNullOrWhiteSpace(_searchQuery) ? null : "s-search-count")" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <div role="region" aria-label="Setting search results"
                     style="border:1px solid var(--border-color); border-radius:4px; padding:6px 10px; margin-bottom:12px;">
                    <p id="s-search-count" role="status" style="margin:2px 0; font-size:0.85rem; color:var(--text-muted);">
                        @_searchResults.Count matching setting@(_searchResults.Count == 1 ? "" : "s").
                    </p>
                    @foreach (var r in _searchResults)
                    {
                        var captured = r;
                        <button style="display:block; width:100%; text-align:left; padding:5px 8px; background:transparent; border:none; cursor:pointer;"
                                data-control-id="@captured.ControlId"
                                @onclick="() => GoToSetting(captured)">
                            @captured.Label <span style="color:var(--text-muted); font-size:0.8rem;">— @captured.Tab tab</span>
                        </button>
                    }
                </div>
            }

            @* The roving tabindex below (0 on the active tab, -1 on the rest) is a PROMISE:
               it tells the browser that Tab reaches this group and ARROW KEYS move within
               it. Only half of that was implemented, so five of the then six tabs — including
               the entire keyboard-rebinding UI and the paper-account reset — were reachable
               by mouse only. The handler is the other half of the promise. *@
            <div role="tablist" aria-label="Settings categories"
                 aria-orientation="horizontal"
                 @onkeydown="OnTabListKeyDown"
                 style="display:flex; gap:0; border-bottom:2px solid var(--border-color); margin-bottom:16px;">
                @foreach (var tab in SettingsTabs)
                {
                    bool active = _activeTab == tab;
                    @* The active tab was a pale #e8f0ff panel, which stopped working the moment the
                       label colour became a theme variable: near-white text on a near-white
                       background rendered the selected tab as an empty box. An accent-tinted wash
                       plus the underline carries selection without depending on the ink being dark.

                       NOTE: this comment sits OUTSIDE the button tag deliberately. A Razor comment
                       placed between an element's attributes compiles without error or warning and
                       emits as an ATTRIBUTE NAME — a multi-line string that Blazor then throws on
                       while rendering. That is what took the whole Settings dialog down. *@
                    <button role="tab"
                            aria-selected="@active.ToString().ToLower()"
                            tabindex="@(active ? 0 : -1)"
                            id="@TabElementId(tab)"
                            aria-controls="tabpanel-@tab.ToLower()"
                            @onclick="() => _activeTab = tab"
                            style="padding:6px 16px; border:none;
                                   border-bottom:@(active ? "3px solid var(--accent-color)" : "3px solid transparent");
                                   background:@(active ? "color-mix(in srgb, var(--accent-color) 22%, transparent)" : "transparent");
                                   font-weight:@(active ? "700" : "400");
                                   color:var(--text-on-surface); cursor:pointer;">
                        @tab
                    </button>
                }
            </div>

            @* ── General tab ───────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-general"
                 aria-labelledby="tab-general"
                 hidden="@(_activeTab != "General")">

                @* ── Trading ─────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Trading</legend>
                    @* The paper/live toggle only makes sense where real-money trading exists
                       (desktop / local). In the hosted + demo builds trading is paper-only, so
                       there is nothing to toggle — hide it (paper mode is forced on elsewhere). *@
                    @if (Demo.AllowLiveTrading)
                    {
                        <div class="modal-row">
                            <label for="s-paper-trading">Paper trading</label>
                            <input id="s-paper-trading" type="checkbox"
                                   aria-describedby="s-paper-trading-hint"
                                   checked="@_paperTradingMode"
                                   @onchange="e => _paperTradingMode = e.Value is bool b ? b : _paperTradingMode" />
                        </div>
                        <p id="s-paper-trading-hint" style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">Orders are simulated against live prices. Nothing reaches a broker and no money moves.</p>

                    }
                    @* Two established, genuinely different ways to size a trade. The terminal
                       supported only one of them while calling it "percent", which is ambiguous
                       between them — and a maintainer armed "0.5%" expecting a $500 position and got
                       a $45,700 one. Both are correct; only one is what you meant. *@
                    <div class="modal-row">
                        <label for="s-quick-sizing">Quick trade: the risk percentage means</label>
                        <select id="s-quick-sizing" aria-describedby="s-quick-sizing-hint"
                                @onchange="OnQuickSizingChanged">
                            <option value="0" selected="@(_quickSizingMode == 0)">The position's value</option>
                            <option value="1" selected="@(_quickSizingMode == 1)">What I lose if the stop is hit</option>
                        </select>
                    </div>
                    <p id="s-quick-sizing-hint" style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">
                        @if (_quickSizingMode == 0)
                        {
                            <text><strong>Position value.</strong> 0.5% of a $100,000 account buys $500 worth, whatever the stop is —
                            the way an exchange order ticket works. Your stop then decides what you stand to lose: 1% away risks $5,
                            20% away risks $100.</text>
                        }
                        else
                        {
                            <text><strong>Risk at the stop.</strong> 0.5% of a $100,000 account means you lose $500 if the stop is hit,
                            so the position grows as the stop tightens — a stop $700 below a $64,000 entry buys 0.714 BTC, a $45,700
                            position. This is what the "1% rule" of risk management refers to, and it makes every trade's downside
                            identical. It can ask for more than a cash account holds.</text>
                        }
                    </p>

                    @* Two-step reset, in place. WCAG 3.3.4 Error Prevention: this destroys the
                       cash balance, every open position, every working order and the whole trade
                       history in one click, with no undo — and it used to do it on the FIRST
                       click, with the button sitting a Tab away from ordinary checkboxes on the
                       busiest tab in the app. A paper account is where a strategy is proved
                       before real money touches it; losing weeks of it to a mis-hit key is not
                       a small thing to a user who cannot see which button their focus is on.

                       In place rather than a nested dialog, and for the reason ApiKeysModal
                       records for the identical pattern: the Settings dialog puts the rest of
                       the document under `inert`, and a second modal on top of it is a stack
                       that Escape, the Tab trap and the MAUI canvas hide would all have to
                       learn. The confirmation is also NOT staged for Save — this is an action,
                       not a preference, and a reset that waited for Save would be a fourth
                       commit idiom in a dialog that just got down to one. *@
                    <div class="modal-row">
                        <span style="flex:1;">Paper account</span>
                        @if (_pendingPaperReset)
                        {
                            <button id="s-paper-reset-confirm" type="button"
                                    style="color:#c00; font-weight:700;"
                                    aria-label="Confirm reset. Erases the paper balance, all open positions and the whole trade history immediately. This cannot be undone."
                                    title="Permanently reset the paper account"
                                    @onclick="ConfirmPaperReset">Confirm reset</button>
                            <button id="s-paper-reset-cancel" type="button"
                                    aria-label="Cancel, keep the paper account as it is"
                                    title="Keep the paper account"
                                    @onclick="CancelPaperReset">Cancel</button>
                        }
                        else
                        {
                            <button id="s-paper-reset" type="button"
                                    aria-label="Reset paper account. Asks for confirmation first."
                                    @onclick="ArmPaperReset">Reset paper account</button>
                        }
                    </div>
                    <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">
                        Erases the balance, every open position and working order, and the whole
                        trade history, returning the account to @Paper.StartingBalance.ToString("N0").
                        There is no undo. You are asked to confirm before anything is erased.
                    </p>
                </fieldset>

                @* ── Workspace ────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Workspace</legend>
                    <div class="modal-row">
                        <label for="s-resume-session">Resume last session at startup</label>
                        <input id="s-resume-session" type="checkbox"
                               checked="@_resumeSession"
                               @onchange="OnResumeSessionChanged" />
                    </div>
                    <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">Autosaves every 30 seconds and when you close the app, then reopens the same charts, tabs and indicators.</p>

                </fieldset>

                @* ── Factory reset (Cody, 2026-09-04) ──────────────────────────
                   Same two-step shape as the paper reset above and for the same WCAG 3.3.4
                   reason, with one addition: the confirmation names what SURVIVES as well as
                   what goes. "All personalization will be lost" is the sentence a user is
                   most likely to read as "including my API keys", and being wrong about that
                   in the frightening direction stops people using a button they need.

                   Not staged for Save, like the paper reset and for the same reason: this is
                   an action, not a preference. It also CLOSES the dialog, because every
                   control in it is now showing a value that no longer exists. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Factory reset</legend>
                    <div class="modal-row">
                        <span style="flex:1;">All terminal settings</span>
                        @if (_pendingFactoryReset)
                        {
                            <button id="s-factory-reset-confirm" type="button"
                                    style="color:#c00; font-weight:700;"
                                    aria-label="@($"Confirm factory reset. Erases {ResetErasedText} immediately. This cannot be undone. Your API keys, your paper account and your saved workspaces are kept.")"
                                    title="Reset every setting to factory defaults"
                                    @onclick="ConfirmFactoryReset">Confirm reset</button>
                            <button id="s-factory-reset-cancel" type="button"
                                    aria-label="Cancel, keep my settings as they are"
                                    title="Keep my settings"
                                    @onclick="CancelFactoryReset">Cancel</button>
                        }
                        else
                        {
                            @* WCAG 2.5.3 Label in Name: the announced name must CONTAIN the visible
                               text, so the extra words go AFTER it — "all terminal settings" broke
                               containment on the word "terminal". *@
                            <button id="s-factory-reset" type="button"
                                    aria-label="Reset all settings to defaults. Every preference, rebinding, theme and sound goes back to how the terminal shipped. Asks for confirmation first."
                                    @onclick="ArmFactoryReset">Reset all settings to defaults</button>
                        }
                    </div>
                    <p style="margin:-8px 0 4px; color:var(--text-muted); font-size:0.9em;">
                        <strong>Warning:</strong> all personalization and settings will be lost and
                        the terminal will be reset to factory defaults. This erases
                        @ResetErasedText. There is no undo.
                    </p>
                    <p style="margin:0 0 12px; color:var(--text-muted); font-size:0.9em;">
                        Kept: @ResetSurvivesText. Restart the terminal afterwards so every part of
                        it re-reads the defaults.
                    </p>
                </fieldset>

                @if (Demo.AllowBackgroundMonitoring)
                {
                    @* ── Background monitoring (multi-workspace) ─────────────── *@
                    <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                        <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Background monitoring</legend>
                        <div class="modal-row">
                            <label for="s-bg-monitor">Keep watching other tabs</label>
                            <input id="s-bg-monitor" type="checkbox"
                                   checked="@_bgMonitoring"
                                   @onchange="OnBgMonitoringChanged" />
                        </div>
                        <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">Alerts and strategies keep evaluating on tabs you are not looking at.</p>

                        <div class="modal-row">
                            <label for="s-bg-poll">Check every</label>
                            <input id="s-bg-poll" type="number" min="10" max="600" step="5"
                                   value="@_bgPollSeconds"
                                   @onchange="OnBgPollChanged" />
                            <span style="color:var(--text-muted);">seconds</span>
                        </div>
                        <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">How often the tabs you are not looking at are re-checked. Minimum 10 seconds.</p>

                        <div class="modal-row">
                            <label for="s-bg-live-tabs">Live-stream other tabs</label>
                            <input id="s-bg-live-tabs" type="checkbox"
                                   checked="@_liveBgTabs"
                                   @onchange="OnLiveBgTabsChanged" />
                        </div>
                        <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">
                            Keeps other tabs tick-fresh so switching to one is instant. Only on
                            exchanges that support it, and only the first
                            @AccessibleTrader.Core.Services.Feeds.BackgroundTabFeedService.MaxLiveBackgroundFeeds tabs.
                        </p>
                        <div class="modal-row">
                            <span style="flex:1; font-size:0.85rem; color:var(--text-muted);">
                                Speaks which workspaces are watched and how fresh each is
                                (also on Ctrl+Alt+Shift+M).
                            </span>
                            <button type="button" @onclick="() => Monitoring.AnnounceStatus()"
                                    aria-label="Speak status of background monitoring">Speak status</button>
                        </div>

                        @* Local-only (the server outlives the browser here; on the hosted
                           terminal the server has no speakers that reach the user). *@
                        @if (Platform.IsBrowserHost && !Demo.IsDemo && !Demo.IsHosted)
                        {
                            <div class="modal-row">
                                <label for="s-bg-local">Keep monitoring when the browser is closed</label>
                                <input id="s-bg-local" type="checkbox"
                                       checked="@_bgLocalMonitor"
                                       @onchange="e => _bgLocalMonitor = e.Value is bool b && b" />
                            </div>
                            <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                                Alerts that name a symbol and provider keep evaluating on this
                                machine with no browser open — spoken through your screen reader, shown as a
                                desktop notification, with a sound (replace it at
                                sounds/alert.wav in the app data folder). Checks once a minute;
                                pauses whenever a browser session is connected. Advanced
                                condition-tree alerts stay session-only.
                            </p>
                        }
                        <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                            Each background tab keeps its own symbol's alerts and strategies live and
                            announces them by name — earcons and speech only. The chart you are viewing
                            keeps full sonification, playback, and navigation audio to itself. Every
                            data check runs inside each provider's own rate limit, so open as many
                            tabs as you like; slower refresh, never refusal.
                        </p>
                    </fieldset>
                }

                @* ── Touch navigation bar ────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Touch navigation bar</legend>
                    <div class="modal-row">
                        <label for="s-touch-nav">Touch toolbar</label>
                        <select id="s-touch-nav"
                                value="@_touchNavMode"
                                @onchange="OnTouchNavModeChanged"
                                aria-label="Touch toolbar visibility">
                            <option value="auto">Automatic (touch-screen devices only)</option>
                            <option value="show">Always show</option>
                            <option value="hide">Never show</option>
                        </select>
                    <p style="margin:2px 0 12px; color:var(--text-muted); font-size:0.9em;">A row of large buttons under the chart for navigating by touch.</p>
                    </div>
                    <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        Automatic detection can misfire on some desktop input setups — if the
                        touch toolbar appears where it shouldn't, set this to Never.
                    </p>
                </fieldset>

                @* ── Drawing ─────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Analysis</legend>
                    <div class="modal-row">
                        <label for="s-market-structure">
                            Add Market Structure (swing highs and lows) to new charts
                        </label>
                        <input id="s-market-structure" type="checkbox"
                               checked="@_marketStructureDefault"
                               @onchange="OnMarketStructureDefaultChanged" />
                    </div>
                    <p style="color:var(--text-muted); font-size:0.9em; margin:4px 0 0 0;">
                        Off by default, so a new chart is just candles, volume and price. Affects
                        charts loaded from now on; charts already open are untouched, and you can
                        always add or remove the indicator per chart.
                    </p>

                    @* The two pattern switches live TOGETHER, and here rather than on Speech or
                       Narration, because neither of those tabs is where a user looks for them:
                       each one changes what is said on the arrow keys AND on a bar close AND
                       during playback, so filing either by trigger puts it on a tab whose rule it
                       breaks. Under Analysis they read as what they are — which analysis the
                       terminal performs — and they sit next to each other, which is the thing
                       that makes the distinction between them legible (Cody, 2026-09-04).

                       They are DIFFERENT ANALYSES, not one setting split in two. A candle pattern
                       is one to three bars: engulfing, harami, doji, hammer. A chart formation is
                       tens of bars: double top, head and shoulders, triangle, flag. Until this
                       pass only the second had a switch, while the first was unconditional — and
                       the Narration tab's help text promised it in a sentence nothing could make
                       true or false. *@
                    <div class="modal-row">
                        <label for="s-candle-patterns">Describe candle patterns</label>
                        <input id="s-candle-patterns" type="checkbox"
                               aria-describedby="s-candle-patterns-hint"
                               checked="@Store.State.DescribeCandlePatterns"
                               @onchange="e => _describeCandlePatterns = e.Value is bool b ? b : Store.State.DescribeCandlePatterns" />
                    </div>
                    <p id="s-candle-patterns-hint" style="color:var(--text-muted); font-size:0.9em; margin:4px 0 0 0;">
                        On by default. One- to three-bar shapes — engulfing, harami, doji, hammer,
                        morning star, three white soldiers — named on the bar that closes, on the
                        live bar as it forms, and on every bar you arrow onto. Off removes the
                        pattern clause from the new-bar announcement, silences the forming one, and
                        leaves the arrow keys reading "Bullish" or "Bearish" and the prices. The
                        detail key (Alt+Shift+D) always names the pattern: it is you asking.
                    </p>

                    <div class="modal-row">
                        <label for="s-chart-patterns">Describe chart patterns</label>
                        <input id="s-chart-patterns" type="checkbox"
                               aria-describedby="s-chart-patterns-hint"
                               checked="@Store.State.DescribeChartPatterns"
                               @onchange="e => _describeChartPatterns = e.Value is bool b ? b : Store.State.DescribeChartPatterns" />
                    </div>
                    <p id="s-chart-patterns-hint" style="color:var(--text-muted); font-size:0.9em; margin:4px 0 0 0;">
                        Off by default — it adds narration to the arrow keys, which you press
                        constantly, so it is opted into rather than imposed. Multi-bar formations:
                        double top, head and shoulders, triangle, flag. Ones still forming are read
                        with the level that would confirm them; completed ones close the loop.
                        Nothing is ever called bullish or bearish.
                    </p>
                </fieldset>

                @* ── Drawing ─────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Drawing</legend>
                    <div class="modal-row">
                        <label for="s-magnet-snap">Magnet snap</label>
                        <input id="s-magnet-snap" type="checkbox"
                               checked="@_magnetSnap"
                               @onchange="OnMagnetSnapChanged" />
                    </div>
                    <p style="margin:-8px 0 12px; color:var(--text-muted); font-size:0.9em;">Drawing anchors snap to the nearest open, high, low or close instead of landing anywhere.</p>

                </fieldset>

                @* ── Viewport ────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Viewport &amp; Navigation</legend>

                    <div class="modal-row">
                        <label for="s-granularity">Panning step (%)</label>
                        <select id="s-granularity"
                                value="@_panningGranularity"
                                @onchange="e => _panningGranularity = int.TryParse(e.Value?.ToString(), out int gv) ? gv : _panningGranularity">
                            @for (int g = 5; g <= 100; g += 5)
                            {
                                <option value="@g" selected="@(g == _panningGranularity)">@g%</option>
                            }
                        </select>
                        <span style="font-size:0.8rem; color:var(--text-muted);">Shift+[ / Shift+] to adjust</span>
                    </div>
                </fieldset>

                @* ── Data Export ─────────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Data Export</legend>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Export visible chart data (OHLCV + indicators) to CSV</span>
                        <button @onclick="ExportDataAsync" aria-label="Export CSV of the chart data">Export CSV</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_exportStatus))
                    {
                        <p role="status" style="color:#4c8; font-size:0.85rem; margin-top:6px;">@_exportStatus</p>
                    }
                </fieldset>

                @* The visual and audio profile buttons used to sit here, in a "Settings Profiles"
                   box on General that exported settings belonging to two other tabs. They are on
                   those tabs now — visual on Appearance, audio on Sonification — so the control
                   that writes a body of settings out sits with the settings it writes
                   (Cody, 2026-09-04). *@
            </div>

            @* ── Speech tab ────────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-speech"
                 aria-labelledby="tab-speech"
                 hidden="@(_activeTab != "Speech")">

                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Speech</legend>

                    <div class="modal-row">
                        <label for="s-speech-enabled">Speech enabled (F2)</label>
                        <input id="s-speech-enabled" type="checkbox"
                               checked="@_speechEnabled"
                               @onchange="e => _speechEnabled = e.Value is bool b ? b : _speechEnabled" />
                    </div>

                    <div class="modal-row">
                        <label for="s-speak-timestamps">Speak timestamps</label>
                        <input id="s-speak-timestamps" type="checkbox"
                               checked="@Store.State.SpeakTimestamps"
                               @onchange="e => _speakTimestamps = e.Value is bool b ? b : Store.State.SpeakTimestamps" />
                    </div>

                    <div class="modal-row">
                        <label for="s-timestamp-where">Speak the time</label>
                        <select id="s-timestamp-where" value="@_timestampWhere"
                                @onchange="OnTimestampWhereChanged">
                            <option value="Always">On every reading</option>
                            <option value="Along X Axis">Only when moving through time</option>
                            <option value="Along Y Axis">Only when moving between series</option>
                            <option value="None">Never</option>
                        </select>
                    </div>
                    <p style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        The timestamp is the longest part of a spoken bar. Limiting it to sideways
                        movement keeps left/right scanning quick without losing the date.
                    </p>

                    <div class="modal-row">
                        <label for="s-date-every-bar">Speak the date on every bar</label>
                        <input id="s-date-every-bar" type="checkbox"
                               checked="@Store.State.SpeakDateOnEveryBar"
                               @onchange="e => _dateEveryBar = e.Value is bool b ? b : Store.State.SpeakDateOnEveryBar" />
                    </div>
                    <p style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        Off, an intraday bar reads its time alone and the date is spoken only when
                        you cross into a new day &mdash; "14:00", "15:00", then "September 6,
                        00:00". On a daily chart or coarser the date is the timestamp either way.
                    </p>

                    <div class="modal-row">
                        <label for="s-speech-order">Speak values as</label>
                        <select id="s-speech-order" value="@_speechOrder"
                                @onchange="OnSpeechOrderChanged">
                            <option value="HeaderValue">Name then value — "Close, 64,900"</option>
                            <option value="ValueOnly">Value only — "64,900"</option>
                            <option value="HeaderValueTimeOnly">Name and value, time only</option>
                            <option value="HeaderValueDateOnly">Name and value, date only</option>
                        </select>
                    </div>

                    <div class="modal-row">
                        <label for="s-read-headers">Read column headers</label>
                        <input id="s-read-headers" type="checkbox"
                               checked="@Store.State.ReadColumnHeaders"
                               @onchange="e => _readHeaders = e.Value is bool b ? b : Store.State.ReadColumnHeaders" />
                    </div>

                    @if (_speechOutput is { IsBrowserTtsBackend: true })
                    {
                        <div class="modal-row">
                            <label for="s-speech-output">Speech output on this device</label>
                            <select id="s-speech-output" value="@_speechOutputMode"
                                    @onchange="OnSpeechOutputChanged">
                                <option value="sr">My screen reader does the talking</option>
                                <option value="tts">Browser voice reads everything</option>
                                <option value="both">Both together</option>
                            </select>
                        </div>
                        <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                            Remembered per browser, not per account — a screen reader can't be
                            detected, so tell the terminal which voice should talk here.
                        </p>
                    }

                    <div class="modal-row">
                        <label for="s-mute-includes-orders">Event mute includes order outcomes</label>
                        <input id="s-mute-includes-orders" type="checkbox"
                               aria-describedby="s-mute-orders-hint"
                               checked="@_muteIncludesOrderEvents"
                               @onchange="e => _muteIncludesOrderEvents = e.Value is bool b ? b : _muteIncludesOrderEvents" />
                    </div>
                    <p id="s-mute-orders-hint" style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        When Shift+F2 or Shift+F3 has events muted, fills, stop hits and
                        take-profits are silenced as well. Off by default so your stops still speak.
                    </p>
                </fieldset>

            </div>

            @* ── Narration tab ─────────────────────────────────────────────── *@
            @* The rule that makes this tab coherent is the TRIGGER, not the topic. The Speech
               tab governs how the terminal says what you ASKED for — values order, timestamps,
               column headers, which voice talks. This tab governs what it says when you pressed
               NOTHING: a bar closed, playback stepped onto a bar.

               The two pattern switches are on GENERAL, under Analysis, and were on Speech until
               2026-09-04. The trigger rule cannot place them: each changes what is said on the
               arrow keys AND on a bar close AND during playback, so either tab it lands on is a
               tab whose rule it breaks. They are filed by what they are — an analysis the
               terminal either performs or does not — and they are filed TOGETHER, which is what
               makes the difference between a candle pattern and a chart formation legible. Both
               carry this tab's vocabulary in their search keywords.

               Both switches here default ON, which is the opposite of the opt-in rule the
               visual-accessibility and pattern-description settings follow, and the reason is
               that neither of them lets anything new through on its own: signals come only from
               series the user flagged with Ctrl+Alt+Shift+N, and the playback switch's ON state
               is exactly what shipped in 2.5.0. What is new is the ability to turn either OFF. *@
            <div role="tabpanel" id="tabpanel-narration"
                 aria-labelledby="tab-narration"
                 hidden="@(_activeTab != "Narration")">

                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Narration</legend>

                    <p style="margin:0 0 12px; color:var(--text-muted); font-size:0.9em;">
                        What the terminal says on its own, without you pressing anything.
                    </p>

                    <div class="modal-row">
                        <label for="s-announce-bars">Announce new bars</label>
                        <input id="s-announce-bars" type="checkbox"
                               aria-describedby="s-announce-bars-hint"
                               checked="@Store.State.AnnounceNewBars"
                               @onchange="e => _announceBars = e.Value is bool b ? b : Store.State.AnnounceNewBars" />
                    </div>
                    <p id="s-announce-bars-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        The closing price of each bar as it finishes. Its candle pattern comes
                        with it while "Describe candle patterns" is on, and any chart formation
                        that resolves on that bar while "Describe chart patterns" is on — both on
                        the General tab.
                    </p>

                    <div class="modal-row">
                        <label for="s-narrate-signals">Narrate signals on bar close</label>
                        <input id="s-narrate-signals" type="checkbox"
                               aria-describedby="s-narrate-signals-hint"
                               checked="@Store.State.NarrateSignalsOnBarClose"
                               @onchange="e => _narrateSignals = e.Value is bool b ? b : Store.State.NarrateSignalsOnBarClose" />
                    </div>
                    <p id="s-narrate-signals-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        N on a series (or Control Alt Shift N from anywhere) chooses which speak,
                        and N on a component narrows it to the components you picked; this switch
                        is the master for all of them. Off means no indicator narrates on a bar
                        close, whatever is flagged.
                    </p>

                    <div class="modal-row">
                        <label for="s-narrate-playback">Narrate during playback</label>
                        <input id="s-narrate-playback" type="checkbox"
                               aria-describedby="s-narrate-playback-hint"
                               checked="@Store.State.NarrateDuringPlayback"
                               @onchange="e => _narratePlayback = e.Value is bool b ? b : Store.State.NarrateDuringPlayback" />
                    </div>
                    <p id="s-narrate-playback-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        The master switch for everything playback says beyond its own start,
                        pause, speed and finish confirmations. Off leaves playback as tones.
                    </p>

                    @* Split out of the switch above on Cody's ask (2026-09-04). The landmark and
                       the signals answer different questions — WHERE IN TIME the tones are, versus
                       WHAT the indicators printed — and wanting the second is not wanting the
                       first read to you every few seconds for the length of a run. Subordinate:
                       with "Narrate during playback" off, nothing here speaks either. *@
                    <div class="modal-row">
                        <label for="s-playback-landmarks">Speak time landmarks during playback</label>
                        <input id="s-playback-landmarks" type="checkbox"
                               aria-describedby="s-playback-landmarks-hint"
                               checked="@Store.State.SpeakPlaybackLandmarks"
                               @onchange="e => _playbackLandmarks = e.Value is bool b ? b : Store.State.SpeakPlaybackLandmarks" />
                    </div>
                    <p id="s-playback-landmarks-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        On by default. The date or hour spoken as playback crosses a boundary —
                        "June 3", "14:00" — which is the only thing that says where in time the
                        tones are. Off keeps the signals and the chart-formation outcomes and
                        stops the calendar. Needs "Narrate during playback" on.
                    </p>
                </fieldset>

            </div>

            @* ── Sonification tab ──────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-sonification"
                 aria-labelledby="tab-sonification"
                 hidden="@(_activeTab != "Sonification")">

                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Sonification</legend>

                    <div class="modal-row">
                        <label for="s-sonif-enabled">Sonification enabled (F3)</label>
                        <input id="s-sonif-enabled" type="checkbox"
                               checked="@_sonificationEnabled"
                               @onchange="e => _sonificationEnabled = e.Value is bool b ? b : _sonificationEnabled" />
                    </div>

                    <div class="modal-row">
                        <label for="s-hover-sonif">Sound under the mouse</label>
                        <input id="s-hover-sonif" type="checkbox"
                               checked="@_hoverSonification"
                               @onchange="OnHoverSonificationChanged" />
                    </div>

                    <div class="modal-row">
                        <label for="s-sound-theme">Sound theme</label>
                        <select id="s-sound-theme"
                                value="@_soundTheme"
                                @onchange="OnSoundThemeChanged"
                                aria-label="Sound theme: which instrument family each indicator uses">
                            @foreach (var t in Core.Services.Audio.SoundThemes.All)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                    </div>
                    <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        One instrument per indicator family, so the RSI, the MACD and the price
                        line are told apart by timbre. Applies to indicators you add from now on.
                    </p>
                </fieldset>

                @* ── The two earcon families (Cody, 2026-09-04) ────────────────────
                   Shift+F3 stays the master mute over both. These decide which family it
                   is muting when it is off. Split by WHAT THE SOUND IS ABOUT, because
                   that is what the appetites differ over: the boundary tone fires on
                   every further arrow press at the edge of a chart, the setup bell fires
                   twice a session, and until now one switch governed both. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Earcons</legend>
                    <p style="margin:0 0 12px; color:var(--text-muted); font-size:0.9em;">
                        Short tones that stand in for a sentence. Shift+F3 mutes all of them at
                        once; these two choose what that mute is switching off. Error tones and
                        order outcomes are never silenced by either.
                    </p>

                    <div class="modal-row">
                        <label for="s-earcons-chart">Market earcons</label>
                        <input id="s-earcons-chart" type="checkbox"
                               aria-describedby="s-earcons-chart-hint"
                               checked="@_chartEarcons"
                               @onchange="e => _chartEarcons = e.Value is bool b ? b : _chartEarcons" />
                    </div>
                    <p id="s-earcons-chart-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        Sounds about the market: an alert firing, a new bar opening, a strategy
                        setup arming or reaching its entry.
                    </p>

                    <div class="modal-row">
                        <label for="s-earcons-interface">Interface earcons</label>
                        <input id="s-earcons-interface" type="checkbox"
                               aria-describedby="s-earcons-interface-hint"
                               checked="@_interfaceEarcons"
                               @onchange="e => _interfaceEarcons = e.Value is bool b ? b : _interfaceEarcons" />
                    </div>
                    <p id="s-earcons-interface-hint" style="margin:-6px 0 10px; color:var(--text-muted); font-size:0.9em;">
                        Sounds about the terminal: the edge of the chart or of a series, a mode
                        toggled with F2 or F3, an action that succeeded or is being retried, the
                        connection changing state. Every one of these is also spoken, so turning
                        them off loses no information.
                    </p>
                </fieldset>

                @* Moved off General on 2026-09-04: a button that writes out this tab's settings
                   belongs on this tab. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Audio profile</legend>
                    <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:10px;">
                        Everything sonification uses as one file — waveforms, volumes and
                        frequencies — to keep, or to hand to someone else. Import replaces what
                        you have.
                    </p>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Waveforms, volumes and frequencies</span>
                        <button id="s-audio-profile-export" @onclick="ExportAudioProfileAsync"
                                aria-label="Export audio profile to file">Export Audio</button>
                        <button id="s-audio-profile-import" @onclick="ImportAudioProfileAsync"
                                aria-label="Import audio profile from file">Import Audio</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_profileStatus))
                    {
                        <p role="status" style="color:#4c8; font-size:0.85rem; margin-top:6px;">@_profileStatus</p>
                    }
                </fieldset>

            </div>

            @* ── Braille tab ───────────────────────────────────────────────────
               Desktop only. The panel and the tab are gated on the same condition, so on the
               browser host there is no tab to reach and no panel behind it. Shift+F4 opens the
               dialog here directly. *@
            @if (!Platform.IsBrowserHost)
            {
            <div role="tabpanel" id="tabpanel-braille"
                 aria-labelledby="tab-braille"
                 hidden="@(_activeTab != "Braille")">

                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Braille / Tactile Display</legend>
                    <div class="modal-row">
                        <label for="s-braille-enabled">Braille display</label>
                        <input id="s-braille-enabled" type="checkbox"
                               checked="@_brailleEnabled"
                               @onchange="e => _brailleEnabled = e.Value is bool b ? b : _brailleEnabled" />
                    </div>
                    <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        When on, the app looks for a supported tactile display at startup and while
                        running, and announces it as it connects or disconnects. All Dot Pad models
                        are supported (the Dot Pad X and the second generation). Turning it off skips
                        device detection entirely. Tactile graphics require Windows and a connected
                        display.
                    </p>
                </fieldset>

                @* One device is supported, so there is nothing to choose between and no picker.
                   Said out loud rather than left as an absence: a tab with a single checkbox
                   invites the question "where is the rest of it", and the honest answer is that
                   the rest of it does not exist yet. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Device</legend>
                    <p style="margin:0; color:var(--text-muted); font-size:0.9em;">
                        The Dot Pad is the only supported display, and it is detected automatically
                        while the switch above is on — F4 turns tactile output on and off from
                        anywhere, and Shift+F4 brings you back to this tab. A device picker will
                        appear here when there is a second device to pick.
                    </p>
                </fieldset>
            </div>
            }

            @* ── Appearance tab ────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-appearance"
                 aria-labelledby="tab-appearance"
                 hidden="@(_activeTab != "Appearance")">

                @* ── Theme ───────────────────────────────────────────────────────
                   ONE panel, called Theme (Cody's call, 2026-09-03). The chart background,
                   its gradient, the window fade and the up/down candle pair used to sit here
                   as app-level colours layered over EVERY theme; they are fields of a theme
                   now, edited in the theme editor, and the app-level keys are retired
                   (ThemeService.WithAccessibilityOverrides). Three verbs: New starts a raw
                   theme from a safe scheme, Clone copies the selected theme — built-in or
                   custom — into a new renameable one, Edit changes the selected custom theme
                   in place. A built-in cannot be edited in place, so on one the Edit button
                   is GATED, never disabled: the user hears why and is told to Clone. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Theme</legend>

                    <div class="modal-row">
                        <label for="s-theme">Theme</label>
                        <select id="s-theme"
                                value="@_selectedTheme"
                                @onchange="OnThemeChanged">
                            <option value="SteelGray">Steel Gray</option>
                            <option value="Blackout">Blackout — black, white text</option>
                            <option value="Classic">Classic — familiar dark navy (default)</option>
                            <option value="MidnightBlue">Midnight Blue — softer than black</option>
                            <option value="AmberCrt">Amber CRT — amber on near-black</option>
                            <option value="Walnut">Walnut — warm wood and brass</option>
                            <option value="Paper">Paper — light, for daylight and printing</option>
                            <option value="HighContrastDark">High Contrast Dark</option>
                            <option value="HighContrastLight">High Contrast Light</option>
                            <option value="SoftDark">Soft Dark</option>
                            <option value="Solarized">Solarized</option>
                            <option value="Braille">Braille Optimized</option>
                            @if (Themes.All.Count > 0)
                            {
                                <optgroup label="Your themes">
                                    @foreach (var custom in Themes.All)
                                    {
                                        <option value="custom:@custom.Id">@custom.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="modal-row">
                        <button type="button" id="s-theme-new" @onclick="NewTheme"
                                title="Start a theme from a plain black, green and red scheme">New theme</button>
                        <button type="button" id="s-theme-clone" @onclick="CloneTheme"
                                title="Copy @SelectedThemeName into a theme of your own">Clone theme</button>
                        <GatedButton ElementId="s-theme-edit" OnClick="EditTheme" Gate="EditThemeGate"
                                     title="@($"Change {SelectedThemeName} in place")">Edit theme</GatedButton>
                        @if (SelectedCustomTheme is { } sel)
                        {
                            <button type="button" id="s-theme-delete" @onclick="DeleteTheme"
                                    aria-label="Delete theme @sel.Name">Delete theme</button>
                        }
                    </div>
                    <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        A theme colours the whole window — toolbars, chart and dialogs — and
                        every colour in it can be changed in the editor.
                    </p>
                </fieldset>

                @* Visual accessibility (Phase D). ALL OFF BY DEFAULT: the terminal
                   presents audio-first; these are opt-in visual accommodations.
                   Changes apply and persist immediately, like the theme. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Visual accessibility</legend>

                    <div class="modal-row">
                        <label for="s-pattern-visuals">Draw chart formations</label>
                        <input id="s-pattern-visuals" type="checkbox"
                               checked="@_showPatternVisuals"
                               @onchange="OnPatternVisualsChanged"
                               aria-describedby="s-pattern-visuals-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-pattern-visuals-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Shades each detected formation and draws its trigger level, for
                            low-vision users or a sighted viewer — the spoken description already
                            carries all of it.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-visual-earcons">Visual earcons</label>
                        <input id="s-visual-earcons" type="checkbox"
                               checked="@_visualEarcons"
                               @onchange="OnVisualEarconsChanged"
                               aria-describedby="s-visual-earcons-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-visual-earcons-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Shows an on-screen badge for each sound cue, for deaf and
                            hard-of-hearing users.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-colorvision">Color-vision-safe chart colors</label>
                        <input id="s-colorvision" type="checkbox"
                               checked="@_colorVisionSafe"
                               @onchange="OnColorVisionChanged"
                               aria-describedby="s-colorvision-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-colorvision-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Blue for up and orange for down on candles and bars, for
                            deuteranopia or protanopia.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-hollow-candles">Hollow up-candles</label>
                        <input id="s-hollow-candles" type="checkbox"
                               checked="@_hollowUpCandles"
                               @onchange="OnHollowCandlesChanged"
                               aria-describedby="s-hollow-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-hollow-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Rising candles as outlines, falling candles filled, so direction reads
                            by shape alone.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-ui-scale">Text size</label>
                        <select id="s-ui-scale"
                                value="@_uiScale"
                                @onchange="OnUiScaleChanged"
                                aria-describedby="s-ui-scale-hint">
                            <option value="85">85%</option>
                            <option value="100">100% (default)</option>
                            <option value="115">115%</option>
                            <option value="130">130%</option>
                            <option value="150">150%</option>
                            <option value="175">175%</option>
                        </select>
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-ui-scale-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Scales the interface text; browser zoom still works on top.
                        </span>
                    </div>
                </fieldset>

                @* Moved off General on 2026-09-04: a button that writes out this tab's settings
                   belongs on this tab. *@
                <fieldset style="border:1px solid var(--border-color); padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:var(--text-on-surface); padding:0 6px;">Visual profile</legend>
                    <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:10px;">
                        Everything on this tab as one file — theme, colours and line styles — to
                        keep, or to hand to someone else. Import replaces what you have.
                    </p>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Theme, colours and line styles</span>
                        <button id="s-visual-profile-export" @onclick="ExportVisualProfileAsync"
                                aria-label="Export visual profile to file">Export Visual</button>
                        <button id="s-visual-profile-import" @onclick="ImportVisualProfileAsync"
                                aria-label="Import visual profile from file">Import Visual</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_profileStatus))
                    {
                        <p role="status" style="color:#4c8; font-size:0.85rem; margin-top:6px;">@_profileStatus</p>
                    }
                </fieldset>
            </div>

            @* ── Keyboard tab ─────────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-keyboard"
                 aria-labelledby="tab-keyboard"
                 hidden="@(_activeTab != "Keyboard")">

                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:12px;">
                    Click <strong>Rebind</strong> on any row, then press your new key combination.
                    Escape cancels. Rebindings are saved immediately.
                </p>

                @if (_capturingCommand != null)
                {
                    <div role="status" aria-live="assertive"
                         style="background:#1a3a5c; color:#fff; padding:10px 16px; border-radius:4px; margin-bottom:12px; font-weight:bold;">
                        Press new key combination for: <em>@_capturingCommandName</em>
                        <button style="margin-left:14px; padding:2px 10px;" @onclick="CancelCapture" aria-label="Cancel key capture">Cancel</button>
