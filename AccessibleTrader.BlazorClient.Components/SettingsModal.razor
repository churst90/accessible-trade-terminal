    private string _searchQuery = string.Empty;
    private List<SettingEntry> _searchResults = new();

    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        var q = _searchQuery.Trim();
        _searchResults = string.IsNullOrEmpty(q)
            ? new List<SettingEntry>()
            : _settingRegistry.Where(s => IsRendered(s.ControlId) && (
                    s.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.Keywords.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.Tab.Contains(q, StringComparison.OrdinalIgnoreCase)))
                .ToList();
    }

    /// <summary>
    /// Whether this build renders the control a registry row points at. Seven rows sit under an
    /// <c>@if</c> — paper trading is desktop-only, background monitoring and the braille display
    /// are gated per host, the speech-output picker exists only on a browser-TTS head — and a
    /// result for a control that is not there sends the user to a tab and drops focus on the
    /// body (<c>focusElement</c> gives up silently on a missing id). The conditions are the same
    /// expressions the markup uses; <c>SettingsSearchRegistryTests</c> cannot see an <c>@if</c>,
    /// so <c>SettingsModal_SearchResults_NameOnlyControlsThatRender</c> checks this in the DOM.
    /// </summary>
    private bool IsRendered(string controlId) => controlId switch
    {
        "s-paper-trading"  => Demo.AllowLiveTrading,
        "s-bg-monitor" or "s-bg-poll" or "s-bg-live-tabs" => Demo.AllowBackgroundMonitoring,
        "s-bg-local"       => Demo.AllowBackgroundMonitoring && Platform.IsBrowserHost && !Demo.IsDemo && !Demo.IsHosted,
        "s-braille-enabled" => !Platform.IsBrowserHost,
        "s-speech-output"  => _speechOutput is { IsBrowserTtsBackend: true },
        _ => true,
    };

    private async Task GoToSetting(SettingEntry entry)
    {
        _activeTab = entry.Tab;
        _searchQuery = string.Empty;
        _searchResults.Clear();
        await InvokeAsync(StateHasChanged);
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", entry.ControlId); }
        catch { /* JS bridge may be absent in tests */ }
    }

    // Appearance tab — derived from ThemeService.Current
    // Visual accessibility toggles (Phase D) — all default OFF, applied immediately.
    private bool _visualEarcons;
    private bool _showPatternVisuals;
    private bool _colorVisionSafe;
    private bool _hollowUpCandles;
    private int _uiScale = 100;
    private string _selectedTheme   = Core.Services.ThemeService.DefaultTheme.ToString();

    // Single source of truth is the <Version> property in Directory.Build.props; it flows into the
    // assembly informational version at build time, and Directory.Build.props appends the short
    // commit sha as SemVer build metadata.
    //
    // The "+sha" suffix used to be STRIPPED here, which threw away the only part that identifies
    // the build. Most builds of this project are not releases, they are commits: two people both
    // running "2.2.0" can be hundreds of commits apart, and a bug report carrying just the version
    // cannot be tied to any particular state of the code. The sha is kept and shown.
    private static readonly string AppVersion =
        typeof(SettingsModal).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
         ?? typeof(SettingsModal).Assembly.GetName().Version?.ToString(3)
         ?? "unknown";

    /// <summary>
    /// The version split for speech. A screen reader reading "two point two point zero plus
    /// a-b-c-1-2-3-4-5" as one run is unusable; the build is announced as a separate labelled
    /// field so it can be skipped or read on demand.
    /// </summary>
    private static string AppVersionNumber => AppVersion.Split('+')[0];
    private static string AppBuildId =>
        AppVersion.Contains('+') ? AppVersion.Split('+')[1] : "not recorded";

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenSettingsEvent>(e => InvokeAsync(() => ShowAsync(e.Tab)));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (!_isVisible || e.ModalName != "Settings") return;

            // Escape with the paper reset armed backs out of the QUESTION, not the dialog.
            // Closing would leave the user outside Settings with no word on what happened to
            // the account they were just asked about — and "no" is the answer they were
            // reaching for. One more Escape closes the dialog as usual. Same rule as
            // ApiKeysModal's armed removal.
            if (_pendingPaperReset) InvokeAsync(CancelPaperReset);
            else if (_pendingFactoryReset) InvokeAsync(CancelFactoryReset);
            else InvokeAsync(Cancel);
        });
        ThemeService.ThemeChanged += OnThemeServiceChanged;
        ResetLocal();
        _uniqueBindings = ShortcutService.GetAllBindings()
            .GroupBy(b => b.Description)
            .Select(g => g.First())
            .ToList();
    }

    /// <summary>
    /// The picker follows the service, not the other way round: when the theme editor's "Save
    /// and use" applies a new custom theme underneath this dialog, the dropdown must show it
    /// and Edit must become available on it. Before 2026-09-03 this only refreshed three colour
    /// pickers that no longer exist.
    /// </summary>
    private void OnThemeServiceChanged(object? sender, AccessibleTrader.Sdk.Theming.ChartTheme theme)
    {
        SyncSelectedThemeFromService();
        InvokeAsync(StateHasChanged);
    }

    // A custom theme is stored by id, so the picker has to show that rather than the base it
    // happens to be built on — otherwise reopening Settings silently reverts the selection.
    private void SyncSelectedThemeFromService()
    {
        var activeCustomId = Settings.GetSetting(Core.Services.SettingsKeys.CustomThemeId)?.ToString();
        _selectedTheme = !string.IsNullOrWhiteSpace(activeCustomId) && Themes.GetById(activeCustomId!) != null
            ? $"custom:{activeCustomId}"
            : ThemeService.Current.ThemeType.ToString();
    }

    private void OnThemeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _selectedTheme = e.Value?.ToString() ?? _selectedTheme;

        // "custom:{id}" selects one of the user's own; anything else is a built-in enum name.
        ApplySelectedTheme();
        EventBus.Publish(new RedrawEvent());
    }

    // ── Visual accessibility toggles — LIVE PREVIEW, reverted by Cancel ──
    //
    // These, and the theme picker, are the deliberate exception to this dialog's
    // stage-then-Save rule (Cody, 2026-09-04: "setting immediate apply controls like for theme
    // live preview, sure"). The point of a visual setting is seeing the effect while you decide,
    // and for a low-vision user that preview IS the information the control carries.
    //
    // What changed is the other half of the bargain: Cancel now puts them back. Each still
    // persists as it is applied — their services own the write and there is no apply-without-
    // persist path — so RevertPreviews re-applies and re-persists the values the dialog opened
    // with. The one gap that leaves is a crash with the dialog open, which would keep a preview
    // the user never accepted; that is worth the simplicity of not forking every appearance
    // service into preview and commit modes.

    /// <summary>Applied immediately so the effect is visible while deciding; see the note above.</summary>
    private void OnPatternVisualsChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _showPatternVisuals = e.Value is bool b && b;
        App.ShowChartPatternVisuals = _showPatternVisuals;
        App.Save();
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _showPatternVisuals
                ? "Chart formations will be drawn on the chart."
                : "Chart formation drawing off.", true));
        EventBus.Publish(new RedrawEvent());
    }

    private void OnVisualEarconsChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _visualEarcons = e.Value is bool b && b;
        App.VisualEarcons = _visualEarcons;
        App.Save();
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _visualEarcons ? "Visual earcons on." : "Visual earcons off.", true));
    }

    private void OnColorVisionChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _colorVisionSafe = e.Value is bool b && b;
        App.ColorVisionSafe = _colorVisionSafe;
        App.Save();
        ThemeService.RefreshAccessibilityOverrides();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _colorVisionSafe ? "Color-vision-safe colors on: up is blue, down is orange."
                             : "Color-vision-safe colors off.", true));
    }

    private async Task OnUiScaleChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int scale)) return;
        _uiScale = Math.Clamp(scale, 50, 250);
        App.UiScale = _uiScale;
        App.Save();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.setUiScale", _uiScale); }
        catch { /* JS bridge may be absent in tests */ }
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Text size {_uiScale} percent.", true));
    }

    private void OnHollowCandlesChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _hollowUpCandles = e.Value is bool b && b;
        App.HollowUpCandles = _hollowUpCandles;
        App.Save();
        ThemeService.RefreshAccessibilityOverrides();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _hollowUpCandles ? "Hollow up-candles on." : "Hollow up-candles off.", true));
    }

    private bool _paperTradingMode;
    private int _quickSizingMode;

    // Staged copies of three controls that used to dispatch straight into the store the moment
    // they changed — so "Speech enabled" in this dialog behaved differently from every checkbox
    // beside it, and Escape could not take any of them back.
    private bool _speechEnabled;
    private bool _sonificationEnabled;
    private int  _panningGranularity = 10;

    // What the live-preview controls held when the dialog opened. RevertPreviews puts these
    // back; they are the only reason Cancel can undo an appearance change at all.
    private int    _uiScaleInitial;
    private bool   _showPatternVisualsInitial;
    private bool   _visualEarconsInitial;
