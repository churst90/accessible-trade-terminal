@code {
    /// <summary>
    /// Null when this row's shortcut can be rebound; otherwise why it cannot. One capture
    /// runs at a time — the row already capturing stays live so the user can see it through.
    /// </summary>
    private string? RebindGate(bool isCapturing) =>
        _capturingCommand != null && !isCapturing
            ? "Another shortcut is waiting for a key. Press it, or press Escape to cancel."
            : null;

    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private string _activeTab = "General";

    // Single source of truth for the tab row: the markup renders from it and the arrow-key
    // handler indexes into it. Two lists would drift, and a drifted list here means an
    // arrow key that lands on a tab that is not there.
    private static readonly string[] AllSettingsTabs =
        { "General", "Speech", "Narration", "Sonification", "Braille", "Appearance", "Keyboard", "License", "About" };

    /// <summary>
    /// Braille sits with the other output channels — Speech, Narration, Sonification, Braille —
    /// because that is what it is, and it is absent on the browser host for the same reason its
    /// controls were: a Dot Pad connects to the machine RUNNING the app, never to the viewer's
    /// browser, so on the web head the tab could only ever be an empty room. Absent rather than
    /// disabled: a disabled control is something a screen-reader user has to walk past to learn
    /// is useless.
    /// </summary>
    private string[] SettingsTabs => Platform.IsBrowserHost
        ? AllSettingsTabs.Where(t => t != "Braille").ToArray()
        : AllSettingsTabs;

    private static string TabElementId(string tab) => "tab-" + tab.ToLowerInvariant();

    /// <summary>
    /// Arrow / Home / End across the settings tabs, completing the roving-tabindex
    /// contract the markup declares. Selection follows focus, per WAI-ARIA: the arrow
    /// both switches the tab and moves focus onto it, so a screen reader announces the
    /// tab the user has actually arrived at.
    /// </summary>
    private async Task OnTabListKeyDown(KeyboardEventArgs e)
    {
        int current = Array.IndexOf(SettingsTabs, _activeTab);
        int? target = TablistNavigator.Target(e.Key, current, SettingsTabs.Length);
        if (target == null) return;   // not a tablist key — leave Tab/Escape alone

        _activeTab = SettingsTabs[target.Value];
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", TabElementId(_activeTab)); }
        catch { /* best-effort, as everywhere else — the tab is selected regardless */ }
    }

    // Local copies for pending changes — written by Save, dropped by Cancel
    private bool _speakTimestamps;
    private bool _dateEveryBar;
    private bool _readHeaders;
    private bool _announceBars;
    private bool _describeChartPatterns;
    private bool _describeCandlePatterns;
    private bool _narrateSignals;
    private bool _narratePlayback;
    private bool _playbackLandmarks;

    // ── Settings search (Phase D second pass) ────────────────────────────────
    private sealed record SettingEntry(string Label, string Tab, string ControlId, string Keywords);

    // One registry row per user-facing setting: label + owning tab + control id
    // (focused after the jump) + extra match keywords.
    private static readonly List<SettingEntry> _settingRegistry = new()
    {
        new("Paper trading", "General", "s-paper-trading", "simulated practice demo"),
        new("Quick trade sizing", "General", "s-quick-sizing", "position size risk percent notional allocation stop"),
        new("Reset paper account", "General", "s-paper-reset", "balance restart"),
