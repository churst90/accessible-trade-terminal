@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Models
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Sdk.Enums
@using AccessibleTrader.Sdk.Alerts
@using AccessibleTrader.Sdk.Analysis
@using Newtonsoft.Json.Linq
@using System.Reflection
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@inject IThemeService ThemeService
@inject IDataExportService DataExporter
@inject IWorkspaceLibraryService WorkspaceLibrary
@inject ISeriesManagementService SeriesManager
@inject IShortcutManager ShortcutService
@inject ISettingsManager Settings
@inject IEnumerable<IAlertChannel> AlertChannels
@inject DemoPolicy Demo
@inject IPaperTradingProvider Paper
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="settings-title"
             style="max-width:660px;"
             @onclick:stopPropagation="true">

            <h2 id="settings-title" tabindex="-1">Settings</h2>

            @* ── Tab list ──────────────────────────────────────────────────── *@
            @* Settings search (Phase D second pass): filters a registry of every
               setting by label/keywords; choosing a result jumps to its tab and
               focuses the control. Cognitive-accessibility item — nobody should
               need to memorise which of six tabs holds a setting. *@
            <div class="modal-row" style="margin-bottom:10px;">
                <label for="s-search">Search settings</label>
                <input id="s-search" type="search"
                       value="@_searchQuery"
                       @oninput="OnSearchInput"
                       placeholder="e.g. speech, theme, alerts"
                       aria-describedby="s-search-count" />
            </div>
            @if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                <div role="region" aria-label="Setting search results"
                     style="border:1px solid #bbb; border-radius:4px; padding:6px 10px; margin-bottom:12px;">
                    <p id="s-search-count" role="status" style="margin:2px 0; font-size:0.85rem; color:var(--text-muted);">
                        @_searchResults.Count matching setting@(_searchResults.Count == 1 ? "" : "s").
                    </p>
                    @foreach (var r in _searchResults)
                    {
                        var captured = r;
                        <button style="display:block; width:100%; text-align:left; padding:5px 8px; background:transparent; border:none; cursor:pointer;"
                                @onclick="() => GoToSetting(captured)">
                            @captured.Label <span style="color:var(--text-muted); font-size:0.8rem;">— @captured.Tab tab</span>
                        </button>
                    }
                </div>
            }

            <div role="tablist" aria-label="Settings categories"
                 style="display:flex; gap:0; border-bottom:2px solid #bbb; margin-bottom:16px;">
                @foreach (var tab in new[] { "General", "Appearance", "Keyboard", "Alerts", "License", "About" })
                {
                    bool active = _activeTab == tab;
                    <button role="tab"
                            aria-selected="@active.ToString().ToLower()"
                            tabindex="@(active ? 0 : -1)"
                            id="tab-@tab.ToLower()"
                            aria-controls="tabpanel-@tab.ToLower()"
                            @onclick="() => _activeTab = tab"
                            style="padding:6px 16px; border:none; border-bottom:@(active ? "3px solid #0078d4" : "3px solid transparent");
                                   background:@(active ? "#e8f0ff" : "transparent");
                                   font-weight:@(active ? "700" : "400");
                                   color:#111; cursor:pointer;">
                        @tab
                    </button>
                }
            </div>

            @* ── General tab ───────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-general"
                 aria-labelledby="tab-general"
                 hidden="@(_activeTab != "General")">

                @* ── Speech ─────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Speech</legend>

                    <div class="modal-row">
                        <label for="s-speech-enabled">Speech enabled (F2)</label>
                        <input id="s-speech-enabled" type="checkbox"
                               checked="@Store.State.IsSpeechEnabled"
                               @onchange="() => Store.Dispatch(new ToggleSpeechAction())" />
                    </div>

                    <div class="modal-row">
                        <label for="s-speak-timestamps">Speak timestamps</label>
                        <input id="s-speak-timestamps" type="checkbox"
                               checked="@Store.State.SpeakTimestamps"
                               @onchange="e => _speakTimestamps = e.Value is bool b ? b : Store.State.SpeakTimestamps" />
                    </div>

                    <div class="modal-row">
                        <label for="s-read-headers">Read column headers</label>
                        <input id="s-read-headers" type="checkbox"
                               checked="@Store.State.ReadColumnHeaders"
                               @onchange="e => _readHeaders = e.Value is bool b ? b : Store.State.ReadColumnHeaders" />
                    </div>

                    <div class="modal-row">
                        <label for="s-announce-bars">Announce new bars</label>
                        <input id="s-announce-bars" type="checkbox"
                               checked="@Store.State.AnnounceNewBars"
                               @onchange="e => _announceBars = e.Value is bool b ? b : Store.State.AnnounceNewBars" />
                    </div>
                    @* The paper/live toggle only makes sense where real-money trading exists
                       (desktop / local). In the hosted + demo builds trading is paper-only, so
                       there is nothing to toggle — hide it (paper mode is forced on elsewhere). *@
                    @if (Demo.AllowLiveTrading)
                    {
                        <div class="modal-row">
                            <label for="s-paper-trading">Paper trading mode (simulated orders)</label>
                            <input id="s-paper-trading" type="checkbox"
                                   checked="@_paperTradingMode"
                                   @onchange="e => _paperTradingMode = e.Value is bool b ? b : _paperTradingMode" />
                        </div>
                    }
                    <div class="modal-row">
                        <label for="s-paper-reset">Paper account</label>
                        <button id="s-paper-reset" type="button" @onclick="ResetPaperAccount">Reset paper account</button>
                    </div>
                </fieldset>

                @* ── Braille / Tactile Display ───────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Braille / Tactile Display</legend>
                    <div class="modal-row">
                        <label for="s-braille-enabled">Enable braille / tactile display output</label>
                        <input id="s-braille-enabled" type="checkbox"
                               checked="@_brailleEnabled"
                               @onchange="e => _brailleEnabled = e.Value is bool b ? b : _brailleEnabled" />
                    </div>
                    <p style="margin:6px 0 0; color:var(--text-muted); font-size:0.9em;">
                        When on, the app looks for a supported tactile display (Dot Pad) at startup
                        and while running, and announces it as it connects or disconnects. Turning it
                        off skips device detection entirely. Tactile graphics require Windows and a
                        connected display.
                    </p>
                </fieldset>

                @* ── Sonification ────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Sonification</legend>

                    <div class="modal-row">
                        <label for="s-sonif-enabled">Sonification enabled (F3)</label>
                        <input id="s-sonif-enabled" type="checkbox"
                               checked="@Store.State.IsSonificationEnabled"
                               @onchange="() => Store.Dispatch(new ToggleSonificationAction())" />
                    </div>

                    <div class="modal-row">
                        <label for="s-wasapi">WASAPI latency (ms)</label>
                        <input id="s-wasapi" type="number" min="50" max="500" step="10"
                               value="@Store.State.WasapiLatency"
                               @onchange="e => _wasapiLatency = int.TryParse(e.Value?.ToString(), out int v) ? v : Store.State.WasapiLatency" />
                    </div>
                </fieldset>

                @* ── Viewport ────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Viewport &amp; Navigation</legend>

                    <div class="modal-row">
                        <label for="s-granularity">Panning step (%)</label>
                        <select id="s-granularity"
                                value="@Store.State.PanningGranularity"
                                @onchange="e => Store.Dispatch(new AdjustGranularityAction(
                                    (int.TryParse(e.Value?.ToString(), out int gv) ? gv : 10) - Store.State.PanningGranularity))">
                            @for (int g = 5; g <= 100; g += 5)
                            {
                                <option value="@g" selected="@(g == Store.State.PanningGranularity)">@g%</option>
                            }
                        </select>
                        <span style="font-size:0.8rem; color:#555;">Shift+[ / Shift+] to adjust</span>
                    </div>
                </fieldset>

                @* ── Keyboard Shortcuts (read-only reference) ────────────────── *@
                <details style="margin-bottom:16px;">
                    <summary style="cursor:pointer; font-weight:700; color:#111; padding:4px 0;">
                        Keyboard Shortcuts Reference
                    </summary>
                    <table class="shortcuts-table" style="margin-top:10px;">
                        <thead><tr><th>Key</th><th>Action</th></tr></thead>
                        <tbody>
                            <tr><td>← →</td><td>Navigate bars</td></tr>
                            <tr><td>↑ ↓</td><td>Switch component</td></tr>
                            <tr><td>Page Up / Page Down</td><td>Switch series</td></tr>
                            <tr><td>Home / End</td><td>Jump to viewport start/end</td></tr>
                            <tr><td>\</td><td>Jump to live bar</td></tr>
                            <tr><td>[ ]</td><td>Pan left / right</td></tr>
                            <tr><td>- =</td><td>Zoom out / in</td></tr>
                            <tr><td>Shift+[ ]</td><td>Decrease / increase pan step</td></tr>
                            <tr><td>Shift+- =</td><td>Decrease / increase playback speed</td></tr>
                            <tr><td>Space</td><td>Play chart</td></tr>
                            <tr><td>Shift+Space</td><td>Play series</td></tr>
                            <tr><td>F1</td><td>Help reference</td></tr>
                            <tr><td>F2</td><td>Toggle speech</td></tr>
                            <tr><td>F3</td><td>Toggle sonification</td></tr>
                            <tr><td>F4</td><td>Context summary</td></tr>
                            <tr><td>F5 / Shift+F5</td><td>Component volume up / down</td></tr>
                            <tr><td>F6 / Shift+F6</td><td>Series volume up / down</td></tr>
                            <tr><td>F7 / Shift+F7</td><td>Chart volume up / down</td></tr>
                            <tr><td>F12</td><td>Settings (this dialog)</td></tr>
                            <tr><td>Shift+F12</td><td>Properties</td></tr>
                            <tr><td>H</td><td>Toggle indicator visibility</td></tr>
                            <tr><td>Alt+H</td><td>Toggle liquidity heatmap</td></tr>
                            <tr><td>M</td><td>Toggle indicator audio</td></tr>
                            <tr><td>Ctrl+Shift+D</td><td>Deep dive detail fact</td></tr>
                        </tbody>
                    </table>
                </details>

                @* ── Data Export ─────────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Data Export</legend>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Export visible chart data (OHLCV + indicators) to CSV</span>
                        <button @onclick="ExportDataAsync" aria-label="Export chart data to CSV">Export CSV</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_exportStatus))
                    {
                        <p role="status" style="color:#4c8; font-size:0.85rem; margin-top:6px;">@_exportStatus</p>
                    }
                </fieldset>

                @* ── Settings Profiles ───────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Settings Profiles</legend>
                    <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">
                        Export/import visual or audio profiles to share your configuration with other users.
                        Visual profiles include theme, colors, and line styles. Audio profiles include waveforms, volumes, and frequencies.
                    </p>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Visual profile (theme + colors)</span>
                        <button @onclick="ExportVisualProfileAsync" aria-label="Export visual profile to file">Export Visual</button>
                        <button @onclick="ImportVisualProfileAsync" aria-label="Import visual profile from file">Import Visual</button>
                    </div>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.9rem;">Audio profile (waveforms + volumes)</span>
                        <button @onclick="ExportAudioProfileAsync" aria-label="Export audio profile to file">Export Audio</button>
                        <button @onclick="ImportAudioProfileAsync" aria-label="Import audio profile from file">Import Audio</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_profileStatus))
                    {
                        <p role="status" style="color:#4c8; font-size:0.85rem; margin-top:6px;">@_profileStatus</p>
                    }
                </fieldset>
            </div>

            @* ── Appearance tab ────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-appearance"
                 aria-labelledby="tab-appearance"
                 hidden="@(_activeTab != "Appearance")">

                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Colors</legend>

                    <div class="modal-row">
                        <label for="s-bg-color">Background color</label>
                        <input id="s-bg-color" type="color"
                               value="@_backgroundColor"
                               @onchange="OnBackgroundColorChanged"
                               aria-label="Chart background color" />
                        <button @onclick="ResetBackgroundColor"
                                aria-label="Reset background color to theme default">
                            Reset to theme default
                        </button>
                    </div>

                </fieldset>

                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Theme</legend>

                    <div class="modal-row">
                        <label for="s-theme">Theme</label>
                        <select id="s-theme"
                                value="@_selectedTheme"
                                @onchange="OnThemeChanged"
                                aria-label="Application theme">
                            <option value="HighContrastDark">High Contrast Dark</option>
                            <option value="HighContrastLight">High Contrast Light</option>
                            <option value="SoftDark">Soft Dark</option>
                            <option value="Solarized">Solarized</option>
                            <option value="Braille">Braille Optimized</option>
                        </select>
                    </div>

                </fieldset>

                @* Visual accessibility (Phase D). ALL OFF BY DEFAULT: the terminal
                   presents audio-first; these are opt-in visual accommodations.
                   Changes apply and persist immediately, like the theme. *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Visual accessibility</legend>

                    <div class="modal-row">
                        <label for="s-visual-earcons">Visual earcons</label>
                        <input id="s-visual-earcons" type="checkbox"
                               checked="@_visualEarcons"
                               @onchange="OnVisualEarconsChanged"
                               aria-describedby="s-visual-earcons-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-visual-earcons-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Mirrors every sound cue (order fills, setups, errors, new bars) as a brief
                            on-screen badge — for deaf and hard-of-hearing users, or noisy environments.
                            One gentle fade per event, never flashing.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-colorvision">Color-vision-safe chart colors</label>
                        <input id="s-colorvision" type="checkbox"
                               checked="@_colorVisionSafe"
                               @onchange="OnColorVisionChanged"
                               aria-describedby="s-colorvision-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-colorvision-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Replaces red/green up-down colors with blue/orange on candles and
                            direction-colored bars — distinguishable with deuteranopia or protanopia.
                            Overrides per-indicator direction colors while on.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-hollow-candles">Hollow up-candles</label>
                        <input id="s-hollow-candles" type="checkbox"
                               checked="@_hollowUpCandles"
                               @onchange="OnHollowCandlesChanged"
                               aria-describedby="s-hollow-hint" />
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-hollow-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Draws rising candles as outlines and falling candles filled, so direction
                            is readable by shape alone — works with any colors.
                        </span>
                    </div>

                    <div class="modal-row">
                        <label for="s-ui-scale">Text size</label>
                        <select id="s-ui-scale"
                                value="@_uiScale"
                                @onchange="OnUiScaleChanged"
                                aria-describedby="s-ui-scale-hint">
                            <option value="85">85%</option>
                            <option value="100">100% (default)</option>
                            <option value="115">115%</option>
                            <option value="130">130%</option>
                            <option value="150">150%</option>
                            <option value="175">175%</option>
                        </select>
                    </div>
                    <div class="modal-row" style="flex-direction:column;align-items:flex-start;gap:4px;">
                        <span id="s-ui-scale-hint" style="font-size:0.85rem;color:var(--text-muted);">
                            Scales the interface text throughout the terminal. Browser zoom still
                            works on top of this.
                        </span>
                    </div>
                </fieldset>
            </div>

            @* ── Keyboard tab ─────────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-keyboard"
                 aria-labelledby="tab-keyboard"
                 hidden="@(_activeTab != "Keyboard")">

                <p style="font-size:0.85rem; color:#555; margin-bottom:12px;">
                    Click <strong>Rebind</strong> on any row, then press your new key combination.
                    Escape cancels. Rebindings are saved immediately.
                </p>

                @if (_capturingCommand != null)
                {
                    <div role="status" aria-live="assertive"
                         style="background:#1a3a5c; color:#fff; padding:10px 16px; border-radius:4px; margin-bottom:12px; font-weight:bold;">
                        Press new key combination for: <em>@_capturingCommandName</em>
                        <button style="margin-left:14px; padding:2px 10px;" @onclick="CancelCapture">Cancel</button>
                    </div>
                }

                <table class="shortcuts-table" style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr>
                            <th style="text-align:left; padding:4px 8px; border-bottom:2px solid #bbb;">Action</th>
                            <th style="text-align:left; padding:4px 8px; border-bottom:2px solid #bbb;">Shortcut</th>
                            <th style="text-align:center; padding:4px 8px; border-bottom:2px solid #bbb; width:70px;">Rebind</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var binding in _uniqueBindings)
                        {
                            bool isCapturing = _capturingCommand?.ToString() == binding.Description;
                            <tr style="border-bottom:1px solid #eee; background:@(isCapturing ? "#1a3a5c" : "transparent");">
                                <td style="padding:4px 8px; font-size:0.85rem; color:@(isCapturing ? "#fff" : "inherit");">@binding.Description</td>
                                <td style="padding:4px 8px; font-size:0.85rem; font-family:monospace; color:@(isCapturing ? "#8cf" : "inherit");">
                                    @(isCapturing ? "▶ waiting..." : binding.DisplayString)
                                </td>
                                <td style="padding:4px 8px; text-align:center;">
                                    <button style="font-size:0.75rem; padding:2px 6px;"
                                            @onclick="() => StartCapture(binding)"
                                            disabled="@(_capturingCommand != null && !isCapturing)"
                                            aria-label="Rebind @binding.Description">
                                        @(isCapturing ? "…" : "Rebind")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ── Alerts tab ─────────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-alerts"
                 aria-labelledby="tab-alerts"
                 hidden="@(_activeTab != "Alerts")">

                <p style="font-size:0.85rem; color:#555; margin-bottom:12px;">
                    Configure external delivery for fired alerts. Each channel activates
                    only when its required fields are filled; unconfigured channels are
                    silently skipped.
                </p>

                @* ── SMTP / Email ─────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Email (SMTP)</legend>

                    <div class="modal-row">
                        <label for="s-email-host">SMTP host</label>
                        <input id="s-email-host" type="text"
                               value="@_emailHost"
                               placeholder="smtp.gmail.com"
                               @onchange="e => _emailHost = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-port">Port</label>
                        <input id="s-email-port" type="number" min="1" max="65535"
                               value="@_emailPort"
                               @onchange="e => _emailPort = int.TryParse(e.Value?.ToString(), out var p) ? p : _emailPort" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-tls">Use TLS</label>
                        <input id="s-email-tls" type="checkbox"
                               checked="@_emailUseTls"
                               @onchange="e => _emailUseTls = e.Value is bool b ? b : _emailUseTls" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-user">Username</label>
                        <input id="s-email-user" type="text"
                               value="@_emailUsername"
                               autocomplete="off"
                               @onchange="e => _emailUsername = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-pass">Password</label>
                        <input id="s-email-pass" type="password"
                               value="@_emailPassword"
                               autocomplete="new-password"
                               @onchange="e => _emailPassword = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-from">From address</label>
                        <input id="s-email-from" type="email"
                               value="@_emailFrom"
                               placeholder="alerts@example.com"
                               @onchange="e => _emailFrom = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <label for="s-email-to">To address</label>
                        <input id="s-email-to" type="email"
                               value="@_emailTo"
                               placeholder="me@example.com"
                               @onchange="e => _emailTo = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.85rem; color:#555;">
                            Sends a sample alert using current values (saved on Close).
                        </span>
                        <button @onclick="TestEmailAsync"
                                aria-label="Send a test email alert">Send test</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_emailStatus))
                    {
                        <p role="status"
                           style="color:@(_emailStatusIsError ? "#c33" : "#4c8"); font-size:0.85rem; margin-top:6px;">
                            @_emailStatus
                        </p>
                    }
                </fieldset>

                @* ── Telegram ─────────────────────────────────────────────────── *@
                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Telegram</legend>

                    <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">
                        Create a bot via <strong>@@BotFather</strong>, send it a message, then paste the bot
                        token and the numeric chat id returned by <code>getUpdates</code>.
                    </p>

                    <div class="modal-row">
                        <label for="s-tg-token">Bot token</label>
                        <input id="s-tg-token" type="password"
                               value="@_tgBotToken"
                               autocomplete="new-password"
                               placeholder="123456:ABC-DEF…"
                               @onchange="e => _tgBotToken = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <label for="s-tg-chat">Chat id</label>
                        <input id="s-tg-chat" type="text"
                               value="@_tgChatId"
                               placeholder="-100123456789"
                               @onchange="e => _tgChatId = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <div class="modal-row">
                        <span style="flex:1; font-size:0.85rem; color:#555;">
                            Sends a sample alert using current values (saved on Close).
                        </span>
                        <button @onclick="TestTelegramAsync"
                                aria-label="Send a test Telegram alert">Send test</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_telegramStatus))
                    {
                        <p role="status"
                           style="color:@(_telegramStatusIsError ? "#c33" : "#4c8"); font-size:0.85rem; margin-top:6px;">
                            @_telegramStatus
                        </p>
                    }
                </fieldset>

                <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                    <legend style="font-weight:700; color:#111; padding:0 6px;">Webhook (Discord / Slack / custom)</legend>

                    <p style="font-size:0.85rem; color:#555; margin-bottom:10px;">
                        Sends alerts as a JSON POST to any HTTPS endpoint. Add one or more named
                        webhooks — a Discord webhook URL (Server Settings, Integrations, Webhooks) or a
                        Slack incoming-webhook URL — and give each a Name (e.g. "BTC channel"). Each
                        alert then routes to the webhook whose name you pick in the Alerts dialog, so
                        BTC alerts land in your BTC channel and KAS alerts in your KAS channel.
                    </p>

                    @for (int i = 0; i < _webhooks.Count; i++)
                    {
                        var row = _webhooks[i];
                        int idx = i;
                        <div class="modal-row" style="align-items:flex-end; gap:8px;">
                            <div style="flex:1;">
                                <label for="s-webhook-name-@idx">Name</label>
                                <input id="s-webhook-name-@idx" type="text"
                                       value="@row.Name"
                                       placeholder="e.g. BTC channel"
                                       @onchange="e => row.Name = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div style="flex:2;">
                                <label for="s-webhook-url-@idx">Webhook URL (HTTPS)</label>
                                <input id="s-webhook-url-@idx" type="url"
                                       value="@row.Url"
                                       placeholder="https://discord.com/api/webhooks/…"
                                       @onchange="e => row.Url = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <div style="flex:1;">
                                <label for="s-webhook-auth-@idx">Auth header (optional)</label>
                                <input id="s-webhook-auth-@idx" type="password"
                                       value="@row.Auth"
                                       autocomplete="new-password"
                                       placeholder="Bearer token"
                                       @onchange="e => row.Auth = e.Value?.ToString() ?? string.Empty" />
                            </div>
                            <button @onclick="() => RemoveWebhook(idx)"
                                    aria-label="@($"Remove webhook {row.Name}")">Remove</button>
                        </div>
                    }
                    <div class="modal-row">
                        <button @onclick="AddWebhook" aria-label="Add a webhook">Add webhook</button>
                        <span style="flex:1;"></span>
                        <button @onclick="TestWebhookAsync"
                                aria-label="Send a test webhook alert to the first webhook">Send test</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_webhookStatus))
                    {
                        <p role="status"
                           style="color:@(_webhookStatusIsError ? "#c33" : "#4c8"); font-size:0.85rem; margin-top:6px;">
                            @_webhookStatus
                        </p>
                    }
                </fieldset>
            </div>

            @* ── License tab ───────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-license"
                 aria-labelledby="tab-license"
                 hidden="@(_activeTab != "License")">

                <div style="padding:8px 0; color:#111; line-height:1.7; font-size:0.92rem;">
                    <p><strong>Accessible Trade Terminal</strong></p>
                    <p>Copyright &copy; 2026 Accessible Trader contributors.</p>
                    <p>MIT License — Free to use, modify, and distribute with attribution.</p>
                    <p>Full license text: <a href="https://opensource.org/licenses/MIT" target="_blank"
                           style="color:#0078d4;">https://opensource.org/licenses/MIT</a></p>
                </div>
            </div>

            @* ── About tab ─────────────────────────────────────────────────── *@
            <div role="tabpanel" id="tabpanel-about"
                 aria-labelledby="tab-about"
                 hidden="@(_activeTab != "About")">

                <img src="_content/AccessibleTrader.BlazorClient.Components/images/logo.svg"
                     alt="Accessible Trade Terminal logo: a deep-green medallion with a reflective gold ring and gold wordmark"
                     style="width:120px; height:120px; display:block; margin:4px auto 12px;" />

                <table class="shortcuts-table" style="margin-top:4px;">
                    <tbody>
                        <tr><td>Version</td><td>@AppVersion</td></tr>
                        <tr><td>Platform</td><td>.NET 10 — MAUI Blazor Hybrid + ASP.NET Core WebHost</td></tr>
                        <tr><td>Chart Engine</td><td>SkiaSharp</td></tr>
                        <tr><td>Audio Engine</td><td>128-voice polyphonic synthesis (cross-platform DSP)</td></tr>
                        <tr><td>Providers</td><td>Alpaca, Binance, Bitstamp, Coinbase, Finnhub, FMP, Interactive Brokers, Kraken, MEXC, Oanda, Polygon, Schwab, Tradier, Twelve Data</td></tr>
                        <tr><td>Repository</td><td><a href="https://github.com/accessible-trader/accessible-trader" target="_blank" style="color:#0078d4;">GitHub</a></td></tr>
                    </tbody>
                </table>
                <p style="margin-top:16px; color:#555; font-size:0.88rem; font-style:italic;">
                    Built for blind and visually impaired traders.
                </p>
            </div>

            <div class="modal-footer">
                <button id="settings-close" @onclick="Close" aria-label="Close settings">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private IDisposable? _closeSub;
    private string _activeTab = "General";

    // Local copies for pending changes — General tab
    private bool _speakTimestamps;
    private bool _readHeaders;
    private bool _announceBars;
    private int _wasapiLatency;

    // ── Settings search (Phase D second pass) ────────────────────────────────
    private sealed record SettingEntry(string Label, string Tab, string ControlId, string Keywords);

    // One registry row per user-facing setting: label + owning tab + control id
    // (focused after the jump) + extra match keywords.
    private static readonly List<SettingEntry> _settingRegistry = new()
    {
        new("Speech enabled", "General", "s-speech-enabled", "voice talk announce tts"),
        new("Speak timestamps", "General", "s-speak-timestamps", "time date spoken"),
        new("Read column headers", "General", "s-read-headers", "table grid"),
        new("Announce new bars", "General", "s-announce-bars", "live candle close"),
        new("Paper trading mode", "General", "s-paper-trading", "simulated practice demo"),
        new("Reset paper account", "General", "s-paper-reset", "balance restart"),
        new("Braille display", "General", "s-braille-enabled", "dot pad tactile"),
        new("Sonification enabled", "General", "s-sonif-enabled", "tones audio sound music"),
        new("Audio latency (WASAPI)", "General", "s-wasapi", "buffer delay sound"),
        new("Panning granularity", "General", "s-granularity", "step scroll viewport"),
        new("Background color", "Appearance", "s-bg-color", "chart theme"),
        new("Theme", "Appearance", "s-theme", "dark light contrast solarized braille colors"),
        new("Visual earcons", "Appearance", "s-visual-earcons", "deaf hearing badge flash cue notification"),
        new("Color-vision-safe chart colors", "Appearance", "s-colorvision", "colorblind deuteranopia protanopia red green blue orange"),
        new("Hollow up-candles", "Appearance", "s-hollow-candles", "colorblind outline shape candle"),
        new("Text size", "Appearance", "s-ui-scale", "font zoom scale magnify low vision bigger"),
        new("Keyboard shortcuts", "Keyboard", "tab-keyboard", "rebind keys hotkey remap"),
        new("Email alerts", "Alerts", "s-email-host", "smtp mail notification"),
        new("Telegram alerts", "Alerts", "s-tg-token", "bot chat notification"),
        new("License", "License", "tab-license", "tier supporter key"),
    };

    private string _searchQuery = string.Empty;
    private List<SettingEntry> _searchResults = new();

    private void OnSearchInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        var q = _searchQuery.Trim();
        _searchResults = string.IsNullOrEmpty(q)
            ? new List<SettingEntry>()
            : _settingRegistry.Where(s =>
                    s.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.Keywords.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || s.Tab.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private async void GoToSetting(SettingEntry entry)
    {
        _activeTab = entry.Tab;
        _searchQuery = string.Empty;
        _searchResults.Clear();
        await InvokeAsync(StateHasChanged);
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", entry.ControlId); }
        catch { /* JS bridge may be absent in tests */ }
    }

    // Appearance tab — derived from ThemeService.Current
    // Visual accessibility toggles (Phase D) — all default OFF, applied immediately.
    private bool _visualEarcons;
    private bool _colorVisionSafe;
    private bool _hollowUpCandles;
    private int _uiScale = 100;
    private string _backgroundColor = "#000000";
    private string _candleUpColor   = "#00cc44";
    private string _candleDownColor = "#cc2200";
    private string _selectedTheme   = "HighContrastDark";

    // Alerts tab — loaded from ISettingsManager on ShowAsync, persisted on Close.
    private string _emailHost = string.Empty;
    private int    _emailPort = 587;
    private bool   _emailUseTls = true;
    private string _emailUsername = string.Empty;
    private string _emailPassword = string.Empty;
    private string _emailFrom = string.Empty;
    private string _emailTo = string.Empty;
    private string _emailStatus = string.Empty;
    private bool   _emailStatusIsError;
    private string _tgBotToken = string.Empty;
    private string _tgChatId = string.Empty;
    private string _telegramStatus = string.Empty;
    private bool   _telegramStatusIsError;
    // Named multi-webhook list (Part B). Mutable rows for editing; serialized to
    // the "alerts.webhooks" settings key on Close.
    private sealed class WebhookRow { public string Name = ""; public string Url = ""; public string Auth = ""; }
    private List<WebhookRow> _webhooks = new();
    private string _webhookStatus = string.Empty;
    private bool   _webhookStatusIsError;

    private void AddWebhook() => _webhooks.Add(new WebhookRow());
    private void RemoveWebhook(int idx)
    {
        if (idx >= 0 && idx < _webhooks.Count) _webhooks.RemoveAt(idx);
    }

    private static string SkColorToHex(SkiaSharp.SKColor c) => $"#{c.Red:X2}{c.Green:X2}{c.Blue:X2}";

    // Single source of truth is the <Version> property in Directory.Build.props;
    // it flows into the assembly informational version at build time. Strip any
    // "+commitsha" suffix appended by SourceLink.
    private static readonly string AppVersion =
        (typeof(SettingsModal).Assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
         ?? typeof(SettingsModal).Assembly.GetName().Version?.ToString(3)
         ?? "unknown").Split('+')[0];

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenSettingsEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Settings") InvokeAsync(Close);
        });
        ThemeService.ThemeChanged += OnThemeServiceChanged;
        ResetLocal();
        _uniqueBindings = ShortcutService.GetAllBindings()
            .GroupBy(b => b.Description)
            .Select(g => g.First())
            .ToList();
    }

    private void OnThemeServiceChanged(object? sender, AccessibleTrader.Sdk.Theming.ChartTheme theme)
    {
        _candleUpColor   = SkColorToHex(theme.CandleBullishBody);
        _candleDownColor = SkColorToHex(theme.CandleBearishBody);
        _backgroundColor = SkColorToHex(theme.Background);
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _selectedTheme = e.Value?.ToString() ?? _selectedTheme;
        if (Enum.TryParse<AccessibleTrader.Sdk.Enums.ThemeType>(_selectedTheme, out var themeType))
        {
            ThemeService.SetTheme(themeType);
        }
    }

    // ── Visual accessibility toggles (Phase D) — persist + apply immediately ──

    private void OnVisualEarconsChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _visualEarcons = e.Value is bool b && b;
        Settings.SetSetting("accessibility.visualEarcons", _visualEarcons);
        Settings.SaveSettings();
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _visualEarcons ? "Visual earcons on." : "Visual earcons off.", true));
    }

    private void OnColorVisionChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _colorVisionSafe = e.Value is bool b && b;
        Settings.SetSetting("appearance.colorVisionSafe", _colorVisionSafe);
        Settings.SaveSettings();
        ThemeService.RefreshAccessibilityOverrides();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _colorVisionSafe ? "Color-vision-safe colors on: up is blue, down is orange."
                             : "Color-vision-safe colors off.", true));
    }

    private async void OnUiScaleChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int scale)) return;
        _uiScale = Math.Clamp(scale, 50, 250);
        Settings.SetSetting("appearance.uiScale", _uiScale);
        Settings.SaveSettings();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.setUiScale", _uiScale); }
        catch { /* JS bridge may be absent in tests */ }
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Text size {_uiScale} percent.", true));
    }

    // ── Background color override — persists + applies immediately like the
    //    other appearance settings. Stored under ThemeService.BackgroundOverrideKey
    //    and applied by ThemeService, so the renderer, background layer, and the
    //    loading overlay all pick it up through ThemeService.Current.Background.
    private void OnBackgroundColorChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _backgroundColor = e.Value?.ToString() ?? _backgroundColor;
        Settings.SetSetting(Core.Services.ThemeService.BackgroundOverrideKey, _backgroundColor);
        Settings.SaveSettings();
        ThemeService.RefreshAccessibilityOverrides();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            "Chart background color changed.", true));
    }

    private void ResetBackgroundColor()
    {
        Settings.SetSetting(Core.Services.ThemeService.BackgroundOverrideKey, string.Empty);
        Settings.SaveSettings();
        ThemeService.RefreshAccessibilityOverrides();
        _backgroundColor = SkColorToHex(ThemeService.Current.Background);
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            "Background color reset to theme default.", true));
    }

    private void OnHollowCandlesChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _hollowUpCandles = e.Value is bool b && b;
        Settings.SetSetting("appearance.hollowUpCandles", _hollowUpCandles);
        Settings.SaveSettings();
        ThemeService.RefreshAccessibilityOverrides();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            _hollowUpCandles ? "Hollow up-candles on." : "Hollow up-candles off.", true));
    }

    private bool _paperTradingMode;
    private bool _paperTradingModeInitial;
    private bool _brailleEnabled;
    private bool _brailleEnabledInitial;

    private void ResetPaperAccount()
    {
        Paper.ResetAccount();
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Paper account reset to {Paper.StartingBalance:N0}.", true));
    }

    private void ResetLocal()
    {
        _speakTimestamps = Store.State.SpeakTimestamps;
        _readHeaders = Store.State.ReadColumnHeaders;
        _announceBars = Store.State.AnnounceNewBars;
        _paperTradingMode = Settings.GetSetting("trading.paperTradingMode")?.ToObject<bool>() ?? false;
        _paperTradingModeInitial = _paperTradingMode;
        _brailleEnabled = Settings.GetSetting("accessibility.braille.enabled")?.ToObject<bool>() ?? false;
        _brailleEnabledInitial = _brailleEnabled;
        _wasapiLatency = Store.State.WasapiLatency;
        _visualEarcons   = Settings.GetSetting("accessibility.visualEarcons")?.ToObject<bool>() ?? false;
        _colorVisionSafe = Settings.GetSetting("appearance.colorVisionSafe")?.ToObject<bool>() ?? false;
        _hollowUpCandles = Settings.GetSetting("appearance.hollowUpCandles")?.ToObject<bool>() ?? false;
        _uiScale         = Settings.GetSetting("appearance.uiScale")?.ToObject<int>() ?? 100;
        _backgroundColor = SkColorToHex(ThemeService.Current.Background);
        _candleUpColor   = SkColorToHex(ThemeService.Current.CandleBullishBody);
        _candleDownColor = SkColorToHex(ThemeService.Current.CandleBearishBody);
        _selectedTheme   = ThemeService.Current.ThemeType.ToString();

        // Alerts config — pull fresh from settings so another component's edits
        // (or a crash-recovery re-open) show the persisted values.
        _emailHost     = Settings.GetSetting("alerts.email.host")?.ToString() ?? string.Empty;
        _emailPort     = Settings.GetSetting("alerts.email.port")?.ToObject<int>() ?? 587;
        _emailUseTls   = Settings.GetSetting("alerts.email.useTls")?.ToObject<bool>() ?? true;
        _emailUsername = Settings.GetSetting("alerts.email.username")?.ToString() ?? string.Empty;
        _emailPassword = Settings.GetSetting("alerts.email.password")?.ToString() ?? string.Empty;
        _emailFrom     = Settings.GetSetting("alerts.email.fromAddress")?.ToString() ?? string.Empty;
        _emailTo       = Settings.GetSetting("alerts.email.toAddress")?.ToString() ?? string.Empty;
        _emailStatus = string.Empty; _emailStatusIsError = false;

        _tgBotToken = Settings.GetSetting("alerts.telegram.botToken")?.ToString() ?? string.Empty;
        _tgChatId   = Settings.GetSetting("alerts.telegram.chatId")?.ToString() ?? string.Empty;
        _telegramStatus = string.Empty; _telegramStatusIsError = false;

        // Load the named webhook list (migrating a legacy single URL if present).
        var parsed = AccessibleTrader.Core.Services.Alerts.WebhookAlertConfigLoader.ParseWebhooks(
            Settings.GetSetting("alerts.webhooks"),
            Settings.GetSetting("alerts.webhook.url")?.ToString(),
            Settings.GetSetting("alerts.webhook.authHeader")?.ToString());
        _webhooks = parsed
            .Select(w => new WebhookRow { Name = w.Name, Url = w.Url, Auth = w.AuthHeader ?? string.Empty })
            .ToList();
        _webhookStatus = string.Empty; _webhookStatusIsError = false;
    }

    private async Task ShowAsync()
    {
        ResetLocal();
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Settings"));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "settings-title"); } catch { }
    }

    private void Close()
    {
        // Apply all pending settings changes (General tab) as a single state update.
        // Theme/appearance are applied immediately via ThemeService.SetTheme when changed.
        Store.Dispatch(new UpdateSettingsAction(s => s with
        {
            SpeakTimestamps  = _speakTimestamps,
            ReadColumnHeaders = _readHeaders,
            AnnounceNewBars  = _announceBars,
            WasapiLatency    = _wasapiLatency,
            BackgroundColor  = _backgroundColor
        }));

        PersistAlertSettings();

        Settings.SetSetting("trading.paperTradingMode", JToken.FromObject(_paperTradingMode));
        Settings.SetSetting("accessibility.braille.enabled", JToken.FromObject(_brailleEnabled));
        Settings.SaveSettings();
        EventBus.Publish(new PaperModeToggledEvent(_paperTradingMode));
        if (_paperTradingMode != _paperTradingModeInitial)
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                _paperTradingMode ? "Paper trading enabled." : "Paper trading disabled.", true));

        // Only signal a braille change when it actually changed — the coordinator
        // connects/disconnects the device in response, so we don't want to churn it
        // every time the dialog closes.
        if (_brailleEnabled != _brailleEnabledInitial)
        {
            EventBus.Publish(new BrailleModeToggledEvent(_brailleEnabled));
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                _brailleEnabled ? "Braille output enabled." : "Braille output disabled.", true));
        }

        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Settings"));
        StateHasChanged();
    }

    // ── Alerts tab persistence + test sends ──────────────────────────────────

    private void PersistAlertSettings()
    {
        Settings.SetSetting("alerts.email.host",        JToken.FromObject(_emailHost));
        Settings.SetSetting("alerts.email.port",        JToken.FromObject(_emailPort));
        Settings.SetSetting("alerts.email.useTls",      JToken.FromObject(_emailUseTls));
        Settings.SetSetting("alerts.email.username",    JToken.FromObject(_emailUsername));
        Settings.SetSetting("alerts.email.password",    JToken.FromObject(_emailPassword));
        Settings.SetSetting("alerts.email.fromAddress", JToken.FromObject(_emailFrom));
        Settings.SetSetting("alerts.email.toAddress",   JToken.FromObject(_emailTo));
        Settings.SetSetting("alerts.telegram.botToken", JToken.FromObject(_tgBotToken));
        Settings.SetSetting("alerts.telegram.chatId",   JToken.FromObject(_tgChatId));
        // Persist the named webhook list. Only rows with both Name + URL are kept.
        var named = _webhooks
            .Where(w => !string.IsNullOrWhiteSpace(w.Name) && !string.IsNullOrWhiteSpace(w.Url))
            .Select(w => new AccessibleTrader.Core.Services.Alerts.NamedWebhook
            {
                Name = w.Name.Trim(),
                Url = w.Url.Trim(),
                AuthHeader = string.IsNullOrWhiteSpace(w.Auth) ? null : w.Auth,
            });
        Settings.SetSetting("alerts.webhooks",
            AccessibleTrader.Core.Services.Alerts.WebhookAlertConfigLoader.ToJson(named));
        Settings.SaveSettings();
    }

    private async Task TestWebhookAsync()
    {
        PersistAlertSettings();
        // Route the test to the first configured webhook so it actually posts.
        var target = _webhooks.FirstOrDefault(w =>
            !string.IsNullOrWhiteSpace(w.Name) && !string.IsNullOrWhiteSpace(w.Url))?.Name;
        if (string.IsNullOrWhiteSpace(target))
        {
            _webhookStatus = "Add a webhook (Name + HTTPS URL) first.";
            _webhookStatusIsError = true;
            StateHasChanged();
            return;
        }
        await SendTestAlertAsync("webhook",
            s => { _webhookStatus = s.Message; _webhookStatusIsError = s.IsError; },
            webhookTarget: target);
    }

    private async Task TestEmailAsync()
    {
        PersistAlertSettings();
        await SendTestAlertAsync("email", s => { _emailStatus = s.Message; _emailStatusIsError = s.IsError; });
    }

    private async Task TestTelegramAsync()
    {
        PersistAlertSettings();
        await SendTestAlertAsync("telegram", s => { _telegramStatus = s.Message; _telegramStatusIsError = s.IsError; });
    }

    private async Task SendTestAlertAsync(string channelId, Action<(string Message, bool IsError)> report,
        string? webhookTarget = null)
    {
        var channel = AlertChannels.FirstOrDefault(c => c.Id == channelId);
        if (channel == null)
        {
            report(("Channel not registered.", true));
            return;
        }
        if (!channel.IsConfigured)
        {
            report(("Required fields are missing — fill them out and try again.", true));
            StateHasChanged();
            return;
        }

        var sample = new AlertFired(
            Definition: new AlertDefinition
            {
                Id = "test-alert",
                Name = "Accessible Trader test alert",
                Target = AlertTarget.Price,
                Condition = AlertCondition.CrossesAbove,
                Delivery = AlertDelivery.Both,
                WebhookTarget = webhookTarget,
            },
            TriggeringValue: 0.0,
            PreviousValue: null,
            SpeechText: "This is a test alert from the Settings modal.");

        report(("Sending…", false));
        StateHasChanged();
        try
        {
            await channel.SendAsync(sample);
            report(("Test sent successfully.", false));
        }
        catch (Exception ex)
        {
            report(($"Send failed: {ex.Message}", true));
        }
        StateHasChanged();
    }

    // ── Data Export ──────────────────────────────────────────────────────────

    private string _exportStatus = "";

    private async Task ExportDataAsync()
    {
        try
        {
            var state = Store.State;
            if (state.Data == null || !state.Data.Any())
            {
                _exportStatus = "No chart data loaded.";
                return;
            }
            string csv = await DataExporter.ExportToCsvAsync(
                state.Data, state.ViewportStartIndex, state.ViewportLength, state.ActiveSeries);
            if (string.IsNullOrEmpty(csv))
            {
                _exportStatus = "No data in viewport.";
                return;
            }
            await JSRuntime.InvokeVoidAsync("accessibleTrader.downloadCsv",
                $"chart_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv", csv);
            _exportStatus = "Export complete.";
        }
        catch (Exception ex)
        {
            _exportStatus = $"Export failed: {ex.Message}";
        }
    }

    // ── Settings Profiles ────────────────────────────────────────────────────

    private string _profileStatus = "";

    private async Task ExportVisualProfileAsync()
    {
        try
        {
            string json = WorkspaceLibrary.ExportVisualProfile(Store.State);
            await JSRuntime.InvokeVoidAsync("accessibleTrader.downloadCsv", "visual_profile.json", json);
            _profileStatus = "Visual profile exported.";
        }
        catch (Exception ex) { _profileStatus = $"Export failed: {ex.Message}"; }
    }

    private async Task ImportVisualProfileAsync()
    {
        try
        {
            string json = await JSRuntime.InvokeAsync<string>("accessibleTrader.readFileAsText", ".json");
            WorkspaceLibrary.ImportVisualProfile(json, Store);

            // Apply the imported background to the live theme — the store value
            // alone only feeds re-export; rendering reads ThemeService.Current.
            var importedBg = Store.State.BackgroundColor;
            if (!string.IsNullOrWhiteSpace(importedBg))
            {
                Settings.SetSetting(Core.Services.ThemeService.BackgroundOverrideKey, importedBg);
                Settings.SaveSettings();
                ThemeService.RefreshAccessibilityOverrides();
                EventBus.Publish(new RedrawEvent());
            }

            _profileStatus = "Visual profile imported.";
            StateHasChanged();
        }
        catch (Exception ex) { _profileStatus = $"Import failed: {ex.Message}"; }
    }

