    /// <summary>
    /// True while the reset has been armed and is waiting for Confirm or Cancel. Cleared on
    /// open and on close, so a question left hanging cannot be answered by the next visit to
    /// this dialog — the same rule <c>ApiKeysModal._pendingRemoval</c> follows.
    /// </summary>
    private bool _pendingPaperReset;

    /// <summary>
    /// Asks the question. Nothing is destroyed here.
    ///
    /// <para>
    /// The announcement says WHAT IS AT STAKE before it says which keys answer it, because a
    /// screen-reader user reaching this from the keyboard has no other signal that the button
    /// under their finger changed. It also names the balance being returned to: "reset" is a
    /// word that could equally mean "clear the history and keep the money".
    /// </para>
    /// </summary>
    private async Task ArmPaperReset()
    {
        _pendingPaperReset = true;
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Reset the paper account? This erases the balance, every open position and the "
          + $"whole trade history, back to {Paper.StartingBalance:N0}. It cannot be undone. "
          + $"Confirm reset, or cancel."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-paper-reset-confirm"); }
        catch { /* focus is best-effort; both buttons are still one Tab away */ }
    }

    /// <summary>
    /// Answers "no". Focus returns to the button the user pressed, so they are where they
    /// started rather than wherever the removed markup left them. Reached from the Cancel
    /// button and from Escape, which behave identically by construction.
    /// </summary>
    private async Task CancelPaperReset()
    {
        _pendingPaperReset = false;
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            "Cancelled. The paper account was not reset."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-paper-reset"); }
        catch { }
    }

    private async Task ConfirmPaperReset()
    {
        _pendingPaperReset = false;
        Paper.ResetAccount();
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Paper account reset to {Paper.StartingBalance:N0}. All positions and history cleared.", true));

        // The button that took the click no longer exists — the row re-rendered back to its
        // single-button form. Without this, focus falls to <body> and the user is returned to
        // the top of the document by a control they pressed in the middle of it.
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-paper-reset"); }
        catch { }
    }

    // ── Factory reset ────────────────────────────────────────────────────────────
    //
    // The wording comes from ITerminalResetService rather than being written here, so the
    // sentence a user is asked to agree to cannot drift from the calls that carry it out.

    /// <summary>Armed and waiting for Confirm or Cancel. Cleared on open and close, like
    /// <see cref="_pendingPaperReset"/>.</summary>
    private bool _pendingFactoryReset;

    private string ResetErasedText   => JoinPhrases(TerminalReset.WhatIsErased);
    private string ResetSurvivesText => JoinPhrases(TerminalReset.WhatSurvives);

    /// <summary>"a, b and c" — spoken lists need the conjunction; a comma before the last item
    /// is heard as another item.</summary>
    private static string JoinPhrases(IReadOnlyList<string> parts)
        => parts.Count switch
        {
            0 => "",
            1 => parts[0],
            _ => string.Join(", ", parts.Take(parts.Count - 1)) + " and " + parts[^1],
        };

    private async Task ArmFactoryReset()
    {
        _pendingFactoryReset = true;
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            "Warning: all personalization and settings will be lost and the terminal will be "
          + $"reset to factory defaults. This erases {ResetErasedText}. Kept: {ResetSurvivesText}. "
          + "It cannot be undone. Are you sure? Confirm reset, or cancel."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-factory-reset-confirm"); }
        catch { }
    }

    private async Task CancelFactoryReset()
    {
        _pendingFactoryReset = false;
        StateHasChanged();
        await Task.Yield();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            "Cancelled. Nothing was reset."));

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-factory-reset"); }
        catch { }
    }

    private async Task ConfirmFactoryReset()
    {
        _pendingFactoryReset = false;
        int failures = TerminalReset.ResetEverything();

        // Re-read every staged field from the defaults that now answer, THEN close. Without
        // this the dialog's own Save on a later visit would write the pre-reset values back
        // out of the fields still holding them — the reset undone by the next Save, which is
        // the failure mode a staged-commit dialog invites and the reason this is not just a
        // call and a close.
        ResetLocal();

        EventBus.Publish(new FeedbackRequestEvent(
            failures == 0 ? FeedbackType.StateChange : FeedbackType.Error,
            failures == 0
                ? "Terminal reset to factory defaults. Restart the terminal so every part of it "
                + "re-reads them. Your API keys, paper account and saved workspaces were kept."
                : $"Reset finished with {failures} problem{(failures == 1 ? "" : "s")}. Some settings "
                + "may not have been cleared — see the log. Restart the terminal.",
            true));

        // Close, without going through Cancel: Cancel reverts the live-preview controls to the
        // values the dialog OPENED with, which are the pre-reset ones — it would hand back the
        // theme and text size the reset just cleared.
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Settings"));
        StateHasChanged();
    }

    private void ResetLocal()
    {
        _speakTimestamps = Store.State.SpeakTimestamps;
        _dateEveryBar    = Store.State.SpeakDateOnEveryBar;
        _readHeaders = Store.State.ReadColumnHeaders;
        _announceBars = Store.State.AnnounceNewBars;
        _describeChartPatterns = Store.State.DescribeChartPatterns;
        _describeCandlePatterns = Store.State.DescribeCandlePatterns;
        _narrateSignals = Store.State.NarrateSignalsOnBarClose;
        _narratePlayback = Store.State.NarrateDuringPlayback;
        _playbackLandmarks = Store.State.SpeakPlaybackLandmarks;
        _paperTradingMode = App.PaperTradingMode;
        _quickSizingMode = Settings.GetSetting(SettingsKeys.QuickTradeSizingMode)?.ToObject<int>() ?? 0;
        _bgMonitoring  = App.BackgroundMonitoring;
        _bgPollSeconds = App.MonitorPollSeconds;
        _liveBgTabs    = App.LiveBackgroundTabs;
        _resumeSession = App.ResumeLastSession;
        _paperTradingModeInitial = _paperTradingMode;
        _brailleEnabled = App.BrailleEnabled;
        _brailleEnabledInitial = _brailleEnabled;
        _muteIncludesOrderEvents = App.MuteIncludesOrderEvents;
        _chartEarcons     = App.ChartEarconsEnabled;
        _interfaceEarcons = App.InterfaceEarconsEnabled;
        _bgLocalMonitor = Settings.GetSetting("monitoring.backgroundLocal")?.ToObject<bool>() ?? false;

        // Optional web-head capability (null on MAUI). Seed the dropdown from the
        // live mode so it reflects a first-visit prompt choice made this session.
        _speechOutput = ServiceProvider.GetService(typeof(AccessibleTrader.Core.Services.IBrowserSpeechOutput))
            as AccessibleTrader.Core.Services.IBrowserSpeechOutput;
        _speechOutputMode = _speechOutput?.Mode switch
        {
            AccessibleTrader.Core.Services.SpeechOutputMode.ScreenReader => "sr",
            AccessibleTrader.Core.Services.SpeechOutputMode.BrowserVoice => "tts",
            _ => "both",
        };
        _hoverSonification = App.HoverSonification;
        _magnetSnap = App.MagnetSnap;
        _marketStructureDefault = App.MarketStructureOnByDefault;
        _soundTheme = App.SoundTheme;
        _touchNavMode = App.TouchNavBarMode;
        _visualEarcons   = App.VisualEarcons;
        // Never read back before 2026-09-04: reopening Settings showed this unchecked however it
        // had been left, so the box disagreed with the chart it controls.
        _showPatternVisuals = App.ShowChartPatternVisuals;
        _colorVisionSafe = App.ColorVisionSafe;
        _hollowUpCandles = App.HollowUpCandles;
        _uiScale         = App.UiScale;
        _speechEnabled        = Store.State.IsSpeechEnabled;
        _sonificationEnabled  = Store.State.IsSonificationEnabled;
        _panningGranularity   = Store.State.PanningGranularity;
        SyncSelectedThemeFromService();

        // The preview baseline. Captured here rather than in ShowAsync because Cancel calls
        // ResetLocal too, and a baseline that drifted with the reverted values would make a
        // second Cancel a no-op against the wrong state.
        _uiScaleInitial            = _uiScale;
        _showPatternVisualsInitial = _showPatternVisuals;
        _visualEarconsInitial      = _visualEarcons;
        _colorVisionSafeInitial    = _colorVisionSafe;
        _hollowUpCandlesInitial    = _hollowUpCandles;
        _selectedThemeInitial      = _selectedTheme;
    }

    private async Task ShowAsync(string? requestedTab = null)
    {
        ResetLocal();
        // A confirmation left hanging when the dialog closed must not still be armed when it
        // reopens: the next visitor would find "Confirm reset" under the cursor where "Reset
        // paper account" belongs, and one keypress would answer a question they never heard.
        _pendingPaperReset = false;

        // A shortcut that names a destination lands on it. An unknown or unavailable name —
        // "Braille" on the browser host, a stale name from an older build — falls back to the
        // default rather than hiding every panel at once, which is what an unmatched _activeTab
        // does: every panel's hidden attribute is a != test, so a name matching none of them
        // renders an empty dialog with a working tab strip above it.
        if (requestedTab != null && SettingsTabs.Contains(requestedTab))
            _activeTab = requestedTab;

        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true, "Settings"));
        StateHasChanged();
        await Task.Yield();

        // Focus the TAB, not the title, when one was asked for: the point of Shift+F4 is to
        // arrive at the braille controls, and landing on the dialog heading would leave the user
        // to find them. The title is still the right target for a plain F12, which names no
        // destination.
        string focusTarget = requestedTab != null && SettingsTabs.Contains(requestedTab)
            ? TabElementId(requestedTab)
            : "settings-title";
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", focusTarget); } catch { }
    }

    /// <summary>
    /// Closes without writing any of the pending edits. Escape, the Cancel button and a click on
    /// the backdrop all land here.
    ///
    /// <para>
    /// Every control on this dialog is now either STAGED — held in a field, dropped by this
    /// method — or a LIVE PREVIEW, which <see cref="RevertPreviews"/> puts back. There is no
    /// third kind and nothing survives a Cancel that the user did not accept. Before 2026-09-04
    /// fifteen controls persisted the moment they changed and Cancel could not reach them.
    /// </para>
    ///
    /// <para>
    /// The one thing Cancel deliberately does not undo is the paper-account reset, because that
    /// is a COMMAND the user pressed, not an edit they made — the same reason Export and the
    /// theme editor's own Save are not on this path either.
    /// </para>
    ///
    /// <para>
    /// It announces. Silence after Escape is indistinguishable from a dialog that did not close,
    /// and this is the one moment where the user needs to know their edits went nowhere.
    /// </para>
    /// </summary>
    private void Cancel()
    {
        bool previewsChanged = RevertPreviews();
        ResetLocal();
        // Disarm on the way out. Escape backs out of the armed question first, so reaching here
        // with it set means the dialog was closed some other way (Cancel button, backdrop) —
        // and leaving it armed would put "Confirm reset" under the cursor the next time the
        // dialog opened, one keypress from erasing an account nobody asked about.
        _pendingPaperReset = false;
        _pendingFactoryReset = false;
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Settings"));
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            previewsChanged
                ? "Settings discarded. Appearance restored."
                : "Settings discarded.", true));
        StateHasChanged();
    }

    /// <summary>
    /// Puts the live-preview controls back to the values this dialog opened with, and reports
    /// whether anything moved. Each branch is guarded on a real change so a plain Escape on an
    /// untouched dialog does not redraw the chart or rewrite the settings file.
    /// </summary>
    private bool RevertPreviews()
    {
        bool changed = false;

        if (_uiScale != _uiScaleInitial)
        {
            _uiScale = _uiScaleInitial;
            App.UiScale = _uiScale;
            SafeSetUiScale(_uiScale);
            changed = true;
        }
        if (_showPatternVisuals != _showPatternVisualsInitial)
        {
            _showPatternVisuals = _showPatternVisualsInitial;
            App.ShowChartPatternVisuals = _showPatternVisuals;
            changed = true;
        }
        if (_visualEarcons != _visualEarconsInitial)
        {
            _visualEarcons = _visualEarconsInitial;
            App.VisualEarcons = _visualEarcons;
            changed = true;
        }
        if (_colorVisionSafe != _colorVisionSafeInitial)
        {
            _colorVisionSafe = _colorVisionSafeInitial;
            App.ColorVisionSafe = _colorVisionSafe;
            changed = true;
        }
        if (_hollowUpCandles != _hollowUpCandlesInitial)
        {
            _hollowUpCandles = _hollowUpCandlesInitial;
            App.HollowUpCandles = _hollowUpCandles;
            changed = true;
        }

        if (changed)
        {
            App.Save();
            ThemeService.RefreshAccessibilityOverrides();
        }

        // The theme last, so its own redraw is the final one.
        if (_selectedThemeInitial != null && _selectedTheme != _selectedThemeInitial)
        {
            _selectedTheme = _selectedThemeInitial;
            ApplySelectedTheme();
            changed = true;
        }

        if (changed) EventBus.Publish(new RedrawEvent());
        return changed;
    }

    /// <summary>The theme half of <see cref="OnThemeChanged"/>, shared with the Cancel revert.</summary>
    private void ApplySelectedTheme()
    {
        if (SelectedCustomTheme is { } preset)
            ThemeService.SetCustomTheme(preset);
        else if (Enum.TryParse<AccessibleTrader.Sdk.Enums.ThemeType>(_selectedTheme, out var themeType))
            ThemeService.SetTheme(themeType);
    }

    /// <summary>UI scale goes through JS; the bridge is absent in unit tests, as everywhere else.</summary>
    private void SafeSetUiScale(int scale) =>
        _ = InvokeAsync(async () =>
        {
            try { await JSRuntime.InvokeVoidAsync("accessibleTrader.setUiScale", scale); }
            catch { /* JS bridge may be absent in tests */ }
        });

    /// <summary>
    /// Writes every pending edit and closes. The Save button is the only thing that calls it.
    ///
    /// <para>
    /// The live-preview controls (theme, UI scale, the visual accommodations) are absent from
    /// here on purpose — they persisted as they were applied, and Save's job for them is simply
    /// not to revert them. Everything else on the dialog lands in this method.
    /// </para>
    /// </summary>
    private void Save()
    {
        // Apply all pending speech changes as a single state update. Theme and the visual
        // accommodations are applied immediately, when changed.
        Store.Dispatch(new UpdateSettingsAction(s => s with
        {
            SpeakTimestamps  = _speakTimestamps,
            SpeakDateOnEveryBar = _dateEveryBar,
            // Both of these were honoured by SpeechFormatter with no control anywhere to set
            // them — live behaviour with no way to reach it, which is what the settings-wiring
            // audit exists to find. They go through the store like every other speech preference.
            TimestampReadLocation = _timestampWhere,
            SpeechOrder      = _speechOrder,
            ReadColumnHeaders = _readHeaders,
            AnnounceNewBars  = _announceBars,
            DescribeChartPatterns = _describeChartPatterns,
            DescribeCandlePatterns = _describeCandlePatterns,
            NarrateSignalsOnBarClose = _narrateSignals,
            NarrateDuringPlayback = _narratePlayback,
            SpeakPlaybackLandmarks = _playbackLandmarks,
        }));

        // The two master toggles and the panning step are store state, not app settings, and
        // each has an action of its own — the same one F2, F3 and Shift+[ / Shift+] fire. They
        // are dispatched only when the staged value actually differs, because ToggleSpeechAction
        // is a TOGGLE: dispatching it unconditionally on every Save would flip speech off for a
        // user who came in to change something else entirely.
        if (_speechEnabled != Store.State.IsSpeechEnabled)
            Store.Dispatch(new ToggleSpeechAction());
        if (_sonificationEnabled != Store.State.IsSonificationEnabled)
            Store.Dispatch(new ToggleSonificationAction());
        if (_panningGranularity != Store.State.PanningGranularity)
            Store.Dispatch(new AdjustGranularityAction(_panningGranularity - Store.State.PanningGranularity));

        App.PaperTradingMode = _paperTradingMode;
        Settings.SetSetting(SettingsKeys.QuickTradeSizingMode, Newtonsoft.Json.Linq.JToken.FromObject(_quickSizingMode));
        App.BrailleEnabled = _brailleEnabled;
        App.MuteIncludesOrderEvents = _muteIncludesOrderEvents;
        App.ChartEarconsEnabled     = _chartEarcons;
        App.InterfaceEarconsEnabled = _interfaceEarcons;
        App.TimestampReadLocation = _timestampWhere;
        App.SpeechOrder = _speechOrder;

        // ── The fifteen that used to write themselves the moment they changed ──────────
        //
        // Each of these called App.Save() from its own @onchange handler, so Cancel and Escape
        // could not take any of them back and the dialog carried two commit idioms at once
        // (Cody, 2026-09-04: "for things like text field, check boxes, radio buttons, those
        // things should save on pressing the save button"). They are staged now; this is where
        // they land.
        App.HoverSonification       = _hoverSonification;
        App.MagnetSnap              = _magnetSnap;
        App.MarketStructureOnByDefault = _marketStructureDefault;
        App.SoundTheme              = _soundTheme;
        App.TouchNavBarMode         = _touchNavMode;
        App.BackgroundMonitoring    = _bgMonitoring;
        App.MonitorPollSeconds      = _bgPollSeconds;
        App.LiveBackgroundTabs      = _liveBgTabs;
        App.ResumeLastSession       = _resumeSession;
        Settings.SetSetting("monitoring.backgroundLocal", Newtonsoft.Json.Linq.JToken.FromObject(_bgLocalMonitor));
        App.Save();

        // Side effects that follow the WRITE, not the keystroke. Reconcile restarts the
        // monitors so a new interval and a new on/off state are adopted together, once.
        EventBus.Publish(new TouchNavBarModeChangedEvent(_touchNavMode));
        Monitoring.Reconcile();
        TabFeeds.Reconcile();
        ApplySpeechOutputMode();

        EventBus.Publish(new PaperModeToggledEvent(_paperTradingMode));
        if (_paperTradingMode != _paperTradingModeInitial)
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                _paperTradingMode ? "Paper trading enabled." : "Paper trading disabled.", true));

        // Only signal a braille change when it actually changed — the coordinator
        // connects/disconnects the device in response, so we don't want to churn it
        // every time the dialog closes.
        if (_brailleEnabled != _brailleEnabledInitial)
        {
            EventBus.Publish(new BrailleModeToggledEvent(_brailleEnabled));
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                _brailleEnabled ? "Braille output enabled." : "Braille output disabled.", true));
        }

        // Saving is the moment the dialog's work becomes real, and for a blind user the
        // announcement IS the evidence the button did anything — the same reason the sound
        // designer's Save Patch and Custom Scripts' Save were given one on 2026-09-04. It is
        // last so that any per-setting sentence above (paper mode, braille) is heard first.
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange, "Settings saved.", true));

        _pendingPaperReset = false;   // see Cancel: an armed question must never outlive the dialog
        _pendingFactoryReset = false;
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Settings"));
        StateHasChanged();
    }

    /// <summary>
    /// Pushes the staged speech-output choice into the web head's speech manager and its browser
    /// storage. Null on MAUI, where the control is not shown at all.
    /// </summary>
    private void ApplySpeechOutputMode()
    {
        if (_speechOutput != null)
        {
            _speechOutput.Mode = _speechOutputMode switch
            {
                "sr"  => AccessibleTrader.Core.Services.SpeechOutputMode.ScreenReader,
                "tts" => AccessibleTrader.Core.Services.SpeechOutputMode.BrowserVoice,
                _     => AccessibleTrader.Core.Services.SpeechOutputMode.Both,
            };
        }
        _ = InvokeAsync(async () =>
        {
            try { await JSRuntime.InvokeVoidAsync("accessibleTrader.setSpeechOutputMode", _speechOutputMode); }
            catch { /* choice applies for this visit even if storage fails */ }
        });
    }

    // ── Data Export ──────────────────────────────────────────────────────────

    private string _exportStatus = "";

    private async Task ExportDataAsync()
    {
        try
        {
            var state = Store.State;
            if (state.Data == null || !state.Data.Any())
            {
                _exportStatus = "No chart data loaded.";
                return;
            }
            string csv = await DataExporter.ExportToCsvAsync(
                state.Data, state.ViewportStartIndex, state.ViewportLength, state.ActiveSeries);
            if (string.IsNullOrEmpty(csv))
            {
                _exportStatus = "No data in viewport.";
                return;
            }
            await JSRuntime.InvokeVoidAsync("accessibleTrader.downloadCsv",
                $"chart_export_{DateTime.Now:yyyyMMdd_HHmmss}.csv", csv);
            _exportStatus = "Export complete.";
        }
        catch (Exception ex)
        {
            _exportStatus = $"Export failed: {ex.Message}";
        }
    }

