    /// <summary>
    /// The Delete button is rendered only while a custom theme is selected, so the element under
    /// the user's finger disappears on the render this causes and focus would fall to
    /// <c>&lt;body&gt;</c>, outside the dialog — the ObjectTree Delete defect in a new place.
    /// Focus goes to the picker, which now shows the theme that took over.
    /// </summary>
    private async Task DeleteTheme()
    {
        if (SelectedCustomTheme is not { } preset) return;

        Themes.Remove(preset.Id);
        // Fall back to whatever it was based on, rather than leaving the app pointing at a theme
        // that no longer exists.
        ThemeService.SetTheme(preset.BasedOn);
        _selectedTheme = preset.BasedOn.ToString();
        EventBus.Publish(new RedrawEvent());
        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Deleted {preset.Name}. Now using {PrettyThemeName(preset.BasedOn)}.", true));
        await InvokeAsync(StateHasChanged);
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "s-theme"); }
        catch { /* best-effort, as everywhere else */ }
    }

