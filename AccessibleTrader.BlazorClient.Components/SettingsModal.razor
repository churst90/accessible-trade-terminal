    // ── Keyboard Rebinding ───────────────────────────────────────────────────

    private List<AccessibleTrader.Core.Services.ShortcutDisplayBinding> _uniqueBindings = new();
    private AccessibleTrader.Core.Models.SystemCommand? _capturingCommand;
    private string _capturingCommandName = "";
    private DotNetObjectReference<SettingsModal>? _dotNetRef;

    private async Task StartCapture(AccessibleTrader.Core.Services.ShortcutDisplayBinding binding)
    {
        if (!Enum.TryParse<AccessibleTrader.Core.Models.SystemCommand>(binding.Description, out var cmd)) return;
        _capturingCommand = cmd;
        _capturingCommandName = binding.Description;
        StateHasChanged();
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("accessibleTrader.captureNextKey", _dotNetRef);
    }

    [JSInvokable]
    public void OnKeyCaptured(string key, bool shift, bool ctrl, bool alt)
    {
        if (_capturingCommand == null) return;
        string reboundName = _capturingCommandName;
        var displaced = ShortcutService.UpdateBinding(_capturingCommand.Value, key, shift, ctrl, alt);
        _uniqueBindings = ShortcutService.GetAllBindings()
            .GroupBy(b => b.Description)
            .Select(g => g.First())
            .ToList();
        _capturingCommand = null;
        _capturingCommandName = "";
        InvokeAsync(StateHasChanged);

        // Tell the user when this rebind stole another command's only shortcut, so a
        // keyboard-first user learns it went unbound now — not by pressing a dead key
        // later. They can re-bind the displaced command from this same dialog.
        if (displaced.Count > 0)
        {
            var names = displaced.Select(c => c.ToString());
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
                $"{reboundName} rebound. This removed the only shortcut for {string.Join(", ", names)}; " +
                "rebind from the Keyboard tab if you still need it.", true));
        }

        // A rebind that could not be written is still LIVE this session but gone on restart.
        // Saying nothing meant the user learned about it by pressing a dead key days later,
        // with no way to connect the two. Error, not StateChange: this needs the failure
        // channel, which is not muteable.
        if (!ShortcutService.LastSaveSucceeded)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Error,
                $"{reboundName} rebound, but the shortcut file could not be saved. " +
                "This change will be lost when you restart.", true));
        }
    }

    private void CancelCapture()
    {
        _capturingCommand = null;
        _capturingCommandName = "";
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
        _eventSub?.Dispose();
        _closeSub?.Dispose();
        ThemeService.ThemeChanged -= OnThemeServiceChanged;
    }
}
