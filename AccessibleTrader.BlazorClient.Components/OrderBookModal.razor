@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Models
@using AccessibleTrader.Sdk.Interfaces
@using AccessibleTrader.Sdk.Models
@using System.Reactive.Linq
@inject IWorkspaceStore Store
@inject IEventBus EventBus
@inject IOrderExecutionService OrderService
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="orderbook-title"
             style="max-width:680px; min-height:480px;"
             @onclick:stopPropagation="true">

            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
                <h2 id="orderbook-title" tabindex="-1" style="margin:0;">
                    Order Book — @(Store.State.Identity.Symbol ?? "No Symbol")
                </h2>
                @if (!_isLive)
                {
                    @* Snapshot-only providers: manual refresh button. Live providers update
                       automatically via SubscribeOrderBookAsync — no button needed. *@
                    <button @onclick="RefreshSnapshotAsync" aria-label="Refresh order book"
                            style="padding:4px 10px;">
                        Refresh
                    </button>
                }
                else
                {
                    <span aria-hidden="true" style="color:var(--text-muted); font-size:0.8rem;">Live</span>
                }
            </div>

            @if (_isLoading)
            {
                <p aria-live="polite">Loading order book...</p>
            }
            else if (_errorMessage != null)
            {
                <div class="alert-box warning" style="margin-top:20px; padding:20px; text-align:center;">
                    <p>@_errorMessage</p>
                </div>
            }
            else
            {
                @if (_isLive)
                {
                    <div style="margin-bottom:8px; font-size:0.8rem; color:var(--text-muted); display:flex; align-items:center; gap:12px;">
                        <label for="ob-announce"><input id="ob-announce" type="checkbox" checked="@_announceLarge" @onchange="e => _announceLarge = e.Value is bool b && b" /> Announce large orders</label>
                        @if (_announceLarge)
                        {
                            <label for="ob-minsize">Min size <input id="ob-minsize" type="number" step="any" min="0" aria-label="Minimum order size to announce" @bind="_minSize" style="width:90px;" /></label>
                        }
                    </div>
                }

                @* Spread / top-of-book summary. Updates silently with the rest of the book —
                   no aria-live so the user reads it on focus rather than being interrupted
                   by every depth change. The visual labels stay obvious to sighted users. *@
                <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:8px;">
                    Best bid: <strong style="color:#44BB44;">@(AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(_bids.FirstOrDefault().Price))</strong>
                    &nbsp;|&nbsp;
                    Best ask: <strong style="color:#FF4444;">@(AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(_asks.FirstOrDefault().Price))</strong>
                    &nbsp;|&nbsp;
                    Spread: <strong>@ComputeSpread()</strong>
                </p>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">

                    @* ── Bids ──────────────────────────────────────────────────── *@
                    <section aria-labelledby="bids-heading">
                        <h3 id="bids-heading" style="color:#44BB44; margin:0 0 6px; font-size:0.9rem;">
                            Bids (Buy Orders)
                        </h3>
                        <table role="table" aria-label="Bid orders, top 20 price levels"
                               style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                            <thead>
                                <tr>
                                    <th scope="col" style="text-align:left; padding:4px 6px; border-bottom:1px solid #333;">Price</th>
                                    <th scope="col" style="text-align:right; padding:4px 6px; border-bottom:1px solid #333;">Size</th>
                                    <th scope="col" style="text-align:right; padding:4px 6px; border-bottom:1px solid #333;">Cumul.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    double bidCumul = 0;
                                    double totalBidSize = _bids.Sum(b => b.Quantity);
                                }
                                @foreach (var bid in _bids)
                                {
                                    bidCumul += bid.Quantity;
                                    double pct = totalBidSize > 0 ? bidCumul / totalBidSize : 0;
                                    var rowLabel = $"Bid {AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(bid.Price)}, size {AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(bid.Quantity)}";
                                    <tr @key="bid.Price"
                                        tabindex="0"
                                        aria-label="@rowLabel"
                                        style="background: linear-gradient(to left, rgba(68,187,68,0.15) @(pct.ToString("P0")), transparent @(pct.ToString("P0"))); outline-offset: -2px;">
                                        <td style="padding:3px 6px; color:#44BB44;">@AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(bid.Price)</td>
                                        <td style="padding:3px 6px; text-align:right;">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(bid.Quantity)</td>
                                        <td style="padding:3px 6px; text-align:right; color:var(--text-muted);">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(bidCumul)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>

                    @* ── Asks ──────────────────────────────────────────────────── *@
                    <section aria-labelledby="asks-heading">
                        <h3 id="asks-heading" style="color:#FF4444; margin:0 0 6px; font-size:0.9rem;">
                            Asks (Sell Orders)
                        </h3>
                        <table role="table" aria-label="Ask orders, top 20 price levels"
                               style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                            <thead>
                                <tr>
                                    <th scope="col" style="text-align:left; padding:4px 6px; border-bottom:1px solid #333;">Price</th>
                                    <th scope="col" style="text-align:right; padding:4px 6px; border-bottom:1px solid #333;">Size</th>
                                    <th scope="col" style="text-align:right; padding:4px 6px; border-bottom:1px solid #333;">Cumul.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    double askCumul = 0;
                                    double totalAskSize = _asks.Sum(a => a.Quantity);
                                }
                                @foreach (var ask in _asks)
                                {
                                    askCumul += ask.Quantity;
                                    double pct2 = totalAskSize > 0 ? askCumul / totalAskSize : 0;
                                    var rowLabel = $"Ask {AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(ask.Price)}, size {AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(ask.Quantity)}";
                                    <tr @key="ask.Price"
                                        tabindex="0"
                                        aria-label="@rowLabel"
                                        style="background: linear-gradient(to right, rgba(255,68,68,0.15) @(pct2.ToString("P0")), transparent @(pct2.ToString("P0"))); outline-offset: -2px;">
                                        <td style="padding:3px 6px; color:#FF4444;">@AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(ask.Price)</td>
                                        <td style="padding:3px 6px; text-align:right;">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(ask.Quantity)</td>
                                        <td style="padding:3px 6px; text-align:right; color:var(--text-muted);">@AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(askCumul)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>

                </div>
            }

            <div class="modal-footer" style="margin-top:16px; border-top:1px solid #333; padding-top:12px;">
                <button @onclick="Close" aria-label="Close order book dialog">Close</button>
            </div>
        </div>
    </div>
}

@code {
    // Phase 5 (2026-04-27): live navigable order book.
    //
    // Design (per user spec):
    //   - 20 price levels per side.
    //   - Live volume updates render silently — no aria-live, no per-update speech.
    //     Screen readers read each row when focus lands on it via Tab/arrow.
    //   - Each <tr> has tabindex="0" + aria-label so the user can tab into the
    //     bid/ask lists and read price+size with a single key press.
    //   - When the active provider implements IOrderBookProvider, we subscribe to
    //     SubscribeOrderBookAsync for live updates and hide the manual Refresh
    //     button. Non-IOrderBookProvider providers fall back to snapshot+button.
    //   - Large-order announcements (v2 follow-up) are NOT in this commit; depth
    //     deltas update silently for now.

    private const int OrderBookDepth = 20;

    private bool _isVisible;
    private bool _isLoading;
    private string? _errorMessage;
    private bool _isLive;
    private List<OrderBookEntry> _bids = new();
    private List<OrderBookEntry> _asks = new();
    private bool _announceLarge;
    private double _minSize;
    private Dictionary<double, double> _prevBids = new();
    private Dictionary<double, double> _prevAsks = new();
    private DateTime _lastAnnounceUtc = DateTime.MinValue;
    private IDisposable? _eventSub;
    private IDisposable? _depthSub;
    private IDisposable? _closeSub;

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenOrderBookEvent>(_ => InvokeAsync(ShowAsync));
        _closeSub = EventBus.Subscribe<CloseTopModalEvent>(e =>
        {
            if (_isVisible && e.ModalName == "Order book") InvokeAsync(Close);
        });
    }

    private async Task ShowAsync()
    {
        _isVisible = true;
        _isLoading = true;
        _errorMessage = null;
        _isLive = false;
        EventBus.Publish(new ModalStateChangedEvent(true, "Order book"));
        StateHasChanged();

        // Do snapshot + subscribe before the focus call so the modal body has
        // settled by the time focus moves. Each await returns a completed Task
        // when the substituted IOrderExecutionService runs in unit tests, so the
        // entire chain unwinds synchronously without yielding to the dispatcher
        // — which keeps bUnit's renderer in step with the test thread.
        await LoadInitialSnapshotAsync();
        await SubscribeLiveUpdatesAsync();

        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "orderbook-title"); }
        catch { /* JS bridge may not be ready during early renders or unit tests */ }
    }

    private async Task RefreshSnapshotAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();
        await LoadInitialSnapshotAsync();
    }

    private async Task LoadInitialSnapshotAsync()
    {
        try
        {
            var state = Store.State;
            string? provider = state.Identity.Provider;
            string? symbol = state.Identity.Symbol;

            if (string.IsNullOrEmpty(provider) || string.IsNullOrEmpty(symbol))
            {
                _errorMessage = "No symbol selected. Select a market from the toolbar first.";
                _isLoading = false;
                StateHasChanged();
                return;
            }

            var (bids, asks) = await OrderService.GetOrderBookAsync(provider, symbol, OrderBookDepth);
            _bids = TrimToDepth(bids);
            _asks = TrimToDepth(asks);

            if (_bids.Count == 0 && _asks.Count == 0)
                _errorMessage = $"Order book is not available for {symbol} on {provider}.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load order book: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SubscribeLiveUpdatesAsync()
    {
        _depthSub?.Dispose();
        _depthSub = null;

        var state = Store.State;
        string? provider = state.Identity.Provider;
        string? symbol = state.Identity.Symbol;
        if (string.IsNullOrEmpty(provider) || string.IsNullOrEmpty(symbol)) return;

        IObservable<OrderBookUpdate>? stream;
        try { stream = await OrderService.SubscribeOrderBookAsync(provider, symbol); }
        catch { stream = null; }

        if (stream == null)
        {
            // Snapshot-only provider — modal stays static until the user clicks Refresh.
            _isLive = false;
            return;
        }

        _isLive = true;
        _depthSub = stream.Subscribe(update =>
        {
            // Provider-side stream may push from a non-UI thread — marshal to the
            // Blazor render context before mutating component fields.
            InvokeAsync(() =>
            {
                if (update.Bids != null && update.Bids.Count > 0) _bids = TrimToDepth(update.Bids);
                if (update.Asks != null && update.Asks.Count > 0) _asks = TrimToDepth(update.Asks);
                AnnounceBookChanges();
                StateHasChanged();
            });
        });
        StateHasChanged();
    }

    private static List<OrderBookEntry> TrimToDepth(IEnumerable<OrderBookEntry> entries)
    {
        // Defensive trim: providers may return more than OrderBookDepth levels even
        // when we asked for that count. Use Take so the downstream rendering loop
        // never blows past the user's chosen depth.
        var list = entries as List<OrderBookEntry> ?? entries.ToList();
        return list.Count <= OrderBookDepth ? list : list.GetRange(0, OrderBookDepth);
    }

    // Opt-in "large order" radar: on each live snapshot, diff against the previous
    // and speak the single most significant change at or above the user's minimum
    // size — a new/grown level ("Large sell order: 50 at 43,250.") or a vanished one
    // ("Sell order removed at 43,250."). Throttled to one announcement every 2s so a
    // fast book doesn't chatter; non-interrupting so it never cuts off navigation.
    private void AnnounceBookChanges()
    {
        if (!_announceLarge || _minSize <= 0) return;

        var newBids = _bids.ToDictionary(b => b.Price, b => b.Quantity);
        var newAsks = _asks.ToDictionary(a => a.Price, a => a.Quantity);
        bool throttled = (DateTime.UtcNow - _lastAnnounceUtc).TotalSeconds < 2;

        string? msg = throttled ? null : (FindBookChange(newAsks, _prevAsks, "sell") ?? FindBookChange(newBids, _prevBids, "buy"));
        _prevBids = newBids;
        _prevAsks = newAsks;

        if (msg != null)
        {
            _lastAnnounceUtc = DateTime.UtcNow;
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Info, msg, false));
        }
    }

    private string? FindBookChange(Dictionary<double, double> cur, Dictionary<double, double> prev, string side)
    {
        double bestDelta = 0, bestPrice = 0;
        bool placed = true;
        foreach (var kv in cur)
        {
            double old = prev.TryGetValue(kv.Key, out var o) ? o : 0;
            double delta = kv.Value - old;
            if (delta >= _minSize && delta > bestDelta) { bestDelta = delta; bestPrice = kv.Key; placed = true; }
        }
        foreach (var kv in prev)
        {
            if (!cur.ContainsKey(kv.Key) && kv.Value >= _minSize && kv.Value > bestDelta) { bestDelta = kv.Value; bestPrice = kv.Key; placed = false; }
        }
        if (bestDelta < _minSize) return null;
        return placed
            ? $"Large {side} order: {AccessibleTrader.Core.Services.Accessibility.QuantityFormatter.FormatCompact(bestDelta)} at {AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(bestPrice)}."
            : $"{(side == "sell" ? "Sell" : "Buy")} order removed at {AccessibleTrader.Core.Services.Accessibility.SpeechPriceFormatter.FormatPrice(bestPrice)}.";
    }

    private string ComputeSpread()
    {
        if (_bids.Count == 0 || _asks.Count == 0) return "N/A";
        double spread = _asks[0].Price - _bids[0].Price;
        double spreadPct = _bids[0].Price > 0 ? spread / _bids[0].Price * 100 : 0;
        return $"{spread:G4} ({spreadPct:F3}%)";
    }

    private void Close()
    {
        _isVisible = false;
        _depthSub?.Dispose();
        _depthSub = null;
        _isLive = false;
        EventBus.Publish(new ModalStateChangedEvent(false, "Order book"));
        StateHasChanged();
    }

    public void Dispose()
    {
        _eventSub?.Dispose();
        _depthSub?.Dispose();
        _closeSub?.Dispose();
    }
}
