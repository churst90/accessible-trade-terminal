<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    AccessibleTrader.BlazorClient.Components — platform-agnostic Razor Class
    Library housing every Razor component for the trading terminal UI.
    Extracted from AccessibleTrader.BlazorClient (the MAUI host) on 2026-04-27
    so components compile against plain net10.0 and can be referenced from:

      • The MAUI host (AccessibleTrader.BlazorClient) for shipping the app.
      • The test project (AccessibleTrader.Tests) for bUnit modal coverage.
      • Any future ASP.NET Core or Blazor WebAssembly host.

    The RCL must NOT take a hard dependency on Microsoft.Maui.* — that is the
    structural contract this extraction enforces. If a component needs a
    platform capability (file picker, native share, device info), expose it
    via an interface in AccessibleTrader.Core and let the MAUI host implement
    it. See IRuntimePlatform for the established pattern.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccessibleTrader.BlazorClient.Components</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!--
      Note: SkiaSharp.Views.Blazor was tried for L2 but uses
      System.Runtime.InteropServices.JavaScript which is WASM-only and
      crashes the Blazor Server circuit on first render. The WebHost
      instead renders Skia to a PNG server-side and pushes a base64 data
      URL into an <img>. Plain SkiaSharp (already transitively referenced
      via Core) is enough; no extra Blazor-Skia package needed.
    -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers (e.g. the order-failure phrasing on
         TradingDashboardModal) without widening them to the public surface. Same approach the
         chart-pattern context uses. -->
    <InternalsVisibleTo Include="AccessibleTrader.Tests" />
  </ItemGroup>

</Project>
