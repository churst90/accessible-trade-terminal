@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject IEventBus EventBus
@inject ISettingsManager Settings
@inject DemoPolicy Demo
@implements IDisposable

@* A landmark, not a bare <div>. This strip carries the PAPER badge — the one persistent
   signal that orders are simulated (MainLayout says so where it places this component) — and
   it holds nothing focusable, so Tab cannot reach it either. Outside every landmark it was
   unreachable by BOTH of a screen-reader user's structural routes: D/landmark navigation and
   Tab. A named <section> is a region landmark and costs one element.

   role="status" moved INWARD onto .status-content deliberately. An element cannot be both a
   landmark and a live region — an explicit role overrides the implicit one, which is the same
   mistake role="toolbar" made on <nav>. Putting it on the content div also takes the badge OUT
   of the live region, which is right: a badge that appears when paper mode is toggled was
   re-announcing the whole strip, and SettingsModal already publishes "Paper trading enabled."
   as its own feedback.

   THE "Last Feedback:" LABEL IS GONE, for the same reason the badge was moved out and one
   more. A live region announces its WHOLE content on every change, so the static label was
   read before every message the app has ever spoken — Cody reported hearing "last feedback,
   focus on chart area" where the sentence alone was the point. Moving it out of the region
   would have fixed the announcement; deleting it is right because the label was never
   carrying anything either. The <section> is already named "Terminal status", so a user
   arriving here by landmark navigation is told what the strip is before reading it, and a
   sighted user is looking at one line of text in a status bar. A label that repeats the name
   of the thing it sits inside is a second name, not a description. *@
<section class="status-bar" aria-label="Terminal status">
    <div class="status-content" role="status" aria-live="polite">
        <span class="status-text">@_lastMessage</span>
    </div>
    @if (_paperMode)
    {
        <span class="paper-indicator" role="img" aria-label="Paper trading enabled" title="Paper trading enabled">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <rect x="3" y="1.5" width="10" height="13" rx="1.5" fill="#2a2a2a" stroke="#ffb300" stroke-width="1.2" />
                <text x="8" y="11" text-anchor="middle" font-size="9" font-weight="bold" fill="#ffb300" font-family="serif">T</text>
            </svg>
            PAPER
        </span>
    }
</section>

<style>
    .status-bar {
        height: 28px;
        background: #1e1e1e;
        color: #dcdcdc;
        border-top: 1px solid #333;
        display: flex;
        align-items: center;
        padding: 0 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.85rem;
        overflow: hidden;
        white-space: nowrap;
    }
    .status-text {
        color: #4ec9b0;
    }
    .paper-indicator {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #ffb300;
        font-weight: bold;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }
</style>

@code {
    private string _lastMessage = "Ready";
    private bool _paperMode;
    private IDisposable? _eventSub;
    private IDisposable? _paperSub;

    protected override void OnInitialized()
    {
        // Hosted/demo builds are paper-only, so the indicator is always on there; elsewhere it
        // follows the saved setting.
        _paperMode = !Demo.AllowLiveTrading
            || (Settings.GetSetting("trading.paperTradingMode")?.ToObject<bool>() ?? false);

        _eventSub = EventBus.Subscribe<FeedbackRequestEvent>(ev => {
            if (!string.IsNullOrEmpty(ev.Message))
            {
                _lastMessage = ev.Message;
                InvokeAsync(StateHasChanged);
            }
        });

        _paperSub = EventBus.Subscribe<PaperModeToggledEvent>(ev => {
            _paperMode = ev.Enabled;
            InvokeAsync(StateHasChanged);
        });
    }

    public void Dispose()
    {
        _eventSub?.Dispose();
        _paperSub?.Dispose();
    }
}
