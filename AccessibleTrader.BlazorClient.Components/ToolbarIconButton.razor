@inject IEventBus EventBus
@*
    Circular-icon toolbar button. Renders a 40px circle with the named SVG
    symbol above a 10px text label so the user gets both a color-coded glyph
    AND a readable caption — the low-vision audience benefits from redundancy.

    The `Variant` parameter drives CSS custom-property `color`, which the inline
    <use> element inherits via `currentColor`. Change a variant → every icon of
    that variant repaints without touching the sprite.

    Label is an abbreviation sized for a 40px circle ("Watch", "AI", "Book"), and
    AriaLabel is where the full name lives. Pass AriaLabel whenever the Label alone
    does not say what the button does — but it is NOT required, and it must not be
    a rewrite: the accessible name has to CONTAIN the visible Label word for word
    (WCAG 2.5.3), so "Pan left" is better served by no AriaLabel at all than by
    "Pan chart left". ToolbarControlSurfaceTests enforces the containment, not the
    presence; enforcing presence is what let ten of these ship announcing words
    that were not on the screen.

    Usage:
        <ToolbarIconButton Icon="alerts" Label="Alerts" Variant="warning"
                          Tooltip="Manage price alerts (Alt+J)"
                          AriaLabel="Alerts"
                          OnClick="() => EventBus.Publish(new OpenAlertsEvent())" />
*@
<button type="button"
        id="@ElementId"
        class="@ButtonClass"
        title="@Tooltip"
        aria-label="@EffectiveAriaLabel"
        aria-pressed="@PressedAttr"
        aria-disabled="@BlockedAttr"
        aria-describedby="@DescribedByAttr"
        @onclick="ActivateAsync">
    <span class="icon-btn-glyph" aria-hidden="true">
        <svg viewBox="0 0 28 28">
            @* xlink:href is the compatibility shim: with <base href="/"> set in
               index.html, WebView2 resolves bare `href="#id"` as an absolute URL
               rather than a same-document fragment reference, which blanks the
               symbol. Emitting both keeps every engine happy. *@
            <use href="@HashRef" xlink:href="@HashRef"></use>
        </svg>
    </span>
    <span class="icon-btn-label">@Label</span>
</button>@*
    Always present so aria-describedby never dangles, blank while the button works.
    Same contract as GatedButton — see that component's header for why a toolbar
    button that VANISHES is worse than one that says why it cannot be pressed.

    But the button only POINTS at it while there is a reason to read. See
    DescribedByAttr: an aria-describedby resolving to the empty string is not
    "no description", it is a description of "", and it SUPPRESSES the title —
    which is where every toolbar tooltip in this app lives.
*@<span id="@ReasonId" role="none" class="gated-reason">@Reason</span>

@code {
    /// <summary>Icon symbol id (without the "icon-" prefix) — e.g. "alerts", "settings".</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    /// <summary>Short caption rendered under the glyph. Keep ≤ 10 chars ideally.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Hover tooltip — typically the full phrase plus the keyboard shortcut.</summary>
    [Parameter] public string? Tooltip { get; set; }

    /// <summary>
    /// Optional DOM id. Set it only when something needs to put focus back here — the
    /// shape-change confirmation returns focus to the Load button when it closes, and
    /// <c>accessibleTrader.focusElement</c> addresses elements by id. Null renders no
    /// attribute at all, so the other twenty-odd buttons are unaffected.
    /// </summary>
    [Parameter] public string? ElementId { get; set; }

    /// <summary>
    /// Accessible label. Defaults to <see cref="Label"/> when null; override for
    /// buttons whose visible label is too terse to be self-describing.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Color variant: data (green), action (cyan), warning (amber), danger (red),
    /// neutral (gray-violet), thought (purple). Invalid values fall back to neutral.
    /// </summary>
    [Parameter] public string Variant { get; set; } = "neutral";

    /// <summary>
    /// When set, renders an aria-pressed toggle surface + "on" style when true.
    ///
    /// <para>USE THIS ONLY WHEN <see cref="Label"/> IS CONSTANT. A toggle button may say what
    /// it does and let aria-pressed carry the state ("Heikin", pressed), or it may put the
    /// state in the label and carry no pressed state at all ("Hide" / "Show") — the ARIA
    /// button pattern offers both and warns against combining them. IndicatorBar used to do
    /// both at once, so a muted series announced "Unmute SMA 20, toggle button, PRESSED":
    /// the name said unmute and the state said pressed. Its two buttons even used opposite
    /// polarity (visibility inverted, audio not), so "pressed" meant different things one
    /// control apart. For a state-in-the-label button use <see cref="Highlighted"/>.</para>
    /// </summary>
    [Parameter] public bool? IsToggleOn { get; set; }

    /// <summary>
    /// The "on" highlight with NO aria-pressed — decoration for a button whose LABEL already
    /// carries the state. Exists so dropping aria-pressed from a state-in-the-label button
    /// does not also drop the visual cue a low-vision user reads.
    /// </summary>
    [Parameter] public bool Highlighted { get; set; }

    /// <summary>Emphasised style — filled background at full variant color.</summary>
    [Parameter] public bool Primary { get; set; }

    /// <summary>
    /// The gate: null when the button works, otherwise the reason it does not, as a
    /// sentence the user can act on. Evaluated on every render AND again at click time.
    /// Replaced the old <c>bool Disabled</c> on 2026-09-02: `disabled` took the four
    /// pan/zoom buttons and Load out of the tab order and out of the screen reader's
    /// button list entirely whenever no chart was loaded, so the toolbar a new user
    /// meets on a cold start was five controls shorter with nothing to explain it.
    /// See GatedButton for the full argument.
    /// </summary>
    [Parameter] public Func<string?>? Gate { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    // Computed attribute values. Built via plain-C# so we never ask the Razor
    // attribute-value tokenizer to walk a string literal nested inside a `@()`
    // block nested inside a double-quoted HTML attribute — that's the pattern
    // most likely to mis-compile and blow up at runtime.
    private string ButtonClass
    {
        get
        {
            var sb = new System.Text.StringBuilder("icon-btn icon-btn-");
            sb.Append(string.IsNullOrEmpty(Variant) ? "neutral" : Variant);
            if (IsToggleOn == true || Highlighted) sb.Append(" icon-btn-on");
            if (Primary) sb.Append(" icon-btn-primary");
            return sb.ToString();
        }
    }

    private string EffectiveAriaLabel =>
        string.IsNullOrEmpty(AriaLabel) ? Label : AriaLabel;

    // Returning null → Blazor omits the attribute for non-toggle buttons.
    private string? PressedAttr =>
        IsToggleOn is null ? null : (IsToggleOn.Value ? "true" : "false");

    private string HashRef => $"#icon-{Icon}";

    private readonly string _reasonId = "tib-" + Guid.NewGuid().ToString("N")[..8];
    private string ReasonId => _reasonId;

    private string? Reason => Gate?.Invoke();

    private string? BlockedAttr => Reason is null ? null : "true";

    /// <summary>
    /// The reason id while the button is gated; NOTHING while it works.
    ///
    /// <para>
    /// This is not a tidiness choice, it is the tooltip. The accessible DESCRIPTION is
    /// computed from aria-describedby FIRST and from <c>title</c> only if that source is
    /// absent — and "resolves to the empty string" counts as present. Measured in
    /// Chromium on 2026-09-03 with CDP <c>Accessibility.getFullAXTree</c>, on a button
    /// carrying both <c>title</c> and an aria-describedby pointing at an empty span:
    /// </para>
    /// <code>
    ///   title only, no describedby        -> description "Open trading dashboard (Alt+T)"
    ///   describedby -> empty span         -> description NULL      &lt;-- the defect
    ///   describedby -> whitespace span    -> description NULL
    ///   describedby -> span with text     -> description that text
    ///   describedby -> missing id         -> description falls back to the title
    /// </code>
    /// <para>
    /// So making aria-describedby unconditional on 2026-09-02 (the GatedButton pass)
    /// silently deleted the spoken tooltip from EVERY toolbar button. The two the user
    /// still heard something from — Objects and Zones — are simply the only two whose
    /// AriaLabel says more than their Label; he was hearing the NAME, not the tooltip.
    /// </para>
    /// <para>
    /// Pointing at nothing is safe here: the span is still rendered either way, so no
    /// IDREF ever dangles, and the reason arrives at exactly the moment there is one.
    /// </para>
    /// </summary>
    private string? DescribedByAttr => Reason is null ? null : ReasonId;

    private async Task ActivateAsync()
    {
        // Re-read the gate here rather than trusting the last render: aria-disabled
        // does not stop a click the way `disabled` did.
        var reason = Gate?.Invoke();
        if (reason is not null)
        {
            EventBus.Publish(new FeedbackRequestEvent(FeedbackType.Boundary, reason));
            return;
        }
        await OnClick.InvokeAsync();
    }
}
