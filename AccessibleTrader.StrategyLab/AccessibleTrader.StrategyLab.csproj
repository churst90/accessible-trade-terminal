<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccessibleTrader.StrategyLab</RootNamespace>
    <AssemblyName>StrategyLab</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The edge registry is data, not code: it ships beside the binary so other tools can read
         it without referencing the lab. EdgeRegistry.DefaultPath() expects it at Catalogue/. -->
    <None Update="Catalogue\edges.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The regime detector is verified against real bear-market dates in the test suite; a swing
         detector that quietly drifted would falsify a claim without anyone noticing. -->
    <InternalsVisibleTo Include="AccessibleTrader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Bitstamp\AccessibleTrader.Plugins.Bitstamp.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Mexc\AccessibleTrader.Plugins.Mexc.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Alpaca\AccessibleTrader.Plugins.Alpaca.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.OkxDerivatives\AccessibleTrader.Plugins.OkxDerivatives.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.AlternativeMe\AccessibleTrader.Plugins.AlternativeMe.csproj" />
  </ItemGroup>

</Project>
