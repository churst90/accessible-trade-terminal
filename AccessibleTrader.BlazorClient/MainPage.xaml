<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AccessibleTrader.BlazorClient"
             xmlns:components="clr-namespace:AccessibleTrader.BlazorClient.Components"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="AccessibleTrader.BlazorClient.MainPage"
             BackgroundColor="Black">

    <!-- Two-layer stack.  Grid children composite in declaration order:
         earlier child behind, later child on top.
           Layer 0 (bottom): BlazorWebView — toolbar, header, indicator bar,
                             footer, modals, ARIA live regions, keyboard
                             bridge. Spans the full Grid.
           Layer 1 (top):    Native SkiaSharp chart canvas. Declared AFTER
                             the WebView so it renders on top, but MARGIN-
                             constrained so it only covers the middle chart
                             region — the toolbar at top and the indicator
                             bar / footer at bottom stay visible.

         Why not canvas-behind-WebView: WebView2 on WinUI 3 composites as an
         opaque native layer. Its transparent pixels reveal the Grid's own
         background, NOT sibling XAML controls underneath it, so a canvas
         placed behind the WebView is never visible. The working model is
         canvas-on-top clipped by margin to just the chart region.

         The margin numbers match the cumulative height of the Blazor chrome
         above (header + icon toolbar + timeframe-quick-pick row ≈ 185 DIPs)
         and below (indicator bar + footer ≈ 100 DIPs) with a small safety
         pad. Measured from the rendered app at ~100% DPI; values were 140
         / 60 on first pass which clipped the Market/Provider row and the
         "Focused Indicator" label — bumped after visual verification. If
         the toolbar or footer grow further, bump again. For pixel-perfect
         sizing wire JS interop that reports ChartArea's bounding rect to
         the host. -->
    <Grid BackgroundColor="Black">
        <!-- Layer 0 (bottom): BlazorWebView spans the full Grid. -->
        <BlazorWebView x:Name="blazorWebView"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- Layer 1 (top): native chart canvas, margin-constrained to the
             middle chart region only. InputTransparent="True" so pointer /
             touch events pass through to the WebView underneath (the drawing
             tool layer handles mouse events via JS interop through Blazor). -->
        <skia:SKCanvasView x:Name="_chartCanvas"
                           PaintSurface="OnCanvasPaint"
                           InputTransparent="True"
                           IgnorePixelScaling="True"
                           Margin="0,185,0,100" />
    </Grid>

</ContentPage>
