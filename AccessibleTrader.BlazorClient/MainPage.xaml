<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AccessibleTrader.BlazorClient"
             xmlns:components="clr-namespace:AccessibleTrader.BlazorClient.Components"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="AccessibleTrader.BlazorClient.MainPage"
             BackgroundColor="Black">

    <!-- Two-layer stack.  Grid children are composited in declaration order:
         the earlier child is behind, the later child is on top.
           Layer 0 (bottom): Native SkiaSharp canvas — chart drawing lives here.
           Layer 1 (top):    BlazorWebView — toolbar, header, indicator bar,
                             footer, modals, ARIA live regions, keyboard bridge.
         The WebView's opaque regions (toolbar / header / footer / modals) cover
         the canvas; its transparent regions (the main / ChartArea element) let
         the canvas show through — that's how the chart appears in the middle
         while the toolbar stays visible at the top.

         Historic note: this file previously declared the children in the
         opposite order, which put the canvas on top of the WebView and hid
         the toolbar entirely (canvas.Clear(Black) paints the full area). -->
    <Grid BackgroundColor="Black">
        <!-- Layer 0 (bottom): native SkiaSharp chart canvas.
             InputTransparent="True" so pointer/touch events pass through to the
             WebView on top and get routed through its Blazor handlers. -->
        <skia:SKCanvasView x:Name="_chartCanvas"
                           PaintSurface="OnCanvasPaint"
                           InputTransparent="True"
                           IgnorePixelScaling="True" />

        <!-- Layer 1 (top): BlazorWebView hosting every interactive surface.
             Its DefaultBackgroundColor is forced to Transparent in
             OnBlazorWebViewInitialized so the transparent chart region in
             MainLayout.razor / ChartArea.razor lets the canvas show through. -->
        <BlazorWebView x:Name="blazorWebView"
                       HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>

</ContentPage>
