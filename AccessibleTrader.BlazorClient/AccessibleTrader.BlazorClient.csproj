    </ItemGroup>

    <!--
        Plugin trust manifest generation.

        After every build (Debug + Release), walk OutDir for
        AccessibleTrader.Plugins.*.dll files, hash each with SHA-256, and emit
        plugins_trusted.manifest into OutDir so PluginTrustPolicy picks it up
        at app startup. Running on every config means the dev workflow stays
        in sync with the shipping default RequireTrusted=true — otherwise a
        local Debug run would silently block every plugin.

        Runs via an inline task written in C#. No external scripts required,
        so the same csproj builds cleanly on Windows, Linux, and macOS CI.
    -->
    <UsingTask TaskName="HashPluginDlls"
               TaskFactory="RoslynCodeTaskFactory"
               AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <PluginsDir ParameterType="System.String" Required="true" />
            <ManifestPath ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Using Namespace="System" />
            <Using Namespace="System.IO" />
            <Using Namespace="System.Linq" />
            <Using Namespace="System.Security.Cryptography" />
            <Using Namespace="System.Text" />
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                if (!Directory.Exists(PluginsDir))
                {
                    Log.LogMessage(MessageImportance.Normal, $"Plugins dir {PluginsDir} not found — skipping manifest generation.");
                    return true;
                }

                var dlls = Directory
                    .EnumerateFiles(PluginsDir, "AccessibleTrader.Plugins.*.dll", SearchOption.AllDirectories)
                    .Where(p => !p.Contains(Path.DirectorySeparatorChar + "ref" + Path.DirectorySeparatorChar))
                    .Select(p => new { Path = p, Name = Path.GetFileName(p) })
                    .GroupBy(x => x.Name)
                    .Select(g => g.First())
                    .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (dlls.Count == 0)
                {
                    Log.LogMessage(MessageImportance.Normal, $"No AccessibleTrader.Plugins.*.dll found under {PluginsDir} — skipping manifest generation.");
                    return true;
                }

                var sb = new StringBuilder();
                sb.AppendLine("# AccessibleTrader plugin trust manifest");
                sb.AppendLine("# Generated: " + DateTime.UtcNow.ToString("u"));
                sb.AppendLine("# One SHA-256 hex digest per line. '#' starts a comment.");
                sb.AppendLine("# Generated automatically by the BlazorClient Release build target.");
                sb.AppendLine();

                // SHA256.HashData(stream) is .NET 5+ and isn't available inside
                // the RoslynCodeTaskFactory host on some build SDKs. Use the
                // broadly-compatible Create()+ComputeHash() pair instead so the
                // task compiles under every supported MSBuild runtime.
                using (var sha = SHA256.Create())
                {
                    foreach (var dll in dlls)
                    {
                        byte[] hash;
                        using (var fs = File.OpenRead(dll.Path))
                            hash = sha.ComputeHash(fs);
                        var hex = BitConverter.ToString(hash).Replace("-", "");
                        sb.Append(hex).Append("  # ").AppendLine(dll.Name);
                    }
                }

                Directory.CreateDirectory(Path.GetDirectoryName(ManifestPath));
                File.WriteAllText(ManifestPath, sb.ToString());
                Log.LogMessage(MessageImportance.High, $"Wrote {dlls.Count} trusted plugin hashes to {ManifestPath}");
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <Target Name="GeneratePluginTrustManifest"
            AfterTargets="Build"
            Condition=" '$(OutDir)' != '' ">
        <HashPluginDlls
            PluginsDir="$(OutDir)"
            ManifestPath="$(OutDir)plugins_trusted.manifest" />
    </Target>

    <!--
        Publish-time manifest, and the desktop head went without it for its entire life.

        The Build-time target above writes to $(OutDir), which a `dotnet publish` does NOT
        carry into the publish output. So every released zip of this head shipped 33 plugin
        DLLs and NO plugins_trusted.manifest, the policy loaded an empty allow-list,
        RequireTrusted refused all 33, and the market dropdown offered only the built-in
        providers. Reported from a Windows VM on 2026-09-21 as "the market dropdown only
        shows My Data and analytics", and confirmed by unzipping the artifact: 33 DLLs
        present, manifest absent.

        The WebHost has had exactly this target since its own publish shipped without one,
        comment and all. It was never applied here — which is the finding worth keeping:
        the two heads have separate project files and a fix landed in one of them is not a
        fix, it is a fix in one place. Hashing the PUBLISHED DLLs rather than the built ones
        also keeps the digests matching what actually ships.
    -->
    <Target Name="GeneratePluginTrustManifestOnPublish"
            AfterTargets="Publish"
            Condition=" '$(PublishDir)' != '' ">
        <HashPluginDlls
            PluginsDir="$(PublishDir)"
            ManifestPath="$(PublishDir)plugins_trusted.manifest" />
    </Target>

    <!--
        Copy the built ScriptWorker output next to the host binary so
        RoslynScriptingService's DefaultWorkerPathResolver finds the exe at
        AppContext.BaseDirectory. The ScriptWorker targets plain net10.0 so
        the source directory is deterministic across MAUI multi-target
        configurations; we copy the whole net10.0 output so deps and
        runtimeconfig.json come along.

        Only runs on desktop-class TFMs that actually reference the worker.
        Android / iOS don't use an external exe (see ProjectReference comment
        above); running the copy there would fail with "source files not
        found" anyway since the ProjectReference guard skips the worker's
        build dependency on those targets.
    -->
    <!--
        Stage the Dot Pad 2nd-gen SDK runtime alongside the host binary on Windows.
        DotPadSDK-3.0.0.dll is loaded at runtime by WindowsDotPadNative via
        NativeLibrary.TryLoad; the SDK's internal modules (TTBEngine, Mecab, jsoncpp,
        liblouis) expect to find each other in the same directory. The tables/
        directory holds LibLouis translation tables and ipadic/ holds the Japanese
        dictionary — both shipped by Dot Inc as zips, extracted in-repo so the build
        can copy them as files. mecabrc is the MeCab config file.

        The SDK is NOT committed to the repo (gitignored — vendor binaries, ~850MB).
        Both the Exists() guard on this target's Condition and the missing-SDK
        warning below make the build succeed on a fresh clone; Dot Pad tactile
        support is simply disabled at runtime until the user follows the
        download steps in docs/PLATFORMS.md.

        Windows-only because the SDK is shipped as .dll files; Linux/macOS will need
        their own staging target when we bind to those SDKs.
    -->
    <Target Name="WarnIfDotPadSdkMissing"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND !Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
        <Message Importance="high" Text="Dot Pad SDK not found at dotpad-sdk/Windows/dotpad-3.0.0/. Tactile-display support will be unavailable at runtime. Download the SDK from https://github.com/dotincorp/dotpad-sample-code and extract Windows/3.0.0/ into dotpad-sdk/Windows/dotpad-3.0.0/. See docs/PLATFORMS.md." />
    </Target>

    <Target Name="CopyDotPadSdkWindows"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
        <ItemGroup>
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc" />
            <DotPadSdkTables Include="..\dotpad-sdk\Windows\dotpad-3.0.0\tables\**\*.*" />
            <DotPadSdkIpadic Include="..\dotpad-sdk\Windows\dotpad-3.0.0\ipadic\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(DotPadSdkBinaries)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkBinaries)' != '' " />
        <Copy SourceFiles="@(DotPadSdkTables)"
              DestinationFolder="$(OutDir)tables\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkTables)' != '' " />
        <Copy SourceFiles="@(DotPadSdkIpadic)"
              DestinationFolder="$(OutDir)ipadic\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkIpadic)' != '' " />
    </Target>

    <!--
        The SAME payloads again, as PUBLISH items this time, and without them neither feature
        exists in a released build.

        The two targets above copy into $(OutDir). A `dotnet publish` does not carry a loose file
        a custom target dropped there, so every released Windows zip has shipped with no Dot Pad
        SDK and no script worker. Demonstrated 2026-09-21 by unzipping the CI artifact: none of
        DotPadSDK-3.0.0.dll, TTBEngine.dll, Mecab.dll, jsoncpp.dll, liblouis.dll, mecabrc,
        tables/ or ipadic/ was in it, and neither was AccessibleTrader.ScriptWorker.exe.

        What that costs, concretely:
          - WindowsDotPadNative logs "NativeLibrary.TryLoad failed ... Tactile DISABLED" and the
            app falls back to NullDotPadNative. The Braille tab still RENDERS — it is ordinary
            DOM — so the feature looks present and is inert, which is the worst of the two.
          - RoslynScriptingService.DefaultWorkerPathResolver looks for the worker beside the host
            binary, and Release builds refuse the in-process path by design, so user-compiled
            indicators and strategies cannot run at all.

        Neither payload is in the repo (the Dot Pad SDK is gitignored vendor binaries; the worker
        is build output), so every item is guarded by Exists() and a build without them still
        succeeds — the warning targets above say so.
    -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows'">
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
            <Link>DotPadSDK-3.0.0.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll')">
            <Link>TTBEngine.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll')">
            <Link>Mecab.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll')">
            <Link>jsoncpp.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll')">
            <Link>liblouis.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc')">
            <Link>mecabrc</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <!--
            LibLouis translation tables (~14MB). Needed for text-to-braille: the driver binds
            DOT_PAD_BRAILLE_DISPLAY among its REQUIRED exports, so the text path is live, not
            optional.

            ipadic/ — the MeCab JAPANESE dictionary, 187MB of the SDK's 204MB staged footprint —
            is deliberately NOT here. Whether the SDK loads it at init regardless of the selected
            language is an empirical question that needs a Windows box and a device to answer,
            and 187MB in every release zip is not a cost to pay on a guess. If a Dot Pad ever
            fails to initialise with everything else present, this is the first thing to add back.
        -->
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\tables\**\*.*" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\tables')">
            <Link>tables\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!--
        The script worker, published. It is a ProjectReference, so its ASSEMBLIES travel, but the
        standalone .exe and its runtimeconfig.json — which is what
        RoslynScriptingService.DefaultWorkerPathResolver actually launches — were staged only into
        $(OutDir) by CopyScriptWorker. AfterTargets="Publish" rather than an item group because
        the worker's own output does not exist until its project has built.
    -->
    <Target Name="CopyScriptWorkerOnPublish"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != '' AND ('$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0')">
        <ItemGroup>
            <!--
                EXCLUDE runtimes/ and *.pdb, and the numbers are the argument. The worker's build
                output is a full app output, so a bare **\*.* wildcard drags in a runtimes/ tree
                with SkiaSharp native binaries and DEBUG SYMBOLS for every RID the package
                supports — win-x86, win-arm64, osx, five flavours of iOS. Measured on the first
                build that shipped it: 354MB added to the artifact, 243MB of that .pdb files, for
                a payload that actually needs FIVE FILES totalling 0.2MB.
                Everything else was already in the host publish, which is the same application
                with the same dependencies; the wildcard only "added" the parts the host had no
                reason to publish in the first place.
            -->
            <PublishedScriptWorkerFiles
                Include="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.*"
                Exclude="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\runtimes\**\*.*;..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(PublishedScriptWorkerFiles)"
              DestinationFolder="$(PublishDir)%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(PublishedScriptWorkerFiles)' != '' " />
    </Target>

    <!--
        Stage the NVDA Controller Client alongside the host binary on Windows.

        BlazorSpeechManager P/Invokes nvdaControllerClient64.dll for NVDA-direct speech, and
        that path is not a nicety on this head: the chart is a native SkiaSharp canvas sitting
        ON TOP of the BlazorWebView, so when the user focuses the chart the screen reader is not
        looking at the WebView's DOM at all and the ARIA live-region fallback cannot reach it.
        No DLL means no speech from the chart, which is the whole application.

        Until 2026-09-21 NOTHING in the build staged this file. One copy had been dropped by
        hand into bin/Debug on 2026-03-03 and never tracked, referenced by any project file, or
        included in a publish — so the developer's own machine spoke and every fresh build and
        every published install was mute. Reported from the Windows VM, 2026-09-21.

        Vendored rather than committed, exactly like the Dot Pad SDK above: it is a third-party
        binary (NV Access, LGPL 2.1). The Exists() guard and the warning below keep a fresh
        clone building; NVDA-direct speech is simply unavailable until the file is placed. See
        docs/PLATFORMS.md.
    -->
    <Target Name="WarnIfNvdaControllerMissing"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND !Exists('..\vendor\nvda\nvdaControllerClient.dll') AND !Exists('..\vendor\nvda\nvdaControllerClient64.dll')">
        <Message Importance="high" Text="NVDA Controller Client not found at vendor/nvda/nvdaControllerClient64.dll. NVDA-direct speech will be unavailable at runtime, and because the chart canvas is a native control the ARIA live-region fallback cannot reach a screen reader while the chart has focus — the chart will be SILENT. Download nvdaControllerClient from https://github.com/nvaccess/nvda/releases (controllerClient zip) and copy the x64 nvdaControllerClient64.dll into vendor/nvda/. See docs/PLATFORMS.md." />
    </Target>

    <!--
        A CONTENT ITEM, not a Copy to $(OutDir), and the difference is the whole point.

        The first cut of this staged the DLL with an AfterTargets="Build" copy into $(OutDir),
        exactly like CopyDotPadSdkWindows above. That reaches a `dotnet build` and NOT a
        `dotnet publish`: $(PublishDir) is a separate directory and a loose file dropped into the
        build output by a custom target is not a publish item, so it does not travel. The release
        zip is a flat `dotnet publish` into publish/maui-win (.github/workflows/release.yml),
        so the fix would have worked on a developer's machine and shipped nothing — which is the
        same failure mode, one layer up, as the hand-dropped DLL it was written to replace.

        CopyToPublishDirectory is what makes it travel. The Link metadata flattens it to the root
        of the output rather than recreating ../vendor/nvda/ there, so it lands beside the
        executable where the default DLL search order will find it.
    -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows'">
        <!--
            BOTH accepted spellings, because NV Access renamed the file. Current
            controllerClient downloads ship x64/nvdaControllerClient.dll; releases from
            some years ago shipped nvdaControllerClient64.dll, and that older name is
            what this code P/Invoked and what every instruction written for it said.
            Whichever the vendor directory holds is staged; NvdaControllerClient resolves
            either at load time.
        -->
        <None Include="..\vendor\nvda\nvdaControllerClient.dll" Condition="Exists('..\vendor\nvda\nvdaControllerClient.dll')">
            <Link>nvdaControllerClient.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\vendor\nvda\nvdaControllerClient64.dll" Condition="Exists('..\vendor\nvda\nvdaControllerClient64.dll')">
            <Link>nvdaControllerClient64.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <Target Name="CopyScriptWorker"
            AfterTargets="Build"
            BeforeTargets="GeneratePluginTrustManifest"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0'">
        <ItemGroup>
            <!-- Same exclusions as CopyScriptWorkerOnPublish below; see the note there. -->
            <ScriptWorkerFiles
                Include="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.*"
                Exclude="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\runtimes\**\*.*;..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(ScriptWorkerFiles)"
              DestinationFolder="$(OutDir)%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(ScriptWorkerFiles)' != '' " />
    </Target>

</Project>
