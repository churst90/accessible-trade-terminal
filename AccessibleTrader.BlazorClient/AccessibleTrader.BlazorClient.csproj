<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>AccessibleTrader.BlazorClient</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>AccessibleTrader.BlazorClient</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.accessibletrader.blazorclient</ApplicationId>

        <!-- Versions — display version inherits from Directory.Build.props;
             ApplicationVersion is the store build counter, bumped per submission. -->
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
        <ApplicationVersion>12</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
        Release-publish RID configuration, consumed by the CI release workflow
        (.github/workflows/release.yml). These live INSIDE this project and are
        scoped per-TFM via Condition so they never flow to the referenced
        net10.0 libraries or to the other heads' TFMs (android/ios) — which is
        exactly what passing -r / -p:RuntimeIdentifier(s) on the command line
        does, producing NETSDK1005 / NETSDK1083 / Mono runtime-pack errors.

        Gated on ReleasePublish=true (the workflow passes -p:ReleasePublish=true)
        so ordinary local builds and VS F5 are completely unaffected.

          - Windows: self-contained, unpackaged (WindowsPackageType=None above)
            win-x64 so the unzipped folder runs with no .NET / WindowsAppRuntime
            install on the user's machine.
          - Mac Catalyst: RuntimeIdentifiers (plural) builds one universal
            x64 + arm64 .app. Unsigned (ad-hoc) — see the workflow header.
    -->
    <PropertyGroup Condition="'$(ReleasePublish)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!--
            Framework-dependent on purpose. The host ProjectReferences the
            ScriptWorker — a non-self-contained net10.0 exe copied next to the
            host so custom scripts can run. A SELF-contained host referencing a
            non-self-contained exe fails NETSDK1150, so we keep the .NET runtime
            framework-dependent (users install the .NET 10 Desktop Runtime).
            WindowsAppSDK stays self-contained, so no separate WindowsAppRuntime
            install is needed.
        -->
        <SelfContained>false</SelfContained>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <!--
            STATED, because it stopped being true without anyone changing it.

            The v2.11.0 Windows app was precompiled and the v2.12.0 one was not. Nothing in this
            repository set PublishReadyToRun either way, so an implicit default moved underneath
            us — the candidates are the action bumps in 9e262b6e (setup-dotnet v4→v5, checkout
            v4→v5) or a windows-latest image roll; the cause was never established. The only
            trace it left was the zip falling 148.4 → 130.8 MB while GAINING seven files, with
            109 assemblies shrinking: Microsoft.CodeAnalysis.CSharp.dll 18.5 → 6.8 MB,
            AccessibleTrader.Core.dll 6.0 → 2.4 MB. Confirmed by reading the PE CLI headers out
            of both published zips — 2.11.0 carries a ManagedNativeHeader, 2.12.0 has none.

            What it costs is startup and first-use JIT on the head with the slowest start
            already, which on this application is the difference between a chart that speaks
            when you open it and one that speaks a few seconds later. Wanted, therefore set
            here rather than inherited; and asserted on the artifact rather than on the
            intention, by the readyToRun block in packaging/release-payloads.json.
        -->
        <PublishReadyToRun>true</PublishReadyToRun>
    </PropertyGroup>
    <PropertyGroup Condition="'$(ReleasePublish)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
        <!--
            Use the Mono interpreter instead of full AOT for the release .app.
            Release Mac Catalyst defaults to AOT, which fails on this large
            multi-plugin app ("AOT compiler exited with code 1"). The interpreter
            yields a working unsigned .app with slightly slower startup; identical
            behaviour otherwise. Revisit if/when AOT is needed for App Store size.
        -->
        <UseInterpreter>true</UseInterpreter>
        <RunAOTCompilation>false</RunAOTCompilation>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#0B2F21" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0B2F21" BaseSize="192,192" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DynamicData" Version="9.4.31" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
        <!-- Patched SQLite native lib (SQLite 3.50.3) overriding the transitive 2.1.11 flagged by
             NU1903 / GHSA-2m69-gcr7-jv3q. See AccessibleTrader.Core.csproj for the rationale. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
        <!--
            The SAME advisory, on the per-platform native builds, and the pin above does not
            reach them: they are separate packages. This project is the only one that
            multi-targets android and ios, so it is the only one that pulls
            SQLitePCLRaw.lib.e_sqlite3.android / .ios, and both stayed on the flagged 2.1.11
            while the desktop one was fixed. CVE-2025-6965 is a memory-corruption bug in SQLite
            before 3.50.2.

            2.1.13 is the newest published build of these two — there is no 3.x for them — and
            it CLEARS the advisory: restoring 2.1.13 with NuGetAudit produces no NU1903 where
            2.1.11 produces one per package (measured 2026-09-21, not assumed).

            Worth knowing for anyone weighing the risk: neither android nor ios is SHIPPED. The
            release workflow publishes net10.0-windows10.0.19041.0 and net10.0-maccatalyst only.
            The TFMs exist so the heads keep compiling, so this was a real advisory against code
            that reaches no user — which is exactly the kind of thing that sits unfixed because
            each person who looks at it decides it is somebody else's.
        -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" Condition="!$([MSBuild]::IsOSPlatform('linux'))" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
        <PackageReference Include="System.Reactive" Version="6.1.0" />
    </ItemGroup>

    <!-- ── Windows tray icon (ON by default; opt-out with -p:EnableWindowsTrayIcon=false) ──
         The Windows head (built by release.yml on every tag, and any Windows dev
         session) now compiles the close-to-tray applet by default. Inert on the
         Linux dev box, where the Windows TFM is excluded. Still verify close-to-
         tray + restore + exit on a real Windows session; opt out with the flag if
         a Windows build needs to skip it. -->
    <PropertyGroup>
        <EnableWindowsTrayIcon Condition="'$(EnableWindowsTrayIcon)' == ''">true</EnableWindowsTrayIcon>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(EnableWindowsTrayIcon)' == 'true'">
        <DefineConstants>$(DefineConstants);TRAY_ICON</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(EnableWindowsTrayIcon)' == 'true'">
        <PackageReference Include="H.NotifyIcon.Maui" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AccessibleTrader.BlazorClient.Components\AccessibleTrader.BlazorClient.Components.csproj" />
      <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
      <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
      <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
      <!--
        Reference the script worker project so it builds before the host,
        but do NOT link its assembly into the host (ReferenceOutputAssembly
        false). The CopyScriptWorker target below copies its bin/$(Config)
        output next to the host binary at build time so
        DefaultProcessLauncher can spawn it from AppContext.BaseDirectory.

        ONLY included on desktop-class TFMs (Windows / macCatalyst).
        - Android hosts the worker inside the in-APK ScriptWorkerService
          class with android:isolatedProcess="true" — no external exe to copy.
        - iOS refuses script compilation entirely (see CustomScriptsModal.razor).
        - Referencing a non-self-contained exe from a self-contained mobile
          target fails NETSDK1150; the TFM guard below skips the reference
          on those targets.
      -->
      <ProjectReference Include="..\AccessibleTrader.ScriptWorker\AccessibleTrader.ScriptWorker.csproj"
                         Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0'">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <Private>false</Private>
      </ProjectReference>
      <!-- Providers (tradeable market data) -->
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Alpaca\AccessibleTrader.Plugins.Alpaca.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Binance\AccessibleTrader.Plugins.Binance.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Bitstamp\AccessibleTrader.Plugins.Bitstamp.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Coinbase\AccessibleTrader.Plugins.Coinbase.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Finnhub\AccessibleTrader.Plugins.Finnhub.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Fmp\AccessibleTrader.Plugins.Fmp.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.InteractiveBrokers\AccessibleTrader.Plugins.InteractiveBrokers.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Kraken\AccessibleTrader.Plugins.Kraken.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.KrakenFutures\AccessibleTrader.Plugins.KrakenFutures.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Gemini\AccessibleTrader.Plugins.Gemini.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Mexc\AccessibleTrader.Plugins.Mexc.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Oanda\AccessibleTrader.Plugins.Oanda.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Polygon\AccessibleTrader.Plugins.Polygon.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Schwab\AccessibleTrader.Plugins.Schwab.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Tradier\AccessibleTrader.Plugins.Tradier.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.TwelveData\AccessibleTrader.Plugins.TwelveData.csproj" />
      <!-- Analytics (non-tradeable data: on-chain, derivatives, sentiment, economic) -->
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.AlternativeMe\AccessibleTrader.Plugins.AlternativeMe.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.WikipediaPageviews\AccessibleTrader.Plugins.WikipediaPageviews.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.SecEdgar\AccessibleTrader.Plugins.SecEdgar.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BGeometrics\AccessibleTrader.Plugins.BGeometrics.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BinanceDerivatives\AccessibleTrader.Plugins.BinanceDerivatives.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BinanceVision\AccessibleTrader.Plugins.BinanceVision.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Cftc\AccessibleTrader.Plugins.Cftc.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Finra\AccessibleTrader.Plugins.Finra.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.CoinGecko\AccessibleTrader.Plugins.CoinGecko.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.CoinMetrics\AccessibleTrader.Plugins.CoinMetrics.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.DefiLlama\AccessibleTrader.Plugins.DefiLlama.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Deribit\AccessibleTrader.Plugins.Deribit.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Etherscan\AccessibleTrader.Plugins.Etherscan.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Fred\AccessibleTrader.Plugins.Fred.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Glassnode\AccessibleTrader.Plugins.Glassnode.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Mempool\AccessibleTrader.Plugins.Mempool.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.OkxDerivatives\AccessibleTrader.Plugins.OkxDerivatives.csproj" />
    </ItemGroup>

    <!--
        Plugin trust manifest generation, shared with the WebHost head.

        This used to be a copy of the WebHost's inline task and targets, and the copying is the
        point: the publish-time target existed there for its whole life and was never applied
        here, so every released desktop zip shipped 33 plugin DLLs with no manifest and the
        market dropdown offered only the built-in providers. Copying it across then inherited a
        second assumption — that the manifest belongs at $(PublishDir) — which is false on Mac
        Catalyst, where the plugins and AppContext.BaseDirectory are both inside
        AppBundle.app/Contents/MonoBundle. Stated once, in one file, the rule is simply "the
        manifest goes where the plugins are". See packaging/PluginTrustManifest.targets.
    -->
    <Import Project="$(MSBuildThisFileDirectory)..\packaging\PluginTrustManifest.targets" />

    <!--
        Copy the built ScriptWorker output next to the host binary so
        RoslynScriptingService's DefaultWorkerPathResolver finds the exe at
        AppContext.BaseDirectory. The ScriptWorker targets plain net10.0 so
        the source directory is deterministic across MAUI multi-target
        configurations; we copy the whole net10.0 output so deps and
        runtimeconfig.json come along.

        Only runs on desktop-class TFMs that actually reference the worker.
        Android / iOS don't use an external exe (see ProjectReference comment
        above); running the copy there would fail with "source files not
        found" anyway since the ProjectReference guard skips the worker's
        build dependency on those targets.
    -->
    <!--
        Stage the Dot Pad 2nd-gen SDK runtime alongside the host binary on Windows.
        DotPadSDK-3.0.0.dll is loaded at runtime by WindowsDotPadNative via
        NativeLibrary.TryLoad; the SDK's internal modules (TTBEngine, Mecab, jsoncpp,
        liblouis) expect to find each other in the same directory. The tables/
        directory holds LibLouis translation tables and ipadic/ holds the Japanese
        dictionary — both shipped by Dot Inc as zips, extracted in-repo so the build
        can copy them as files. mecabrc is the MeCab config file.

        The SDK is NOT committed to the repo (gitignored — vendor binaries, ~850MB).
        Both the Exists() guard on this target's Condition and the missing-SDK
        warning below make the build succeed on a fresh clone; Dot Pad tactile
        support is simply disabled at runtime until the user follows the
        download steps in docs/PLATFORMS.md.

        Windows-only because the SDK is shipped as .dll files; Linux/macOS will need
        their own staging target when we bind to those SDKs.
    -->
    <Target Name="WarnIfDotPadSdkMissing"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND !Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
        <!--
            AN ERROR ON A RELEASE PUBLISH, a message everywhere else, and v2.12.0 is why.

            That release told users "Braille and Dot Pad support is actually in the download".
            It was not in any of the six published assets: dotpad-sdk/ is gitignored, every item
            below is Exists()-guarded so a build without it succeeds in silence, and the release
            is built by GitHub Actions, which had no copy. A green run, a published release, and
            an inert feature — and the Braille tab renders fine on a build that cannot load the
            SDK, so nothing about the running application says otherwise.

            A release that ships a dead feature is worse than a release that fails, so on
            ReleasePublish=true this stops the build. release.yml fetches the SDK from the
            vendor's own public repository, pinned by SHA-256, before it publishes.
        -->
        <Error Condition="'$(ReleasePublish)' == 'true'"
               Text="RELEASE BUILD WITH NO DOT PAD SDK. dotpad-sdk/Windows/dotpad-3.0.0/DotPadSDK-3.0.0.dll is absent, so this release would ship with tactile output inert while the Braille tab still renders — which is exactly what v2.12.0 did. release.yml's 'Fetch Dot Pad SDK runtime' step supplies it; if you are publishing by hand, download Windows/3.0.0/ from https://github.com/dotincorp/dotpad-sdk-guide into dotpad-sdk/Windows/dotpad-3.0.0/. See docs/PLATFORMS.md." />
        <Message Importance="high" Text="Dot Pad SDK not found at dotpad-sdk/Windows/dotpad-3.0.0/. Tactile-display support will be unavailable at runtime. Download the SDK from https://github.com/dotincorp/dotpad-sdk-guide and extract Windows/3.0.0/ into dotpad-sdk/Windows/dotpad-3.0.0/. See docs/PLATFORMS.md." />
    </Target>

    <Target Name="CopyDotPadSdkWindows"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
        <ItemGroup>
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll" />
            <DotPadSdkBinaries Include="..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc" />
            <DotPadSdkTables Include="..\dotpad-sdk\Windows\dotpad-3.0.0\tables\**\*.*" />
            <DotPadSdkIpadic Include="..\dotpad-sdk\Windows\dotpad-3.0.0\ipadic\**\*.*" />
        </ItemGroup>
        <Copy SourceFiles="@(DotPadSdkBinaries)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkBinaries)' != '' " />
        <Copy SourceFiles="@(DotPadSdkTables)"
              DestinationFolder="$(OutDir)tables\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkTables)' != '' " />
        <Copy SourceFiles="@(DotPadSdkIpadic)"
              DestinationFolder="$(OutDir)ipadic\%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(DotPadSdkIpadic)' != '' " />
    </Target>

    <!--
        The SAME payloads again, as PUBLISH items this time, and without them neither feature
        exists in a released build.

        The two targets above copy into $(OutDir). A `dotnet publish` does not carry a loose file
        a custom target dropped there, so every released Windows zip has shipped with no Dot Pad
        SDK and no script worker. Demonstrated 2026-09-21 by unzipping the CI artifact: none of
        DotPadSDK-3.0.0.dll, TTBEngine.dll, Mecab.dll, jsoncpp.dll, liblouis.dll, mecabrc,
        tables/ or ipadic/ was in it, and neither was AccessibleTrader.ScriptWorker.exe.

        What that costs, concretely:
          - WindowsDotPadNative logs "NativeLibrary.TryLoad failed ... Tactile DISABLED" and the
            app falls back to NullDotPadNative. The Braille tab still RENDERS — it is ordinary
            DOM — so the feature looks present and is inert, which is the worst of the two.
          - RoslynScriptingService.DefaultWorkerPathResolver looks for the worker beside the host
            binary, and Release builds refuse the in-process path by design, so user-compiled
            indicators and strategies cannot run at all.

        Neither payload is in the repo (the Dot Pad SDK is gitignored vendor binaries; the worker
        is build output), so every item is guarded by Exists() and a build without them still
        succeeds — the warning targets above say so.
    -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows'">
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll')">
            <Link>DotPadSDK-3.0.0.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\TTBEngine.dll')">
            <Link>TTBEngine.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\Mecab.dll')">
            <Link>Mecab.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\jsoncpp.dll')">
            <Link>jsoncpp.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\liblouis.dll')">
            <Link>liblouis.dll</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\mecabrc')">
            <Link>mecabrc</Link><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <!--
            LibLouis translation tables (~14MB). Needed for text-to-braille: the driver binds
            DOT_PAD_BRAILLE_DISPLAY among its REQUIRED exports, so the text path is live, not
            optional.

            ipadic/ — the MeCab JAPANESE dictionary, 187MB of the SDK's 204MB staged footprint —
            is deliberately NOT here. Whether the SDK loads it at init regardless of the selected
            language is an empirical question that needs a Windows box and a device to answer,
            and 187MB in every release zip is not a cost to pay on a guess. If a Dot Pad ever
            fails to initialise with everything else present, this is the first thing to add back.
        -->
        <None Include="..\dotpad-sdk\Windows\dotpad-3.0.0\tables\**\*.*" Condition="Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\tables')">
            <Link>tables\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!--
        The script worker, published. It is a ProjectReference, so its ASSEMBLIES travel, but the
        standalone .exe and its runtimeconfig.json — which is what
        RoslynScriptingService.DefaultWorkerPathResolver actually launches — were staged only into
        $(OutDir) by CopyScriptWorker. AfterTargets="Publish" rather than an item group because
        the worker's own output does not exist until its project has built.
    -->
    <Target Name="CopyScriptWorkerOnPublish"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != '' AND ('$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0')">
        <ItemGroup>
            <!--
                EXCLUDE runtimes/ and *.pdb, and the numbers are the argument. The worker's build
                output is a full app output, so a bare **\*.* wildcard drags in a runtimes/ tree
                with SkiaSharp native binaries and DEBUG SYMBOLS for every RID the package
                supports — win-x86, win-arm64, osx, five flavours of iOS. Measured on the first
                build that shipped it: 354MB added to the artifact, 243MB of that .pdb files, for
                a payload that actually needs FIVE FILES totalling 0.2MB.
                Everything else was already in the host publish, which is the same application
                with the same dependencies; the wildcard only "added" the parts the host had no
                reason to publish in the first place.
            -->
            <PublishedScriptWorkerFiles
                Include="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.*"
                Exclude="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\runtimes\**\*.*;..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(PublishedScriptWorkerFiles)"
              DestinationFolder="$(PublishDir)%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(PublishedScriptWorkerFiles)' != '' " />
    </Target>

    <!--
        Stage the NVDA Controller Client alongside the host binary on Windows.

        BlazorSpeechManager P/Invokes nvdaControllerClient64.dll for NVDA-direct speech, and
        that path is not a nicety on this head: the chart is a native SkiaSharp canvas sitting
        ON TOP of the BlazorWebView, so when the user focuses the chart the screen reader is not
        looking at the WebView's DOM at all and the ARIA live-region fallback cannot reach it.
        No DLL means no speech from the chart, which is the whole application.

        Until 2026-09-21 NOTHING in the build staged this file. One copy had been dropped by
        hand into bin/Debug on 2026-03-03 and never tracked, referenced by any project file, or
        included in a publish — so the developer's own machine spoke and every fresh build and
        every published install was mute. Reported from the Windows VM, 2026-09-21.

        Vendored rather than committed, exactly like the Dot Pad SDK above: it is a third-party
        binary (NV Access, LGPL 2.1). The Exists() guard and the warning below keep a fresh
        clone building; NVDA-direct speech is simply unavailable until the file is placed. See
        docs/PLATFORMS.md.
    -->
    <Target Name="WarnIfNvdaControllerMissing"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND !Exists('..\vendor\nvda\nvdaControllerClient.dll') AND !Exists('..\vendor\nvda\nvdaControllerClient64.dll')">
        <!--
            AN ERROR ON A RELEASE PUBLISH. Same reasoning as WarnIfDotPadSdkMissing above, and
            the stakes are higher: on this head the chart is a native SkiaSharp canvas over the
            BlazorWebView, so with no controller client a chart that has focus is SILENT, and
            silence is this application's total failure. v2.12.0 shipped exactly that while its
            notes said "It is in the download now, under both the names NV Access has used for
            it, so nothing needs renaming or placing by hand."

            "A release that ships mute is worse than a release that fails" — the VPS note that
            found it, and the rule this line encodes.
        -->
        <Error Condition="'$(ReleasePublish)' == 'true'"
               Text="RELEASE BUILD WITH NO NVDA CONTROLLER CLIENT. Neither vendor/nvda/nvdaControllerClient.dll nor nvdaControllerClient64.dll exists, so this release would ship MUTE for every NVDA user: the chart canvas is a native control, the ARIA live-region fallback cannot reach a reader focused on it, and there is no other path. release.yml's 'Fetch NVDA controller client' step supplies it; if you are publishing by hand, take the x64 DLL from https://www.nvaccess.org/files/nvda/releases/&lt;version&gt;/nvda_&lt;version&gt;_controllerClient.zip into vendor/nvda/. See docs/PLATFORMS.md." />
        <Message Importance="high" Text="NVDA Controller Client not found at vendor/nvda/nvdaControllerClient64.dll. NVDA-direct speech will be unavailable at runtime, and because the chart canvas is a native control the ARIA live-region fallback cannot reach a screen reader while the chart has focus — the chart will be SILENT. Download nvdaControllerClient from https://github.com/nvaccess/nvda/releases (controllerClient zip) and copy the x64 nvdaControllerClient64.dll into vendor/nvda/. See docs/PLATFORMS.md." />
    </Target>

    <!--
        A CONTENT ITEM, not a Copy to $(OutDir), and the difference is the whole point.

        The first cut of this staged the DLL with an AfterTargets="Build" copy into $(OutDir),
        exactly like CopyDotPadSdkWindows above. That reaches a `dotnet build` and NOT a
        `dotnet publish`: $(PublishDir) is a separate directory and a loose file dropped into the
        build output by a custom target is not a publish item, so it does not travel. The release
        zip is a flat `dotnet publish` into publish/maui-win (.github/workflows/release.yml),
        so the fix would have worked on a developer's machine and shipped nothing — which is the
        same failure mode, one layer up, as the hand-dropped DLL it was written to replace.

        CopyToPublishDirectory is what makes it travel. The Link metadata flattens it to the root
        of the output rather than recreating ../vendor/nvda/ there, so it lands beside the
        executable where the default DLL search order will find it.
    -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows'">
        <!--
            BOTH accepted spellings, because NV Access renamed the file. Current
            controllerClient downloads ship x64/nvdaControllerClient.dll; releases from
            some years ago shipped nvdaControllerClient64.dll, and that older name is
            what this code P/Invoked and what every instruction written for it said.
            Whichever the vendor directory holds is staged; NvdaControllerClient resolves
            either at load time.
        -->
        <None Include="..\vendor\nvda\nvdaControllerClient.dll" Condition="Exists('..\vendor\nvda\nvdaControllerClient.dll')">
            <Link>nvdaControllerClient.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\vendor\nvda\nvdaControllerClient64.dll" Condition="Exists('..\vendor\nvda\nvdaControllerClient64.dll')">
            <Link>nvdaControllerClient64.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <!--
        The Visual C++ runtime, because the Dot Pad SDK is a C++ library and we now ship it.

        Read out of DotPadSDK-3.0.0.dll's PE import table on 2026-09-22: its only non-system
        imports are MSVCP140.dll, VCRUNTIME140.dll and VCRUNTIME140_1.dll. A .NET publish carries
        none of the three — the published v2.12.0 Windows zip has 637 entries and not one of them
        is a VC++ runtime file. On a machine without the Visual C++ 2015-2022 redistributable
        installed, NativeLibrary.TryLoad therefore fails, WindowsDotPadNative logs "Tactile
        DISABLED", and the Braille tab renders as though everything were fine.

        That is the same silent-inert-feature failure that staging the SDK is meant to end, so
        staging the SDK without its runtime would fix the symptom on developer machines (which
        all have the redistributable, because Visual Studio installs it) and leave it in place
        for the users least likely to have it. App-local deployment of these three files is a
        supported Microsoft deployment mode; release.yml copies them off the runner's VC redist
        directory into vendor/vcruntime/.

        Exists()-guarded like every other vendored payload, so a fresh clone still builds; the
        release check in scripts/verify_release_payloads.py is what makes their absence loud.
    -->
    <ItemGroup Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows'">
        <None Include="..\vendor\vcruntime\msvcp140.dll" Condition="Exists('..\vendor\vcruntime\msvcp140.dll')">
            <Link>msvcp140.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\vendor\vcruntime\vcruntime140.dll" Condition="Exists('..\vendor\vcruntime\vcruntime140.dll')">
            <Link>vcruntime140.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
        <None Include="..\vendor\vcruntime\vcruntime140_1.dll" Condition="Exists('..\vendor\vcruntime\vcruntime140_1.dll')">
            <Link>vcruntime140_1.dll</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <Target Name="ErrorIfVcRuntimeMissingOnRelease"
            AfterTargets="Build"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' AND '$(ReleasePublish)' == 'true' AND Exists('..\dotpad-sdk\Windows\dotpad-3.0.0\DotPadSDK-3.0.0.dll') AND !Exists('..\vendor\vcruntime\msvcp140.dll')">
        <Error Text="RELEASE BUILD SHIPPING THE DOT PAD SDK WITHOUT THE VC++ RUNTIME. DotPadSDK-3.0.0.dll statically imports MSVCP140/VCRUNTIME140/VCRUNTIME140_1 and a .NET publish carries none of them, so on any machine without the Visual C++ 2015-2022 redistributable the SDK will not load and tactile output will be silently inert. release.yml's 'Stage the VC++ runtime' step supplies them into vendor/vcruntime/." />
    </Target>

    <Target Name="CopyScriptWorker"
            AfterTargets="Build"
            BeforeTargets="GeneratePluginTrustManifest"
            Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0'">
        <ItemGroup>
            <!-- Same exclusions as CopyScriptWorkerOnPublish below; see the note there. -->
            <ScriptWorkerFiles
                Include="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.*"
                Exclude="..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\runtimes\**\*.*;..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\**\*.pdb" />
        </ItemGroup>
        <Copy SourceFiles="@(ScriptWorkerFiles)"
              DestinationFolder="$(OutDir)%(RecursiveDir)"
              SkipUnchangedFiles="true"
              Condition=" '@(ScriptWorkerFiles)' != '' " />
    </Target>

</Project>
