<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <OutputType>Exe</OutputType>
        <RootNamespace>AccessibleTrader.BlazorClient</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>AccessibleTrader.BlazorClient</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.companyname.accessibletrader.blazorclient</ApplicationId>

        <!-- Versions — display version inherits from Directory.Build.props;
             ApplicationVersion is the store build counter, bumped per submission. -->
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
        <ApplicationVersion>12</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
        Release-publish RID configuration, consumed by the CI release workflow
        (.github/workflows/release.yml). These live INSIDE this project and are
        scoped per-TFM via Condition so they never flow to the referenced
        net10.0 libraries or to the other heads' TFMs (android/ios) — which is
        exactly what passing -r / -p:RuntimeIdentifier(s) on the command line
        does, producing NETSDK1005 / NETSDK1083 / Mono runtime-pack errors.

        Gated on ReleasePublish=true (the workflow passes -p:ReleasePublish=true)
        so ordinary local builds and VS F5 are completely unaffected.

          - Windows: self-contained, unpackaged (WindowsPackageType=None above)
            win-x64 so the unzipped folder runs with no .NET / WindowsAppRuntime
            install on the user's machine.
          - Mac Catalyst: RuntimeIdentifiers (plural) builds one universal
            x64 + arm64 .app. Unsigned (ad-hoc) — see the workflow header.
    -->
    <PropertyGroup Condition="'$(ReleasePublish)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <!--
            Framework-dependent on purpose. The host ProjectReferences the
            ScriptWorker — a non-self-contained net10.0 exe copied next to the
            host so custom scripts can run. A SELF-contained host referencing a
            non-self-contained exe fails NETSDK1150, so we keep the .NET runtime
            framework-dependent (users install the .NET 10 Desktop Runtime).
            WindowsAppSDK stays self-contained, so no separate WindowsAppRuntime
            install is needed.
        -->
        <SelfContained>false</SelfContained>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    </PropertyGroup>
    <PropertyGroup Condition="'$(ReleasePublish)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
        <!--
            Use the Mono interpreter instead of full AOT for the release .app.
            Release Mac Catalyst defaults to AOT, which fails on this large
            multi-plugin app ("AOT compiler exited with code 1"). The interpreter
            yields a working unsigned .app with slightly slower startup; identical
            behaviour otherwise. Revisit if/when AOT is needed for App Store size.
        -->
        <UseInterpreter>true</UseInterpreter>
        <RunAOTCompilation>false</RunAOTCompilation>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#0B2F21" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0B2F21" BaseSize="192,192" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />

        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DynamicData" Version="9.4.31" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
        <!-- Patched SQLite native lib (SQLite 3.50.3) overriding the transitive 2.1.11 flagged by
             NU1903 / GHSA-2m69-gcr7-jv3q. See AccessibleTrader.Core.csproj for the rationale. -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
        <!--
            The SAME advisory, on the per-platform native builds, and the pin above does not
            reach them: they are separate packages. This project is the only one that
            multi-targets android and ios, so it is the only one that pulls
            SQLitePCLRaw.lib.e_sqlite3.android / .ios, and both stayed on the flagged 2.1.11
            while the desktop one was fixed. CVE-2025-6965 is a memory-corruption bug in SQLite
            before 3.50.2.

            2.1.13 is the newest published build of these two — there is no 3.x for them — and
            it CLEARS the advisory: restoring 2.1.13 with NuGetAudit produces no NU1903 where
            2.1.11 produces one per package (measured 2026-09-21, not assumed).

            Worth knowing for anyone weighing the risk: neither android nor ios is SHIPPED. The
            release workflow publishes net10.0-windows10.0.19041.0 and net10.0-maccatalyst only.
            The TFMs exist so the heads keep compiling, so this was a real advisory against code
            that reaches no user — which is exactly the kind of thing that sits unfixed because
            each person who looks at it decides it is somebody else's.
        -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.13" Condition="!$([MSBuild]::IsOSPlatform('linux'))" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
        <PackageReference Include="System.Reactive" Version="6.1.0" />
    </ItemGroup>

    <!-- ── Windows tray icon (ON by default; opt-out with -p:EnableWindowsTrayIcon=false) ──
         The Windows head (built by release.yml on every tag, and any Windows dev
         session) now compiles the close-to-tray applet by default. Inert on the
         Linux dev box, where the Windows TFM is excluded. Still verify close-to-
         tray + restore + exit on a real Windows session; opt out with the flag if
         a Windows build needs to skip it. -->
    <PropertyGroup>
        <EnableWindowsTrayIcon Condition="'$(EnableWindowsTrayIcon)' == ''">true</EnableWindowsTrayIcon>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(EnableWindowsTrayIcon)' == 'true'">
        <DefineConstants>$(DefineConstants);TRAY_ICON</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(EnableWindowsTrayIcon)' == 'true'">
        <PackageReference Include="H.NotifyIcon.Maui" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\AccessibleTrader.BlazorClient.Components\AccessibleTrader.BlazorClient.Components.csproj" />
      <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
      <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
      <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
      <!--
        Reference the script worker project so it builds before the host,
        but do NOT link its assembly into the host (ReferenceOutputAssembly
        false). The CopyScriptWorker target below copies its bin/$(Config)
        output next to the host binary at build time so
        DefaultProcessLauncher can spawn it from AppContext.BaseDirectory.

        ONLY included on desktop-class TFMs (Windows / macCatalyst).
        - Android hosts the worker inside the in-APK ScriptWorkerService
          class with android:isolatedProcess="true" — no external exe to copy.
        - iOS refuses script compilation entirely (see CustomScriptsModal.razor).
        - Referencing a non-self-contained exe from a self-contained mobile
          target fails NETSDK1150; the TFM guard below skips the reference
          on those targets.
      -->
      <ProjectReference Include="..\AccessibleTrader.ScriptWorker\AccessibleTrader.ScriptWorker.csproj"
                         Condition="'$([MSBuild]::GetTargetPlatformIdentifier(&quot;$(TargetFramework)&quot;))' == 'windows' or '$(TargetFramework)' == 'net10.0'">
        <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        <Private>false</Private>
      </ProjectReference>
      <!-- Providers (tradeable market data) -->
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Alpaca\AccessibleTrader.Plugins.Alpaca.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Binance\AccessibleTrader.Plugins.Binance.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Bitstamp\AccessibleTrader.Plugins.Bitstamp.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Coinbase\AccessibleTrader.Plugins.Coinbase.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Finnhub\AccessibleTrader.Plugins.Finnhub.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Fmp\AccessibleTrader.Plugins.Fmp.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.InteractiveBrokers\AccessibleTrader.Plugins.InteractiveBrokers.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Kraken\AccessibleTrader.Plugins.Kraken.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.KrakenFutures\AccessibleTrader.Plugins.KrakenFutures.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Gemini\AccessibleTrader.Plugins.Gemini.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Mexc\AccessibleTrader.Plugins.Mexc.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Oanda\AccessibleTrader.Plugins.Oanda.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Polygon\AccessibleTrader.Plugins.Polygon.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Schwab\AccessibleTrader.Plugins.Schwab.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Tradier\AccessibleTrader.Plugins.Tradier.csproj" />
      <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.TwelveData\AccessibleTrader.Plugins.TwelveData.csproj" />
      <!-- Analytics (non-tradeable data: on-chain, derivatives, sentiment, economic) -->
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.AlternativeMe\AccessibleTrader.Plugins.AlternativeMe.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.WikipediaPageviews\AccessibleTrader.Plugins.WikipediaPageviews.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.SecEdgar\AccessibleTrader.Plugins.SecEdgar.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BGeometrics\AccessibleTrader.Plugins.BGeometrics.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BinanceDerivatives\AccessibleTrader.Plugins.BinanceDerivatives.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BinanceVision\AccessibleTrader.Plugins.BinanceVision.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Cftc\AccessibleTrader.Plugins.Cftc.csproj" />
      <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Finra\AccessibleTrader.Plugins.Finra.csproj" />
