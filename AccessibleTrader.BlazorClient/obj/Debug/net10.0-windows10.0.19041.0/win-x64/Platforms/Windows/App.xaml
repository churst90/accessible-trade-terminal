<maui:MauiWinUIApplication
    x:Class="AccessibleTrader.BlazorClient.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:AccessibleTrader.BlazorClient.WinUI">

    <Application.Resources>
        <!-- Override the WinUI3 default light-theme white page background.
             Without this the window chrome shows white before MAUI renders,
             and any un-covered area behind transparent elements is white. -->
        <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#FF000000"/>
    </Application.Resources>

</maui:MauiWinUIApplication>

