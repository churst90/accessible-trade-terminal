@inherits LayoutComponentBase
@implements IDisposable
@using System.Threading
@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@using AccessibleTrader.BlazorClient.Services
@using AccessibleTrader.Core.Services.Strategies
@using AccessibleTrader.Core.Services.Accessibility
@using AccessibleTrader.Core.Services.Scripting
@inject IWorkspaceStore Store
@inject ISpeechManager SpeechManager
@inject GlobalInputService InputService
@inject IJSRuntime JSRuntime
@inject IAudioFeedbackRouter AudioRouter
@inject IScriptWorkerLauncher ScriptWorkerLauncher
@*
    SetupSonifier is a singleton that subscribes to SetupConfirmed/Reconfirmed/Dropped
    events on construction. Injecting it into MainLayout forces DI to construct it at
    app start so the subscriptions are wired before any composite strategy can fire.
    StrategyAutoLoader is also resolved here for the same reason — its LoadAll() runs
    once on first render to re-instantiate every IsAutoActivate strategy from the library.
*@
@inject SetupSonifier _setupSonifier
@inject StrategyAutoLoader _autoLoader
@* AlertDeliveryService eagerly resolved here so its AlertFiredEvent subscription
   is live before any alert can fire — the service does nothing on its own
   beyond subscribing, and DI would otherwise lazy-construct it only on first
   caller, leaving early alerts undelivered to SMTP / Telegram channels. *@
@inject AccessibleTrader.Core.Services.Alerts.AlertDeliveryService _alertDelivery
@inject ILogger<MainLayout> _layoutLogger

<div class="app-container">

    @* Icon sprite injected once — <use href="#icon-*"> in every button references these symbols. *@
    <IconSprite />

    <header role="banner" class="app-header">
        <h1 id="main-heading" style="font-size: 1.1rem; margin: 0; font-weight: bold;">
            @GetTitle()
        </h1>
    </header>

    <Toolbar />

    <TabBar />

    <main role="main" style="flex: 1; display: flex; flex-direction: column; overflow: hidden; background: transparent; position: relative;">
        <ChartArea />
    </main>

    <IndicatorBar />

    @* ── Modals ── All modals subscribe to their own OpenXxxEvent on the EventBus.
       They are rendered here (outside <main>) so they overlay the entire viewport. *@
    <AddIndicatorModal />
    <SettingsModal />
    <ObjectTreeModal />
    <PropertiesModal />
    <TradingDashboardModal />
    <OrderBookModal />
    <ApiKeysModal />
    <HelpModal />
    <StrategyModal />
    <DrawingToolsModal />
    <DrawingContextMenu />
    <AlertsModal />
    <CustomScriptsModal />
    <SoundDesignerModal />
    <AIAnalystModal />
    <SaveWorkspaceModal />
    <LoadWorkspaceModal />
    <JournalModal />

    @* ARIA LIVE DOUBLE BUFFER:
       Two assertive regions swap on each speech call so that identical strings are
       re-announced. Only one region has content at any time; the other is empty.
       Screen readers re-read a region when its content changes, so alternating
       between the two guarantees every message triggers an announcement. *@
    <div class="visually-hidden" aria-hidden="false">
        <div id="aria-speech-1" role="status" aria-live="assertive" aria-atomic="true">
            @(_activeBuffer == 1 ? _latestSpeech : "")
        </div>
        <div id="aria-speech-2" role="status" aria-live="assertive" aria-atomic="true">
            @(_activeBuffer == 2 ? _latestSpeech : "")
        </div>
    </div>

    <footer role="contentinfo" class="app-footer">
        <span>Accessible Trade Terminal &copy; 2026. This application is for demonstration purposes only.</span>
    </footer>


</div>

@inject AccessibleTrader.Core.Services.IEventBus _eventBus

@code {
    private string _latestSpeech = "";
    private int _activeBuffer = 1;
    private IDisposable? _stateSub;
    private IDisposable? _modalSub;

    protected override async Task OnInitializedAsync()
    {
        // Wire the ARIA live region callback. The speech manager queues any early
        // boot messages and delivers them here as soon as the callback is set.
        SpeechManager.OnSpeak = text =>
            InvokeAsync(() =>
            {
                _latestSpeech = text;
                _activeBuffer = _activeBuffer == 1 ? 2 : 1;
                StateHasChanged();
            });

        // Re-render on every store state change so the header title stays current.
        _stateSub = Store.StateStream.Subscribe(_ => InvokeAsync(StateHasChanged));

        // Announce modal open/close through the same ARIA live pipeline speech uses.
        // Focus-move alone is not enough — NVDA/JAWS users in browse mode don't hear
        // a focus change, so the live-region text is what tells them which modal
        // just opened or closed.
        _modalSub = _eventBus.AsObservable<ModalStateChangedEvent>()
            .Subscribe(evt =>
            {
                // Arm/disarm the keyboard.js Tab trap for every modal (including
                // those that publish ModalStateChangedEvent directly without going
                // through ModalBase). Fire-and-forget; the trap no-ops if the JS
                // runtime isn't ready yet.
                try { _ = JSRuntime.InvokeVoidAsync("accessibleTrader.setModalOpen", evt.IsOpen); }
                catch { /* non-critical */ }

                // Gate single-letter chart commands on "chart is active". The
                // simplest safe rule: chart is active when no modal is open.
                // Individual toolbar inputs are already handled by the form-control
                // guard in keyboard.js; this covers the gap for modal inputs.
                try { _ = JSRuntime.InvokeVoidAsync("accessibleTrader.setChartFocused", !evt.IsOpen); }
                catch { /* non-critical */ }

                // Earcon before speech so a blind user hears an immediate audio cue
                // when any modal opens or closes — speech arrives ~100-300 ms later
                // and not at all if the screen reader is in a pattern that dedupes
                // the double-buffered live region. Info tone on open, boundary on close.
                try
                {
                    AudioRouter.PlayEarcon(evt.IsOpen ? FeedbackType.Info : FeedbackType.Boundary);
                }
                catch (Exception ex)
                {
                    _layoutLogger.LogWarning(ex, "Modal earcon failed.");
                }

                if (string.IsNullOrEmpty(evt.ModalName)) return;
                var phrase = evt.IsOpen ? $"{evt.ModalName} dialog opened" : $"{evt.ModalName} dialog closed";
                InvokeAsync(() =>
                {
                    _latestSpeech = phrase;
                    _activeBuffer = _activeBuffer == 1 ? 2 : 1;
                    StateHasChanged();
                });
            });

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Register the global keyboard handler. Wrapping in try/catch prevents
            // a JS interop failure from crashing the layout component. Time-bounded
            // so a hung JS runtime doesn't trap the first render indefinitely.
            try
            {
                using var initCts = new CancellationTokenSource(TimeSpan.FromSeconds(10));
                await InputService.InitializeAsync(JSRuntime).WaitAsync(initCts.Token);
            }
            catch (OperationCanceledException)
            {
                _layoutLogger.LogError("Keyboard bridge init timed out after 10 s.");
            }
            catch (Exception ex)
            {
                // Log silently; keyboard input may be partially unavailable but the
                // app should still render rather than throw.
                _layoutLogger.LogError(ex, "Keyboard bridge init failed.");
            }

            // Re-instantiate every saved strategy whose IsAutoActivate flag is true. Idempotent —
            // calling LoadAll() a second time is a no-op. Wrapped in try/catch so a single bad
            // spec can never block the app from finishing initial render.
            try
            {
                _autoLoader.LoadAll();
            }
            catch (Exception ex)
            {
                _layoutLogger.LogError(ex, "StrategyAutoLoader failed.");
            }

            // Startup sandbox advisory. If the registered script-worker launcher is the
            // plain DefaultProcessLauncher — i.e. none of the platform-specific OS sandboxes
            // are in effect — the user is running custom indicators with only process-boundary
            // isolation. On Windows or macOS this means the AppContainer / sandbox-exec
            // primitives were unavailable (AV, GPO, corporate policy, or dev toolchain gap).
            // Surface it explicitly at launch so the trader knows and can decide whether
            // custom indicators are safe to run on this machine.
            try
            {
                var launcherType = ScriptWorkerLauncher.GetType();
                if (launcherType == typeof(DefaultProcessLauncher))
                {
                    const string msg = "Security notice: OS-level sandbox not available. Custom indicators run with process-boundary isolation only. Built-in indicators are unaffected.";
                    _layoutLogger.LogWarning(msg);
                    _eventBus.Publish(new AnnouncementEvent(msg, true));
                    try { AudioRouter.PlayEarcon(FeedbackType.Alert); }
                    catch { /* earcon is enhancement; message itself is what matters */ }
                }
            }
            catch (Exception ex)
            {
                _layoutLogger.LogWarning(ex, "Sandbox advisory check failed.");
            }
        }
    }

    private string GetTitle()
    {
        var identity = Store.State.Identity;
        if (string.IsNullOrEmpty(identity.Symbol))
            return "Accessible Trade Terminal";
        return $"Accessible Trade Terminal: {identity.Symbol} {identity.Timeframe} on {identity.Provider}";
    }

    public void Dispose()
    {
        _stateSub?.Dispose();
        _modalSub?.Dispose();
        SpeechManager.OnSpeak = null;
    }
}
