@using AccessibleTrader.Core.Services
@using AccessibleTrader.Core.Models
@inject IApiKeyService ApiKeyService
@inject IEventBus EventBus
@inject IJSRuntime JSRuntime
@implements IDisposable

@* API Keys manager: add, edit, remove, and activate credential profiles per provider.
   Each provider supports multiple named profiles (e.g. "Alpaca Paper", "Alpaca Live")
   stored with metadata in apikeys_meta.json and credentials in MAUI SecureStorage. *@

@if (_isVisible)
{
    <div class="modal-overlay" role="none" @onclick="Close">
        <div class="modal-content"
             role="dialog"
             aria-modal="true"
             aria-labelledby="apikeys-title"
             style="max-width:620px;"
             @onclick:stopPropagation="true">

            <h2 id="apikeys-title" tabindex="-1">API Keys</h2>

            <p style="color:#555; font-size:0.85rem; margin-top:0;">
                Manage credentials for data and trading providers. Use separate profiles
                for Paper and Live environments. Active profiles are used for the current session.
            </p>

            @* ── Existing profiles list ─────────────────────────────────────── *@
            @if (_keys.Any())
            {
                <div role="list" aria-label="Configured API key profiles" style="margin-bottom:16px;">
                    @foreach (var k in _keys)
                    {
                        <div class="object-tree-item"
                             role="listitem"
                             aria-label="@GetKeyLabel(k)">

                            <span style="flex:1; font-weight:@(k.IsActive ? "700" : "400");">
                                @k.Nickname
                            </span>

                            <span style="font-size:0.78rem; color:#555; min-width:60px;">
                                @k.Provider
                            </span>

                            <span style="font-size:0.78rem;
                                         color:@(k.Environment == "Live" ? "#c00" : "#060");
                                         min-width:44px; font-weight:600;">
                                @k.Environment
                            </span>

                            <span style="font-size:0.78rem; color:#555; min-width:50px;">
                                @k.MarketType
                            </span>

                            @if (k.IsActive)
                            {
                                <span aria-label="Active profile" style="color:#060; font-size:0.78rem; min-width:50px;">✔ Active</span>
                            }
                            else
                            {
                                <button aria-label="Set @k.Nickname as active"
                                        title="Set as active"
                                        @onclick="() => SetActive(k.Nickname)"
                                        @onclick:stopPropagation="true">
                                    Activate
                                </button>
                            }

                            <button aria-label="Remove @k.Nickname"
                                    style="color:#c00;"
                                    title="Remove profile"
                                    @onclick="() => Remove(k.Nickname)"
                                    @onclick:stopPropagation="true">
                                ✕
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:#555; font-size:0.88rem; margin-bottom:16px;">
                    No API keys configured. Add a profile below.
                </p>
            }

            @* ── Add new profile form ────────────────────────────────────────── *@
            <fieldset style="border:1px solid #bbb; padding:12px 16px; margin-bottom:16px;">
                <legend style="font-weight:700; color:#111; padding:0 6px;">Add New Profile</legend>

                <div class="modal-row">
                    <label for="key-provider">Provider</label>
                    <select id="key-provider" @bind="_newProvider">
                        @foreach (var p in _knownProviders)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-nickname">Profile Name</label>
                    <input id="key-nickname" type="text" placeholder="e.g. Alpaca Paper"
                           @bind="_newNickname" aria-label="Profile nickname" />
                </div>

                <div class="modal-row">
                    <label for="key-env">Environment</label>
                    <select id="key-env" @bind="_newEnvironment">
                        <option value="Paper">Paper</option>
                        <option value="Live">Live</option>
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-market">Market Type</label>
                    <select id="key-market" @bind="_newMarketType">
                        <option value="Spot">Spot</option>
                        <option value="Futures">Futures</option>
                        <option value="Crypto">Crypto</option>
                        <option value="Stocks">Stocks</option>
                    </select>
                </div>

                <div class="modal-row">
                    <label for="key-apikey">API Key</label>
                    <input id="key-apikey" type="password"
                           @bind="_newApiKey" aria-label="API key" />
                </div>

                <div class="modal-row">
                    <label for="key-secret">API Secret</label>
                    <input id="key-secret" type="password"
                           @bind="_newApiSecret" aria-label="API secret" />
                </div>

                <div class="modal-row">
                    <label for="key-pass">Passphrase</label>
                    <input id="key-pass" type="password" placeholder="Optional"
                           @bind="_newPassphrase" aria-label="Passphrase (optional)" />
                </div>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <p role="alert" style="color:#c00; margin-top:6px; font-size:0.88rem;">@_formError</p>
                }

                <div style="margin-top:12px; display:flex; justify-content:flex-end;">
                    <button id="apikeys-save" class="primary"
                            @onclick="SaveNew"
                            aria-label="Save new API key profile">
                        Save Profile
                    </button>
                </div>
            </fieldset>

            <div class="modal-footer">
                <button id="apikeys-close" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible;
    private IDisposable? _eventSub;
    private List<ApiKeyConfig> _keys = new();

    // New profile form fields
    private string _newProvider    = "Alpaca";
    private string _newNickname    = "";
    private string _newEnvironment = "Paper";
    private string _newMarketType  = "Spot";
    private string _newApiKey      = "";
    private string _newApiSecret   = "";
    private string _newPassphrase  = "";
    private string? _formError;

    private static readonly List<string> _knownProviders = new()
    {
        "Alpaca", "Binance", "Bitstamp", "Coinbase", "Polygon", "FRED", "Custom"
    };

    protected override void OnInitialized()
    {
        _eventSub = EventBus.Subscribe<OpenApiKeysEvent>(_ => InvokeAsync(ShowAsync));
    }

    private async Task ShowAsync()
    {
        _keys = await ApiKeyService.GetAllKeysAsync();
        _formError = null;
        _isVisible = true;
        EventBus.Publish(new ModalStateChangedEvent(true));
        StateHasChanged();
        await Task.Yield();
        try { await JSRuntime.InvokeVoidAsync("accessibleTrader.focusElement", "apikeys-title"); } catch { }
    }

    private void Close()
    {
        _isVisible = false;
        EventBus.Publish(new ModalStateChangedEvent(false));
        StateHasChanged();
    }

    private async Task SaveNew()
    {
        if (string.IsNullOrWhiteSpace(_newNickname))
        {
            _formError = "Profile name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newApiKey))
        {
            _formError = "API key is required.";
            return;
        }
        if (_keys.Any(k => k.Nickname.Equals(_newNickname, StringComparison.OrdinalIgnoreCase)))
        {
            _formError = $"A profile named \"{_newNickname}\" already exists.";
            return;
        }

        var config = new ApiKeyConfig(
            Provider:    _newProvider,
            Nickname:    _newNickname,
            ApiKey:      _newApiKey,
            ApiSecret:   _newApiSecret,
            Passphrase:  _newPassphrase,
            MarketType:  _newMarketType,
            Environment: _newEnvironment,
            IsActive:    false);

        await ApiKeyService.SaveKeyAsync(config);
        _keys = await ApiKeyService.GetAllKeysAsync();

        // Reset form
        _newNickname = "";
        _newApiKey = "";
        _newApiSecret = "";
        _newPassphrase = "";
        _formError = null;
        StateHasChanged();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"Profile {config.Nickname} saved"));
    }

    private async Task SetActive(string nickname)
    {
        await ApiKeyService.SetActiveKeyAsync(nickname);
        _keys = await ApiKeyService.GetAllKeysAsync();
        StateHasChanged();

        EventBus.Publish(new FeedbackRequestEvent(FeedbackType.StateChange,
            $"{nickname} set as active"));
    }

    private async Task Remove(string nickname)
    {
        await ApiKeyService.RemoveKeyAsync(nickname);
        _keys = await ApiKeyService.GetAllKeysAsync();
        StateHasChanged();
    }

    private string GetKeyLabel(ApiKeyConfig k)
    {
        string active = k.IsActive ? ", active" : "";
        return $"{k.Nickname}, {k.Provider}, {k.Environment}, {k.MarketType}{active}";
    }

    public void Dispose() => _eventSub?.Dispose();
}
