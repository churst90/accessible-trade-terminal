<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
    <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
    <!--
      Build the ScriptWorker before the tests so the roundtrip integration
      test can spawn it. Don't link the worker assembly into the test; we
      just want it on disk at bin/$(Config)/net10.0 for the test to
      Process.Start. ReferenceOutputAssembly=false keeps the linker happy.
    -->
    <ProjectReference Include="..\AccessibleTrader.ScriptWorker\AccessibleTrader.ScriptWorker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!--
      Plugin references exist solely so tests can reflect into a provider's
      private normalisation helpers. The plugin's only non-SDK dependency
      (Newtonsoft.Json) flows through transitively.
    -->
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Kraken\AccessibleTrader.Plugins.Kraken.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Coinbase\AccessibleTrader.Plugins.Coinbase.csproj" />
    <!--
      Fixture plugin for Phase 10-F DLL-plugin loader tests. Build-order dependency
      only (ReferenceOutputAssembly=false) — we don't want the fixture types linked
      into the test assembly's default ALC, because the loader tests need to prove
      the plugin loads cleanly from an empty scratch directory. The DLL itself is
      copied into the test output via the CopyStrategyPluginFixture target below.
    -->
    <ProjectReference Include="..\Plugins\Strategies\AccessibleTrader.Plugins.Strategy.Fixture\AccessibleTrader.Plugins.Strategy.Fixture.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Copies the built fixture DLL into the test output directory so
    StrategyPluginRegistryTests can stage it into a per-test scratch dir. We use
    an AfterBuild target rather than a <Content>/<None> item because the fixture
    DLL is a build output, not a source asset: <Content> would resolve relative
    to the project on _project load_, which happens before the fixture is built.
  -->
  <Target Name="CopyStrategyPluginFixture" AfterTargets="Build">
    <PropertyGroup>
      <FixturePluginSource>$(MSBuildThisFileDirectory)..\Plugins\Strategies\AccessibleTrader.Plugins.Strategy.Fixture\bin\$(Configuration)\net10.0\AccessibleTrader.Plugins.Strategy.Fixture.dll</FixturePluginSource>
    </PropertyGroup>
    <Copy
      SourceFiles="$(FixturePluginSource)"
      DestinationFolder="$(OutputPath)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(FixturePluginSource)')" />
  </Target>

</Project>