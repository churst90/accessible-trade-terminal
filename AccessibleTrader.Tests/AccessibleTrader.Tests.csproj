<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!--
      bUnit, for the modal contract suites.

      The MAUI head (UseMaui=true) targets only mobile/desktop TFMs and cannot be
      referenced from a plain net10.0 test project. That is why the dialogs live in
      AccessibleTrader.BlazorClient.Components, a net10.0 Razor Class Library the head
      and the tests both reference — see the ProjectReference below. This note used to
      describe that extraction as a three-step plan; it has been done for a long time,
      and the constraint is the only part still worth knowing.

      Pinned to the latest 1.x line that supports net10.0: bUnit 1.40+ requires
      Microsoft.AspNetCore.Components 9.x.
    -->
    <PackageReference Include="bunit" Version="1.40.0" />
    <!-- NU1902 (AngleSharp 1.2.0, GHSA-pgww-w46g-26qg, moderate) is the one advisory in
         this repo's restore graph, and it is deliberately left alone. AngleSharp arrives
         transitively as bUnit's HTML parser; bUnit states a floor rather than an exact pin,
         so a direct reference here does lift the resolved version. It was tried. 1.3.0 and
         1.4.0 are still affected; 1.5.2 clears the advisory and breaks bUnit outright —
         AngleSharp changed IHtmlCollection<T> binary-incompatibly and bUnit 1.40 was built
         against the old shape, so every test that indexes a rendered element collection dies
         with MissingMethodException (three of them did). The parser is test-only, reaches no
         shipping assembly, and only ever parses markup this repo rendered itself, so there
         is no exposure to trade for a broken harness. Revisit when bUnit ships against a
         patched AngleSharp; do not re-attempt the direct pin before then. -->
    <!-- NSubstitute used to stub services with deep interface surfaces (ISeriesManagementService,
         IThemeService, etc.) without writing 50+ no-op methods per modal-test file. -->
    <PackageReference Include="NSubstitute" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.BlazorClient.Components\AccessibleTrader.BlazorClient.Components.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
    <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
    <!-- WebHost ProjectReference: lets tests reach `internal` helpers
         (PickPlayer / SelectBackend / FindOnPath / internal ctor on
         WebHostSpeechManager) granted via InternalsVisibleTo in
         AccessibleTrader.WebHost.csproj. -->
    <ProjectReference Include="..\AccessibleTrader.WebHost\AccessibleTrader.WebHost.csproj" />
    <!--
      Build the ScriptWorker before the tests so the roundtrip integration
      test can spawn it. Don't link the worker assembly into the test; we
      just want it on disk at bin/$(Config)/net10.0 for the test to
      Process.Start. ReferenceOutputAssembly=false keeps the linker happy.
    -->
    <ProjectReference Include="..\AccessibleTrader.ScriptWorker\AccessibleTrader.ScriptWorker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
    <!--
      Plugin references exist solely so tests can reflect into a provider's
      private normalisation helpers. The plugin's only non-SDK dependency
      (Newtonsoft.Json) flows through transitively.
    -->
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Kraken\AccessibleTrader.Plugins.Kraken.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.KrakenFutures\AccessibleTrader.Plugins.KrakenFutures.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Gemini\AccessibleTrader.Plugins.Gemini.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Coinbase\AccessibleTrader.Plugins.Coinbase.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Bitstamp\AccessibleTrader.Plugins.Bitstamp.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Alpaca\AccessibleTrader.Plugins.Alpaca.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Polygon\AccessibleTrader.Plugins.Polygon.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Tradier\AccessibleTrader.Plugins.Tradier.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Oanda\AccessibleTrader.Plugins.Oanda.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Finnhub\AccessibleTrader.Plugins.Finnhub.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.TwelveData\AccessibleTrader.Plugins.TwelveData.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Tradier\AccessibleTrader.Plugins.Tradier.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Mexc\AccessibleTrader.Plugins.Mexc.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Fmp\AccessibleTrader.Plugins.Fmp.csproj" />
    <!-- Phase E enrollment: fetch/live-stream contract tests for the providers
         that were previously only covered by the timeframe contract table. -->
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Binance\AccessibleTrader.Plugins.Binance.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.InteractiveBrokers\AccessibleTrader.Plugins.InteractiveBrokers.csproj" />
    <ProjectReference Include="..\Plugins\Providers\AccessibleTrader.Plugins.Schwab\AccessibleTrader.Plugins.Schwab.csproj" />
    <ProjectReference Include="..\AccessibleTrader.StrategyLab\AccessibleTrader.StrategyLab.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.AlternativeMe\AccessibleTrader.Plugins.AlternativeMe.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.WikipediaPageviews\AccessibleTrader.Plugins.WikipediaPageviews.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.SecEdgar\AccessibleTrader.Plugins.SecEdgar.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Cftc\AccessibleTrader.Plugins.Cftc.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Finra\AccessibleTrader.Plugins.Finra.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.CoinGecko\AccessibleTrader.Plugins.CoinGecko.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Mempool\AccessibleTrader.Plugins.Mempool.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.DefiLlama\AccessibleTrader.Plugins.DefiLlama.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Deribit\AccessibleTrader.Plugins.Deribit.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BGeometrics\AccessibleTrader.Plugins.BGeometrics.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.CoinMetrics\AccessibleTrader.Plugins.CoinMetrics.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Glassnode\AccessibleTrader.Plugins.Glassnode.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.OkxDerivatives\AccessibleTrader.Plugins.OkxDerivatives.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Etherscan\AccessibleTrader.Plugins.Etherscan.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.Fred\AccessibleTrader.Plugins.Fred.csproj" />
    <ProjectReference Include="..\Plugins\Analytics\AccessibleTrader.Plugins.BinanceDerivatives\AccessibleTrader.Plugins.BinanceDerivatives.csproj" />
    <!--
      Fixture plugin for Phase 10-F DLL-plugin loader tests. Build-order dependency
      only (ReferenceOutputAssembly=false) — we don't want the fixture types linked
      into the test assembly's default ALC, because the loader tests need to prove
      the plugin loads cleanly from an empty scratch directory. The DLL itself is
      copied into the test output via the CopyStrategyPluginFixture target below.
    -->
    <ProjectReference Include="..\Plugins\Strategies\AccessibleTrader.Plugins.Strategy.Fixture\AccessibleTrader.Plugins.Strategy.Fixture.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Copies the built fixture DLL into the test output directory so
    StrategyPluginRegistryTests can stage it into a per-test scratch dir. We use
    an AfterBuild target rather than a <Content>/<None> item because the fixture
    DLL is a build output, not a source asset: <Content> would resolve relative
    to the project on _project load_, which happens before the fixture is built.
  -->
  <Target Name="CopyStrategyPluginFixture" AfterTargets="Build">
    <PropertyGroup>
      <FixturePluginSource>$(MSBuildThisFileDirectory)..\Plugins\Strategies\AccessibleTrader.Plugins.Strategy.Fixture\bin\$(Configuration)\net10.0\AccessibleTrader.Plugins.Strategy.Fixture.dll</FixturePluginSource>
    </PropertyGroup>
    <Copy SourceFiles="$(FixturePluginSource)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('$(FixturePluginSource)')" />
  </Target>

</Project>