@page "/account/loginwithrecovery"
@model AccessibleTrader.WebHost.Pages.Account.LoginWithRecoveryModel
@{
    Layout = null;
    ViewData["Title"] = "Recovery code";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Recovery code — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <img class="mark" src="~/icons/icon-192.png" alt="" aria-hidden="true" />
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Sign in with a recovery code</h1>
            <p class="auth-sub">
                Each recovery code works exactly once. After you're in, visit Account
                security to re-enroll your authenticator or generate fresh codes.
            </p>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="auth-error" role="alert" aria-live="assertive">@Model.Error</div>
            }

            <form method="post">
                <div class="auth-field">
                    <label asp-for="Input.RecoveryCode">Recovery code</label>
                    <input class="auth-input" asp-for="Input.RecoveryCode" type="text"
                           autocomplete="off" autofocus aria-describedby="rc-err" />
                    <span id="rc-err" class="field-error" asp-validation-for="Input.RecoveryCode" role="alert"></span>
                </div>
                <button class="auth-btn" type="submit">Sign in</button>
            </form>

            <p class="auth-alt">
                Found the device after all? <a href="@Url.Content("~/account/loginwith2fa")">Enter an authenticator code</a>
            </p>
        </div>
    </main>
</body>
</html>
