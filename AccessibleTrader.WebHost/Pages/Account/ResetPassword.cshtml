@page "/account/resetpassword"
@model AccessibleTrader.WebHost.Pages.Account.ResetPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Reset your password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title auth-error="@(Model.Errors.Count > 0)">Reset your password — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <img class="mark" src="~/icons/icon-192.png" alt="" aria-hidden="true" />
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Choose a new password</h1>
            <p class="auth-sub">Set a new password for your account using the reset link you were given.</p>

            @if (Model.Errors.Count > 0)
            {
                <div class="auth-error" auth-announce role="alert" aria-live="assertive">
                    <strong>We couldn't reset your password:</strong>
                    <ul>
                        @foreach (var e in Model.Errors) { <li>@e</li> }
                    </ul>
                </div>
            }

            <form method="post">
                <p class="auth-required-note">Fields marked with an asterisk are required.</p>
                <input asp-for="Input.Email" type="hidden" />
                <input asp-for="Input.Token" type="hidden" />
                <div class="auth-field">
                    <label asp-for="Input.NewPassword">New password</label>
                    <input class="auth-input" asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus aria-describedby="pw-err pw-hint" />
                    <span id="pw-hint" class="auth-hint">At least 10 characters, including an uppercase letter and a number.</span>
                    <span id="pw-err" class="field-error" asp-validation-for="Input.NewPassword"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input class="auth-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-describedby="cpw-err" />
                    <span id="cpw-err" class="field-error" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
                <button class="auth-btn" type="submit">Update password</button>
            </form>

            <p class="auth-alt">
                Remembered it? <a href="@Url.Content("~/account/login")">Sign in</a>
            </p>
        </div>
    </main>
</body>
</html>
