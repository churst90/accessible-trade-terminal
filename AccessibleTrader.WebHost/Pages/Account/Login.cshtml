@page "/account/login"
@model AccessibleTrader.WebHost.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" href="data:," />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <span class="mark" aria-hidden="true">A</span>
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Sign in</h1>
            <p class="auth-sub">Welcome back &mdash; sign in to your paper-trading account.</p>

            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="auth-error" role="alert" aria-live="assertive">@Model.Error</div>
            }

            <form method="post">
                <div class="auth-field">
                    <label asp-for="Input.Email">Email</label>
                    <input class="auth-input" asp-for="Input.Email" type="email" autocomplete="username" autofocus aria-describedby="email-err" />
                    <span id="email-err" class="field-error" asp-validation-for="Input.Email" role="alert"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Input.Password">Password</label>
                    <input class="auth-input" asp-for="Input.Password" type="password" autocomplete="current-password" aria-describedby="pw-err" />
                    <span id="pw-err" class="field-error" asp-validation-for="Input.Password" role="alert"></span>
                </div>
                <label class="auth-check">
                    <input asp-for="Input.RememberMe" type="checkbox" /> Keep me signed in
                </label>
                <button class="auth-btn" type="submit">Sign in</button>
            </form>

            <p class="auth-alt">
                New here? <a href="@Url.Content("~/account/register")">Create a free account</a>
            </p>
        </div>
    </main>
</body>
</html>
