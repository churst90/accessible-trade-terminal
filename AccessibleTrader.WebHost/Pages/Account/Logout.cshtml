@page "/account/logout"
@model AccessibleTrader.WebHost.Pages.Account.LogoutModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign out — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <img class="mark" src="~/icons/icon-192.png" alt="" aria-hidden="true" />
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Sign out</h1>
            <p class="auth-sub">Sign out of Accessible Trade Terminal?</p>
            <form method="post">
                <button class="auth-btn" type="submit">Sign out</button>
            </form>
            <a class="auth-btn auth-btn--ghost" href="@Url.Content("~/")">Stay signed in and go back</a>
        </div>
    </main>
</body>
</html>
