@page "/account/register"
@model AccessibleTrader.WebHost.Pages.Account.RegisterModel
@{
    Layout = null;
    ViewData["Title"] = "Create an account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create an account — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <img class="mark" src="~/icons/icon-192.png" alt="" aria-hidden="true" />
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Create your free account</h1>
            <p class="auth-sub">Paper-trade and learn the market by ear &mdash; your settings and progress, saved.</p>

            @if (Model.Errors.Count > 0)
            {
                <div class="auth-error" role="alert" aria-live="assertive">
                    <strong>Please fix the following:</strong>
                    <ul>
                        @foreach (var e in Model.Errors) { <li>@e</li> }
                    </ul>
                </div>
            }

            <form method="post">
                <div class="auth-field">
                    <label asp-for="Input.Email">Email</label>
                    <input class="auth-input" asp-for="Input.Email" type="email" autocomplete="username" autofocus aria-describedby="email-err" />
                    <span id="email-err" class="field-error" asp-validation-for="Input.Email" role="alert"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Input.Password">Password</label>
                    <input class="auth-input" asp-for="Input.Password" type="password" autocomplete="new-password" aria-describedby="pw-hint pw-err" />
                    <span id="pw-hint" class="auth-hint">At least 10 characters, including an uppercase letter and a number.</span>
                    <span id="pw-err" class="field-error" asp-validation-for="Input.Password" role="alert"></span>
                </div>
                <div class="auth-field">
                    <label asp-for="Input.ConfirmPassword">Confirm password</label>
                    <input class="auth-input" asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" aria-describedby="cpw-err" />
                    <span id="cpw-err" class="field-error" asp-validation-for="Input.ConfirmPassword" role="alert"></span>
                </div>
                <button class="auth-btn" type="submit">Create account</button>
            </form>

            <p class="auth-alt">
                Already have an account? <a href="@Url.Content("~/account/login")">Sign in</a>
            </p>
        </div>
    </main>
</body>
</html>
