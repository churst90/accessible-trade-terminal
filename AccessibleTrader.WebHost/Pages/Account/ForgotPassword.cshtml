@page "/account/forgotpassword"
@model AccessibleTrader.WebHost.Pages.Account.ForgotPasswordModel
@{
    Layout = null;
    ViewData["Title"] = "Forgot your password?";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title auth-error="false">Forgot your password? — Accessible Trade Terminal</title>
    <link rel="stylesheet" href="~/auth.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
</head>
<body>
    <header class="auth-header">
        <a href="/" aria-label="Accessible Trade Terminal home">
            <img class="mark" src="~/icons/icon-192.png" alt="" aria-hidden="true" />
            <span>Accessible Trade Terminal</span>
        </a>
    </header>
    <main role="main" class="auth-wrap">
        <div class="auth-card">
            <h1>Forgot your password?</h1>
            <p class="auth-sub">Enter your email and we'll start a reset.</p>

            @if (Model.Submitted)
            {
                <div class="auth-note" auth-announce role="status" aria-live="polite">
                    If that account exists, contact <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>
                    from the email address on file and we'll send you a reset link.
                </div>
                <p class="auth-alt">
                    <a href="@Url.Content("~/account/login")">Back to sign in</a>
                </p>
            }
            else
            {
                <form method="post">
                    <p class="auth-required-note">Fields marked with an asterisk are required.</p>
                    <div class="auth-field">
                        <label asp-for="Input.Email">Email</label>
                        <input class="auth-input" asp-for="Input.Email" type="email" autocomplete="username" autofocus aria-describedby="email-err" />
                        <span id="email-err" class="field-error" asp-validation-for="Input.Email"></span>
                    </div>
                    <button class="auth-btn" type="submit">Start password reset</button>
                </form>

                <p class="auth-alt">
                    Remembered it? <a href="@Url.Content("~/account/login")">Sign in</a>
                </p>
            }
        </div>
    </main>
</body>
</html>
