@*
    Top-level Blazor Web App document. The Router lives in Routes.razor;
    everything in <head> and the framework script live here so the SSR'd
    response is a complete HTML page.

    The RCL ships scoped component CSS as a bundle at
    _content/AccessibleTrader.BlazorClient.Components/AccessibleTrader.BlazorClient.Components.bundle.scp.css
    when the RCL is referenced as a ProjectReference. Without that link,
    component-scoped styles (anything in a *.razor.css) won't apply.
*@
@inject AccessibleTrader.Core.Services.DemoPolicy Demo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The public builds are reverse-proxied under a subpath on the marketing site, so the
       base href (and therefore every relative asset + the /_blazor SignalR endpoint) must
       live under that prefix: --demo under /app/, hosted accounts under /terminal/. Root
       otherwise (desktop / local web). Mirrors UsePathBase in Program.cs. *@
    <base href="@(Demo.IsDemo ? "/app/" : Demo.IsHosted ? "/terminal/" : "/")" />
    <title>Accessible Trade Terminal</title>
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/AccessibleTrader.BlazorClient.Components/AccessibleTrader.BlazorClient.Components.bundle.scp.css" />
    <link rel="stylesheet" href="AccessibleTrader.WebHost.styles.css" />
    @* Relative hrefs so the icons resolve under the reverse-proxy base path too. *@
    <link rel="icon" type="image/svg+xml" href="_content/AccessibleTrader.BlazorClient.Components/images/logo.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png">
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <BrowserSpeechBridge @rendermode="RenderMode.InteractiveServer" />
    <BrowserAudioBridge @rendermode="RenderMode.InteractiveServer" />
    @* prerender: false — the app tree (MainLayout/Toolbar/ChartArea) does heavy, stateful,
       per-circuit init in OnInitialized (loads the chart, dispatches to the scoped
       WorkspaceStore). Prerendering ran that in a throwaway SSR scope that is disposed
       right after prerender, so the in-flight chart load dispatched to an already-disposed
       store (ObjectDisposedException) — harmless but noisy. Rendering only on the real
       interactive circuit runs that init exactly once, in the long-lived per-visitor scope. *@
    <AppRoutes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <div id="blazor-error-ui" role="alert" aria-live="assertive" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss" role="button" tabindex="0" aria-label="Dismiss error">&#x2715;</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/keyboard.js"></script>
    <script src="js/canvasRegion.js"></script>
    <script src="js/treeKeyboard.js"></script>
    <script src="js/webSpeech.js"></script>
    <script src="js/audio.js"></script>
</body>
</html>
