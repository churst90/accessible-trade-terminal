@*
    Top-level Blazor Web App document. The Router lives in Routes.razor;
    everything in <head> and the framework script live here so the SSR'd
    response is a complete HTML page.

    The RCL ships scoped component CSS as a bundle at
    _content/AccessibleTrader.BlazorClient.Components/AccessibleTrader.BlazorClient.Components.bundle.scp.css
    when the RCL is referenced as a ProjectReference. Without that link,
    component-scoped styles (anything in a *.razor.css) won't apply.
*@
@inject AccessibleTrader.Core.Services.DemoPolicy Demo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* The public builds are reverse-proxied under a subpath on the marketing site, so the
       base href (and therefore every relative asset + the /_blazor SignalR endpoint) must
       live under that prefix: --demo under /app/, hosted accounts under /terminal/. Root
       otherwise (desktop / local web). Read from the REQUEST's PathBase — the value
       UsePathBase in Program.cs stripped — rather than re-deriving it from the mode, so the
       two cannot disagree and a configured `PathBase` override reaches here too. *@
    <base href="@BaseHref" />
    <title>Accessible Trade Terminal</title>
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/AccessibleTrader.BlazorClient.Components/AccessibleTrader.BlazorClient.Components.bundle.scp.css" />
    <link rel="stylesheet" href="AccessibleTrader.WebHost.styles.css" />
    @* Relative hrefs so the icons resolve under the reverse-proxy base path too. *@
    <link rel="icon" type="image/svg+xml" href="_content/AccessibleTrader.BlazorClient.Components/images/logo.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="icons/favicon-32.png">
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <BrowserSpeechBridge @rendermode="RenderMode.InteractiveServer" />
    <BrowserAudioBridge @rendermode="RenderMode.InteractiveServer" />
    @* First-visit speech-output chooser (double-speech fix). Renders nothing on
       server-side-speech deploys or once a per-browser choice is stored; while
       visible it sits before the app in DOM, so it's first in tab order. *@
    <SpeechOutputPrompt @rendermode="RenderMode.InteractiveServer" />
    @* prerender: false — the app tree (MainLayout/Toolbar/ChartArea) does heavy, stateful,
       per-circuit init in OnInitialized (loads the chart, dispatches to the scoped
       WorkspaceStore). Prerendering ran that in a throwaway SSR scope that is disposed
       right after prerender, so the in-flight chart load dispatched to an already-disposed
       store (ObjectDisposedException) — harmless but noisy. Rendering only on the real
       interactive circuit runs that init exactly once, in the long-lived per-visitor scope. *@
    <AppRoutes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />

    <div id="blazor-error-ui" role="alert" aria-live="assertive" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss" role="button" tabindex="0" aria-label="Dismiss error">&#x2715;</span>
    </div>

    @* ── The circuit reconnect overlay ──────────────────────────────────────────
       Until 2026-09-21 this markup did not exist, so Blazor's DEFAULT overlay applied:
       a plain div, no live region, no focus management. When the circuit dropped, a
       blind trader was told nothing at all. The element right above has carried
       role="alert" aria-live="assertive" all along, so the accessible treatment was
       deliberate for unhandled errors and simply never extended to reconnects.

       The ids and class names are the framework's — it drives this element by adding
       components-reconnect-{show,hide,failed,rejected,refused} to it — so the markup is
       presentational only. The ANNOUNCEMENT is owned by reconnect.js, because a live
       region that is merely unhidden does not reliably re-announce and the transitions
       that matter here (attempt 1 → 2 → 3 → failed) carry no text change at all. *@
    <div id="components-reconnect-modal" data-nosnippet>
        <span class="components-reconnect-show">
            Connection to the terminal was lost. Reconnecting&hellip;
            attempt <span id="components-reconnect-current-attempt"></span>
            of <span id="components-reconnect-max-retries"></span>.
            Your chart and any orders already placed are unaffected.
        </span>
        <span class="components-reconnect-failed">
            Could not reconnect to the terminal. The server may be restarting.
            <a href="" class="components-reconnect-button">Retry now</a>
        </span>
        @* .NET 10 also uses -resume-failed (the session could not be resumed); app.css shows
           this span for it, because to the user it is the same news. *@
        <span class="components-reconnect-rejected">
            Your session ended while you were disconnected. Orders already placed are held
            at the venue and are not affected.
            <a href="" class="components-reconnect-button">Reload the terminal</a>
        </span>
    </div>

    @* The nodes that actually speak, both visually hidden because the overlay above is the
       visual presentation of the same state. #reconnect-status carries one sentence per state
       change, assertively (no role: role="status" implies polite and contradicts it).
       #reconnect-progress carries "still reconnecting, attempt N", politely and at most once a
       minute: the framework rewrites the attempt counter every second, and announcing each
       rewrite read the whole sentence out once a second for minutes. *@
    <div id="reconnect-status" aria-live="assertive" aria-atomic="true"
         class="visually-hidden" data-nosnippet></div>
    <div id="reconnect-progress" role="status" aria-live="polite" aria-atomic="true"
         class="visually-hidden" data-nosnippet></div>

    @* RECONNECTION BACK-OFF. autostart="false" hands the start to js/boot.js, which passes a
       retry policy: one immediate attempt, then 1-2-4-8 s capped at 15 s with jitter. The
       framework default is ten attempts with no delay at all, which is the storm in the
       server's logs (100 of 141 negotiates 502 between 7 and 20 September, in bursts of
       ten-plus within one second).

       boot.js MUST stay a file and come right after blazor.web.js. The 2026-09-21 attempt
       started the circuit from an inline <script>, and the CSP (script-src 'self', see
       SecurityHeadersPolicy) refused it, so nothing started the circuit and the page never
       loaded. ReconnectAndHealthBrowserTests pins both halves. *@
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/boot.js"></script>
    <script src="js/reconnect.js"></script>
    <script src="_content/AccessibleTrader.BlazorClient.Components/js/keyboard.js?v=20260716b"></script>
    <script src="_content/AccessibleTrader.BlazorClient.Components/js/canvasRegion.js?v=20260716b"></script>
    <script src="_content/AccessibleTrader.BlazorClient.Components/js/treeKeyboard.js?v=20260716b"></script>
    <script src="js/webSpeech.js"></script>
    <script src="js/audio.js"></script>
    <script src="js/webPush.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string BaseHref
    {
        get
        {
            string? fromRequest = HttpContext?.Request.PathBase.Value;
            if (!string.IsNullOrEmpty(fromRequest)) return fromRequest.TrimEnd('/') + "/";
            // No HttpContext (never the case for the SSR root document) or no prefix on the
            // request: fall back to the mode's default so a hosted head reached without its
            // prefix still names the prefix it is served under.
            return Demo.IsDemo ? "/app/" : Demo.IsHosted ? "/terminal/" : "/";
        }
    }
}
