  <!--
    Plugin trust manifest generation, and the script-worker staging that has to happen before it.
    Both live in packaging/PluginTrustManifest.targets so this head and the MAUI head cannot
    drift: the previous copy-paste is what let the desktop head ship for its whole life with no
    manifest at all. See that file's header.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\packaging\PluginTrustManifest.targets" />

  <!--
    Stage the script worker beside the host binary, at BUILD and at PUBLISH, because the two are
    different directories and only one of them ships.

    COPY WHAT THE DESTINATION DOES NOT ALREADY HAVE, rather than an explicit file list. Both
    obvious alternatives are wrong in a way this repository has already paid for:

      - Copy everything (the desktop head's target, with its runtimes/ and *.pdb exclusions).
        Here the worker's self-contained output IS the .NET runtime, 115 MB of files the host
        published moments earlier from the same build. Copying them over the host's own copies
        is 115 MB of churn to land 0.15 MB of new bytes, and it lets the worker's view of a
        shared assembly version overwrite the host's.

      - Name the five files. That is a list which is correct today and silently wrong the first
        time the worker gains a dependency the host does not carry — the exact shape of every
        defect this file's comments are about. An Exists() filter keeps the list honest: a new
        unique dependency is simply not in the destination, so it is copied.

    The Exclude keeps .pdb out (0.8 MB on linux-x64, and a released head has no use for them).
  -->
  <Target Name="CopyScriptWorkerOnBuild" AfterTargets="Build"
          BeforeTargets="GeneratePluginTrustManifest"
          Condition=" '$(OutDir)' != '' AND Exists('$(_ScriptWorkerOutDir)') ">
    <ItemGroup>
      <_WorkerBuildCandidates Include="$(_ScriptWorkerOutDir)**\*.*" Exclude="$(_ScriptWorkerOutDir)**\*.pdb" />
      <_WorkerBuildNew Include="@(_WorkerBuildCandidates)"
                       Condition="!Exists('$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerBuildNew)" DestinationFolder="$(OutDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" Condition=" '@(_WorkerBuildNew)' != '' " />
  </Target>

  <Target Name="CopyScriptWorkerOnPublish" AfterTargets="Publish"
          Condition=" '$(PublishDir)' != '' AND Exists('$(_ScriptWorkerOutDir)') ">
    <ItemGroup>
      <_WorkerPublishCandidates Include="$(_ScriptWorkerOutDir)**\*.*" Exclude="$(_ScriptWorkerOutDir)**\*.pdb" />
      <_WorkerPublishNew Include="@(_WorkerPublishCandidates)"
                         Condition="!Exists('$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerPublishNew)" DestinationFolder="$(PublishDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" Condition=" '@(_WorkerPublishNew)' != '' " />
    <Message Importance="high"
             Text="Staged @(_WorkerPublishNew->Count()) script-worker file(s) into $(PublishDir) (the rest were already there from the host's own publish)." />
  </Target>

</Project>
