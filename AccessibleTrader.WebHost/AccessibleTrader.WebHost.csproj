<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AccessibleTrader.WebHost — ASP.NET Core Blazor Server host for the
    trading terminal. Provides a cross-platform desktop experience
    (Linux / macOS / Windows) by serving the existing
    AccessibleTrader.BlazorClient.Components RCL through Kestrel and
    opening it in the user's default browser. The same project is also the
    deployment target for the public chart demo on the marketing site
    (gated by the demo-mode CLI switch in Program.cs).

    Intentionally NOT a MAUI head. The Components RCL was extracted
    precisely so that a non-MAUI host could reuse every Razor component
    without modification (see the RCL csproj header comment, line 11).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AccessibleTrader.WebHost</RootNamespace>
    <!-- Same .NET SDK 10.0.300+ Razor source-generator regression as the
         Components RCL (see its csproj header): false RZ1021 inside @if
         blocks corrupts the generated C# for SpeechOutputPrompt.razor on a
         clean build. Classic two-phase Razor compilation until the SDK fix
         ships. https://github.com/dotnet/razor/issues/13184 -->
    <UseRazorSourceGenerator>false</UseRazorSourceGenerator>
    <!-- Version inherited from Directory.Build.props — bump it there only. -->
    <!-- Release builds run as a windowed (GUI-subsystem) app on Windows so the
         shipped binary doesn't pop a black console window when the user double-
         clicks it; the app opens the browser itself. Debug stays a console app
         so logs are visible during development.
         EXCEPTION: a server/demo publish (-p:ServerPublish=true) must stay a
         plain Exe — WinExe drops _framework/blazor.web.js and the RCL scoped-CSS
         bundle from the static-asset manifest, so the Blazor circuit never boots
         ("no data loaded").

         The IsOSPlatform('Windows') clause is NOT belt-and-braces, and the claim
         this comment used to make — "WinExe is a no-op on Linux/macOS (no Windows
         console subsystem)" — was false. WinExe strips those assets from the
         manifest on EVERY platform, because the stripping happens in the SDK's
         static-web-assets targets and not in the OS loader. Measured on Linux
         2026-08-26 by counting _framework routes in
         AccessibleTrader.WebHost.staticwebassets.endpoints.json:
           Debug                          → 12 routes (blazor.web.js present)
           Release                        →  0 routes
           Release -p:ServerPublish=true  → 12 routes
         Zero routes means Kestrel answers 404 for /_framework/blazor.web.js, the
         circuit never starts, and a Blazor Server page renders nothing at all.

         That is what took down the whole Chromium harness job: every shipping
         path already passes ServerPublish=true (release.yml does so for all RIDs,
         win-x64 included, and SERVER_SETUP.md documents it as required), so this
         property had stopped guarding any artifact we actually ship and only
         caught the builds nobody thought to add the flag to — a developer's
         `dotnet build -c Release`, and AccessibleTrader.BrowserTests. Restricting
         it to Windows makes the destructive case unreachable on the platforms
         where the windowed subsystem means nothing anyway. -->
    <OutputType Condition="'$(Configuration)' == 'Release'
                       And '$(ServerPublish)' != 'true'
                       And $([MSBuild]::IsOSPlatform('Windows'))">WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Internal helpers (PickPlayer / SelectBackend / FindOnPath / internal
         ctor on WebHostSpeechManager) exposed to the test project so unit
         tests can pin the backend-selection logic without spawning real
         pw-cat / gdbus / spd-say processes. -->
    <InternalsVisibleTo Include="AccessibleTrader.Tests" />
    <!-- Same internal ctor, different reason: the browser harness must PIN the backend to
         BrowserTts. Left to probe the machine it runs on, WebHostSpeechManager finds the
         developer's real /usr/bin/spd-say and every announcement the harness provokes is
         spoken out loud by the developer's own speech-dispatcher — and none of it is
         observable from the browser, which is where the harness is looking. -->
    <InternalsVisibleTo Include="AccessibleTrader.BrowserTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
    <!-- Design-time only: needed to CREATE migrations, never shipped at runtime.
         PrivateAssets="all" keeps it out of the published output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5" PrivateAssets="all" />
    <!-- Patched SQLite native lib (SQLite 3.50.3) overriding the transitive 2.1.11 flagged by
         NU1903 / GHSA-2m69-gcr7-jv3q. See AccessibleTrader.Core.csproj for the rationale. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <!-- Accounts (hosted multi-user only; gated behind Accounts:Enabled). ASP.NET Core
         Identity + EF Core stores for the AuthDbContext (auth.db). No effect on the
         local/demo modes or the MAUI head. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.5" />
    <!-- QR rendering for the accessible 2FA enrollment page (pure managed, no
         native deps; the copyable text key is the primary path, QR is the
         phone-scan convenience). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <!-- StatusNotifierItem + DBusMenu tray icon for the LOCAL Linux desktop (HostMode.Full).
         Pure D-Bus client, no GUI toolkit; never registered on the hosted server.
         Keep >= 0.92.0: earlier versions are flagged NU1903 / GHSA-xrw6-gwf8-vvr9 (High —
         session-bus signal spoofing / FD-exhaustion DoS). Do NOT downgrade. -->
    <PackageReference Include="Tmds.DBus" Version="0.92.0" />
    <!-- SkiaSharp native runtime. Core's Rendering/* uses SKPaint/SKCanvas; the
         MAUI head gets the native .so transitively via SkiaSharp.Views.Maui.Controls,
         but the WebHost has no MAUI dep so we need the per-OS native asset
         packages directly. -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" />
  </ItemGroup>

  <!--
    Where the script worker's output lands, and what to build it as. Both answers depend on
    whether this publish carries a RID: with one, the SDK writes the worker's output under a
    per-RID subdirectory and can emit an apphost for that RID (cross-building win-x64 and osx-*
    from the Ubuntu release runner is fine — the apphost comes from a NuGet pack, not the build
    host). Without one — a developer's plain `dotnet build` — the output is the flat net10.0
    directory and the worker is framework-dependent, which is correct there because so is the
    host.
  -->
  <PropertyGroup>
    <_ScriptWorkerBuildProps Condition="'$(RuntimeIdentifier)' != ''">RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)</_ScriptWorkerBuildProps>
    <_ScriptWorkerOutDir Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildThisFileDirectory)..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\</_ScriptWorkerOutDir>
    <_ScriptWorkerOutDir Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildThisFileDirectory)..\AccessibleTrader.ScriptWorker\bin\$(Configuration)\net10.0\</_ScriptWorkerOutDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.BlazorClient.Components\AccessibleTrader.BlazorClient.Components.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
    <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
    <!--
      The script worker, and this head went without it for its entire life.

      `grep -n ScriptWorker AccessibleTrader.WebHost.csproj` found NOTHING until 2026-09-22,
      while RoslynScriptingService.DefaultWorkerPathResolver resolves the worker from
      AppContext.BaseDirectory on EVERY head and Release refuses the in-process path by design.
      So user-compiled indicators and strategies could not run at all on the package the site
      recommends first. Reported from the VPS after reading the published v2.12.0 assets.

      This is the same lesson as GeneratePluginTrustManifestOnPublish below, in the other
      direction: that target existed here and not on the desktop head, this reference existed on
      the desktop head and not here. Two heads, two project files, and a fix landed in one of
      them is not a fix — it is a fix in one place. The parity is now asserted by
      PublishStagingParityTests rather than remembered.

      RuntimeIdentifier and SelfContained are FORWARDED, and that is the whole difference between
      a worker that starts and one that does not. This head publishes self-contained per-RID
      (release.yml passes self-contained), so its directory carries a private .NET runtime and
      the user is promised they need no .NET install. A framework-dependent worker apphost
      dropped beside it resolves its runtime through hostfxr's INSTALL search — never through the
      sibling private runtime — so it would fail to start on exactly the machines this head
      exists for. Built for the same RID and self-contained, it shares the host's runtime files
      instead.

      Measured on linux-x64, 2026-09-22: the worker's self-contained publish is 284 files /
      115.1 MB, and FIVE of them (0.15 MB) are not already in the host's publish byte-for-byte —
      the apphost, the worker dll, its deps.json and runtimeconfig.json, and the macOS sandbox
      profile. CopyScriptWorkerOnPublish below copies only the ones the host does not have, so
      the promise the ScriptWorker csproj makes in its own comment — "this costs no shipped
      bytes" — is now true here and measured rather than asserted.
    -->
    <ProjectReference Include="..\AccessibleTrader.ScriptWorker\AccessibleTrader.ScriptWorker.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
      <AdditionalProperties>$(_ScriptWorkerBuildProps)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

