<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AccessibleTrader.ScriptWorker</RootNamespace>
    <AssemblyName>AccessibleTrader.ScriptWorker</AssemblyName>
    <!--
      The worker is a standalone sandboxed console that the MAUI host spawns
      per compiled script. It reads stdin frames, executes indicator code in
      a collectible AssemblyLoadContext, and writes result frames to stdout.
      See docs/SANDBOX_DESIGN.md for the full protocol + per-platform OS
      sandbox plan.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccessibleTrader.Sdk\AccessibleTrader.Sdk.csproj" />
    <ProjectReference Include="..\AccessibleTrader.ScriptSandbox\AccessibleTrader.ScriptSandbox.csproj" />
    <!--
      Strategy scripts compile against AccessibleTrader.Core — BaseStrategy and the strategy
      helper types live there, and CompileStrategyAsync has always put Core in the reference
      set. A script assembly that names a Core type therefore cannot LOAD without Core
      resolvable from the worker, so the worker has to carry it: the collectible ALC falls back
      to the default context, which probes this project's deps.json and nothing else.

      This costs no shipped bytes. The BlazorClient's CopyScriptWorker target copies the whole
      worker output over the host's own directory, which already holds an identical Core.dll
      and its dependencies from the same build.

      It does NOT give a script the host's service graph: PluginHostServices' statics are unset
      in the worker and Core's caches are empty there, so a strategy that reaches for a host
      singleton gets null. Everything the strategy templates teach reads its inputs from OnBar's
      arguments and is unaffected.
    -->
    <ProjectReference Include="..\AccessibleTrader.Core\AccessibleTrader.Core.csproj" />
  </ItemGroup>

  <!--
    Hard memory ceiling for user script code, enforced by the RUNTIME rather than by the
    supervisor.

    OutOfProcessScriptHost polls WorkingSet64 every 2 seconds against a 256 MB quota, so a
    script that writes `new double[500_000_000]` gets the whole allocation and the host
    notices up to two seconds later — by which point the machine has already been asked for
    4 GB. A GC heap hard limit makes the runtime refuse the allocation at the point it is
    made: the script sees an OutOfMemoryException, the worker stays alive, and the user gets
    the error rather than the swap storm.

    192 MB sits deliberately BELOW OutOfProcessScriptHost.DefaultMaxWorkingSetBytes (256 MB)
    so the runtime is what refuses first and the poll stays as the backstop for everything a
    heap limit does not cover (native allocations, thread stacks, a runaway worker that is
    merely resident). ScriptWorkerMemoryLimitTests pins that ordering — the two numbers live
    in different projects and would otherwise drift apart silently.

    Decimal, not the 0x form used for the DOTNET_GCHeapHardLimit env var: this lands in
    runtimeconfig.json, where the value is read as a number.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="201326592" />
  </ItemGroup>

  <!--
    Ship the macOS sandbox profile next to the worker binary so
    MacSandboxExecLauncher can find it via
    Path.Combine(AppContext.BaseDirectory, "sandbox-profiles", "script-worker.sb").
    On non-macOS platforms the file tags along as a few kilobytes of
    unused text — cheap enough to avoid platform-gated build logic.
  -->
  <ItemGroup>
    <None Include="sandbox-profiles\script-worker.sb">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
