# Claude Code local settings + agent state
.claude/

# StrategyLab research fixtures — regenerate with `StrategyLab snapshot` / `xs-snapshot`
strategy-lab-data/

# StrategyLab walk-forward runtime outputs — regenerate per run
AccessibleTrader.StrategyLab/walk_forward_results.json

# WebHost runtime data fallback location — used when XDG_DATA_HOME is unset.
# DataCache/ holds OHLCV per-symbol caches, secrets/ holds DataProtection-
# encrypted API keys. Both are user-specific and regenerated at runtime.
AccessibleTrader.WebHost/AccessibleTrader/

# Same runtime data, but at the repo root — created when the WebHost is run
# from the solution directory (cwd) rather than the project directory.
/AccessibleTrader/

# ML experiment datasets (regenerable via StrategyLab ml-export)
strategy-lab-data/ml/*.csv
