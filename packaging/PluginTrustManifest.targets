<Project>

  <!--
    THE PLUGIN TRUST MANIFEST, ONCE, FOR EVERY HEAD.

    This logic used to exist twice — the same inline task and the same two targets, copied into
    AccessibleTrader.WebHost.csproj and AccessibleTrader.BlazorClient.csproj. That duplication is
    not a tidiness complaint; it is the exact defect this repository keeps paying for:

      - The WebHost gained GeneratePluginTrustManifestOnPublish when its own publish shipped
        without a manifest. The desktop head did not, and went its entire life shipping 33 plugin
        DLLs with no manifest — PluginTrustPolicy.RequireTrusted enforcing an empty allow-list and
        refusing all 33, the market dropdown offering only the built-in providers. Found from a
        Windows VM on 2026-09-21, not by a test.
      - When that was fixed by copying the target across, the copy inherited the assumption that
        the manifest belongs at $(PublishDir). On Mac Catalyst it does not: the plugins live in
        AppBundle.app/Contents/MonoBundle and so does AppContext.BaseDirectory, while $(PublishDir)
        is the directory the bundle sits IN. So the target ran, wrote a manifest, and the workflow
        zipped the bundle without it. Found on 2026-09-22 by reading the published v2.12.0 .app.

    Both bugs are the same bug: the manifest has to be where the PLUGINS are, and that is not a
    constant across heads. So the rule is now stated once, as a rule —
    WriteBesidePlugins="true" puts the manifest in the directory the plugin DLLs were actually
    found in — and imported by both heads instead of remembered by both authors.
  -->

  <UsingTask TaskName="HashPluginDlls"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <PluginsDir ParameterType="System.String" Required="true" />
      <ManifestPath ParameterType="System.String" Required="true" />
      <!--
        Also write the manifest into the directory the plugin DLLs were found in, when that is
        not already where ManifestPath points. This is what makes the Mac Catalyst bundle work
        without the targets needing to know what an .app is.
      -->
      <WriteBesidePlugins ParameterType="System.Boolean" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
        if (!Directory.Exists(PluginsDir))
        {
            Log.LogMessage(MessageImportance.Normal, $"Plugins dir {PluginsDir} not found — skipping manifest generation.");
            return true;
        }

        // Kept UNDEDUPLICATED as well: the same plugin legitimately exists more than once under
        // a publish tree (loose per-RID output and again inside an .app bundle), and which copy
        // a name-deduplicated list keeps is an artefact of walk order.
        var allFiles = Directory
            .EnumerateFiles(PluginsDir, "AccessibleTrader.Plugins.*.dll", SearchOption.AllDirectories)
            .Where(p => !p.Contains(Path.DirectorySeparatorChar + "ref" + Path.DirectorySeparatorChar))
            .ToList();

        var dlls = allFiles
            .Select(p => new { Path = p, Name = Path.GetFileName(p) })
            .GroupBy(x => x.Name)
            .Select(g => g.First())
            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (dlls.Count == 0)
        {
            Log.LogMessage(MessageImportance.Normal, $"No AccessibleTrader.Plugins.*.dll found under {PluginsDir} — skipping manifest generation.");
            return true;
        }

        var sb = new StringBuilder();
        sb.AppendLine("# AccessibleTrader plugin trust manifest");
        sb.AppendLine("# Generated: " + DateTime.UtcNow.ToString("u"));
        sb.AppendLine("# One SHA-256 hex digest per line. '#' starts a comment.");
        sb.AppendLine("# Generated automatically by packaging/PluginTrustManifest.targets.");
        sb.AppendLine();

        // SHA256.HashData(stream) is .NET 5+ and isn't available inside the RoslynCodeTaskFactory
        // host on some build SDKs. Use the broadly-compatible Create()+ComputeHash() pair so the
        // task compiles under every supported MSBuild runtime.
        using (var sha = SHA256.Create())
        {
            foreach (var dll in dlls)
            {
                byte[] hash;
                using (var fs = File.OpenRead(dll.Path))
                    hash = sha.ComputeHash(fs);
                var hex = BitConverter.ToString(hash).Replace("-", "");
                sb.Append(hex).Append("  # ").AppendLine(dll.Name);
            }
        }

        var manifestFull = Path.GetFullPath(ManifestPath);
        Directory.CreateDirectory(Path.GetDirectoryName(manifestFull));
        File.WriteAllText(manifestFull, sb.ToString());
        Log.LogMessage(MessageImportance.High, $"Wrote {dlls.Count} trusted plugin hashes to {manifestFull}");

        if (!WriteBesidePlugins) return true;

        // ONE MANIFEST PER DIRECTORY THAT HOLDS PLUGINS, HASHING THAT DIRECTORY'S OWN FILES.
        //
        // Two mistakes are possible here and the first draft made both. The list above is
        // deduplicated BY FILE NAME across the whole tree, which is right for a single manifest
        // and fatally wrong as a list of destinations: on Mac Catalyst the same plugin exists
        // loose in bin/<rid>/ AND inside YourApp.app/Contents/MonoBundle, so the GroupBy kept
        // whichever the walk reached first and the bundle was never seen at all. That is exactly
        // how the v2.12.0 .app shipped with 33 plugins and no manifest, and the first fix for it
        // reproduced the bug one layer in.
        //
        // The second is subtler and worse: writing the deduplicated digests into a directory
        // whose copies are DIFFERENT BYTES. PluginTrustPolicy would then refuse every plugin
        // there — a manifest that is present and wrong, which is harder to diagnose than one
        // that is absent. So each directory is hashed on its own terms.
        foreach (var group in allFiles.GroupBy(f => Path.GetDirectoryName(f), StringComparer.OrdinalIgnoreCase))
        {
            var destination = Path.GetFullPath(Path.Combine(group.Key, "plugins_trusted.manifest"));
            if (string.Equals(destination, manifestFull, StringComparison.OrdinalIgnoreCase)) continue;

            var local = new StringBuilder();
            local.AppendLine("# AccessibleTrader plugin trust manifest");
            local.AppendLine("# Generated: " + DateTime.UtcNow.ToString("u"));
            local.AppendLine("# One SHA-256 hex digest per line. '#' starts a comment.");
            local.AppendLine("# Generated automatically by packaging/PluginTrustManifest.targets.");
            local.AppendLine();

            var here = group.Select(f => new { Path = f, Name = Path.GetFileName(f) })
                            .OrderBy(x => x.Name, StringComparer.OrdinalIgnoreCase)
                            .ToList();

            using (var sha = SHA256.Create())
            {
                foreach (var dll in here)
                {
                    byte[] hash;
                    using (var fs = File.OpenRead(dll.Path))
                        hash = sha.ComputeHash(fs);
                    local.Append(BitConverter.ToString(hash).Replace("-", "")).Append("  # ").AppendLine(dll.Name);
                }
            }

            File.WriteAllText(destination, local.ToString());
            Log.LogMessage(MessageImportance.High, $"Wrote {here.Count} trusted plugin hashes to {destination}");
        }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!--
    WHEN NOT TO WRITE INTO A BUNDLE, and it took a failed release to learn it.

    A universal Mac Catalyst publish builds the app once per RID and then LIPO-merges the two
    bundles, and that merge requires every non-binary file to be BYTE-IDENTICAL between them.
    Two per-RID manifests never are: they carry a generation timestamp, and the plugin
    assemblies they hash are different builds. So writing the manifest into each inner bundle
    turned "the macOS app has no manifest" into "the macOS app does not build":

        error : Unable to merge the file 'Contents/MonoBundle/plugins_trusted.manifest',
                it's different between the input app bundles.

    The inner per-RID build is an INPUT to that merge; only the outer build runs after it, and
    only the outer build's bundle is the one that ships. An inner build is the case where a RID
    is pinned AND the project declares several — the outer universal build has RuntimeIdentifier
    empty, and every single-RID head (Windows, all four WebHosts) declares no RuntimeIdentifiers
    at all, so both are unaffected.
  -->
  <PropertyGroup>
    <_AttInnerRidBuildOfUniversalPublish Condition="'$(RuntimeIdentifier)' != '' and '$(RuntimeIdentifiers)' != ''">true</_AttInnerRidBuildOfUniversalPublish>
    <_AttWriteManifestBesidePlugins Condition="'$(_AttInnerRidBuildOfUniversalPublish)' == 'true'">false</_AttWriteManifestBesidePlugins>
    <_AttWriteManifestBesidePlugins Condition="'$(_AttWriteManifestBesidePlugins)' == ''">true</_AttWriteManifestBesidePlugins>
  </PropertyGroup>

  <!--
    Build-time manifest, for running out of bin/. Not the one that ships.
  -->
  <Target Name="GeneratePluginTrustManifest" AfterTargets="Build" Condition=" '$(OutDir)' != '' ">
    <HashPluginDlls PluginsDir="$(OutDir)"
                    ManifestPath="$(OutDir)plugins_trusted.manifest"
                    WriteBesidePlugins="$(_AttWriteManifestBesidePlugins)" />
  </Target>

  <!--
    Publish-time manifest, and the one that decides whether a released build has any providers.

    A `dotnet publish` does NOT carry a file a custom target dropped into $(OutDir), and a
    self-contained RID publish copies the plugin DLLs into PublishDir, so the manifest has to be
    generated THERE, against the published DLLs — the digests then describe the bytes that
    actually ship. Without this the released zip has the plugin DLLs and no manifest,
    RequireTrusted refuses every one of them, and the application behaves exactly as though no
    plugins were installed, which is not a symptom anyone reads as "a manifest is missing".
  -->
  <Target Name="GeneratePluginTrustManifestOnPublish" AfterTargets="Publish" Condition=" '$(PublishDir)' != '' ">
    <HashPluginDlls PluginsDir="$(PublishDir)"
                    ManifestPath="$(PublishDir)plugins_trusted.manifest"
                    WriteBesidePlugins="$(_AttWriteManifestBesidePlugins)" />
  </Target>

</Project>
